    // ═══ CHORD HELP OVERLAY (v0.1.353) ═══
    //
    // Full-screen-ish popup showing every keybinding grouped by
    // category. Triggered by F1 / Ctrl+/ / Ctrl+? — the standard
    // "how do I use this app" reflexes.
    //
    // Closes on Escape or click-outside. Doesn't get in the way
    // of the chord that opened it (the overlay doesn't claim
    // any chords itself, so e.g. another F1 just re-fires the
    // toggle through the global Shortcut, which currently
    // re-opens; could toggle in a follow-up).
    // v0.1.765: build-error fuzzy menu. Parses the SUMMARY/CAT/DIAG wire from
    // backend.summarize_focused_build() and shows a categorized, theme-tinted,
    // keyboard/voice-navigable list of cargo/cmake diagnostics. Errors first.
    Popup {
        id: errorMenu
        modal: true
        dim: true
        closePolicy: Popup.CloseOnEscape | Popup.CloseOnPressOutside
        focus: true
        x: Math.round((root.width - width) / 2)
        y: Math.round((root.height - height) / 2)
        width: Math.min(root.width - 60, 760)
        height: Math.min(root.height - 80, 560)
        background: Rectangle { color: th.sf; radius: 12; border.color: th.bd; border.width: 1 }

        property int _errN: 0
        property int _warnN: 0
        property string _target: ""
        property var _cats: []     // [{key,label,count}]
        property var _diags: []    // [{sev,code,cat,file,line,col,msg,help}]

        // category → theme-tinted color (stable mapping for the chips + borders)
        function _catColor(key) {
            switch (key) {
                case "resolve":    return th.ac
                case "type":       return "#e0a03e"
                case "borrow":     return "#d2607a"
                case "trait":      return "#b07ad2"
                case "link":       return "#d2607a"
                case "cmake":      return "#6aa6d8"
                case "cfg":        return "#7d9dba"
                case "deprecated": return "#d89a4a"
                case "unused":     return th.tm
                case "style":      return "#7daa7d"
                default:           return th.tm
            }
        }

        function openFromFocused() {
            if (!backend || !backend.summarize_focused_build) return
            _parseWire(backend.summarize_focused_build())
            open()
        }

        function _parseWire(blob) {
            var cats = [], diags = []
            _errN = 0; _warnN = 0; _target = ""
            if (blob && blob.length > 0) {
                var lines = blob.split("\n")
                for (var i = 0; i < lines.length; i++) {
                    var f = lines[i].split("\x1F")
                    if (f[0] === "SUMMARY" && f.length >= 4) {
                        _errN = parseInt(f[1]) || 0
                        _warnN = parseInt(f[2]) || 0
                        _target = f[3]
                    } else if (f[0] === "CAT" && f.length >= 4) {
                        cats.push({ key: f[1], label: f[2], count: parseInt(f[3]) || 0 })
                    } else if (f[0] === "DIAG" && f.length >= 9) {
                        diags.push({
                            sev: f[1], code: f[2], cat: f[3], file: f[4],
                            line: f[5], col: f[6], msg: f[7], help: f[8]
                        })
                    }
                }
            }
            _cats = cats
            _diags = diags
        }

        contentItem: Column {
            spacing: 10
            // header
            Row {
                spacing: 10
                Text {
                    text: (errorMenu._errN === 0 ? "\u2713 " : "\u2717 ")
                          + errorMenu._errN + (errorMenu._errN === 1 ? " error" : " errors")
                          + " \u00B7 " + errorMenu._warnN + (errorMenu._warnN === 1 ? " warning" : " warnings")
                    color: errorMenu._errN === 0 ? "#7daa7d" : th.ac
                    font.pixelSize: 15; font.bold: true
                }
                Text {
                    visible: errorMenu._target.length > 0
                    text: "(" + errorMenu._target + ")"
                    color: th.tm; font.pixelSize: 13
                    anchors.verticalCenter: parent.verticalCenter
                }
            }
            // category chips
            Flow {
                width: parent.width
                spacing: 6
                Repeater {
                    model: errorMenu._cats
                    delegate: Rectangle {
                        height: 22
                        width: chipText.implicitWidth + 18
                        radius: 11
                        color: hexRgba(errorMenu._catColor(modelData.key), 0.18)
                        border.color: errorMenu._catColor(modelData.key)
                        border.width: 1
                        Text {
                            id: chipText
                            anchors.centerIn: parent
                            text: modelData.label + " \u00D7" + modelData.count
                            color: errorMenu._catColor(modelData.key)
                            font.pixelSize: 11
                        }
                    }
                }
            }
            // diagnostics list
            ListView {
                id: errorMenuList
                width: parent.width
                height: errorMenu.height - 110
                clip: true
                model: errorMenu._diags
                spacing: 4
                delegate: Rectangle {
                    width: errorMenuList.width
                    height: rowCol.implicitHeight + 12
                    color: rowHover.hovered ? hexRgba(th.tc, 0.05) : "transparent"
                    radius: 6
                    // category-tinted left bar
                    Rectangle {
                        width: 3; height: parent.height - 6
                        anchors.left: parent.left; anchors.leftMargin: 2
                        anchors.verticalCenter: parent.verticalCenter
                        radius: 2
                        color: errorMenu._catColor(modelData.cat)
                    }
                    HoverHandler { id: rowHover }
                    Column {
                        id: rowCol
                        anchors.left: parent.left; anchors.leftMargin: 14
                        anchors.right: parent.right; anchors.rightMargin: 10
                        anchors.verticalCenter: parent.verticalCenter
                        spacing: 2
                        Row {
                            spacing: 8
                            Text {
                                text: modelData.sev === "error" ? "\u2717" : "\u26A0"
                                color: modelData.sev === "error" ? th.ac : "#d89a4a"
                                font.pixelSize: 12
                            }
                            Text {
                                visible: modelData.code.length > 0
                                text: modelData.code; color: th.tm
                                font.pixelSize: 12; font.family: "monospace"
                            }
                            Text {
                                visible: modelData.file.length > 0
                                text: modelData.file + (modelData.line.length > 0 ? ":" + modelData.line : "")
                                color: th.ac; font.pixelSize: 12; font.family: "monospace"
                            }
                        }
                        Text {
                            width: parent.width
                            text: modelData.msg
                            color: th.tc; font.pixelSize: 13; wrapMode: Text.Wrap
                        }
                        Text {
                            visible: modelData.help.length > 0
                            width: parent.width
                            text: "\u2192 " + modelData.help
                            color: "#7daa7d"; font.pixelSize: 12; wrapMode: Text.Wrap
                        }
                    }
                    // click: copy the file:line location (jump-ready)
                    MouseArea {
                        anchors.fill: parent
                        onClicked: {
                            if (backend && backend.clipboard_set && modelData.file.length > 0) {
                                var loc = modelData.file + (modelData.line.length > 0 ? ":" + modelData.line : "")
                                backend.clipboard_set(loc)
                            }
                            errorMenu.close()
                        }
                    }
                }
                // empty state
                Text {
                    anchors.centerIn: parent
                    visible: errorMenuList.count === 0
                    text: errorMenu._errN === 0 && errorMenu._warnN === 0
                          ? "No diagnostics in recent output."
                          : ""
                    color: th.tm; font.pixelSize: 13
                }
            }
        }
    }

    Popup {
        id: chordOverlay
        modal: true
        dim: true
        closePolicy: Popup.CloseOnEscape | Popup.CloseOnPressOutside
        // v0.1.757: the global Escape Shortcut could shadow the Popup's
        // CloseOnEscape (the dogfood "ESC does not close F1 help" bug). Grab
        // focus on open and handle Escape explicitly so it always closes.
        // v0.1.762: a Popup is NOT an Item, so Keys.onEscapePressed / a
        // forceActiveFocus() call on it throw "Could not attach Keys property"
        // (seen in the dogfood log). ESC handling lives on the search TextInput
        // inside (which has focus + its own Keys.onEscapePressed) plus the
        // Popup's CloseOnEscape policy. `focus: true` is a valid Popup property
        // and helps the search field receive focus on open.
        focus: true
        x: Math.round((root.width - width) / 2)
        y: Math.round((root.height - height) / 2)
        width: Math.min(root.width - 60, 720)
        height: Math.min(root.height - 60, 600)
        background: Rectangle {
            color: th.sf
            radius: 12
            border.color: th.bd
            border.width: 1
        }
        // v0.1.371: search-box filter text. Empty = show all.
        // Non-empty = match against both keys and description
        // (case-insensitive substring). Categories with zero
        // surviving entries are hidden entirely.
        property string searchText: ""
        // v0.1.372: per-context filter. When true, hide chord
        // entries whose `context` field doesn't match the current
        // tab. Entries without a context field count as "any".
        // Defaults true so users see exactly what applies right
        // now — they can untick to see everything.
        property bool contextFilter: true
        // Reset filters every time the overlay opens so users
        // get a clean view; if they want to keep the prior
        // search they can re-type it. ContextFilter resets to
        // its default (true) too.
        onAboutToShow: { searchText = ""; contextFilter = true }

        // Helper: case-insensitive substring match against an
        // entry's keys/desc fields. Returns true when the entry
        // should be visible given the current searchText.
        function _entryMatches(entry, q) {
            if (!q || q.length === 0) return true
            var needle = q.toLowerCase()
            if (entry.keys && entry.keys.toLowerCase().indexOf(needle) >= 0)
                return true
            if (entry.display && entry.display.toLowerCase().indexOf(needle) >= 0)
                return true
            if (entry.desc && entry.desc.toLowerCase().indexOf(needle) >= 0)
                return true
            if (entry.category && entry.category.toLowerCase().indexOf(needle) >= 0)
                return true
            return false
        }

        // v0.1.372: context filter helper. Entries without a
        // context field always pass (treated as "any"). Tagged
        // entries only pass when the tag matches the current
        // tab. When contextFilter is false, everything passes.
        function _contextMatches(entry) {
            if (!contextFilter) return true
            if (!entry.context || entry.context === "any") return true
            // tabBar.currentIndex: 0 = browser, 1 = terminal
            var here = (tabBar.currentIndex === 1) ? "terminal" : "browser"
            return entry.context === here
        }

        // v0.1.384: keyboard quick-jump. Press Alt+<letter>
        // while the chord overlay is open to scroll-snap to
        // that category. Letters chosen for memorability —
        // not always the first letter of the category name
        // (Terminal collides with "Tabs & Navigation" if
        // we used first letters, so the mnemonic for
        // "Tabs & Navigation" is N for Nav).
        //
        // The Shortcut blocks fire even when the search
        // field has focus (since Alt is the modifier, not
        // a printable char), so power users can still
        // type-to-filter without breaking jumps.
        readonly property var jumpMap: ({
            "n": "Tabs & Navigation",
            "e": "Editing",
            "t": "Terminal",
            "v": "Voice & AI",
            "w": "Window",
            "h": "Help"
        })
        function _jumpToSection(letter) {
            var category = jumpMap[letter.toLowerCase()]
            if (!category) return
            // Find the matching section Column. Repeater
            // delegates are addressable by objectName.
            var children = _chordContent.children
            for (var i = 0; i < children.length; i++) {
                var c = children[i]
                if (!c || !c.objectName) continue
                // Walk into the Repeater's instantiated
                // delegates — they're grandchildren.
                if (c.objectName === "chordSection:" + category) {
                    _scrollFlickableTo(c.y)
                    return
                }
                // The Repeater itself doesn't have an
                // objectName; recurse one level for its
                // delegate Columns.
                if (c.children) {
                    for (var j = 0; j < c.children.length; j++) {
                        var gc = c.children[j]
                        if (gc && gc.objectName === "chordSection:" + category) {
                            _scrollFlickableTo(gc.y + c.y)
                            return
                        }
                    }
                }
            }
        }
        function _scrollFlickableTo(targetY) {
            // Clamp targetY into the valid contentY range.
            var maxY = Math.max(0, _chordFlick.contentHeight
                                - _chordFlick.height)
            var clamped = Math.max(0, Math.min(targetY, maxY))
            _chordFlick.contentY = clamped
        }

        // Six Shortcuts, one per jumpMap entry. enabled
        // only when the overlay is opened so we don't
        // steal Alt+T (etc) from the rest of the app.
        //
        // chord-registry-skip — these shortcuts are documented
        // in the overlay's own footer hint, and only fire while
        // the overlay is open, so they don't need a per-key
        // entry in the registry they're navigating.
        Shortcut {  // chord-registry-skip
            sequence: "Alt+N"; enabled: chordOverlay.opened
            onActivated: chordOverlay._jumpToSection("n")
        }
        Shortcut {  // chord-registry-skip
            sequence: "Alt+E"; enabled: chordOverlay.opened
            onActivated: chordOverlay._jumpToSection("e")
        }
        Shortcut {  // chord-registry-skip
            sequence: "Alt+T"; enabled: chordOverlay.opened
            onActivated: chordOverlay._jumpToSection("t")
        }
        Shortcut {  // chord-registry-skip
            sequence: "Alt+V"; enabled: chordOverlay.opened
            onActivated: chordOverlay._jumpToSection("v")
        }
        Shortcut {  // chord-registry-skip
            sequence: "Alt+W"; enabled: chordOverlay.opened
            onActivated: chordOverlay._jumpToSection("w")
        }
        Shortcut {  // chord-registry-skip
            sequence: "Alt+H"; enabled: chordOverlay.opened
            onActivated: chordOverlay._jumpToSection("h")
        }

        Flickable {
            id: _chordFlick
            anchors.fill: parent
            anchors.margins: 20
            contentHeight: _chordContent.implicitHeight + 20
            clip: true
            ScrollBar.vertical: ScrollBar {
                policy: ScrollBar.AsNeeded
            }
            Column {
                id: _chordContent
                width: parent.width
                spacing: 14

                Row {
                    width: parent.width
                    spacing: 10
                    Text {
                        text: "Keyboard shortcuts"
                        color: th.tc
                        font.pixelSize: 18
                        font.bold: true
                        anchors.verticalCenter: parent.verticalCenter
                    }
                    Item { width: 6; height: 1 }
                    Text {
                        text: "Esc to close · Alt+N/E/T/V/W/H jump to section"
                        color: th.tm
                        font.pixelSize: 11
                        font.italic: true
                        anchors.verticalCenter: parent.verticalCenter
                    }
                }

                // v0.1.371: search box. Type to filter the list
                // by chord keys or description. Autofocus on open
                // so power users can type without first clicking.
                Rectangle {
                    width: _chordContent.width
                    height: 28
                    radius: 6
                    color: th.ib
                    border.color: _chordSearchField.activeFocus ? th.ac : th.bd
                    border.width: 1
                    Row {
                        anchors.fill: parent
                        anchors.leftMargin: 8
                        anchors.rightMargin: 8
                        spacing: 6
                        Text {
                            text: "\u2315"  // command/keyboard glyph
                            color: th.tm
                            font.pixelSize: 14
                            anchors.verticalCenter: parent.verticalCenter
                        }
                        TextInput {
                            id: _chordSearchField
                            width: parent.width - 30
                            anchors.verticalCenter: parent.verticalCenter
                            color: th.tc
                            font.pixelSize: 12
                            selectByMouse: true
                            focus: chordOverlay.opened
                            text: chordOverlay.searchText
                            onTextChanged: chordOverlay.searchText = text
