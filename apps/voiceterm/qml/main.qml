                                }
                            }

                            function runScrollbackSearch() {
                                var q = termFindField.text
                                if (!backend || !backend.term_search_scrollback || q.length < 1) {
                                    termScreen.searchMatches = []
                                    termScreen.currentMatchIndex = -1
                                    termFindResults.text = ""
                                    return
                                }
                                // v0.1.355: pass caseSensitive state to
                                // backend. The backend always supported
                                // this arg; the UI surfaces it now.
                                var blob = backend.term_search_scrollback(q, caseSensitive)
                                var matches = []
                                if (blob && blob.length > 0) {
                                    var rows = blob.split("\n")
                                    for (var i = 0; i < rows.length; i++) {
                                        var parts = rows[i].split("\x1F")
                                        if (parts.length >= 4) {
                                            matches.push({
                                                abs: parts[0],
                                                colStart: parseInt(parts[1]),
                                                colEnd: parseInt(parts[2]),
                                                rowText: parts[3]
                                            })
                                        }
                                    }
                                }
                                termScreen.searchMatches = matches
                                if (matches.length > 0) {
                                    termScreen.currentMatchIndex = 0
                                    jumpToCurrent()
                                    termFindResults.text = "1 of " + matches.length
                                } else {
                                    termScreen.currentMatchIndex = -1
                                    termFindResults.text = "no matches"
                                }
                            }

                            // v0.1.361: kick off a filesystem search.
                            // Backend handles ripgrep (or grep fallback)
                            // in a worker thread; we poll for results.
                            // Every new keystroke cancels the prior
                            // search so the worker doesn't pile up.
                            function runFsSearch() {
                                if (!backend || !backend.fs_find_start) {
                                    termFindResults.text = "fs-find unavailable"
                                    return
                                }
                                // v0.1.363: refuse fs_find when in
                                // an SSH session. The search runs on
                                // the LOCAL filesystem, which is
                                // almost never what the user wants
                                // when they're working on a remote
                                // shell. Surface a friendly message
                                // and bail. Power-user can switch
                                // back to scrollback mode to search
                                // the remote shell's visible output.
                                if (backend.in_ssh_session === true) {
                                    termFindResults.text = "local only"
                                    fsResults = []
                                    fsSelectedIndex = -1
                                    fsPollTimer.stop()
                                    fsRunning = false
                                    return
                                }
                                // Always clear scrollback hits so they
                                // don't visually leak into files mode.
                                termScreen.searchMatches = []
                                termScreen.currentMatchIndex = -1
                                var q = termFindField.text
                                if (q.length < 2) {
                                    // Avoid spamming the FS on every
                                    // single-char keystroke. 2+ chars
                                    // before we kick anything off.
                                    fsResults = []
                                    fsSelectedIndex = -1
                                    fsPollTimer.stop()
                                    fsRunning = false
                                    termFindResults.text = q.length === 0
                                        ? "" : "type more…"
                                    return
                                }
                                // Cancel any in-flight search before
                                // starting a new one. Cheap; the worker
                                // checks the cancel flag between lines.
                                if (backend.fs_find_cancel) {
                                    backend.fs_find_cancel()
                                }
                                var started = backend.fs_find_start(q)
                                if (started) {
                                    fsRunning = true
                                    termFindResults.text = "searching…"
                                    fsPollTimer.start()
                                } else {
                                    // start_search refused — either
                                    // empty query or worker still in
                                    // flight. Schedule a retry on the
                                    // next poll tick.
                                    fsPollTimer.start()
                                }
                            }

                            // v0.1.361: drain the latest fs result.
                            // Called by fsPollTimer.
                            function _drainFsResult() {
                                if (!backend || !backend.fs_find_poll) {
                                    fsPollTimer.stop()
                                    fsRunning = false
                                    return
                                }
                                var blob = backend.fs_find_poll()
                                if (blob && blob.length > 0) {
                                    var results = []
                                    var rows = blob.split("\n")
                                    for (var i = 0; i < rows.length; i++) {
                                        var parts = rows[i].split("\x1F")
                                        if (parts.length >= 3) {
                                            results.push({
                                                path: parts[0],
                                                line: parseInt(parts[1]),
                                                matched: parts[2],
                                            })
                                        }
                                    }
                                    fsResults = results
                                    fsSelectedIndex = results.length > 0 ? 0 : -1
                                    fsRunning = false
                                    fsPollTimer.stop()
                                    termFindResults.text = results.length > 0
                                        ? ("1 of " + results.length)
                                        : "no matches"
                                    return
                                }
                                // No result yet. If the worker has
                                // stopped running AND we got no blob,
                                // this query produced zero matches.
                                if (backend.fs_find_is_running
                                    && !backend.fs_find_is_running()) {
                                    fsResults = []
                                    fsSelectedIndex = -1
                                    fsRunning = false
                                    fsPollTimer.stop()
                                    termFindResults.text = "no matches"
                                }
                                // Otherwise just keep polling.
                            }

                            // v0.1.355: walk history. delta=-1 → older
                            // (Up), delta=+1 → newer (Down). When
                            // walking past the newest entry, restore
                            // pre-history text. When walking past oldest,
                            // stay put.
                            function walkHistory(delta) {
                                if (searchHistory.length === 0) return
                                // First Up press: capture current text
                                // so we can restore it.
                                if (historyIndex === -1 && delta < 0) {
                                    preHistoryText = termFindField.text
                                    historyIndex = searchHistory.length - 1
                                    _suppressHistoryReset = true
                                    termFindField.text = searchHistory[historyIndex]
                                    runSearch()
                                    return
                                }
                                if (historyIndex === -1) return  // can't go newer than fresh
                                var ni = historyIndex + delta
                                if (ni < 0) ni = 0  // clamp at oldest
                                if (ni >= searchHistory.length) {
                                    // Past newest — restore pre-history.
                                    historyIndex = -1
                                    _suppressHistoryReset = true
                                    termFindField.text = preHistoryText
                                    runSearch()
                                    return
                                }
                                historyIndex = ni
                                _suppressHistoryReset = true
                                termFindField.text = searchHistory[historyIndex]
                                runSearch()
                            }

                            // Move selection within the result list.
                            // delta=+1 → next (newer in the newest-first
                            // ordering returned by backend). delta=-1 →
                            // prev. Wraps around.
                            // v0.1.361: routes by mode — scrollback
                            // mode walks term match list; files mode
                            // walks fsResults.
                            function step(delta) {
                                if (mode === "files") {
                                    var fn = fsResults.length
                                    if (fn === 0) return
                                    var fi = fsSelectedIndex + delta
                                    if (fi < 0) fi = fn - 1
                                    if (fi >= fn) fi = 0
                                    fsSelectedIndex = fi
                                    termFindResults.text = (fi + 1) + " of " + fn
                                    return
                                }
                                var n = termScreen.searchMatches.length
                                if (n === 0) return
                                var idx = termScreen.currentMatchIndex + delta
                                if (idx < 0) idx = n - 1
                                if (idx >= n) idx = 0
                                termScreen.currentMatchIndex = idx
                                jumpToCurrent()
                                termFindResults.text = (idx + 1) + " of " + n
                            }

                            // v0.1.361: commit the currently selected
                            // fs result to the PTY. The match's path
                            // (relative to cwd) becomes a shell token
                            // the user can wrap in their editor command:
                            //   typed: "src/main.rs"
                            //   user does: $EDITOR <enter> or vim "
                            // We don't auto-invoke an editor — that
                            // would require knowing the user's
                            // preference and is opinionated. Pasting
                            // the path is the least-surprising primitive.
                            function commitFsSelection() {
                                if (mode !== "files") return false
                                if (fsSelectedIndex < 0
                                    || fsSelectedIndex >= fsResults.length) return false
                                if (!backend || !backend.pty_write) return false
                                var sel = fsResults[fsSelectedIndex]
                                // Shell-quote the path defensively so
                                // spaces / metachars don't break the
                                // command line.
                                var path = sel.path
                                var needsQuote = /[ \t'"$\\();|&<>*?\[\]{}]/.test(path)
                                var token = needsQuote
                                    ? "'" + path.replace(/'/g, "'\\''") + "'"
                                    : path
                                // Write the token (no newline — user
                                // composes the surrounding command).
                                backend.pty_write(token)
                                closeBar()
                                return true
                            }

                            // Scroll the terminal so the current match
                            // is visible. Targets viewport row = middle
                            // so the user has context above and below.
                            function jumpToCurrent() {
                                var idx = termScreen.currentMatchIndex
                                if (idx < 0 || idx >= termScreen.searchMatches.length) return
                                if (!backend || !backend.pty_scroll_to_abs) return
                                var m = termScreen.searchMatches[idx]
                                var rows = backend.term_visible_rows
                                    ? backend.term_visible_rows() : 24
                                var middleRow = Math.max(0, Math.floor(rows / 2) - 1)
                                backend.pty_scroll_to_abs(m.abs, middleRow)
                            }

                            // v0.1.361: poll the backend for fs_find
                            // results every 150ms while a search is in
                            // flight. _drainFsResult stops the timer
                            // when the worker reports it's done.
                            Timer {
                                id: fsPollTimer
                                interval: 150
                                running: false
                                repeat: true
                                onTriggered: termFindBar._drainFsResult()
                            }

                            RowLayout {
                                anchors.fill: parent
                                anchors.margins: 4
                                spacing: 6

                                // Search icon (decorative, helps locate
                                // the bar visually).
                                Text {
                                    text: "\uD83D\uDD0D"
                                    color: th.tm
                                    font.pixelSize: 14
                                    Layout.preferredWidth: 18
                                }

                                Rectangle {
                                    Layout.fillWidth: true
                                    Layout.preferredHeight: 26
                                    radius: 13
                                    color: th.ib
                                    TextInput {
                                        id: termFindField
                                        anchors.fill: parent
                                        anchors.margins: 8
                                        verticalAlignment: TextInput.AlignVCenter
                                        color: th.tc
                                        font.pixelSize: 12
                                        selectByMouse: true
                                        // v0.1.355: reset historyIndex
                                        // when user types (so editing a
                                        // recalled query doesn't get
                                        // clobbered by walkHistory). Run
                                        // search on every change as
                                        // before — power users get live
                                        // results without committing.
                                        onTextChanged: {
                                            // Only reset if the change
                                            // came from user typing, not
                                            // from walkHistory itself.
                                            // walkHistory sets historyIndex
                                            // first then changes text, so
                                            // its text-change comes with
                                            // historyIndex >= 0. Real user
                                            // typing leaves historyIndex
                                            // at the value walkHistory
                                            // set; we detect "user typed
                                            // after walking" via a flag.
                                            if (termFindBar._suppressHistoryReset) {
                                                termFindBar._suppressHistoryReset = false
                                            } else {
                                                termFindBar.historyIndex = -1
                                            }
                                            termFindBar.runSearch()
                                        }
                                        Keys.onPressed: function(e) {
                                            if (e.key === Qt.Key_Escape) {
                                                termFindBar.closeBar()
                                                e.accepted = true
                                            } else if (e.key === Qt.Key_Return || e.key === Qt.Key_Enter) {
                                                // v0.1.355: pressing Enter
                                                // commits the current
                                                // query into history,
                                                // then advances match.
                                                // v0.1.361: in files
                                                // mode, plain Enter
                                                // commits the selected
                                                // path to the PTY
                                                // instead of stepping.
                                                // Shift+Enter still
                                                // steps backward.
                                                termFindBar.pushHistory(termFindField.text)
                                                if (termFindBar.mode === "files"
                                                    && !(e.modifiers & Qt.ShiftModifier)) {
                                                    termFindBar.commitFsSelection()
                                                } else if (e.modifiers & Qt.ShiftModifier) {
                                                    termFindBar.step(-1)
                                                } else {
                                                    termFindBar.step(+1)
                                                }
                                                e.accepted = true
                                            } else if (e.key === Qt.Key_F3) {
                                                if (e.modifiers & Qt.ShiftModifier) {
                                                    termFindBar.step(-1)
                                                } else {
                                                    termFindBar.step(+1)
                                                }
                                                e.accepted = true
                                            } else if (e.key === Qt.Key_Up) {
                                                // v0.1.361: in files mode,
                                                // Up navigates the result
                                                // list (no history concept).
                                                // In scrollback mode, Up
                                                // walks history as before.
                                                if (termFindBar.mode === "files") {
                                                    termFindBar.step(-1)
                                                } else {
                                                    termFindBar._suppressHistoryReset = true
                                                    termFindBar.walkHistory(-1)
                                                }
                                                e.accepted = true
                                            } else if (e.key === Qt.Key_Down) {
                                                if (termFindBar.mode === "files") {
                                                    termFindBar.step(+1)
                                                } else {
                                                    termFindBar._suppressHistoryReset = true
                                                    termFindBar.walkHistory(+1)
                                                }
                                                e.accepted = true
                                            }
                                        }
                                    }
                                    Text {
                                        anchors.right: parent.right
                                        anchors.rightMargin: 10
                                        anchors.verticalCenter: parent.verticalCenter
                                        // v0.1.361: placeholder hints
                                        // the current search target.
                                        text: termFindBar.mode === "files"
                                            ? "Find in files (cwd)"
                                            : "Search scrollback"
                                        color: th.tm
                                        font.pixelSize: 11
                                        visible: termFindField.text.length === 0
                                    }
                                }

                                // Match counter ("3 of 14" or "no matches").
                                Text {
                                    id: termFindResults
                                    color: th.tm
                                    font.pixelSize: 11
                                    Layout.preferredWidth: 80
                                    horizontalAlignment: Text.AlignHCenter
                                }

                                // v0.1.361: mode toggle. Click to flip
                                // between scrollback search (📜) and
                                // filesystem find (📁). Active mode
                                // shows the corresponding glyph; the
                                // button itself stays compact like Aa.
                                Rectangle {
                                    Layout.preferredWidth: 28
                                    Layout.preferredHeight: 26
                                    radius: 6
                                    color: termFindBar.mode === "files"
                                        ? th.ac
                                        : (_modeMa.containsMouse
                                            ? Qt.lighter(th.sf, 1.4)
                                            : Qt.lighter(th.sf, 1.2))
                                    border.width: 1
                                    border.color: termFindBar.mode === "files"
                                        ? Qt.darker(th.ac, 1.2)
                                        : th.bd
                                    Behavior on color { ColorAnimation { duration: 100 } }
                                    Text {
                                        anchors.centerIn: parent
                                        // Scroll icon for scrollback,
                                        // folder for files.
                                        text: termFindBar.mode === "files"
                                            ? "\uD83D\uDCC1" : "\uD83D\uDCDC"
                                        font.pixelSize: 12
                                    }
                                    MouseArea {
                                        id: _modeMa
                                        anchors.fill: parent
                                        hoverEnabled: true
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: {
                                            termFindBar.mode =
                                                (termFindBar.mode === "files")
                                                ? "scrollback" : "files"
                                            // Cancel any in-flight fs
                                            // search if leaving files mode.
                                            if (termFindBar.mode !== "files"
                                                && backend && backend.fs_find_cancel) {
                                                backend.fs_find_cancel()
                                            }
                                            // Re-run the query in the new
                                            // mode so the user sees
                                            // appropriate results land.
                                            termFindBar.runSearch()
                                            termFindField.forceActiveFocus()
                                        }
                                    }
                                    // Tooltip on hover.
                                    Rectangle {
                                        visible: _modeMa.containsMouse
                                        anchors.bottom: parent.top
                                        anchors.bottomMargin: 4
                                        anchors.horizontalCenter: parent.horizontalCenter
                                        width: _modeTip.implicitWidth + 12
                                        height: 18
                                        radius: 4
                                        color: Qt.rgba(0, 0, 0, 0.85)
                                        z: 10
                                        Text {
                                            id: _modeTip
                                            anchors.centerIn: parent
                                            text: termFindBar.mode === "files"
                                                ? "Files (click for scrollback)"
                                                : "Scrollback (click for files)"
                                            color: "#fff"
                                            font.pixelSize: 9
                                        }
                                    }
                                }

                                // v0.1.355: case-sensitivity toggle (Aa).
                                // Active state borders in accent to make
                                // the on/off distinction obvious at a
                                // glance — power users care which mode
                                // they're in.
                                Rectangle {
                                    Layout.preferredWidth: 28
                                    Layout.preferredHeight: 26
                                    radius: 6
                                    color: termFindBar.caseSensitive
                                        ? th.ac
                                        : (_caseMa.containsMouse
                                            ? Qt.lighter(th.sf, 1.4)
                                            : Qt.lighter(th.sf, 1.2))
                                    border.width: 1
                                    border.color: termFindBar.caseSensitive
                                        ? Qt.darker(th.ac, 1.2)
                                        : th.bd
                                    Behavior on color { ColorAnimation { duration: 100 } }
                                    Text {
                                        anchors.centerIn: parent
                                        text: "Aa"
                                        color: termFindBar.caseSensitive ? "#fff" : th.tc
                                        font.pixelSize: 11
                                        font.bold: true
                                    }
                                    MouseArea {
                                        id: _caseMa
                                        anchors.fill: parent
                                        hoverEnabled: true
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: {
                                            termFindBar.caseSensitive =
                                                !termFindBar.caseSensitive
                                            // Re-run with new sensitivity
                                            // so the user sees the
                                            // change land immediately.
                                            termFindBar.runSearch()
                                            // Keep focus in the field —
                                            // tapping a toggle button
                                            // shouldn't steal focus from
                                            // the input the user is in.
                                            termFindField.forceActiveFocus()
                                        }
                                    }
                                    // Tooltip-style label on hover.
                                    Rectangle {
                                        visible: _caseMa.containsMouse
                                        anchors.bottom: parent.top
                                        anchors.bottomMargin: 4
                                        anchors.horizontalCenter: parent.horizontalCenter
                                        width: _caseTip.implicitWidth + 12
                                        height: 18
                                        radius: 4
                                        color: Qt.rgba(0, 0, 0, 0.85)
                                        z: 10
                                        Text {
                                            id: _caseTip
                                            anchors.centerIn: parent
                                            text: termFindBar.caseSensitive
                                                ? "Case-sensitive (on)"
                                                : "Case-sensitive (off)"
                                            color: "#fff"
                                            font.pixelSize: 9
                                        }
                                    }
                                }

                                // Prev (older / up).
                                Rectangle {
                                    Layout.preferredWidth: 26
                                    Layout.preferredHeight: 26
                                    radius: 13
                                    color: _prevMa.containsMouse
                                        ? Qt.lighter(th.sf, 1.4)
                                        : Qt.lighter(th.sf, 1.2)
                                    Behavior on color { ColorAnimation { duration: 100 } }
                                    Text {
                                        anchors.centerIn: parent
                                        text: "\u25B2"
                                        color: th.tc
                                        font.pixelSize: 10
                                    }
                                    MouseArea {
                                        id: _prevMa
                                        anchors.fill: parent
                                        hoverEnabled: true
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: termFindBar.step(-1)
                                    }
                                }

                                // Next (newer / down).
                                Rectangle {
                                    Layout.preferredWidth: 26
                                    Layout.preferredHeight: 26
                                    radius: 13
                                    color: _nextMa.containsMouse
                                        ? Qt.lighter(th.sf, 1.4)
                                        : Qt.lighter(th.sf, 1.2)
                                    Behavior on color { ColorAnimation { duration: 100 } }
                                    Text {
                                        anchors.centerIn: parent
                                        text: "\u25BC"
                                        color: th.tc
                                        font.pixelSize: 10
                                    }
                                    MouseArea {
                                        id: _nextMa
                                        anchors.fill: parent
                                        hoverEnabled: true
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: termFindBar.step(+1)
                                    }
                                }

                                // Close.
                                Rectangle {
                                    Layout.preferredWidth: 26
                                    Layout.preferredHeight: 26
                                    radius: 13
                                    color: _closeMa.containsMouse
                                        ? Qt.lighter(th.sf, 1.4)
                                        : Qt.lighter(th.sf, 1.2)
                                    Behavior on color { ColorAnimation { duration: 100 } }
                                    Text {
                                        anchors.centerIn: parent
                                        text: "\u2715"
                                        color: th.tc
                                        font.pixelSize: 12
                                    }
                                    MouseArea {
                                        id: _closeMa
                                        anchors.fill: parent
                                        hoverEnabled: true
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: termFindBar.closeBar()
                                    }
                                }
                            }
                        }

                        // v0.1.361: filesystem-find results panel.
                        // Visible only when the find bar is in files
                        // mode AND has at least one result OR is
                        // actively searching (so the user gets a
                        // visible "something is happening" affordance).
                        // Each row shows path:line and the matched text.
                        Rectangle {
                            id: fsResultsPanel
                            Layout.fillWidth: true
                            Layout.preferredHeight: visible
                                ? Math.min(220, fsResultsView.contentHeight + 8)
                                : 0
                            visible: termFindBar.visible
                                && termFindBar.mode === "files"
                                && (termFindBar.fsResults.length > 0
                                    || termFindBar.fsRunning)
                            color: Qt.darker(th.sf, 1.05)
                            border.color: th.bd
                            border.width: 1
                            clip: true
                            Behavior on Layout.preferredHeight {
                                NumberAnimation { duration: 100 }
                            }

                            ListView {
                                id: fsResultsView
                                anchors.fill: parent
                                anchors.margins: 4
                                model: termFindBar.fsResults
                                clip: true
                                spacing: 1
                                boundsBehavior: Flickable.StopAtBounds
                                // Keep the selected row in view as the
                                // user navigates with Up/Down.
                                currentIndex: termFindBar.fsSelectedIndex
                                highlightFollowsCurrentItem: true
                                onCurrentIndexChanged: positionViewAtIndex(
                                    currentIndex, ListView.Contain)

                                delegate: Rectangle {
                                    width: ListView.view.width
                                    height: 22
                                    color: index === termFindBar.fsSelectedIndex
                                        ? Qt.lighter(th.ac, 0.5)
                                        : (_fsRowMa.containsMouse
                                            ? Qt.lighter(th.sf, 1.3)
                                            : "transparent")
                                    radius: 3
                                    Behavior on color { ColorAnimation { duration: 80 } }

                                    Row {
                                        anchors.fill: parent
                                        anchors.leftMargin: 6
                                        anchors.rightMargin: 6
                                        spacing: 8
                                        Text {
                                            anchors.verticalCenter: parent.verticalCenter
                                            // path:line in accent color
                                            text: modelData.path + ":"
                                                + modelData.line
                                            color: th.ac
                                            font.pixelSize: 11
                                            font.family: "monospace"
                                        }
                                        Text {
                                            anchors.verticalCenter: parent.verticalCenter
                                            width: parent.width
                                                - parent.children[0].width - 16
                                            text: modelData.matched
                                            color: th.tc
                                            font.pixelSize: 11
                                            font.family: "monospace"
                                            elide: Text.ElideRight
                                        }
                                    }

                                    MouseArea {
                                        id: _fsRowMa
                                        anchors.fill: parent
                                        hoverEnabled: true
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: {
                                            termFindBar.fsSelectedIndex = index
                                            termFindBar.commitFsSelection()
                                        }
                                    }
                                }

                                // Spinner-ish "searching…" header when
                                // worker is running with no results yet.
                                Text {
                                    visible: termFindBar.fsRunning
                                        && termFindBar.fsResults.length === 0
                                    anchors.centerIn: parent
                                    text: "Searching files…"
                                    color: th.tm
                                    font.pixelSize: 11
                                    font.italic: true
                                }
                            }
                        }

                        // v0.1.748: native terminal tab strip (Hector step 2a).
                        // Renders the workspace tabs from root.termPaneStrip
                        // (the ws_wire format: idx\x1Fname\x1FpaneCount\x1F
                        // active\x1Ffocused). Tapping a tab switches to it
                        // (ws_command "go to tab N"); the + button opens a new
                        // tab. Hidden when there's <=1 tab so single-terminal
                        // users see no change. Switching swaps the focused
                        // pane's PTY into the existing termScreen view, so the
                        // render path below is unchanged.
                        Rectangle {
                            id: termTabStrip
                            Layout.fillWidth: true
                            property var _tabs: {
                                var out = []
                                var raw = root.termPaneStrip || ""
                                var lines = raw.split("\n")
                                for (var i = 0; i < lines.length; i++) {
                                    if (lines[i].length === 0) continue
                                    var f = lines[i].split("\u001F")
                                    if (f.length < 5) continue
                                    out.push({ idx: parseInt(f[0]), name: f[1],
                                        panes: parseInt(f[2]), active: f[3] === "1",
                                        focused: f[4],
                                        pinned: f.length > 5 && f[5] === "1",
                                        fenceAfter: f.length > 6 && f[6] === "1" })
                                }
                                return out
                            }
                            // v0.1.796: hidden — replaced by the vertical sidebar
