        // on close.
        property bool openedForWakeRegistration: false
        ListModel { id: voiceCandidatesModel }
        property alias candidates: voiceCandidatesModel
        // Live hints from the shell's tab completion. Populated when the
        // popup opens (with empty partial — "what's possible here") and
        // re-populated after whisper produces text. Each entry is a
        // string the user could tap to inject directly into the typed
        // command, bypassing voice scoring.
        ListModel { id: liveHintsModel }
        property bool _executed: false  // set true by executeIntent before close
        property string _pendingZellijCmd: ""  // v0.1.702 zellij confirm
        // v0.1.458: set true by an intent's dispatch (e.g. "llm")
        // that re-opens the popup, to suppress the deferred close.
        property bool _reopenDuringDispatch: false
        // Voice mode: 0 = off (button hidden, no capture), 1 = silent (no chime,
        // immediate record), 2 = chime (standard with auditory cue).
        // Future: 3 = wake word. Default 2 for discoverability — hint shown
        // on first use suggests Silent for fast talkers.
        property int voiceMode: 2
        onOpened: {
            _executed = false
            // Suppress wake-word detection while popup is open. This
            // prevents a wake firing mid-utterance (e.g. user says
            // "Yo Big K, list files" — without suppression, the bg
            // listener might fire ANOTHER wake event during the
            // command portion).
            if (backend && backend.voice_set_wake_suppressed) {
                backend.voice_set_wake_suppressed(true)
            }
            // Defensive reset: any time the popup opens, every transient field
            // should be in a clean state. Previously only startListening()
            // cleared a subset (recognizedText/intentKind/intentDesc/intentParam),
            // which left phoneticMatch / whisperText / candidates / etc.
            // showing stale data from previous sessions when the popup was
            // reopened via certain paths (e.g. FAB press without proper tap,
            // LLM-async open path, or dismissal-then-reopen cycles).
            if (!recording && !processing) {
