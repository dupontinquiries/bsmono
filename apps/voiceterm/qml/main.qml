                                    }
                                    if (termScreen.smoothScrollEnabled) {
                                        slideAnim.stop()
                                        // When scrolling BACK (dir>0), older
                                        // content appears at the top, which
                                        // means termText is now showing
                                        // content positioned ABOVE where it
                                        // was. To make the visible position
                                        // equal the OLD position (so we can
                                        // animate from there), we shift
                                        // termText DOWN by rows * rowH. That
                                        // means slideOffset is positive for
                                        // dir>0, negative for dir<0.
                                        termScreen.slideOffset = dir * rows * rowH
                                        slideAnim.start()
                                    }
                                }
                            }

                            // ─── Non-invasive terminal animations ───
                            //
                            // Three layered overlays. None of them block
                            // input, none reflow text, none move the
                            // grid. They sit on top of the terminal,
                            // ignore mouse events, and trigger off
                            // already-emitted backend signals.

                            // (1) Command-boundary flash bar.
                            //
                            // A 2px tall colored bar slides across the
                            // BOTTOM edge of the terminal each time the
                            // user submits a command (Enter on a non-
                            // empty line). Color is neutral cyan for
                            // now; future versions can color-code by
                            // exit status if shell integration via
                            // OSC 133 is added.
                            //
                            // The animation: bar starts at left edge,
                            // sweeps right at constant velocity, fades
                            // out as it goes. Total duration 380ms.
                            // Triggered by watching backend.term_command_count
                            // for changes — no new signal needed, the
                            // existing property's change-notify is
                            // enough.
                            Rectangle {
                                id: _cmdFlashBar
                                anchors.left: parent.left
                                anchors.bottom: parent.bottom
                                height: 2
                                width: 0
                                radius: 1
                                color: Qt.lighter(th.ac, 1.4)
                                opacity: 0
                                z: 5
                                // Block mouse events from being captured.
                                // Without this, the bar (briefly) shadows
                                // the click target underneath.
                                enabled: false
                                Connections {
                                    target: backend
                                    ignoreUnknownSignals: true
                                    function onTerm_command_count_changed() {
                                        _flashSweep.restart()
                                    }
                                }
                                ParallelAnimation {
                                    id: _flashSweep
                                    NumberAnimation {
                                        target: _cmdFlashBar; property: "width"
                                        from: 0; to: termScreen.width
                                        duration: 380
                                        easing.type: Easing.OutQuart
                                    }
                                    SequentialAnimation {
                                        NumberAnimation {
                                            target: _cmdFlashBar; property: "opacity"
                                            from: 0; to: 0.85
                                            duration: 60
                                            easing.type: Easing.OutQuad
                                        }
                                        NumberAnimation {
                                            target: _cmdFlashBar; property: "opacity"
                                            from: 0.85; to: 0.0
                                            duration: 320
                                            easing.type: Easing.InQuad
                                        }
                                    }
                                }
                            }

                            // (2) Idle prompt heartbeat.
                            //
                            // When the terminal hasn't received any new
                            // output for a while AND the user isn't in
                            // an alt-screen TUI, a *very* faint pulse
                            // appears around the cursor. Says "I'm here,
                            // waiting for you." Stops the moment any
                            // output arrives or any key is pressed.
                            //
                            // We piggyback on the existing termCursor
                            // Rectangle by overlaying a slightly larger
                            // halo Rectangle that fades in/out. Sits at
                            // z=4 so it's below the cursor itself
                            // (z=10) but above the text.
                            //
                            // Idle threshold: 4s without output_changed.
                            // That's long enough that fast typists never
                            // see it (they're still mid-edit) but short
                            // enough that "I just got back from making
                            // tea" users see the friendly indicator.
                            Rectangle {
                                id: _idleHalo
                                // v0.1.149 fix: guard against backend == null.
                                // The original `&& !backend.term_in_alt_screen()`
                                // crashed with TypeError when backend was null
                                // (segfault in user journal). Bindings fire
                                // during shutdown and early startup; both
                                // moments can hit a null backend. Treat null
                                // backend as "not in alt screen" — same as the
                                // safe default the halo wants anyway.
                                visible: cursorMode > 0
                                    && termCursor.visible
                                    && (backend ? !backend.term_in_alt_screen() : false)
                                    && _idleHaloAlpha > 0.01
                                x: termCursor.x - 3
                                y: termCursor.y - 3
                                width: termCursor.width + 6
                                height: termCursor.height + 6
                                radius: 3
                                color: "transparent"
                                border.color: Qt.lighter(th.ac, 1.6)
                                border.width: 1
                                opacity: _idleHaloAlpha
                                z: 4
                                enabled: false
                                property real _idleHaloAlpha: 0
                                // Idle detection. Reset on any output
                                // change OR any key press. Polls every
                                // 1s for low overhead.
                                property real _lastActivity: 0
                                Component.onCompleted: _lastActivity = Date.now()
                                Connections {
                                    target: backend
                                    ignoreUnknownSignals: true
                                    function onTerm_output_changed() {
                                        _idleHalo._lastActivity = Date.now()
                                        _idleHaloAnim.stop()
                                        _idleHalo._idleHaloAlpha = 0
                                    }
                                    function onTerm_command_count_changed() {
                                        _idleHalo._lastActivity = Date.now()
                                        _idleHaloAnim.stop()
                                        _idleHalo._idleHaloAlpha = 0
                                    }
                                }
                                Timer {
                                    interval: 1000
                                    running: tabBar.currentIndex === 1
                                    repeat: true
                                    onTriggered: {
                                        if (!backend) return  // v0.1.149 null-guard
                                        var idle = Date.now() - _idleHalo._lastActivity
                                        if (idle > 4000 && !_idleHaloAnim.running
                                            && !backend.term_in_alt_screen()) {
                                            _idleHaloAnim.start()
                                        }
                                    }
                                }
                                SequentialAnimation {
                                    id: _idleHaloAnim
                                    loops: Animation.Infinite
                                    NumberAnimation {
                                        target: _idleHalo
                                        property: "_idleHaloAlpha"
                                        from: 0; to: 0.35
                                        duration: 1400
                                        easing.type: Easing.InOutSine
                                    }
                                    NumberAnimation {
                                        target: _idleHalo
                                        property: "_idleHaloAlpha"
                                        from: 0.35; to: 0
                                        duration: 1400
                                        easing.type: Easing.InOutSine
                                    }
                                }
                            }

                            // (3) Output-arrival ripple.
                            //
                            // When new PTY output arrives after a
                            // significant pause (the user ran something
                            // slow and it just finished, OR a remote
                            // process just printed), a faint horizontal
                            // highlight sweep fires across the terminal.
                            // Helps the user's eye catch "the build
                            // finished and printed something" without
                            // them watching the screen.
                            //
                            // Suppressed in alt-screen — TUIs constantly
                            // produce output; sweeping every helix
                            // keystroke would be infuriating. Also
                            // ─── Bouncy typed-char overlay ───
                            //
                            // When the user types into the shell prompt
                            // (or when a voice-paste is being delivered
                            // character by character), spawn a small
                            // floating Text per char that bounces in
                            // from +12px right with springy easing,
                            // settles into place, then fades to 0
                            // opacity. By the time the fade is done
                            // the underlying terminal grid has already
                            // rendered the char in its final position,
                            // so the visual effect is "the letter
                            // appeared in flight then merged into the
                            // terminal."
                            //
                            // Suppressed in alt-screen mode (TUI apps
                            // do their own cursor management, our bounce
                            // would race their redraw).
                            Item {
                                id: _typeOverlay
                                anchors.fill: parent
                                anchors.margins: 2
                                z: 4   // above cursor (z=2-3) and ripple (z=3)
                                clip: false
                                // Track the same drag/slide offset that
                                // termText uses, so overlay chars stay
                                // visually pinned to the buffer cells they
                                // were spawned over even when the user is
                                // mid-drag or in a smooth-scroll. Without
                                // this, the bouncy letters appeared a few
                                // pixels higher (or lower) than the buffer
                                // char during scroll motion. v0.1.87 fix.
                                transform: Translate {
                                    y: termScreen.dragOffset + termScreen.slideOffset
                                }
                                // Hidden in alt-screen mode AND in password
                                // mode (sudo/ssh/passwd). Password mode
                                // suppression added v0.1.87 — without it,
                                // typed password chars were rendering as
                                // floating bouncy text visible to anyone
                                // watching the screen. Polled every 200ms
                                // because foreground_command is cheap.
                                property bool _inPwMode: false
                                Timer {
                                    interval: 200
                                    running: backend !== null
                                        && tabBar.currentIndex === 1
                                    repeat: true
                                    triggeredOnStart: true
                                    onTriggered: {
                                        if (backend && backend.term_in_password_mode) {
                                            _typeOverlay._inPwMode = backend.term_in_password_mode()
                                        }
                                    }
                                }
                                visible: backend !== null
                                    && !backend.term_in_alt_screen()
                                    && !_inPwMode
                                    && tabBar.currentIndex === 1

                                // Public API used by the termKeyArea
                                // onTextChanged hook AND by the voice
                                // self-typing path. Pass a single char
                                // string; we snapshot the cursor pos
                                // and create an animation.
                                //
                                // v0.1.101: animation duration adapts to
                                // typing speed. We measure the gap since
                                // the last spawn() call. If you're typing
                                // fast (gap < 100ms), the bounce runs at
                                // a proportionally shorter duration so it
                                // can keep up with each keystroke and
                                // doesn't pile up overlapping bounces.
                                // Slow typing keeps the full 320ms bounce
                                // for the satisfying feel on each char.
                                //
                                // Mapping (linear interp clamped):
                                //   gap >= 320ms → bounce duration = 320ms
                                //   gap == 100ms → bounce duration = 100ms
                                //   gap == 30ms  → bounce duration = 60ms
                                //   gap < 30ms   → bounce duration = 60ms (floor)
                                // Same scaling applied to mask fade-in,
                                // hold pause, and fade-out, so the whole
                                // sequence shrinks proportionally rather
                                // than just the bounce. Otherwise fast
                                // typing would have quick bounces but
                                // the holds/fades would still pile up.
                                property real _lastSpawnAt: 0
                                function _animDurationForGap(gap_ms) {
                                    if (gap_ms >= 320) return 1.0
                                    if (gap_ms <= 30)  return 0.20
                                    // Linear interp 30..320 → 0.20..1.0
                                    return 0.20 + 0.80 * (gap_ms - 30) / (320 - 30)
                                }

                                // v0.1.216: check whether a buffer cell is
                                // currently blank (space or past end-of-row).
                                // Used to suppress the typing animation when
                                // it would land on an existing character —
                                // the moving overlay text would visually
                                // OBSCURE the underlying buffer char during
                                // the bounce-in, which the user noticed.
                                //
                                // Strategy: peek at backend.term_row(row).
                                // Cells beyond the row's string length are
                                // blank (terminal hasn't written there yet).
                                // Cells AT or before length end are blank
                                // only if the char is a literal space.
                                //
                                // Performance: spawn() calls this once per
                                // keystroke. spawnSequence caches the row
                                // across its loop and only refetches on
                                // row change (newline), so a 100-char paste
                                // is 1-2 backend calls, not 100.
                                function _cellIsBlank(row, col) {
                                    if (!backend || !backend.term_row) return true
                                    return _cellIsBlankInRowText(backend.term_row(row), col)
                                }
                                function _cellIsBlankInRowText(rowText, col) {
                                    if (!rowText) return true
                                    if (col >= rowText.length) return true
                                    var c = rowText.charAt(col)
                                    return c === " " || c === "\t" || c === ""
                                }

                                function spawn(ch) {
                                    if (!ch || ch.length === 0) return
                                    if (!backend) return
                                    if (_inPwMode) return  // safety
                                    // Skip non-printable.
                                    var code = ch.charCodeAt(0)
                                    if (code < 0x20 && code !== 0x09) return
                                    if (code === 0x7f) return
                                    var curCol = backend.term_cursor_col
                                    var curRow = backend.term_cursor_row
                                    // v0.1.216: don't animate over existing
                                    // content. If the cell at the cursor
                                    // currently has a non-space character,
                                    // the bounce-in would briefly cover
                                    // visible text — worse than a missing
                                    // bounce. Skip silently; the PTY still
                                    // gets the byte, so functionality is
                                    // preserved.
                                    if (!_cellIsBlank(curRow, curCol)) return
                                    var cx = curCol * termScreen.charW
                                    var cy = curRow * termScreen.charH
                                    var now = Date.now()
                                    var gap = _lastSpawnAt > 0 ? (now - _lastSpawnAt) : 1000
                                    _lastSpawnAt = now
                                    var scale = _animDurationForGap(gap)
                                    _typeModel.append({
                                        ch: ch,
                                        startX: cx + 12,
                                        endX: cx,
                                        py: cy,
                                        spawnedAt: now,
                                        animScale: scale
                                    })
                                    // Cap pool size — old entries get
                                    // dropped on cleanup but we don't
                                    // want a runaway during paste.
                                    while (_typeModel.count > 64) {
                                        _typeModel.remove(0, 1)
                                    }
                                }

                                // Spawn an entire string with chars
                                // staggered visually. Used by the voice
                                // "self-typing" flow — when a command
                                // is being pasted, we still write the
                                // bytes to PTY immediately (so behavior
                                // doesn't change), but visually the
                                // chars appear in sequence with the
                                // bouncy entrance, reading like the
                                // assistant is typing the answer.
                                //
                                // The cursor position is read ONCE at
                                // sequence start and we increment by
                                // 1 cell per char locally — so by the
                                // time the third char animates in, its
                                // x is start_col + 2*charW even though
                                // backend.term_cursor_col may already
                                // have advanced past 10. Decoupling
                                // overlay position from live cursor
                                // makes the animation deterministic
                                // and frame-rate-stable.
                                function spawnSequence(s) {
                                    if (!s || s.length === 0) return
                                    if (!backend) return
                                    if (_inPwMode) return  // safety
                                    // Read cursor BEFORE bytes hit PTY
                                    // — caller is responsible for
                                    // sequencing. In practice we're
                                    // called after pty_write but the
                                    // grid update is async via the
                                    // poll, so cursor reads here are
                                    // typically still pre-paste.
                                    var startCol = backend.term_cursor_col
                                    var startRow = backend.term_cursor_row
                                    // v0.1.216: cache the current row's
                                    // text once. Refetch on row change
                                    // so a multi-line paste is bounded
                                    // at one backend call per row, not
                                    // per char.
                                    var rowText = backend && backend.term_row
                                        ? backend.term_row(startRow) : ""
                                    var lastFetchedRow = startRow
                                    // v0.1.218: track column WITHIN the
                                    // current row segment, not the loop
                                    // index. The previous formula
                                    // `(startCol + i)` was wrong after a
                                    // newline: it jumped by `i` instead
                                    // of resetting. Now col resets to 0
                                    // on newline and increments by 1 per
                                    // emitted char.
                                    var col = startCol
                                    for (var i = 0; i < s.length; i++) {
                                        var ch = s.charAt(i)
                                        var code = ch.charCodeAt(0)
                                        if (code < 0x20) {
                                            // Newline (or any C0 control
                                            // we treat as line break).
                                            col = 0
                                            startRow += 1
                                            continue
                                        }
                                        if (code === 0x7f) continue
                                        // v0.1.216: refetch row text when
                                        // the row has changed since the
                                        // last fetch (newline-driven row
                                        // bump above). Cached otherwise.
                                        if (startRow !== lastFetchedRow) {
                                            rowText = backend && backend.term_row
                                                ? backend.term_row(startRow) : ""
                                            lastFetchedRow = startRow
                                        }
                                        // Skip animating chars whose cell
                                        // currently has visible content —
                                        // animating over them would briefly
                                        // obscure the user's view. Note: we
                                        // still advance `col` for skipped
                                        // cells (the PTY byte still lands
                                        // there, so the spawn POSITION must
                                        // track it even when we don't emit
                                        // an overlay).
                                        if (!_cellIsBlankInRowText(rowText, col)) {
                                            col += 1
                                            continue
                                        }
                                        var cx = col * termScreen.charW
                                        var cy = startRow * termScreen.charH
                                        // Stagger spawnedAt so the
                                        // cleanup timer's age check
                                        // doesn't drop them all at once.
                                        // Also gives a visual cascade —
                                        // each char's bounce is offset
                                        // by ~25ms.
                                        _typeModel.append({
                                            ch: ch,
                                            startX: cx + 12,
                                            endX: cx,
                                            py: cy,
                                            spawnedAt: Date.now() + i * 25
                                        })
                                        col += 1
                                    }
                                    while (_typeModel.count > 64) {
                                        _typeModel.remove(0, 1)
                                    }
                                }

                                ListModel { id: _typeModel }

                                // Cleanup timer: drops entries whose
                                // animation+fade has fully finished.
                                // For cascade spawns spawnedAt is in
                                // the future; we wait until 850ms
                                // PAST that timestamp (cascade pause
                                // + opacity fade-in + bounce + hold +
                                // fade-out, with margin).
                                Timer {
                                    interval: 200  // poll more frequently for fast-typing cleanup
                                    running: _typeModel.count > 0
                                    repeat: true
                                    onTriggered: {
                                        var now = Date.now()
                                        for (var i = _typeModel.count - 1; i >= 0; i--) {
                                            var e = _typeModel.get(i)
                                            // Remove once the full sequence
                                            // (60+90+320+180+220 = ~870ms
                                            // at full scale) has elapsed.
                                            // Scale by animScale so fast-typed
                                            // entries clean up sooner.
                                            var s = e.animScale || 1.0
                                            var lifetime = Math.max(180, 870 * s)
                                            if (now - e.spawnedAt > lifetime) {
                                                _typeModel.remove(i, 1)
                                            }
                                        }
                                    }
                                }

                                Repeater {
                                    model: _typeModel
                                    // Each delegate is now an Item containing:
                                    //   - A masking Rectangle at the FINAL
                                    //     position (endX) that hides the
                                    //     buffer character below
                                    //   - The animated Text that bounces in
                                    //     from startX
                                    // The mask fades out as the overlay
                                    // fades, revealing the buffer char beneath
                                    // (crossfade reveal). Without this, the
                                    // user saw a double-image during the
                                    // bounce (grid + overlay both rendering
                                    // the same char).
                                    delegate: Item {
                                        id: _delegate
                                        // Cell-sized hit area
                                        x: 0
                                        y: 0
                                        width: termScreen.charW
                                        height: termScreen.charH
                                        property real animX: model.startX
                                        property int _cascadeMs: Math.max(0, model.spawnedAt - Date.now())
                                        // Mask — covers the buffer char at
                                        // endX with the terminal background
                                        // color. Same Z as the animated text
                                        // so it visually replaces the grid
                                        // char while the overlay does its
                                        // entrance.
                                        Rectangle {
                                            id: _mask
                                            x: model.endX
                                            y: model.py
                                            width: termScreen.charW
                                            height: termScreen.charH
                                            // termScreen background (whatever
                                            // the theme uses for the buffer).
                                            color: th.tbg
                                            opacity: 0  // starts hidden, animates up
                                        }
                                        Text {
                                            id: _animText
                                            text: model.ch
                                            font.pixelSize: termScreen.termFontPx
                                            font.family: termScreen.termFont
                                            color: th.tfg
                                            x: _delegate.animX
                                            y: model.py
                                            opacity: 0
                                        }
                                        Component.onCompleted: _seq.start()
                                        SequentialAnimation {
                                            id: _seq
                                            // Cascade wait — for sequence
                                            // spawns, each char's start
                                            // is offset 25ms after its
                                            // predecessor.
                                            PauseAnimation { duration: _delegate._cascadeMs }
                                            ParallelAnimation {
                                                // Mask becomes opaque to
                                                // hide the buffer char that
                                                // just landed there from the
                                                // PTY render.
                                                NumberAnimation {
                                                    target: _mask
                                                    property: "opacity"
                                                    from: 0; to: 1.0
                                                    duration: Math.max(15, 60 * (model.animScale || 1.0))
                                                    easing.type: Easing.OutQuad
                                                }
                                                // Animated text fades in.
                                                NumberAnimation {
                                                    target: _animText
                                                    property: "opacity"
                                                    from: 0; to: 1.0
                                                    duration: Math.max(20, 90 * (model.animScale || 1.0))
                                                    easing.type: Easing.OutQuad
                                                }
                                                // Bounce: animate from
                                                // startX to endX with
                                                // OutBack overshoot.
                                                NumberAnimation {
                                                    target: _delegate
                                                    property: "animX"
                                                    from: model.startX
                                                    to: model.endX
                                                    duration: Math.max(60, 320 * (model.animScale || 1.0))
                                                    easing.type: Easing.OutBack
                                                    easing.overshoot: 2.4
                                                }
                                            }
                                            // Hold the masked overlay briefly
                                            // — the user sees the bouncy
                                            // letter, the grid char is hidden.
                                            PauseAnimation { duration: Math.max(40, 180 * (model.animScale || 1.0)) }
                                            // Crossfade reveal: mask AND
                                            // animated text both fade out
                                            // in parallel. The buffer char
                                            // at the same position becomes
                                            // visible smoothly.
                                            ParallelAnimation {
                                                NumberAnimation {
                                                    target: _mask
                                                    property: "opacity"
                                                    from: 1.0; to: 0.0
                                                    duration: Math.max(50, 220 * (model.animScale || 1.0))
                                                    easing.type: Easing.InQuad
                                                }
                                                NumberAnimation {
                                                    target: _animText
                                                    property: "opacity"
                                                    from: 1.0; to: 0.0
                                                    duration: Math.max(50, 220 * (model.animScale || 1.0))
                                                    easing.type: Easing.OutQuad
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // ─── Output-arrival ripple ───
                            //
                            // Thin horizontal flash at the cursor row
                            // when fresh output arrives after a quiet
                            // period. Helps the user notice that the
                            // command produced a result. Auto-
                            // suppressed if the gap between outputs is
                            // < 1500ms (typical command output streams
                            // multiple chunks).
                            Rectangle {
                                id: _outputRipple
                                anchors.left: parent.left
                                anchors.right: parent.right
                                height: 1
                                radius: 0
                                color: Qt.lighter(th.ac, 1.5)
                                opacity: 0
                                y: termCursor.y
                                z: 3
                                enabled: false
                                property real _lastArrival: 0
                                Connections {
                                    target: backend
                                    ignoreUnknownSignals: true
                                    function onTerm_output_changed() {
                                        // LINT-OK: handler runs only when
                                        // backend emits a signal, so backend
                                        // is guaranteed non-null here. Lint
                                        // misclassifies this as a binding
                                        // because it walks back to find the
                                        // enclosing `ignoreUnknownSignals:`
                                        // and treats the whole thing as a
                                        // property RHS.
                                        if (backend.term_in_alt_screen()) return
                                        var now = Date.now()
                                        var gap = now - _outputRipple._lastArrival
                                        _outputRipple._lastArrival = now
                                        // Only ripple after a significant
                                        // pause — we don't want to fire on
                                        // every chunk of streamed output.
                                        if (gap > 1500) {
                                            _outputRipple.y = termCursor.y
                                            _outputRippleAnim.restart()
                                        }
                                    }
                                }
                                SequentialAnimation {
                                    id: _outputRippleAnim
                                    NumberAnimation {
                                        target: _outputRipple; property: "opacity"
                                        from: 0; to: 0.55
                                        duration: 80
                                        easing.type: Easing.OutQuad
                                    }
                                    NumberAnimation {
                                        target: _outputRipple; property: "opacity"
                                        from: 0.55; to: 0
                                        duration: 480
                                        easing.type: Easing.InQuad
                                    }
                                }
                            }

                            // ─── Split-pane render (v0.1.762, step 2b) ───
                            //
                            // When the active tab has >1 pane, the workspace
                            // model holds a split (confirmed on-device: the tab
                            // strip shows "1 (2)"), but the rich single-pane
                            // renderer above only ever shows the FOCUSED pane
                            // full-screen. This overlay tiles ALL panes in their
                            // geometric rects (from ws_pane_rects) so the split
                            // is actually visible.
                            //
                            // MVP trade-off (honest): every pane here uses the
                            // lightweight pane_row_html row renderer — no cursor
                            // blink, selection, or scrollback. You SEE the split
                            // and the focused pane still takes keyboard input
                            // (termKeyArea routes to self.pty = focused pane).
                            // Rich per-pane fidelity is a later step. The 1-pane
