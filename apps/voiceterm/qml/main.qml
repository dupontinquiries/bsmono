            // away so there's nothing to confirm. Sets _confirmListening
            // to false and tells the backend to drop in-flight audio.
            cancelConfirmListen()
            // Also cancel any in-flight AI fragment check — the popup
            // is closed so the answer can't reach the user. Note this
            // is the EXPLICIT cancel path; cancelConfirmListen no
            // longer auto-cancels the AI on incidental taps.
            cancelFragmentCheck()
            // Drop any pending fragment so it doesn't carry into the
            // next popup session.
