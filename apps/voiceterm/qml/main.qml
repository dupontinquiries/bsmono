            Rectangle { Layout.fillWidth: true; height: 1; color: th ? th.bd : "#33333a" }
            // v0.1.858: the per-row tier-2 strip replaces the old static 3-column
            // menu; this slim line just keeps the keyboard chords discoverable.
            Item {
                Layout.fillWidth: true; Layout.preferredHeight: 24
