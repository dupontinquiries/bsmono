    // v0.1.164: send-terminal-context + redaction-tier multi-button.
    //
    // Four cells: cancel (turns send-context OFF entirely) and three
    // escalating redaction tiers (1/2/3 locks) which both turn
    // send-context ON and set the redaction strength.
    //
    // The icons are cascading padlocks drawn as inline SVG data URIs.
    // Tier strength reads at a glance from the number of locks. Cascade
    // arrangement (top-left to bottom-right with overlap) gives a sense
    // of "stacking defenses" — additional protection layered on.
    //
    // SVG design:
    //   - 32×32 viewBox.
    //   - Padlock: shackle (U-arc, stroked) + body (rounded rect) +
    //     keyhole (small circle + slot).
    //   - Single lock: centered.
    //   - Multi-lock: cascade with (6,5) offset between locks. Each
    //     lock is drawn over the previous so the final visual reads
    //     top-left-back → bottom-right-front.
    //   - Stroke is white-ish (#d4d0c8 matches the app's tc); fill
    //     is semi-transparent so overlap is visible.
    //
    // The SVGs are encoded inline because shipping asset files for
    // four small icons would mean restructuring the build for
    // qrc/resource bundling. Inline keeps everything in one place.
    //
    // Each cell's `id` matches the redaction tier value semantically:
    //   "off"     → send_terminal_context = false (tier irrelevant)
    //   "tier1"   → send_terminal_context = true, redaction_tier = 1
    //   "tier2"   → send_terminal_context = true, redaction_tier = 2
    //   "tier3"   → send_terminal_context = true, redaction_tier = 3
    readonly property string _svgCancel:
        "data:image/svg+xml;utf8," +
        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'>" +
        "<circle cx='16' cy='16' r='12' fill='none' stroke='%23d4d0c8' stroke-width='2.5'/>" +
        "<line x1='8' y1='8' x2='24' y2='24' stroke='%23d4d0c8' stroke-width='2.5'/>" +
        "</svg>"

    // Single lock at center (offset_x=8, offset_y=6 in viewBox).
    readonly property string _svgLock1:
        "data:image/svg+xml;utf8," +
        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'>" +
        // shackle
        "<path d='M 12 14 L 12 11 A 4 4 0 0 1 20 11 L 20 14' fill='none' " +
        "stroke='%23d4d0c8' stroke-width='2'/>" +
        // body
        "<rect x='9' y='14' width='14' height='10' rx='1.5' fill='%23484034' " +
        "stroke='%23d4d0c8' stroke-width='1.5'/>" +
        // keyhole
        "<circle cx='16' cy='18' r='1.3' fill='%23d4d0c8'/>" +
        "<rect x='15.5' y='18' width='1' height='3' fill='%23d4d0c8'/>" +
