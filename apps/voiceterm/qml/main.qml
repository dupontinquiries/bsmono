                                if(backend)backend.pty_arrow(0);e.accepted=true
                            }
                            Keys.onDownPressed: function(e){
                                if((e.modifiers & Qt.ShiftModifier) && (e.modifiers & Qt.ControlModifier)){
                                    if(paneSplitLayer.visible && backend && backend.ws_command){ root.termPaneStrip = backend.ws_command("focus down") }
                                    e.accepted=true; return
                                }
                                if((e.modifiers & Qt.ShiftModifier) && backend){ backend.pty_write("\u001b[1;2B"); e.accepted=true; return }
                                if(backend)backend.pty_arrow(1);e.accepted=true
                            }
                            Keys.onLeftPressed: function(e){
                                var shift=(e.modifiers & Qt.ShiftModifier), ctrl=(e.modifiers & Qt.ControlModifier);
                                if(shift && ctrl){
                                    if(paneSplitLayer.visible && backend && backend.ws_command){ root.termPaneStrip = backend.ws_command("focus left") }
                                    e.accepted=true; return
                                }
                                if(shift && backend && backend.ws_command){
                                    root.termPaneStrip = backend.ws_command("previous tab"); e.accepted=true; return
                                }
