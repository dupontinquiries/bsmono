                && intentKind !== "unknown" && backend) {
                backend.voice_record_cancel(recognizedText, intentKind, intentParam || "")
            }
            // v0.1.267: also feed the cancel into the corpus-
            // driven filler-learning system. Bumps the rejection
            // count for this utterance; after 3 rejections of the
            // same low-content utterance ("mh mhmmm", "uh huh"),
            // it auto-promotes to a confirmed filler and future
            // utterances matching it short-circuit the popup
            // entirely.
            //
            // Independent of voice_record_cancel above: that one
            // tracks intent-specific learning ("user rejected the
            // grep-by-keypath interpretation of this utterance"),
            // while voice_register_rejection tracks utterance-
            // level filtering ("user keeps cancelling 'hmm'").
            if (!_executed && recognizedText && backend
                && backend.voice_register_rejection) {
                backend.voice_register_rejection(recognizedText)
            }
            // Clear stashed prior candidates from the yes/no confirmation
            // flow so they don't leak into the next time the popup opens.
            _prevHadCandidates = false
            _prevCandidates.clear()
