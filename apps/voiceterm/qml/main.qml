    // ───────────────────────────────────────────────────────────────────
    // v0.1.787: SUPER TOUCH-FRIENDLY COMMAND HISTORY
    //
    // A bottom sheet of recent commands (from backend.recall_commands). Each is a
    // big touch card; DRAG ONE UP to "pull it out" — it lifts in 3D (translate +
    // X-axis tilt + scale + growing shadow) and, released past the threshold,
    // saves to the "⭐ Saved" palette section with a confirming pulse. TAP a card
    // to drop the command onto the terminal input line (review, then Enter).
    // Self-contained overlay; uses only existing qt_methods.
    // ───────────────────────────────────────────────────────────────────
    Rectangle {
        id: cmdHistorySheet
        anchors.fill: parent
        visible: false
        z: 1350
        color: Qt.rgba(0, 0, 0, 0.5)
        property var items: []

        function open() {
            var raw = backend ? backend.recall_commands("", 40) : ""
            var lines = raw.length > 0 ? raw.split("\n") : []
            var arr = []
            for (var i = 0; i < lines.length; i++) {
                if (lines[i].length === 0) continue
                var f = lines[i].split("\t")
                if (!f[0] || f[0].length === 0) continue
                arr.push({ cmd: f[0], cwd: f[1] || "", ts: f[2] || "", exit: f[3] || "" })
            }
            cmdHistorySheet.items = arr
            cmdHistorySheet.visible = true
            cmdSheetPanel.y = cmdHistorySheet.height
            cmdSheetSlideIn.restart()
        }
        function close() { cmdSheetSlideOut.restart() }

        MouseArea { anchors.fill: parent; onClicked: cmdHistorySheet.close() }

        Rectangle {
            id: cmdSheetPanel
            width: parent.width
            height: Math.min(parent.height * 0.72, 640)
            anchors.horizontalCenter: parent.horizontalCenter
            y: parent.height
            color: th ? th.sf : "#16161c"
            radius: 20
            border.color: th ? th.bd : "#333"; border.width: 1
            clip: false
            MouseArea { anchors.fill: parent } // swallow taps inside the panel

            NumberAnimation { id: cmdSheetSlideIn; target: cmdSheetPanel; property: "y"
                to: cmdHistorySheet.height - cmdSheetPanel.height; duration: 300; easing.type: Easing.OutCubic }
            SequentialAnimation { id: cmdSheetSlideOut
                NumberAnimation { target: cmdSheetPanel; property: "y"; to: cmdHistorySheet.height; duration: 220; easing.type: Easing.InCubic }
                ScriptAction { script: cmdHistorySheet.visible = false } }

            ColumnLayout {
                anchors.fill: parent; anchors.margins: 16; spacing: 10
                RowLayout {
                    Layout.fillWidth: true; spacing: 8
                    Rectangle { width: 40; height: 5; radius: 3; color: th ? th.bd : "#444"; Layout.alignment: Qt.AlignHCenter }
                }
                RowLayout {
                    Layout.fillWidth: true
                    Text { text: "Command history"; color: th ? th.tc : "#eee"; font.pixelSize: 21; font.bold: true; Layout.fillWidth: true }
                    Text { text: "drag a card up to save  ↑"; color: th ? th.tm : "#8a8a93"; font.pixelSize: 12 }
                }
                Rectangle { Layout.fillWidth: true; height: 1; color: th ? th.bd : "#333" }
                ListView {
                    id: cmdHistList
                    Layout.fillWidth: true; Layout.fillHeight: true
                    clip: true; spacing: 12; cacheBuffer: 400
                    model: cmdHistorySheet.items
                    ScrollBar.vertical: ScrollBar { policy: ScrollBar.AsNeeded }
                    delegate: Item {
                        id: histRow
                        width: cmdHistList.width
                        height: 62
                        property var rowData: modelData
                        property real pull: 0
                        clip: false

                        // shadow grows as the card lifts
                        Rectangle {
                            anchors.fill: cardRect
                            anchors.topMargin: 6 + histRow.pull * 14
                            radius: cardRect.radius
                            color: "#000000"
                            opacity: histRow.pull * 0.45
                            z: -1
                        }

                        Rectangle {
                            id: cardRect
                            anchors.left: parent.left; anchors.right: parent.right
                            height: 56
                            radius: 13
                            color: th ? th.bg2 : "#23232c"
                            border.color: histRow.pull > 0.04 ? (th ? th.ac : "#7fd17f") : (th ? th.bd : "#333")
                            border.width: histRow.pull > 0.04 ? 2 : 1
                            transform: [
                                Translate { y: -histRow.pull * 28 },
                                Rotation { origin.x: cardRect.width / 2; origin.y: cardRect.height
                                    axis { x: 1; y: 0; z: 0 } angle: -histRow.pull * 24 },
                                Scale { origin.x: cardRect.width / 2; origin.y: cardRect.height / 2
                                    xScale: 1 + histRow.pull * 0.05; yScale: 1 + histRow.pull * 0.05 }
                            ]

                            RowLayout {
                                anchors.fill: parent; anchors.leftMargin: 16; anchors.rightMargin: 16; spacing: 12
                                Rectangle {
                                    width: 9; height: 9; radius: 5
                                    color: (histRow.rowData.exit === "0" || histRow.rowData.exit === "") ? "#50fa7b" : "#ff5555"
                                }
                                Text {
                                    Layout.fillWidth: true
                                    text: histRow.rowData.cmd
                                    color: th ? th.tc : "#eee"
                                    font.family: "monospace"; font.pixelSize: 15
                                    elide: Text.ElideRight; maximumLineCount: 1
                                }
                                Text {
                                    text: histRow.pull > 0.5 ? "release to save ★" : "save ↑"
                                    color: histRow.pull > 0.5 ? (th ? th.ac : "#7fd17f") : (th ? th.tm : "#8a8a93")
                                    font.pixelSize: 12; opacity: 0.5 + histRow.pull * 0.5
                                }
                            }

                            TapHandler {
                                onTapped: {
                                    if (backend && backend.pty_write) backend.pty_write(histRow.rowData.cmd)
                                    cmdHistorySheet.close()
                                }
                            }
                            DragHandler {
                                id: pullDrag
                                target: null
                                xAxis.enabled: false; yAxis.enabled: true
                                onTranslationChanged: histRow.pull = Math.max(0, Math.min(1, -translation.y / 80))
                                onActiveChanged: {
                                    if (!active) {
                                        if (histRow.pull > 0.5) histSavePulse.restart()
                                        else histReleaseBack.restart()
                                    }
                                }
                            }
                            SequentialAnimation {
                                id: histSavePulse
                                NumberAnimation { target: histRow; property: "pull"; to: 1; duration: 110; easing.type: Easing.OutCubic }
                                ScriptAction { script: {
                                    if (backend && backend.palette_add) backend.palette_add("\u2b50 Saved", histRow.rowData.cmd)
                                    cmdSavedToast.label = histRow.rowData.cmd; cmdSavedToast.flash()
                                } }
                                PauseAnimation { duration: 220 }
                                NumberAnimation { target: histRow; property: "pull"; to: 0; duration: 280; easing.type: Easing.InOutCubic }
                            }
                            NumberAnimation { id: histReleaseBack; target: histRow; property: "pull"; to: 0; duration: 240; easing.type: Easing.OutBack }
                        }
                    }
                }
            }

            // saved confirmation toast (rides above the list)
            Rectangle {
                id: cmdSavedToast
                property string label: ""
                anchors.horizontalCenter: parent.horizontalCenter
                anchors.top: parent.top; anchors.topMargin: 70
                width: Math.min(parent.width - 48, savedToastText.implicitWidth + 36)
                height: 40; radius: 20
                color: th ? th.ac : "#7fd17f"
                opacity: 0; visible: opacity > 0.01
                z: 50
                function flash() { savedToastAnim.restart() }
                Text {
                    id: savedToastText
                    anchors.centerIn: parent
                    text: "★ Saved  " + cmdSavedToast.label
                    color: "#0d1f0d"; font.pixelSize: 14; font.bold: true
                    elide: Text.ElideRight; width: Math.min(cmdSheetPanel.width - 60, implicitWidth)
                }
                SequentialAnimation {
                    id: savedToastAnim
                    NumberAnimation { target: cmdSavedToast; property: "opacity"; to: 1; duration: 140 }
                    PauseAnimation { duration: 900 }
                    NumberAnimation { target: cmdSavedToast; property: "opacity"; to: 0; duration: 280 }
                }
            }
        }
    }

    Timer { id: _saveTimer; interval: 1500; onTriggered: { if (backend) backend.save_settings() } }
    Timer { id: ptyPoll; interval: tabBar.currentIndex === 1 ? 50 : 500
        repeat: true; running: true
        // 50ms poll when terminal is visible (20fps for live updates),
        // 500ms when browsing (background commands still get tracked but
        // we don't waste cycles re-rendering HTML the user can't see).
        // Without this, every browser interaction was competing with 20
        // unnecessary terminal-renders per second.
        //
        // v0.1.244: also tracks alt-screen state transitions for the
        // profiling log. Useful for correlating frame drops with TUI
        // activations (vim/helix/htop/less). The event() call is a
        // no-op when WEB2QML_PROFILE != 1, so zero cost in normal use.
        property bool _lastAltScreen: false
        onTriggered: {
            if (!backend) return
            backend.pty_read_screen()
            if (_prof && _prof.enabled && backend.term_in_alt_screen) {
                var inAlt = backend.term_in_alt_screen()
                if (inAlt !== _lastAltScreen) {
                    _lastAltScreen = inAlt
                    _prof.event(inAlt ? "altscreen:enter" : "altscreen:exit")
                }
            }
        }
    }

