            processing = true
            recognizedText = ""; intentKind = ""; intentDesc = ""
            intentParam = ""; intentParam2 = ""
            whisperText = text
            phoneticMatch = ""; phoneticScore = 999
            phoneticMatch2 = ""; phoneticScore2 = 999
            showCandidates = false; topScore = 0; diagText = ""
            if (candidates) candidates.clear()
