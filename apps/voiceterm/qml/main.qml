                                                visible: modelData.kind === "d"
                                                    && !filePickerDrawer.folderOnly
                                                text: "\u203A"
                                                color: th.tm; font.pixelSize: 14
                                            }
                                            // v0.1.152 STAGE M: per-row gesture
                                            // menu. Same pattern as the block-
                                            // row `⋯` (v0.1.146) — single shared
                                            // popup at top level, `⋯` host
                                            // passes the row context (columnIndex,
                                            // entryName, entryKind) so dispatch
                                            // can resolve which row.
                                            //
                                            // Differentiated visual (1px resting
                                            // border, hover-fill) same as the
                                            // block-row ⋯ following v0.1.150.
                                            GestureHost {
                                                id: _fpMoreBtn
                                                popup: _filePickerRowPopup
                                                gestureContext: ({
                                                    columnIndex: _colPane._columnIndex,
                                                    entryName: modelData.name,
                                                    entryKind: modelData.kind
                                                })
                                                hoverEnabled: true
                                                Layout.preferredWidth: 24
                                                Layout.preferredHeight: 22
                                                ToolTip.visible: _fpMoreBtn.containsMouse
                                                ToolTip.text: "Actions"
                                                Rectangle {
                                                    anchors.fill: parent
                                                    radius: 5
                                                    color: _fpMoreBtn.containsMouse ? th.ac : "transparent"
                                                    border.width: _fpMoreBtn.containsMouse ? 0 : 1
                                                    border.color: Qt.rgba(th.tm.r, th.tm.g, th.tm.b, 0.35)
                                                    Text {
                                                        anchors.centerIn: parent
                                                        text: "\u22EF"  // ⋯
                                                        color: _fpMoreBtn.containsMouse ? "#fff" : th.tm
                                                        font.pixelSize: 12
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ── Single-pane fallback (pre-v125 layout) ──
            //
            // Shown when filePickerDrawer.useColumnPicker is false.
            // Renders ONLY the rightmost column's entries (the deepest
            // directory the user has drilled into). Tapping a directory
            // navigates into it IN PLACE — no column accumulation.
            //
            // The underlying _columns model still works the same way:
            // _navigateIntoFromColumn appends to _columns; in single-
            // pane mode we just show the last item. Up button pops the
            // last column (same as column mode), so navigation history
            // is preserved if user toggles back to column view.
            ListView {
                id: _singlePaneList
                visible: !filePickerDrawer.useColumnPicker
                Layout.fillWidth: true; Layout.fillHeight: true
                Layout.preferredHeight: visible ? -1 : 0
                clip: true
                // v0.1.263: single-pane file list now prepends a
                // synthetic ".." entry so users have a discoverable
                // in-list way to go up a folder. The existing ↑
                // button in the header still works; this matches
                // mental models from ranger / mc / DOS where `..`
                // is the first listed item. Skipped at filesystem
                // root.
                model: {
                    var _ = filePickerDrawer._columnsTick
                    if (filePickerDrawer._columns.items.length === 0) return []
                    var last = filePickerDrawer._columns.items[
                        filePickerDrawer._columns.items.length - 1]
                    var entries = last.entries
                    // Skip the .. entry if we're at root.
                    if (!last.path || last.path === "/") return entries
                    // Prepend a synthetic .. entry. Use a marker
                    // kind "up" so the delegate knows to invoke
                    // _navigateUp() rather than treating it as a
                    // normal directory.
                    var withUp = [{ kind: "up", name: "..", count: -1 }]
                    if (Array.isArray(entries)) {
                        for (var i = 0; i < entries.length; ++i) {
                            withUp.push(entries[i])
                        }
                    } else {
                        // entries may be a ListModel — iterate via
                        // count/get. Single-pane handles both forms
                        // because the underlying _columns store
                        // sometimes uses plain arrays.
                        for (var j = 0; j < entries.count; ++j) {
                            withUp.push(entries.get(j))
                        }
                    }
                    return withUp
                }
                delegate: Rectangle {
                    width: _singlePaneList.width
                    height: 36
                    color: _spMa.containsMouse
                        ? Qt.lighter(th.sf, 1.35)
                        : "transparent"
                    Behavior on color { ColorAnimation { duration: 80 } }
                    // v0.1.154: tap-to-open MouseArea declared FIRST so the
                    // later-declared RowLayout (containing the `⋯`
                    // GestureHost) renders on top at the ⋯ region. Same
                    // hit-test reasoning as the v0.1.152 column-mode
                    // delegate — see notes there.
                    MouseArea {
                        id: _spMa
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            // v0.1.263: the synthetic ".." entry
                            // uses kind "up" — handle by going up.
                            if (modelData.kind === "up") {
                                filePickerDrawer._navigateUp()
                                return
                            }
                            var lastIdx = filePickerDrawer._columns.items.length - 1
                            if (lastIdx < 0) return
                            filePickerDrawer._navigateIntoFromColumn(
                                lastIdx, modelData.name, modelData.kind)
                        }
                    }
                    RowLayout {
                        anchors.fill: parent
                        anchors.leftMargin: 12
                        anchors.rightMargin: 8
                        spacing: 10
                        Text {
                            // v0.1.263: ".." gets a distinct icon
                            // (up arrow) so it reads as
                            // "navigate up" not "folder named ..".
                            text: modelData.kind === "up" ? "\u2B05"
                                : modelData.kind === "d" ? "\uD83D\uDCC1"
                                : modelData.kind === "l" ? "\uD83D\uDD17"
                                : "\uD83D\uDCC4"
                            font.pixelSize: 14
                        }
                        Text {
                            Layout.fillWidth: true
                            text: (modelData.name || "?") + (modelData.kind === "d" ? "/" : "")
                            color: modelData.kind === "up" ? th.tm : th.tc
                            font.pixelSize: 13
                            font.italic: modelData.kind === "up"
                            elide: Text.ElideRight
                        }
                        // v0.1.154: per-row gesture menu, single-pane mode.
                        // Same shared `_filePickerRowPopup` instance as the
                        // column-mode delegate (v0.1.152). gestureContext
                        // always points at the last column since single-
                        // pane mode only shows that one.
                        GestureHost {
                            id: _spMoreBtn
                            popup: _filePickerRowPopup
                            gestureContext: ({
                                columnIndex: Math.max(0, filePickerDrawer._columns.items.length - 1),
                                entryName: modelData.name,
                                entryKind: modelData.kind
                            })
                            hoverEnabled: true
                            Layout.preferredWidth: 26
                            Layout.preferredHeight: 24
                            ToolTip.visible: _spMoreBtn.containsMouse
                            ToolTip.text: "Actions"
                            Rectangle {
                                anchors.fill: parent
                                radius: 5
                                color: _spMoreBtn.containsMouse ? th.ac : "transparent"
                                border.width: _spMoreBtn.containsMouse ? 0 : 1
                                border.color: Qt.rgba(th.tm.r, th.tm.g, th.tm.b, 0.35)
                                Text {
                                    anchors.centerIn: parent
                                    text: "\u22EF"  // ⋯
                                    color: _spMoreBtn.containsMouse ? "#fff" : th.tm
                                    font.pixelSize: 13
                                }
                            }
                        }
                    }
                }
            }

            // Bottom action bar: cd into current path / Insert path
            Rectangle {
                Layout.fillWidth: true; Layout.preferredHeight: 56
                color: Qt.darker(th.sf, 1.05)
                RowLayout {
                    anchors.fill: parent; anchors.margins: 8; spacing: 8
                    // cd into current path
                    Rectangle {
                        Layout.fillWidth: true; Layout.preferredHeight: 40
                        radius: 20
                        color: _cdMa.containsMouse ? Qt.lighter(th.ac, 1.15) : th.ac
                        Behavior on color { ColorAnimation { duration: 100 } }
                        Text { anchors.centerIn: parent; text: "\u2713 cd here"
                            color: "#fff"; font.pixelSize: 13; font.bold: true }
                        MouseArea { id: _cdMa; anchors.fill: parent; hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: filePickerDrawer._commitAsCd() }
                    }
                    // Insert path only (no cd)
                    Rectangle {
                        Layout.preferredWidth: 90; Layout.preferredHeight: 40
                        radius: 20
                        color: _insMa.containsMouse ? Qt.lighter(th.sf, 1.4) : Qt.lighter(th.sf, 1.2)
                        border.color: th.bd; border.width: 1
                        Text { anchors.centerIn: parent; text: "Insert"; color: th.tc; font.pixelSize: 12 }
                        MouseArea { id: _insMa; anchors.fill: parent; hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: filePickerDrawer._commitAsPath() }
                    }
                }
            }
        }
    }

    // ═══ ASK-AI POPUP ═══
    // Triggered by the "ask ai" voice buzzword. Shows the LLM's
    // response in a scrollable layout with code blocks rendered as
    // tappable rectangles. Press-and-hold a code block → paste it
    // to the terminal and run. Single-tap a code block → copy to
    // clipboard. Like a one-shot Jupyter notebook for voice.
    //
    // ─── Image preview popup ───
    //
    // Lightweight floating image preview for path tokens that look
    // like images. Designed to appear under the user's cursor on
    // hover (desktop) or after a brief tap-and-hold on mobile.
    //
    // Tap-and-hold on the preview itself opens the system share
    // portal via backend.file_share() — gives the user a native
    // share sheet on mobile (Telegram, Signal, Save) and a "open
    // with" affordance on desktop.
    //
    // Public API (call from anywhere):
    //   imagePreviewPopup.showAt(absPath, x, y)
    //   imagePreviewPopup.hide()
    Popup {
        id: imagePreviewPopup
        modal: false
        // No dim — this is a hover affordance, not a focus-stealing modal.
        closePolicy: Popup.CloseOnEscape | Popup.CloseOnPressOutside
        property string filePath: ""
        property int idealW: 280
        property int idealH: 200
        // Keep popup on screen — clamp x/y when target is near edge
        function showAt(absPath, anchorX, anchorY) {
            if (!absPath || absPath.length === 0) return
            filePath = absPath
            // Position above the anchor point if possible, otherwise below.
            var px = Math.max(8, Math.min(root.width - idealW - 8, anchorX - idealW/2))
            var py = anchorY - idealH - 12
            if (py < 8) py = anchorY + 18
            x = px
            y = py
            open()
        }
        function hide() {
            close()
            filePath = ""
        }
        width: idealW; height: idealH
        background: Rectangle {
            color: th.sf
            radius: 10
            border.color: th.bd; border.width: 1
            // Subtle drop shadow via layered Rectangle. Qt Quick has
            // no native drop-shadow, so we approximate.
            Rectangle {
                anchors.fill: parent; anchors.margins: -2
                radius: 12; color: "transparent"
                border.color: Qt.rgba(0, 0, 0, 0.15)
                border.width: 4
                z: -1
            }
        }
        contentItem: Item {
            Image {
                id: _previewImg
                anchors.fill: parent
                anchors.margins: 6
                anchors.bottomMargin: 22
                source: imagePreviewPopup.filePath
                    ? "file://" + imagePreviewPopup.filePath
                    : ""
                fillMode: Image.PreserveAspectFit
                asynchronous: true
                cache: true
                // Show a placeholder while the image is loading.
                Rectangle {
                    anchors.fill: parent
                    visible: _previewImg.status === Image.Loading
                    color: Qt.rgba(0.5, 0.5, 0.5, 0.1)
                    Text {
                        anchors.centerIn: parent
                        text: "Loading…"; color: th.tm; font.pixelSize: 10
                    }
                }
            }
            // Filename label at the bottom
            Text {
                id: _previewLabel
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.bottom: parent.bottom
                anchors.margins: 6
                text: imagePreviewPopup.filePath
                    ? imagePreviewPopup.filePath.split("/").pop()
                    : ""
                color: th.tm; font.pixelSize: 9
                horizontalAlignment: Text.AlignHCenter
                elide: Text.ElideMiddle
            }
            // Tap-and-hold opens the share portal. On desktop this
            // typically launches "open with" via gio. On mobile (post-
            // marketOS) it surfaces the system share sheet.
            MouseArea {
                anchors.fill: parent
                pressAndHoldInterval: 500
                hoverEnabled: true
                cursorShape: Qt.PointingHandCursor
                onPressAndHold: {
                    if (!backend || !backend.file_share) return
                    var ok = backend.file_share(imagePreviewPopup.filePath)
                    if (ok) {
                        if (typeof toast !== "undefined" && toast.show) {
                            toast.show("Sharing…")
                        }
                    } else {
                        if (typeof toast !== "undefined" && toast.show) {
                            toast.show("No share portal available")
                        }
                    }
                }
                // Soft visual cue that hold does something.
                onPressed: _previewImg.scale = 0.97
                onReleased: _previewImg.scale = 1.0
                onCanceled: _previewImg.scale = 1.0
                Behavior on scale { NumberAnimation { duration: 80 } }
            }
        }
    }

    // The LLM call is fire-and-forget via llm_query_async; we poll
    // llm_poll_result() for the result on a fast timer. While
    // pending, show "Thinking…" with a spinner.
    Popup {
        id: askAiPopup
        modal: true; dim: true
        // Closing policy: explicit only. The previous setting
        // (CloseOnPressOutside) made any tap dismiss the popup,
        // including incidental touches while reading the response.
        // Now only Escape, the X button, or voice "cancel"/"close"
        // close it. NoAutoClose covers the case where modal lets
        // through a touch event we'd otherwise treat as outside-press.
        closePolicy: Popup.CloseOnEscape
        x: (root.width - width) / 2
        y: Math.max(8, (root.height - height) / 2)
        width: Math.min(root.width - 40, 640)
        height: Math.min(root.height - 16, 420)

        property string question: ""
        property string response: ""
        property bool thinking: false
        property var codeBlocks: []  // array of {start, end, text}

        enter: Transition {
            NumberAnimation { property: "scale"; from: 0.7; to: 1.0; duration: 200; easing.type: Easing.OutBack }
            NumberAnimation { property: "opacity"; from: 0; to: 1; duration: 150 }
        }
        exit: Transition {
            NumberAnimation { property: "opacity"; from: 1; to: 0; duration: 220 }
            NumberAnimation { property: "scale"; from: 1.0; to: 0.94; duration: 220; easing.type: Easing.InQuad }
        }

        background: Rectangle {
            color: th.sf
            border.color: th.bd; border.width: 1
            radius: 12
        }

        // Public API: start a fresh LLM query for this question.
        function askQuestion(q) {
            question = q
            response = ""
            thinking = true
            codeBlocks = []
            open()
            // Decide between context-aware and bare prompt.
            //
            // Context-aware path: questions that need to know what the
            // user is currently doing in the terminal to answer well.
            // Heuristics: question starts with "how" / "what" / "which" /
            // "why" / "explain" / "should I" / contains "this" referring
            // to current state. These questions REWARD knowing
            // recent commands + cwd; without context the model gives
            // generic fluff.
            //
            // Bare path: factual asks ("convert 5 miles to km",
            // "what year was X released") — context would just dilute.
            var qLower = q.toLowerCase()
            var contextHints = [
                "how do i", "how can i", "how to ",
                "what does", "what is this", "what should",
                "explain ", "why is", "why does",
                "should i", "save space", "clean up",
                "this folder", "this directory", "this file",
                "my project", "my code", "my repo",
                "this command", "this output", "this error",
                // v0.1.828: page/screen hints — route page questions through the
                // context path so the open tab's page content (now piped into the
                // context) is actually used to answer.
                "this page", "the page", "this article", "this doc",
                "this man page", "on screen", "on the screen",
                "what's open", "whats open", "what's on", "whats on",
                "summarize this", "summarize the", "read this", "this section"
            ]
            var needsContext = false
            for (var ci = 0; ci < contextHints.length; ci++) {
                if (qLower.indexOf(contextHints[ci]) >= 0) {
                    needsContext = true
                    break
                }
            }
            if (needsContext && backend && backend.llm_query_with_context) {
                console.log("[ask-ai] using context-aware prompt for: " + q)
                backend.llm_query_with_context(q)
                _llmPollTimer.start()
                return
            }

            // Build the prompt. Bias toward short factual answers
            // with executable shell when relevant — this is a CLI
            // companion, not a chat model.
            var prompt = "You are a concise assistant for a Linux"
                + " developer. Answer the question briefly. If the"
                + " answer is a shell command, provide it inside a"
                + " ```bash code block. Otherwise answer in 1-3"
                + " sentences. Question: " + q
            if (backend && backend.llm_query_async) {
                backend.llm_query_async(prompt)
                _llmPollTimer.start()
            } else {
                response = "[backend unavailable]"
                thinking = false
            }
        }

        // Poll the async LLM result — same pattern other places use.
        // v0.1.829: drains completed background per-pane web fetches, caches
        // them, and re-points termPaneStrip so the now-cached panes render.
        // Started by a web pane's empty-state when it kicks off a fetch; stops
        // v0.1.881: periodic web-pane refresh. Web panes are never the focused
        // pane (split_web restores focus to the prior pane), so the v0.1.879
        // focus-bump never fired and internal web2qml:// pages (mail, drafts,
        // sessions) only refreshed when the pane STRIP changed — i.e. "not
        // until I split a pane." Bumping _webTick re-evaluates paneWebSrc;
        // render_pane_qml is content-addressed, so an unchanged page yields the
        // same file path and the Loader does NOT reload (no flicker) — only
        // genuinely-changed pages re-render. Cheap enough to run continuously.
        Timer {
            interval: 1500
            repeat: true
            running: true
            onTriggered: {
                if (typeof paneSplitLayer !== "undefined") paneSplitLayer._webTick++
            }
        }
        // itself after a stretch with no results.
        Timer {
            id: _paneFetchPollTimer
            interval: 400
            repeat: true
            running: false
            property int _idle: 0
            onTriggered: {
                if (!backend || !backend.pane_fetch_poll) { stop(); return }
                var wire = backend.pane_fetch_poll()
                if (wire && wire.length > 0) {
                    root.termPaneStrip = wire
                    // v0.1.848: the wire (pane structure) is often UNCHANGED after a
                    // fetch — only the page cache filled — so the assignment above is
                    // a no-op and never rebuilds the delegate. Bump the web tick so
                    // every web pane re-evaluates paneWebSrc (render_pane_qml now
                    // returns real, content-addressed content) and the Loader reloads.
                    if (typeof paneSplitLayer !== "undefined") paneSplitLayer._webTick++
                    _idle = 0
                } else {
                    _idle++
                    if (_idle > 10) { stop(); _idle = 0 }
                }
            }
        }
        Timer {
            id: _llmPollTimer
            interval: 200
            repeat: true
            onTriggered: {
                if (!backend || !backend.llm_poll_result) {
                    stop(); return
                }
                var r = backend.llm_poll_result()
                if (r && r.length > 0) {
                    askAiPopup.response = r
                    askAiPopup.thinking = false
                    askAiPopup._extractCodeBlocks(r)
                    stop()
                }
            }
        }

        // Parse code blocks from markdown response. Recognizes
        // ```lang\n...\n``` and indented 4-space blocks (less
        // common from LLM but possible). The result populates
        // askAiPopup.codeBlocks for the renderer.
        function _extractCodeBlocks(text) {
            var blocks = []
            var idx = 0
            while (idx < text.length) {
                var fenceStart = text.indexOf("```", idx)
                if (fenceStart < 0) break
                // Skip the language tag if present
                var afterFence = text.indexOf("\n", fenceStart + 3)
                if (afterFence < 0) break
                var fenceEnd = text.indexOf("```", afterFence + 1)
                if (fenceEnd < 0) break
                var code = text.substring(afterFence + 1, fenceEnd).trim()
                if (code.length > 0) {
                    blocks.push({
                        start: fenceStart,
                        end: fenceEnd + 3,
                        text: code
                    })
                }
                idx = fenceEnd + 3
            }
            codeBlocks = blocks
        }

        contentItem: ColumnLayout {
            anchors.fill: parent
            anchors.margins: 16
            spacing: 10

            // Header
            RowLayout { Layout.fillWidth: true; spacing: 8
                Rectangle {
                    Layout.preferredWidth: 36; Layout.preferredHeight: 36
                    radius: 18
                    color: th.ac
                    Text { anchors.centerIn: parent
                        text: "\uD83E\uDD16"  // robot face
                        font.pixelSize: 18 }
                }
                ColumnLayout { Layout.fillWidth: true; spacing: 2
                    Text { text: "Ask AI"; color: th.tc; font.pixelSize: 15; font.bold: true }
                    Text { text: askAiPopup.question
                        color: th.tm; font.pixelSize: 11; font.italic: true
                        Layout.fillWidth: true; elide: Text.ElideRight }
                }
                Rectangle {
                    Layout.preferredWidth: 28; Layout.preferredHeight: 28
                    radius: 14
                    color: _aiCloseMa.containsMouse ? Qt.lighter(th.sf, 1.4) : "transparent"
                    Behavior on color { ColorAnimation { duration: 100 } }
                    Text { anchors.centerIn: parent; text: "\u2715"; color: th.tm; font.pixelSize: 14 }
                    MouseArea { id: _aiCloseMa; anchors.fill: parent; hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: askAiPopup.close() }
                }
            }

            // Thinking indicator
            RowLayout {
                Layout.fillWidth: true
                Layout.preferredHeight: askAiPopup.thinking ? 32 : 0
                visible: askAiPopup.thinking
                Behavior on Layout.preferredHeight { NumberAnimation { duration: 180 } }
                BusyIndicator {
                    Layout.preferredWidth: 20; Layout.preferredHeight: 20
                    running: askAiPopup.thinking
                }
                Text {
                    Layout.fillWidth: true
                    text: "Thinking…"
                    color: th.tm; font.pixelSize: 12; font.italic: true
                }
            }

            // Response area — scrollable. The text shows the FULL
            // response including code-fence syntax (the model often
            // includes language hints that are useful to see). Below
            // we ALSO show code blocks as tappable rectangles for
            // direct interaction.
            ScrollView {
                Layout.fillWidth: true; Layout.fillHeight: true
                clip: true

                ColumnLayout {
                    width: parent ? parent.width : 0
                    spacing: 12

                    // Full response as text (preserves code fences for context)
                    Text {
                        Layout.fillWidth: true
                        text: askAiPopup.response
                        color: th.tc
                        font.pixelSize: 13
                        wrapMode: Text.WordWrap
                        textFormat: Text.PlainText
                    }

                    // Tappable code blocks. Single-tap = copy to
                    // clipboard with toast confirmation. Press-and-
                    // hold = paste to terminal AND run (Enter included).
                    // The code-block rectangles are styled as commands
                    // — monospace, inset border — so they read as
                    // "things you can execute."
                    Repeater {
                        model: askAiPopup.codeBlocks
                        delegate: Rectangle {
                            Layout.fillWidth: true
                            Layout.preferredHeight: _codeText.implicitHeight + 56
                            radius: 8
                            color: Qt.darker(th.tbg, 1.3)
                            border.color: _codeMa.containsMouse ? th.ac : th.bd
                            border.width: 1
                            Behavior on border.color { ColorAnimation { duration: 100 } }

                            ColumnLayout {
                                anchors.fill: parent
                                anchors.margins: 10
                                spacing: 6
                                Text {
                                    id: _codeText
                                    Layout.fillWidth: true
                                    text: modelData.text
                                    color: th.tfg
                                    font.family: "monospace"
                                    font.pixelSize: 12
                                    wrapMode: Text.Wrap
                                    textFormat: Text.PlainText
                                }
                                RowLayout {
                                    Layout.fillWidth: true
                                    spacing: 8
                                    Text {
                                        text: _codeMa.pressed
                                            ? "Hold to run \u23F1\uFE0F"
                                            : "Tap: copy  \u00B7  Hold: run in terminal"
                                        color: _codeMa.pressed ? th.ac : th.tm
                                        font.pixelSize: 10; font.italic: true
                                        Layout.fillWidth: true
                                    }
                                }
                            }

                            MouseArea {
                                id: _codeMa
                                anchors.fill: parent
                                hoverEnabled: true
                                cursorShape: Qt.PointingHandCursor
                                pressAndHoldInterval: 600
                                onClicked: {
                                    if (backend) backend.clipboard_set(modelData.text)
                                    toast.show("Copied code block")
                                }
                                onPressAndHold: {
                                    if (backend) {
                                        // Switch to terminal tab + paste
                                        // + Enter. Like running a Jupyter
                                        // cell — the user voiced a question,
                                        // got runnable code, holds to
                                        // execute it. Single-tap stays as
                                        // copy for cases where the user
                                        // wants to inspect / edit first.
                                        tabBar.currentIndex = 1
                                        swipeView.currentIndex = 1
                                        // v0.1.416: paste the (possibly
                                        // multi-line) body via pty_paste
                                        // (bracketed paste handles multi-
                                        // line correctly), then send a
                                        // SEPARATE real Enter via pty_write.
                                        // Appending "\r" to the paste put
                                        // the Enter INSIDE the bracketed-
                                        // paste markers, where it's literal
                                        // text — so the command pasted but
                                        // didn't run / misaligned the
                                        // cursor. Splitting them means the
                                        // body pastes, then a clean Enter
                                        // submits it.
                                        backend.pty_paste(modelData.text)
                                        backend.pty_write("\r")
                                        toast.show("Running in terminal…")
                                        askAiPopup.close()
                                    }
                                }
                            }
                            // Visual feedback during press-and-hold:
                            // grow border accent color over the duration
                            // so user knows hold is registering.
                            Rectangle {
                                anchors.left: parent.left
                                anchors.bottom: parent.bottom
                                anchors.right: parent.right
                                height: 3
                                radius: 1.5
                                color: th.ac
                                width: _codeMa.pressed
                                    ? parent.width * (_codeMa.pressed ? 1.0 : 0.0)
                                    : 0
                                opacity: _codeMa.pressed ? 1.0 : 0.0
                                Behavior on width { NumberAnimation { duration: 600; easing.type: Easing.Linear } }
                                Behavior on opacity { NumberAnimation { duration: 100 } }
                            }
                        }
                    }
                }
            }
        }
    }

    // ═══ VOICE COMMAND POPUP ═══
    Popup {
        id: voicePopup; modal: true; dim: true; closePolicy: Popup.CloseOnEscape | Popup.CloseOnPressOutside
        // Position: horizontally centered, vertically centered but never
        // pushed off the top edge. On phones in portrait, the popup height
        // can exceed root.height when stacked hints expand, in which case
        // a centered y goes negative and the popup top is unreachable.
        // Clamp at 8px from the top to keep dismiss controls visible.
        x: (root.width - width) / 2
        y: Math.max(8, (root.height - height) / 2)
        // Width adapts to whether the hints sidebar has anything to show.
        // When empty (no shell completions for the current state, or we're
        // on the browser tab), popup stays at its compact 480px. When
        // populated AND the screen is wide enough, it grows by up to 240px
        // to accommodate the sidebar shown to the right of the main column.
        // On narrow viewports (phones, ~380px wide) the sidebar can't fit
        // alongside without crushing the main content, so the layout
        // switches to stacked: main column on top, hints below as a
        // collapsible row. That's why we precompute `_hintsLayoutMode` here.
        readonly property string _hintsLayoutMode: {
            if (liveHintsModel.count === 0) return "none"
            // Need at least 600px viewport to fit 480 main + 240 sidebar +
            // gutters. Below that, stack vertically.
            if (root.width < 620) return "stacked"
            return "sidebar"
        }
        width: {
            var base = Math.min(root.width - 40, 480)
            var withSidebar = Math.min(root.width - 40, 720)
