    // v0.1.350: long-running command notifications. Fires when a
    // block finishes with duration >= threshold (default 10s,
    // settable via backend.long_command_threshold_secs).
    //
    // Notification policy: surface a toast when the user has
    // navigated away from the terminal — either to a different tab
    // or by defocusing the window. If the user is staring AT the
    // terminal when the command finishes, they don't need a toast;
    // they already see the new prompt. The notification is for the
    // "kicked off a build, switched to the browser to read docs,
    // when does it finish" case.
    //
    // Future: optional system-level notification via Qt's
    // NotificationManager when window is fully out of focus
    // (not just on different tab). Filed in todo.
    Connections {
        target: backend
        function onLong_command_finished(cmd, durationSecs, exitCode) {
            // Conditions for showing the toast:
            //   1. User is on a tab other than terminal, OR
            //   2. The application window is not active (focused).
            // Either condition makes the user "away" from the
            // command and likely to want a ping.
            var onTerm = tabBar.currentIndex === 1
            var windowActive = root.active
            var shouldToast = !onTerm || !windowActive
            if (!shouldToast) {
                // User is here. Skip the toast — silent success.
                return
            }
            // Truncate the command for the toast. Long pasted
            // commands or one-liners with quotes can be huge;
            // a toast that fills half the screen is worse than
            // a brief one with "..." at the end.
            var shortCmd = cmd
            if (shortCmd.length > 50) {
                shortCmd = shortCmd.substring(0, 47) + "..."
            }
            // Format the duration humanely.
            var durStr
            if (durationSecs < 60) {
                durStr = durationSecs + "s"
            } else if (durationSecs < 3600) {
                var mins = Math.floor(durationSecs / 60)
                var secs = durationSecs % 60
                durStr = mins + "m" + (secs > 0 ? " " + secs + "s" : "")
            } else {
                durStr = Math.floor(durationSecs / 3600) + "h+"
            }
            // exitCode -1 means unknown (current backend always
            // reports -1 because BlockTracker doesn't capture exit
            // codes yet). When known, we'd append a ✓ or ✗ glyph.
            // For now treat all as success — the user can switch
            // back and check if they care.
            if (typeof toast !== "undefined" && toast.show) {
                // v0.1.363: caveat the toast with "(remote)" when
                // the command ran during an active SSH session.
                // The duration measurement is correct (we timed
                // the local ssh subprocess) but the WORK happened
                // on the other end — power users want that visible.
                var prefix = (backend && backend.in_ssh_session === true)
                    ? "Finished (remote, " : "Finished ("
                toast.show(prefix + durStr + "): " + shortCmd)
            }
        }
    }
