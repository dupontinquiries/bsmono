    readonly property var sendCtxMenuModel: [
        { id: "off",   gridX: 0, gridY: 0, svg: _svgCancel },
        { id: "tier1", gridX: 1, gridY: 0, svg: _svgLock1 },
        { id: "tier2", gridX: 2, gridY: 0, svg: _svgLock2 },
        { id: "tier3", gridX: 3, gridY: 0, svg: _svgLock3 }
