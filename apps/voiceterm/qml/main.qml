                                ctx.moveTo(sx, sy)
                                ctx.lineTo(ex, ey)
                                ctx.stroke()
                                ctx.setLineDash([])  // v0.1.761: solid arrowhead even for back-edges

                                // v0.1.327: arrowhead. Skip for
                                // line-style edges (style "l" — no
                                // head). Triangle, filled. Size
                                // scales mildly with weight so
                                // thick arrows have proportional
                                // heads.
                                if (e.arrow !== false && style !== "l") {
                                    var ahLen = 8 + Math.min(w, 4)
                                    var ahHalf = 4 + Math.min(w, 3) * 0.5
                                    // perpendicular unit
                                    var px = -uy
                                    var py = ux
                                    var tipX = ex
                                    var tipY = ey
                                    var baseX = ex - ux * ahLen
                                    var baseY = ey - uy * ahLen
                                    var leftX = baseX + px * ahHalf
                                    var leftY = baseY + py * ahHalf
                                    var rightX = baseX - px * ahHalf
                                    var rightY = baseY - py * ahHalf
                                    ctx.setLineDash([])
                                    ctx.beginPath()
                                    ctx.moveTo(tipX, tipY)
                                    ctx.lineTo(leftX, leftY)
                                    ctx.lineTo(rightX, rightY)
