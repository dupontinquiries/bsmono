                // homepage/empty state; Graph View (the connections
                // graph) opens the cards canvas. Sit next to
                // back/forward as peer navigation actions.
                ToolBtn { icon: "\u2302"; onTapped: showHomepage() }
                // v0.1.677: edit the current note (WYSIWYG editor open-hook).
                // backend.open_note_editor() reads the current .md and emits
                // open_note_editor_ready → noteEditor.present(). No-ops (and
                // logs) if the current page isn't an editable .md file.
                ToolBtn { icon: "\u270E"; onTapped: { if (backend && backend.open_note_editor) backend.open_note_editor() } }
                ToolBtn { icon: "\uD83D\uDD78"; onTapped: { if (typeof cardsCanvas !== "undefined") cardsCanvas.open() } }
                // URL pill
                Rectangle {
                    id: urlPill
                    Layout.fillWidth: true; Layout.preferredHeight: 36; radius: 18
                    color: th.ib; border.color: urlBar.activeFocus ? th.ac : th.bd; border.width: urlBar.activeFocus ? 2 : 1
                    MouseArea {
                        anchors.fill: parent; z: -1
                        onClicked: { urlBar.forceActiveFocus(); urlBar.selectAll() }
                        cursorShape: Qt.IBeamCursor
                    }
                    RowLayout {
                        anchors.fill: parent; anchors.leftMargin: 14; anchors.rightMargin: 8; spacing: 4
                        // Loading spinner
                        Rectangle {
                            width: 16; height: 16; radius: 8; visible: loading; color: "transparent"; border.color: th.ac; border.width: 2
                            RotationAnimator on rotation { from: 0; to: 360; duration: 800; loops: Animation.Infinite; running: loading }
                            Rectangle { width: 8; height: 2; color: th.ac; anchors.centerIn: parent }
                        }
                        TextInput {
                            id: urlBar; Layout.fillWidth: true; verticalAlignment: TextInput.AlignVCenter
                            // v0.1.181: was `text: backend ? backend.last_query : ""`
                            // as a property binding. The binding kept re-evaluating
                            // when backend.last_query changed, which could wipe out
                            // typed-but-not-yet-committed text mid-edit. User
                            // reported: "sometimes they were entered into url and
                            // it would not show when typing into it." Fixed by
                            // setting text once via Component.onCompleted, then
                            // updating via Connections only when the bar doesn't
                            // have activeFocus (so user editing isn't disturbed).
                            color: th.tc; font.pixelSize: 13; font.family: ffam
                            selectByMouse: true; clip: true
                            Component.onCompleted: { if (backend) text = backend.last_query }
                            Connections {
                                target: backend
                                function onLast_query_changed() {
                                    if (!urlBar.activeFocus) {
                                        urlBar.text = backend.last_query
                                    }
                                }
                            }
                            // v0.1.232: when the URL bar gets focus
                            // (Ctrl-L, click on pill area, voice
                            // command), ensure the bar is visible.
                            // Previously: if the user had scrolled
                            // past the chrome-hide threshold,
                            // urlBarVisible was false, so focusing
                            // via shortcut left the bar in 0-height
                            // limbo and the cursor was invisible.
                            //
                            // v0.1.245: handler consolidated with the
                            // selectAll() handler below. The TextInput
                            // had two separate onActiveFocusChanged
                            // bindings (this one and one at the end
                            // of the element) — QML lets the second
                            // override the first silently, so the
                            // urlBarVisible=true effect wasn't firing.
                            // User caught this in hardware testing
                            // and patched locally; merging the fix
                            // upstream.
                            // (urlBarVisible=true is now in the
                            // single consolidated handler below)
                            // v0.1.176 originally moved focus to browseFlick on
                            // nav-commit, but browseFlick is in a different focus
                            // scope from the helixKeys FocusScope that handles
                            // single-letter shortcuts (l, x, j, k, etc.). Stealing
                            // activeFocus to browseFlick left helixKeys without
                            // activeFocus, so shortcuts silently stopped working
                            // until restart (when helixKeys re-claims via its
                            // declarative `focus:` binding).
                            //
                            // v0.1.177 fix: focus the helixKeys scope explicitly.
                            // That's the scope that *should* own keyboard focus
                            // in the post-nav reading state. urlBar gives up
                            // focus naturally as a side effect.
                            onAccepted: {
                                loading = true
                                if (backend) { backend.last_query = text; backend.nav(text) }
                                helixKeys.forceActiveFocus()
                            }
                            // v0.1.178: Escape = cancel edit. Restores the
                            // displayed URL to whatever the page is actually
                            // showing (backend.last_query) and drops focus,
                            // which on touch platforms also dismisses the
                            // virtual keyboard. helixKeys reclaims focus so
                            // single-letter shortcuts work immediately.
                            //
                            // v0.1.179: switched from Keys.onEscapePressed
                            // (didn't fire on TextInput in practice) to
                            // Keys.onPressed with explicit Key_Escape check.
                            // Matches the idiom used elsewhere (see line ~913
                            // in hint overlay). Also explicitly calls
                            // Qt.inputMethod.hide() to force virt keyboard
                            // dismiss even when focus-loss doesn't propagate
                            // through Wayland input panel correctly.
                            Keys.onPressed: function(e) {
                                if (e.key === Qt.Key_Escape) {
                                    // v0.1.673: ESC hides the suggestion
                                    // dropdown AND unfocuses the bar. Before,
                                    // it only unfocused, leaving suggestions
                                    // up. If suggestions are showing, the
                                    // first ESC just closes them; a second
                                    // ESC (bar still focused) unfocuses.
                                    if (typeof urlSuggestPopup !== "undefined"
                                        && urlSuggestPopup.visible) {
                                        urlSuggestPopup.close()
                                        e.accepted = true
                                        return
                                    }
                                    if (backend) text = backend.last_query
                                    helixKeys.forceActiveFocus()
                                    Qt.inputMethod.hide()
                                    e.accepted = true
                                }
                                // v0.1.682: arrow-key navigation of the
                                // suggestion dropdown. Down/Up move selection;
                                // Enter activates the selected row (falls
                                // through to normal submit if none selected).
                                else if (typeof urlSuggestPopup !== "undefined"
                                         && urlSuggestPopup.visible
                                         && urlSuggestPopup._rows.length > 0) {
                                    if (e.key === Qt.Key_Down) {
                                        urlSuggestPopup._selIndex =
                                            (urlSuggestPopup._selIndex + 1) % urlSuggestPopup._rows.length
                                        e.accepted = true
                                    } else if (e.key === Qt.Key_Up) {
                                        var n = urlSuggestPopup._rows.length
                                        urlSuggestPopup._selIndex =
                                            (urlSuggestPopup._selIndex - 1 + n) % n
                                        e.accepted = true
                                    } else if ((e.key === Qt.Key_Return || e.key === Qt.Key_Enter)
                                               && urlSuggestPopup._selIndex >= 0) {
                                        urlSuggestPopup._act(
                                            urlSuggestPopup._rows[urlSuggestPopup._selIndex])
                                        e.accepted = true
                                    }
                                }
                            }
                            // v0.1.245: consolidated handler. Both
                            // urlBarVisible=true (v0.1.232) and
                            // selectAll() (older) fire on focus-in.
                            // Previously these were in two separate
                            // onActiveFocusChanged blocks; the second
                            // silently overrode the first.
                            onActiveFocusChanged: {
                                if (activeFocus) {
                                    urlBarVisible = true
                                    selectAll()
                                }
                            }
                        }
                        // Mic button (if voice available)
                        Text { text: "\uD83C\uDFA4"; color: th.tm; font.pixelSize: 14
                            visible: backend && backend.voice_available && backend.voice_available()
                            MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor
                                onClicked: { if(backend) { var t=backend.voice_listen(); if(t&&!t.startsWith("[")) { urlBar.text=t; urlBar.forceActiveFocus() } } } }
                        }
                        // Clear button
                        Text { text: "\u2715"; color: th.tm; font.pixelSize: 12; visible: urlBar.text.length > 0 && urlBar.activeFocus
                            MouseArea { anchors.fill: parent; onClicked: { urlBar.text = ""; urlBar.forceActiveFocus() } } }
                    }
                }
                ToolBtn { icon: "\u27A4"; accent: true; onTapped: {
                    loading = true
                    if (backend) { backend.last_query = urlBar.text; backend.nav(urlBar.text) }
                    // v0.1.177: focus helixKeys (the keyboard shortcut scope),
                    // not browseFlick. See urlBar.onAccepted comment.
                    helixKeys.forceActiveFocus()
                } }
                ToolBtn {
                    id: settingsBtn
                    icon: "\u2699"
                    // v0.1.202: tap = quick-settings popup (2 fast
                    // toggles); long-press = full settings page
                    // (the existing settingsPopup). Pattern: quick
                    // settings is for everyday "flip theme / mute
                    // voice"; full settings is for tuning specifics.
                    // v0.1.204: id added so the thought-bubble demo
                    // can point at this button.
                    // v0.1.206: opt into hold-progress feedback so
                    // the user sees the long-press registering.
                    // v0.1.207: heldDown closes the quick popup if
                    // it was opened by the first click of a
                    // double-click sequence. Right-click and
                    // double-click both promote to heldDown via
                    // ToolBtn's enableHoldProgress wiring.
                    enableHoldProgress: true
                    onTapped: quickSettingsPopup.open()
                    onHeldDown: {
                        if (quickSettingsPopup.opened) quickSettingsPopup.close()
                        settingsPopup.open()
                    }
                }
            }
        }

        // ═══ TAB STRIP (v0.1.291, TAB-1 finish) ═══
        // Renders the in-memory browser tabs from backend.tabs_list.
        // Visible only when 2+ tabs are open; single-tab use looks
        // identical to pre-tab UI. Each chip shows a truncated
        // domain label + close ×. Tap chip → tab_switch(index).
        // Long-press × → tab_close(index). "+" at the end opens
        // a fresh tab at the current URL.
        //
        // Persistence into workspaces lands as TAB-1b (deferred).
        // Visual: thin (32px) bar with rounded chips; active tab
        // gets accent color, others use surface bg.
        Rectangle {
            id: tabStrip
            Layout.fillWidth: true
            // Hidden when only 0 or 1 tabs. backend.tabs_list is
            // newline-separated; the split is cheap (<20 entries).
            property var _tabs: (backend && backend.tabs_list)
                ? backend.tabs_list.split("\n").filter(function(s) { return s.length > 0 })
                : []
            // v0.1.392: parallel array of age labels ("now",
            // "5m", "2h", etc.) — same length as _tabs. Shown
            // in tooltips on chip hover (long-press on touch).
            property var _ages: (backend && backend.tab_ages_list)
                ? backend.tab_ages_list.split("\n")
                : []
            property int _active: backend ? backend.active_tab_index : 0
            visible: _tabs.length > 1
            Layout.preferredHeight: visible ? 32 : 0
            color: th.sf
            clip: true
            Behavior on Layout.preferredHeight { NumberAnimation { duration: 120 } }

            // Helper: extract a short display label from a URL.
            // E.g. "https://news.ycombinator.com/" → "news.ycombinator.com".
            // Falls back to the raw URL when no scheme present.
            // v0.1.618: keep this in lockstep with Rust short_label_of
            // (main.rs ~2997). They were diverging on web2qml:// URLs —
            // Rust caps the page suffix at 20 chars and returns early;
            // this used to append the full suffix then truncate via the
            // generic >24 rule, so the SAME internal page rendered
            // differently here vs. elsewhere. Match Rust: cap at 20,
            // return early. (Verified equal across test URLs.)
            function _shortLabel(url) {
                if (!url) return ""
                var s = url
                if (s.startsWith("https://")) s = s.substring(8)
                else if (s.startsWith("http://")) s = s.substring(7)
                else if (s.startsWith("web2qml://")) return "web2qml:" + s.substring(10, 30)
                else if (s.startsWith("file://")) return "file"
                // Trim trailing slash and path for compact display
                var slash = s.indexOf("/")
                if (slash > 0) s = s.substring(0, slash)
                if (s.length > 24) s = s.substring(0, 22) + "…"
                return s
            }

            RowLayout {
                anchors.fill: parent
                anchors.leftMargin: 6
                anchors.rightMargin: 6
                anchors.topMargin: 4
                anchors.bottomMargin: 4
                spacing: 4

                // Scrollable chip row — for users with many tabs.
                ListView {
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    orientation: ListView.Horizontal
                    model: tabStrip._tabs
                    spacing: 4
                    clip: true
                    boundsBehavior: Flickable.StopAtBounds

                    delegate: Rectangle {
                        // Each chip. Width sized to content; active
                        // chip uses accent color, others use surface
                        // bg with hover tint.
                        property bool isActive: index === tabStrip._active
                        property bool hovered: _chipMa.containsMouse
                        height: parent ? parent.height : 24
                        // v0.1.788: was a full pill (radius 12); square it to match
                        // the session tabs + toolbar buttons, and tighten the width.
                        radius: 4
                        color: isActive ? th.ac
                              : (hovered ? Qt.lighter(th.ib, 1.1) : th.ib)
                        border.color: isActive ? th.ac : th.bd
                        border.width: 1
                        // Width: label + padding + close button.
                        width: _labelText.implicitWidth + 28

                        Behavior on color { ColorAnimation { duration: 100 } }

                        Text {
                            id: _labelText
                            anchors.left: parent.left
                            anchors.leftMargin: 10
                            anchors.verticalCenter: parent.verticalCenter
                            text: tabStrip._shortLabel(modelData)
                            color: parent.isActive ? "#fff" : th.tc
                            font.pixelSize: 11
                            elide: Text.ElideRight
                            maximumLineCount: 1
                        }

                        // Close × — tap to close THIS tab.
                        Text {
                            anchors.right: parent.right
                            anchors.rightMargin: 6
                            anchors.verticalCenter: parent.verticalCenter
                            text: "×"
                            color: parent.isActive ? "#fff" : th.tm
                            font.pixelSize: 14
                            opacity: 0.7
                            MouseArea {
                                anchors.fill: parent
                                anchors.margins: -4  // expand tap target
                                onClicked: {
                                    if (backend) backend.tab_close(index)
                                }
                            }
                        }

                        // Click anywhere else on the chip → switch.
                        MouseArea {
                            id: _chipMa
                            anchors.fill: parent
                            anchors.rightMargin: 22  // don't swallow close-tap
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: {
                                if (backend) backend.tab_switch(index)
                            }
                        }

                        // v0.1.392: hover tooltip shows the tab's
                        // full URL + age. Helps users distinguish
                        // chips when many tabs are open and the
                        // short labels collide (multiple github
                        // subpages all show "github.com"). Visible
                        // 600ms after hover starts, matching Qt's
                        // default behavior. Touch users see this
                        // via long-press.
                        ToolTip {
                            visible: _chipMa.containsMouse
                            delay: 600
                            timeout: 4000
                            text: {
                                var age = (index < tabStrip._ages.length)
                                    ? tabStrip._ages[index]
                                    : "?"
                                var url = modelData || ""
                                // Compose phrasing — "opened now"
                                // is fine ("opened now ago" isn't).
                                var phrase
                                if (age === "now") phrase = "opened just now"
                                else if (age === "?") phrase = "opened at unknown time"
                                else phrase = "opened " + age + " ago"
                                return url + "\n(" + phrase + ")"
                            }
                        }
                    }
                }

                // "+" button — new tab via the pane system.
                Rectangle {
                    Layout.preferredWidth: 28
                    Layout.preferredHeight: 24
                    radius: 4
                    color: _addMa.containsMouse ? Qt.lighter(th.ib, 1.15) : th.ib
                    border.color: th.bd
                    border.width: 1
                    Text {
                        anchors.centerIn: parent
                        text: "+"
                        color: th.tc
                        font.pixelSize: 14
                        font.bold: true
                    }
                    MouseArea {
                        id: _addMa
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            // v0.1.830: route to the pane system's new-tab. Was the old
                            // placeholder `tab_open(last_query || "web2qml://home")`, which
                            // opened a web-view tab at the URL-bar text — useless now that
                            // web pages are panes. Just match the endpoint: a fresh tab.
                            if (backend && backend.ws_command)
                                root.termPaneStrip = backend.ws_command("new tab")
                        }
                    }
                }
            }
        }

        // ═══ FIND BAR ═══
        Rectangle {
            id: findBar; Layout.fillWidth: true; Layout.preferredHeight: visible ? 40 : 0; visible: false
            color: th.sf; clip: true
            Behavior on Layout.preferredHeight { NumberAnimation { duration: 100 } }
            RowLayout {
                anchors.fill: parent; anchors.margins: 6; spacing: 6
                Rectangle {
                    Layout.fillWidth: true; Layout.preferredHeight: 28; radius: 14; color: th.ib
                    TextInput { id: findField; anchors.fill: parent; anchors.margins: 10; verticalAlignment: TextInput.AlignVCenter
                        color: th.tc; font.pixelSize: 12; selectByMouse: true
                        onAccepted: { if (backend && text.length >= 2) { findResults.text = "Searching..."; var r = backend.search_page(text); var c = r.split("\n").filter(function(x){return x.length>0}).length; findResults.text = c + " found" } }
                        onTextChanged: { findResults.text = "" }
                        // v0.1.178: Escape closes find bar entirely. Drops
                        // focus (dismissing virt keyboard) and returns control
                        // to helixKeys for shortcuts.
                        //
                        // v0.1.179: switched from Keys.onEscapePressed to
                        // Keys.onPressed; added Qt.inputMethod.hide(). Same
                        // reasoning as urlBar.
                        Keys.onPressed: function(e) {
                            if (e.key === Qt.Key_Escape) {
                                findBar.visible = false
                                text = ""
                                helixKeys.forceActiveFocus()
                                Qt.inputMethod.hide()
                                e.accepted = true
                            }
                        }
                    }
                    Text { anchors.right: parent.right; anchors.rightMargin: 10; anchors.verticalCenter: parent.verticalCenter
                        text: "Find in page"; color: th.tm; font.pixelSize: 11; visible: findField.text.length === 0 }
                }
                Text { id: findResults; color: th.tm; font.pixelSize: 11 }
                Text { text: "\uD83C\uDFA4"; color: th.tm; font.pixelSize: 14
                    visible: backend && backend.voice_available && backend.voice_available()
                    MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor
                        onClicked: { if(backend){var t=backend.voice_listen(); if(t&&!t.startsWith("[")) { findField.text=t; findField.accepted() }} } } }
                Text { text: "\u2715"; color: th.tm; font.pixelSize: 14; MouseArea { anchors.fill: parent; onClicked: { findBar.visible = false; findField.text = ""; helixKeys.forceActiveFocus() } } }
            }
        }

        // ═══ TABLE COMMAND BAR ═══ (v0.1.198, ship 2.4.4)
        //
        // Slim bar above the page content, visible only when the
        // current page has at least one table. The user types
        // commands like:
        //   "show columns 1 4 7"
        //   "hide column 3"
        //   "sort by 2 desc"
        //   "fill column 4 with 2x prev"
        //   "table 2: filter column 1 = active"  (multi-table dispatch)
        //
        // Submit on Enter. Status appears in the right-side label
        // (success or error). Empty input → no-op.
        //
        // The bar is intentionally minimal — single text input, no
        // dropdowns or buttons. The vocabulary lives in the
        // table_nlp parser, not the UI; learning is by trying
        // commands and reading the status.
        Rectangle {
            id: tableCmdBar
            Layout.fillWidth: true
            Layout.preferredHeight: visible ? 36 : 0
            visible: backend && backend.table_count > 0 && tabBar.currentIndex === 0
            color: th.sf
            border.color: th.bd; border.width: 1

            RowLayout {
                anchors.fill: parent
                anchors.margins: 4
                spacing: 8

                // Leading prompt-like icon, hints what this is.
                Text {
                    text: "▦"
                    color: th.tm
                    font.pixelSize: 14
                    Layout.preferredWidth: 18
                    horizontalAlignment: Text.AlignHCenter
                }

                // Input field
                Rectangle {
                    Layout.fillWidth: true
                    Layout.preferredHeight: 26
                    radius: 13
                    color: th.ib
                    border.color: tableCmdInput.activeFocus ? th.ac : th.bd
                    border.width: tableCmdInput.activeFocus ? 2 : 1

                    TextInput {
                        id: tableCmdInput
                        anchors.fill: parent
                        anchors.leftMargin: 12
                        anchors.rightMargin: 12
                        verticalAlignment: TextInput.AlignVCenter
                        // v0.1.224: was `th.tc` — undefined key (theme
                        // dicts use `tc` for text-color). The undefined
                        // produced "Unable to assign [undefined] to
                        // QColor" warning at startup.
                        color: th.tc
                        font.pixelSize: 12
                        selectByMouse: true
                        clip: true
                        // Placeholder text via overlay
                        Text {
                            anchors.fill: parent
                            verticalAlignment: Text.AlignVCenter
                            text: backend && backend.table_count > 1
                                ? "table N: command  (e.g. \"table 1: hide column 2\")"
                                : "table command  (e.g. \"show columns 1 4 7\")"
                            color: th.tm
                            font.pixelSize: 12
                            visible: tableCmdInput.text.length === 0 && !tableCmdInput.activeFocus
                        }
                        onAccepted: {
                            if (!backend) return
                            backend.table_command(text)
                            text = ""
                        }
                        Keys.onEscapePressed: {
                            text = ""
                            helixKeys.forceActiveFocus()
                        }
                    }
                }

                // Status text — shows result of last command.
                // Truncated by the available width; the user can
                // tap to see the full message in console (future
                // ship adds expansion).
                Text {
                    id: tableCmdStatus
                    // v0.1.209: route the status through a local
                    // property so the color binding has a stable
                    // string to inspect. Previously read `text` (the
                    // Text's own text property) which could be
                    // undefined briefly during QML init when
                    // backend.table_command_status hasn't been
                    // populated yet. Calling `.startsWith` on
                    // undefined threw, the ternary collapsed to
                    // undefined, and QML logged "Unable to assign
                    // [undefined] to QColor" at construction.
                    property string _statusText: backend && backend.table_command_status
                        ? backend.table_command_status : ""
                    text: _statusText
                    color: _statusText.startsWith("ok") ? "#7cb342"
                         : _statusText.startsWith("didn") || _statusText.startsWith("no") ? "#ef5350"
                         : th.tm
                    font.pixelSize: 11
                    Layout.preferredWidth: Math.min(implicitWidth, 200)
                    elide: Text.ElideRight
                    visible: _statusText.length > 0
                }

                // Undo button — pops the last op on table 1.
                // For multi-table dispatch, user can type "table N
                // undo" though we don't parse that yet; for now
                // this button always targets the first table.
                Rectangle {
                    Layout.preferredWidth: 50
                    Layout.preferredHeight: 24
                    radius: 12
                    color: "transparent"
                    border.color: th.bd
                    border.width: 1
                    Text {
                        anchors.centerIn: parent
                        text: "undo"
                        color: th.tm
                        font.pixelSize: 11
                    }
                    TapHandler {
                        onTapped: {
                            if (backend) backend.table_undo(0)
                        }
                    }
                }
            }
        }

        // ═══ TAB BAR ═══
        // v0.1.572: bottom mount slot — holds the tab toggle on mobile
        // (compact). Collapses to 0 height on desktop when the toggle
        // has reparented to the top slot. Mirrors bottomMountSlot.
        Item {
            id: tabToggleBottomSlot
            Layout.fillWidth: true
            Layout.preferredHeight: root._navAtTop ? 0 : tabToggleBar.Layout.preferredHeight
            visible: !root._navAtTop
        }
        Rectangle {
            id: tabToggleBar
            parent: root._navAtTop ? tabToggleTopSlot : tabToggleBottomSlot
            anchors.fill: parent
            color: th.sf
            // v0.1.806: workspace layout drops the Browse/Term toggle (the
            // sidebar + swipe carry navigation now).
            visible: !root._workspaceLayout
            // Keep Layout.* like topBar does: harmless when parented to
            // a (non-Layout) mount slot, and the slot reads
            // Layout.preferredHeight for its own height. This mirrors
            // the proven topBar reparent pattern exactly.
            Layout.fillWidth: true
            Layout.preferredHeight: root._workspaceLayout ? 0 : 48
            RowLayout {
                anchors.fill: parent; anchors.margins: 6; spacing: 6
                Repeater { model: [{t:"\u26A1 Browse",i:0},{t:">_ Term",i:1}]
                    delegate: Rectangle { Layout.fillWidth: true; Layout.preferredHeight: 36; radius: 18
                        color: tabBar.currentIndex===modelData.i ? th.ac : Qt.lighter(th.sf,1.2)
                        Behavior on color { ColorAnimation { duration: 150 } }
                        Text { anchors.centerIn: parent; text: modelData.t; color: tabBar.currentIndex===modelData.i ? "#fff" : th.tm; font.pixelSize: 13; font.bold: tabBar.currentIndex===modelData.i }
                        MouseArea { anchors.fill: parent; onClicked: { tabBar.currentIndex=modelData.i; swipeView.currentIndex=modelData.i } }
                    }
                }
            }
        }
    }
    TabBar {
        id: tabBar
        visible: false
        currentIndex: 1   // v0.1.839: terminal is the only page now
        TabButton{}
        TabButton{}
        // v0.1.244: emit a profiling event when the active tab
        // changes so post-hoc analysis can correlate frame drops
        // with "user was in terminal" vs "browser" mode. Cheap —
        // the event() call is a no-op when WEB2QML_PROFILE != 1.
        onCurrentIndexChanged: {
            // v0.1.839: web page (index 0) removed — clamp to the terminal so the
            // Ctrl+Tab toggle and any leftover web-nav can't land on the dead page.
            if (currentIndex !== 1) { currentIndex = 1; return }
            if (_prof) _prof.event("tab:" + (currentIndex === 1 ? "term" : "browse"))
            // v0.1.481: offer the model setup assistant when the user
            // enters the web flow (tab 0), per the requested trigger.
            // Gated inside maybeOfferSetup on: not mid-tutorial,
            // stamp absent, no model active. Cheap; safe to call often.
            if (currentIndex === 0 && typeof _setupHint !== "undefined") {
                _setupHint.maybeOffer()
            }
        }
    }
    // v0.1.811: keep the hidden tabBar in sync with the SwipeView's visible page.
    // Lots of terminal behavior gates on tabBar.currentIndex === 1 (the identity
    // refresh poll, the fast pty poll, every terminal shortcut). Before v806 the
    // Browse/Term toggle set tabBar.currentIndex; with the toggle gone, swiping
    // moved swipeView but left tabBar stale at 0 — so tabs and keys only woke up
    // when something re-synced on a focus change. Mirror the SwipeView here.
    Connections {
        target: swipeView
        function onCurrentIndexChanged() { tabBar.currentIndex = swipeView.currentIndex }
    }

    // ═══ Global Thought Bubble ═══ (v0.1.204, ship 2.6.2)
    //
    // Single root-level instance used by the guided tour driver
    // (2.6.3, future) and any feature that wants to point at
    // something with explanatory text.
    //
    // Usage from elsewhere in QML:
    //   globalThoughtBubble.target = someItem
    //   globalThoughtBubble.text = "Tap this to start reading."
    //   globalThoughtBubble.show()
    //
    // The bubble is anchored to root via `anchors.fill: parent`
    // inside the component, so it covers the whole window. Only
    // the bubble rectangle itself has a MouseArea; taps elsewhere
    // pass through.
    //
    // For v1 we ship ONE instance. If multi-bubble becomes needed,
    // promote to a Repeater + model.
    ThoughtBubble {
        id: globalThoughtBubble
    }

    // v0.1.376 (discoverability arc): first-launch recipes hint.
    // Small dismissable pill anchored at the bottom of the
    // screen, shown ONCE per install (or after the user resets
    // the recipes_seen.flag). Calls
    // backend.recipes_should_offer() at startup; if true,
    // animates in after a short delay so it doesn't compete
    // with the onboarding tour for attention. Tapping opens the
    // recipes page; dismissing just hides it. Either way,
    // backend.recipes_mark_seen() fires so it doesn't show
    // again.
    //
    // Intentionally non-modal: power users who don't want it
    // can ignore it for as long as they like; first-launch
    // users see it long enough to remember the URL.
    Rectangle {
        id: _recipesHint
        z: 1100  // below modal popups, above page content
        anchors.bottom: parent.bottom
        anchors.bottomMargin: 80  // above topBar which is at bottom in v0.1.249+
        anchors.horizontalCenter: parent.horizontalCenter
        width: visible ? _recipesHintRow.implicitWidth + 24 : 0
        height: 36
        radius: 18
        color: Qt.rgba(0.18, 0.30, 0.45, 0.95)
        border.color: Qt.rgba(0.35, 0.55, 0.80, 0.7)
        border.width: 1
        visible: opacity > 0.05
        opacity: 0.0
        Behavior on opacity { NumberAnimation { duration: 400; easing.type: Easing.OutQuad } }
        Behavior on width { NumberAnimation { duration: 200 } }

        // Show 2.5 seconds after startup so we don't compete
        // with onboarding tour or initial page-load chrome.
        Timer {
            id: _recipesHintTimer
            interval: 2500
            running: true
            repeat: false
            onTriggered: {
                if (!backend) return
                if (!backend.recipes_should_offer) return
                if (backend.recipes_should_offer()) {
                    _recipesHint.opacity = 1.0
                }
            }
        }

        function dismiss() {
            opacity = 0.0
            if (backend && backend.recipes_mark_seen) {
                backend.recipes_mark_seen()
            }
        }

        Row {
            id: _recipesHintRow
            anchors.centerIn: parent
            spacing: 10
            Text {
                anchors.verticalCenter: parent.verticalCenter
                text: "\u2728 New here? Try"
                color: "#d6e4ff"
                font.pixelSize: 11
            }
            Rectangle {
                anchors.verticalCenter: parent.verticalCenter
                width: _recipesHintLink.implicitWidth + 14
                height: 22
                radius: 11
                color: _recipesHintMa.containsMouse
                    ? Qt.rgba(1, 1, 1, 0.18)
                    : Qt.rgba(1, 1, 1, 0.10)
                Behavior on color { ColorAnimation { duration: 100 } }
                Text {
                    id: _recipesHintLink
                    anchors.centerIn: parent
                    text: "web2qml://recipes"
                    color: "#ffffff"
                    font.pixelSize: 11
                    font.family: "monospace"
                    font.bold: true
                }
                MouseArea {
                    id: _recipesHintMa
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: {
                        _recipesHint.dismiss()
                        if (backend && backend.open_web_tab) {
                            root.termPaneStrip = backend.open_web_tab("web2qml://recipes")
                        }
                    }
                }
            }
            Text {
                anchors.verticalCenter: parent.verticalCenter
                text: "\u00d7"  // dismiss
                color: "#a8b8d0"
                font.pixelSize: 16
                font.bold: true
                MouseArea {
                    anchors.fill: parent
                    cursorShape: Qt.PointingHandCursor
                    onClicked: _recipesHint.dismiss()
                }
            }
        }
    }

    // v0.1.481 (model setup assistant): dismissable pill offering to
    // set up a fast local model. Triggered when the user enters the
    // web flow (tabBar → 0) or opens command history — the moments
    // the requested trigger calls for — via _setupHint.maybeOffer().
    //
    // Gating (all must hold, checked in maybeOffer):
    //   1. NOT mid-tutorial (root.onboardingActive false) — so it
    //      never competes with the voice-onboarding tour.
    //   2. backend.setup_should_offer() — stamp absent AND no model
    //      already active (don't nag a user who's set up).
    // Tapping opens settingsPopup (which contains the ModelPicker
    // with the ★ RAM-recommended pick); either tap or dismiss stamps
    // setup_mark_seen so it shows at most once. Mirrors _recipesHint.
    Rectangle {
        id: _setupHint
        z: 1100
        anchors.bottom: parent.bottom
        anchors.bottomMargin: 80
        anchors.horizontalCenter: parent.horizontalCenter
        width: visible ? _setupHintRow.implicitWidth + 24 : 0
        height: 36
        radius: 18
        color: Qt.rgba(0.18, 0.34, 0.30, 0.96)
        border.color: Qt.rgba(0.40, 0.70, 0.55, 0.7)
        border.width: 1
        visible: opacity > 0.05
        opacity: 0.0
        Behavior on opacity { NumberAnimation { duration: 400; easing.type: Easing.OutQuad } }
        Behavior on width { NumberAnimation { duration: 200 } }

        // Guard so we only evaluate the offer once per session even
        // if the user toggles tabs repeatedly — the stamp handles
        // across-session, this handles within-session churn.
        property bool _checkedThisSession: false

        function maybeOffer() {
            if (_setupHint._checkedThisSession) return
            if (!backend || !backend.setup_should_offer) return
            // Gate 1: never during the voice-onboarding tour.
            if (typeof root !== "undefined" && root.onboardingActive) return
            _setupHint._checkedThisSession = true
            // Gate 2: stamp absent + no active model.
            if (backend.setup_should_offer()) {
                _setupHint.opacity = 1.0
            }
        }

        function dismiss() {
            opacity = 0.0
            if (backend && backend.setup_mark_seen) {
                backend.setup_mark_seen()
            }
        }

        Row {
            id: _setupHintRow
            anchors.centerIn: parent
            spacing: 10
            Text {
                anchors.verticalCenter: parent.verticalCenter
                text: "\u26A1 Speed up replies \u2014 set up a local model"
                color: "#d6ffe9"
                font.pixelSize: 11
            }
            Rectangle {
                anchors.verticalCenter: parent.verticalCenter
                width: _setupHintLink.implicitWidth + 14
                height: 22
                radius: 11
                color: _setupHintMa.containsMouse
                    ? Qt.rgba(1, 1, 1, 0.18)
                    : Qt.rgba(1, 1, 1, 0.10)
                Behavior on color { ColorAnimation { duration: 100 } }
                Text {
                    id: _setupHintLink
                    anchors.centerIn: parent
                    text: "Set up"
                    color: "#ffffff"
                    font.pixelSize: 11
                    font.bold: true
                }
                MouseArea {
                    id: _setupHintMa
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: {
                        _setupHint.dismiss()
                        // v0.1.534: open the focused setup wizard (F3)
                        // instead of dumping the user into settings.
                        if (typeof setupWizard !== "undefined") {
                            setupWizard.open()
                        } else if (typeof settingsPopup !== "undefined") {
                            settingsPopup.open()
                        }
                    }
                }
            }
            Text {
                anchors.verticalCenter: parent.verticalCenter
                text: "\u00d7"
                color: "#a8d0bc"
                font.pixelSize: 16
                font.bold: true
                MouseArea {
                    anchors.fill: parent
                    cursorShape: Qt.PointingHandCursor
                    onClicked: _setupHint.dismiss()
                }
            }
        }
    }

    // v0.1.534: the model setup wizard (F3). The setup pill's CTA opens
    // this focused flow instead of dumping the user into settings.
    SetupWizard {
        id: setupWizard
        backend: root.ctxBackend
    }

    // v0.1.553: the chat panel (local-model conversation UI). Same
    // root.ctxBackend wiring as setupWizard to avoid the self-shadow
    // null trap (v0.1.546).
    ChatPanel {
        id: chatPanel
        backend: root.ctxBackend
    }

    // v0.1.564: REPL/debugger voice companion. A corner glow (bottom-
    // right) that invites voice interaction when gdb/lldb/python/etc. is
    // focused. Only on the terminal tab. Anchored, NOT full-window — it
    // never covers the stack trace the developer is reading. backend via
    // root.ctxBackend (shadow-null trap, v0.1.546).
    ReplVoiceGlow {
        id: replVoiceGlow
        backend: root.ctxBackend
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        anchors.rightMargin: 18
        anchors.bottomMargin: 96   // clears the bottom command bar
        // Suppress on non-terminal tabs; the component's own context
        // poll decides whether a REPL is actually focused.
        parentActive: tabBar.currentIndex === 1
    }

    // v0.1.537: web2qml://models (and the URL route) opens the wizard.
    Connections {
        target: backend
        function onSetup_wizard_requested() {
            if (backend && backend.log_message) backend.log_message("[wizard-qml] setup_wizard_requested signal received")
            if (typeof setupWizard !== "undefined") setupWizard.open()
            else if (backend && backend.log_message) backend.log_message("[wizard-qml] setupWizard is undefined!")
        }
        // v0.1.553: open the chat panel overlay.
        function onChat_panel_requested() {
            if (backend && backend.log_message) backend.log_message("[chat-qml] chat_panel_requested signal received")
            if (typeof chatPanel !== "undefined") chatPanel.open()
            else if (backend && backend.log_message) backend.log_message("[chat-qml] chatPanel is undefined!")
        }
        // v0.1.823: an in-page link navigated the active pane (backend.link_nav).
        // The generated page QML loaded inside a pane can't reach the root id to
        // assign termPaneStrip, so it routes through this signal carrying the new
        // workspace wire.
        function onTerm_strip_refreshed(wire) {
            if (wire && wire.length > 0) root.termPaneStrip = wire
            // v0.1.899: a pane's url/kind change (open-in-current-pane, an
            // in-page link) does NOT change to_wire() — it only encodes tab
            // structure, not per-pane url/kind. So the assignment above is a
            // no-op that never fires onTermPaneStripChanged, and the pane model
            // keeps the stale url. Force the model to re-read ws_pane_rects (new
            // url) and web panes to re-render; render_pane_qml is content-
            // addressed, so unchanged panes cost a hash and no Loader reload.
            if (typeof paneSplitLayer !== "undefined") {
                paneSplitLayer._recompute()
                paneSplitLayer._webTick++
            }
        }
    }

    // ═══ Background Job Notifier ═══ (v0.1.209, ship 2.6.4)
    //
    // Thin strip at the bottom of the window showing a backgrounded
    // job's progress and status text. Visible while
    // backend.job_status is non-empty. Auto-hides 3 seconds after
    // status clears (or becomes "ready!").
    //
    // Substrate D of the multi-user onboarding arc — the
    // "your voice profile is building..." UI. Reusable for any
    // background work that benefits from a status surface.
    Rectangle {
        id: jobNotifier
        property string statusText: backend && backend.job_status
            ? backend.job_status : ""
        property real progressValue: backend && backend.job_progress !== undefined
            ? backend.job_progress : 0.0
        // Show while text is non-empty. After clearing, give a
        // half-second tail before hiding so the "ready!" beat
        // has time to register.
        property bool wantVisible: statusText.length > 0
        property bool shownNow: wantVisible

        // Delay-hide on text-clear via a Timer.
        Timer {
            id: _jobHideTimer
            interval: 500
            running: !jobNotifier.wantVisible && jobNotifier.shownNow
            onTriggered: jobNotifier.shownNow = false
        }
        onStatusTextChanged: {
            if (wantVisible) shownNow = true
        }
        onWantVisibleChanged: {
            if (wantVisible) shownNow = true
        }

        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        // v0.1.249: lift above the bottom chrome (URL bar + tab bar).
        // Same math as the toast: tab bar is always ~48px, URL bar
        // is 50 when visible / 0 when hidden, plus 4px clearance.
        anchors.bottomMargin: 48 + (topBar.visible ? 50 : 0) + 4
        // 28px when shown, 0 when hidden (collapses out of view).
        height: shownNow ? 28 : 0
        Behavior on height { NumberAnimation { duration: 200; easing.type: Easing.OutQuad } }
        visible: height > 0
        color: th.sf
        border.color: th.bd; border.width: 1
        z: 800  // below thought bubble (1000), above page content

        Row {
            anchors.fill: parent
            anchors.leftMargin: 12
            anchors.rightMargin: 12
            spacing: 10

            // Spinner during active progress (progress > 0 but < 1).
            // For terminal states (progress = 1.0 or text starts with
            // "ready") show a check mark instead.
            Text {
                anchors.verticalCenter: parent.verticalCenter
                text: jobNotifier.statusText.toLowerCase().startsWith("ready")
                    || jobNotifier.progressValue >= 0.999
                    ? "\u2713"   // ✓
                    : "\u22ef"   // ⋯
                color: th.ac
                font.pixelSize: 14
                font.bold: true
            }

            // Status text.
            Text {
                anchors.verticalCenter: parent.verticalCenter
                text: jobNotifier.statusText
                color: th.tc
                font.pixelSize: 11
                width: jobNotifier.width - 200
                elide: Text.ElideRight
            }

            // Progress bar — only visible during active progress.
            Rectangle {
                anchors.verticalCenter: parent.verticalCenter
                width: 120
                height: 4
                radius: 2
                color: Qt.darker(th.bd, 1.2)
                visible: jobNotifier.progressValue > 0.001 && jobNotifier.progressValue < 0.999
                Rectangle {
                    anchors.left: parent.left
                    anchors.top: parent.top
                    anchors.bottom: parent.bottom
                    width: parent.width * Math.max(0, Math.min(1, jobNotifier.progressValue))
                    color: th.ac
                    radius: 2
                    Behavior on width { NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }
                }
            }
        }
    }

    // ═══ Guided Tour Driver ═══ (v0.1.210, ship 2.6.3)
    //
    // Sequences a script of steps to walk the user through app
    // features. Composes the three onboarding substrates:
    //   - A (manpages, v0.1.203): scripts can navigate to docs
    //   - B (thought bubbles, v0.1.204): scripts can show
    //     directive overlays pointing at UI elements
    //   - D (job notifier, v0.1.209): scripts can surface
    //     "tour in progress..." status
    //
    // Script format: a JS array of step objects. Each step:
    //   { type: "bubble", targetId: "backBtn", text: "..." }
    //   { type: "navigate", url: "web2qml://man/welcome" }
    //   { type: "delay", ms: 500 }
    //   { type: "jobStatus", text: "...", progress: 0.3 }
    //   { type: "clearJob" }
    //
    // Steps advance when:
    //   - bubble: user taps to ack (the bubble's acknowledged signal)
    //   - delay: timer fires
    //   - others: immediately after the effect
    //
    // Target resolution: bubble steps reference targets by string
    // id ("backBtn", "settingsBtn", ...). The driver looks them up
    // in `targetRegistry` populated below. Adding a new tour
    // target = add a line to that table.
    //
    // Cancellation: calling stop() aborts the current step, closes
    // any open bubble, and clears job status. Tours that need to
    // survive user-cancel should listen to the stopped signal.
    QtObject {
        id: tourDriver

        // The script being executed. Null when no tour is running.
        property var _script: null
        // Index of the currently-running step.
        property int _stepIdx: -1
        // Connection to the bubble's acknowledged signal — set up
        // when we show a bubble, cleared on advance. Stored so we
        // can disconnect cleanly across step transitions.
        property var _bubbleConn: null

        // Lookup table for bubble targets. Add new entries here as
        // we add scripts that reference new UI elements. Using a
        // function so we always resolve to current Items (avoids
        // stale references if QML rebuilds anything).
        function _resolveTarget(targetId) {
            switch (targetId) {
                case "backBtn":     return backBtn
                case "settingsBtn": return settingsBtn
                default:
                    console.warn("[tour] unknown target id: " + targetId)
                    return null
            }
        }

        signal stopped()

        // Timer for delay steps. Sibling of the QtObject (not
        // child) because Timer-inside-QtObject has spotty support
        // across Qt versions in this codebase. The id is global
        // anyway so the function reference works the same.

        // Public: start a tour. `script` is an array of step objects.
        // If a tour is already running, it's stopped first.
        function start(script) {
            stop()
            _script = script
            _stepIdx = -1
            _advance()
        }

        // Public: stop the current tour. Closes any open bubble,
        // clears job status, fires stopped signal. Safe to call
        // when no tour is running.
        function stop() {
            if (_script === null) return
            if (_bubbleConn) {
                globalThoughtBubble.acknowledged.disconnect(_bubbleConn)
                _bubbleConn = null
            }
            if (globalThoughtBubble._shown) {
                globalThoughtBubble.hide()
            }
            _tourDelayTimer.stop()
            if (backend && backend.clear_job_status) {
                backend.clear_job_status()
            }
            _script = null
            _stepIdx = -1
            // v0.1.213: also reset onboarding routing. Filed M
            // in v0.1.212 — if the user cancels the tour mid-
            // bubble (or another tour starts), we don't want
            // their next voice capture to still route to the
            // registration dialog.
            //
            // startOnboarding() compensates by setting
            // onboardingActive AFTER calling start(), so the
            // internal stop() that start() always issues doesn't
            // clobber the just-set flag.
            if (typeof root !== "undefined" && "onboardingActive" in root) {
                root.onboardingActive = false
            }
            stopped()
        }

        // Internal: advance to the next step, or stop if we're done.
        function _advance() {
            if (_script === null) return
            // Clean up any per-step state.
            if (_bubbleConn) {
                globalThoughtBubble.acknowledged.disconnect(_bubbleConn)
                _bubbleConn = null
            }
            _stepIdx++
            if (_stepIdx >= _script.length) {
                // Tour complete. Don't auto-clear job status —
                // the last step's setJobStatus / clearJob is the
                // author's responsibility.
                console.log("[tour] complete (" + _script.length + " steps)")
                _script = null
                _stepIdx = -1
                stopped()
                return
            }
            var step = _script[_stepIdx]
            console.log("[tour] step " + _stepIdx + " type=" + step.type)
            _executeStep(step)
        }

        // Internal: run a single step's effect and either advance
        // immediately or wait for an async trigger (bubble ack,
        // timer).
        function _executeStep(step) {
            switch (step.type) {
                case "bubble": {
                    var target = _resolveTarget(step.targetId)
                    if (!target) {
                        // Skip unresolvable target rather than
                        // hanging the tour. Log + advance.
                        _advance()
                        return
                    }
                    globalThoughtBubble.target = target
                    globalThoughtBubble.text = step.text || ""
                    // Connect ONCE to acknowledged → advance.
                    var conn = function() { tourDriver._advance() }
                    globalThoughtBubble.acknowledged.connect(conn)
                    _bubbleConn = conn
                    globalThoughtBubble.show()
                    break
                }
                case "navigate": {
                    if (backend && step.url) {
                        backend.link_nav(step.url)
                    }
                    // Navigation is fire-and-forget here. The next
                    // step (typically a delay) is responsible for
                    // waiting until the page renders. Without a
                    // delay step, the bubble's target.mapToItem
                    // might resolve before content lands.
                    _advance()
                    break
                }
                case "delay": {
                    _tourDelayTimer.interval = step.ms || 500
                    _tourDelayTimer.start()
                    // _advance is called from the timer's onTriggered.
                    break
                }
                case "jobStatus": {
                    if (backend && backend.set_job_status) {
                        backend.set_job_status(step.text || "", step.progress || 0.0)
                    }
                    _advance()
                    break
                }
                case "clearJob": {
                    if (backend && backend.clear_job_status) {
                        backend.clear_job_status()
                    }
                    _advance()
                    break
                }
                default:
                    console.warn("[tour] unknown step type: " + step.type)
                    _advance()
                    break
            }
        }

        // ─── Built-in tours ───
        //
        // Authors can compose their own scripts and call start();
        // these are the ones the app ships with. v0.1.210 includes
        // a minimal "intro" tour as a smoke test for the substrate.
        // The real onboarding flow (2.6.5) will add more.

        function startIntroTour() {
            start([
                { type: "jobStatus", text: "Quick tour...", progress: 0.0 },
                { type: "navigate", url: "web2qml://man/welcome" },
                { type: "delay", ms: 600 },
                {
                    type: "bubble",
                    targetId: "backBtn",
                    text: "This is the back button. Tap this bubble to continue."
                },
                { type: "jobStatus", text: "Quick tour...", progress: 0.5 },
                {
                    type: "bubble",
                    targetId: "settingsBtn",
                    text: "Tap the gear for quick settings. Long-press, double-click, or right-click for the full panel."
                },
                { type: "jobStatus", text: "Tour complete — ready!", progress: 1.0 },
                { type: "delay", ms: 1500 },
                { type: "clearJob" }
            ])
        }

        // v0.1.212 (ship 2.6.5): the real onboarding flow. Sets
        // root.onboardingActive = true so the voice popup's
        // completion routes to the speaker registration dialog.
        //
        // Script: open the onboarding manpage → bubble explaining
        // what to do → end tour (user takes over by tapping the
        // voice button and reading). The registration dialog
        // appears after voice capture completes, and resetting
        // onboardingActive happens on Save/Cancel in that dialog.
        //
        // Cancellation (v0.1.213): tourDriver.stop() now resets
        // onboardingActive too, so cancelling the tour mid-bubble
        // also abandons the onboarding routing. If the user wants
        // to complete onboarding after a cancel, they re-invoke
        // startOnboarding (which sets the flag again after the
        // internal stop()). This matches user intent: cancelling
        // the tour means "I'm done with this flow."
        function startOnboarding() {
            // v0.1.213: set onboardingActive AFTER calling start().
            // start() always calls stop() internally, and stop() now
            // resets onboardingActive — so setting before start would
            // clobber. Order matters.
            start([
                { type: "jobStatus", text: "Voice setup...", progress: 0.1 },
                { type: "navigate", url: "web2qml://man/onboarding" },
                { type: "delay", ms: 600 },
                {
                    type: "bubble",
                    targetId: "settingsBtn",
                    text: "Read the paragraph on this page aloud, then tap the voice button (bottom-right) to capture your voice. Tap this bubble to begin."
                },
                { type: "jobStatus", text: "Ready when you are...", progress: 0.3 },
                { type: "clearJob" }
            ])
            root.onboardingActive = true
        }
    }

    // Timer for the tourDriver's "delay" steps. Sibling rather
    // than child of the QtObject for Qt-version compatibility.
    Timer {
        id: _tourDelayTimer
        interval: 500
        running: false
        repeat: false
        onTriggered: tourDriver._advance()
    }

    // ═══ First-launch onboarding auto-trigger ═══ (v0.1.219)
    //
    // On startup, ask the backend whether we should proactively
    // show the onboarding tour (no speakers registered AND the
    // seen-flag stamp file doesn't exist). If yes, mark the
    // stamp and fire startOnboarding().
    //
    // Why a Timer with 1500ms delay (not Component.onCompleted):
    //   - Whisper model load happens during early Backend init
    //     and can keep the main thread busy for ~50-100ms after
    //     QML is ready. Auto-firing during that window would
    //     mean the bubble paints on top of a half-rendered UI.
    //   - The bubble targets `gearPin` (the quick-settings gear).
    //     That element needs to exist and be laid out before
    //     the bubble can anchor to it.
    //   - 1500ms is comfortable for both fast machines (UI
    //     already idle) and slow ones (still loading audio,
    //     but the gear is laid out).
    //
    // The stamp is set BEFORE startOnboarding() so a crash or
    // immediate dismissal still counts as "seen" — the user
    // won't be re-nagged. They can re-open onboarding manually
    // via the quick-settings "register your voice" link.
    Timer {
        id: _onboardingAutoTriggerTimer
        interval: 1500
        running: true
        repeat: false
        onTriggered: {
            if (!backend) return
            if (!backend.onboarding_should_auto_trigger) return
            if (backend.onboarding_should_auto_trigger()) {
                backend.onboarding_mark_seen()
                if (tourDriver && tourDriver.startOnboarding) {
                    tourDriver.startOnboarding()
                }
            }
        }
    }

    // ═══ Onboarding state ═══ (v0.1.212, ship 2.6.5)
    //
    // When true, the voice popup's completion routes to the
    // speaker registration dialog instead of normal intent
    // dispatch. Set by tourDriver.startOnboarding(), cleared
    // on save/cancel in the dialog.
    //
    // This is the substrate that lets us reuse the regular
    // voice popup for capture without polluting the intent
    // dispatch path with onboarding-specific branches.
    property bool onboardingActive: false

    // ═══ Speaker Registration Popup ═══ (v0.1.212, ship 2.6.5)
    //
    // Shown after voice capture in onboarding mode. Reads
    // backend.speaker_preview_color() to display the swatch,
    // takes the user's preferred name, and calls
    // backend.speaker_register_current(name) on Save.
    //
    // The color suggestion can be overridden — the user can
    // pick from a small palette of alternatives. Since
    // speakers::add_speaker uses the audio buffer's profile
    // (not the override), the displayed color and the actual
    // stored color CAN diverge if the user overrides. v1
    // accepts this — fixing requires either threading the
    // override down into add_speaker (signature change) or
    // calling a separate set_speaker_color after registration.
    // Deferred. v1 just commits with the derived color.
    // ─── URL-bar suggestions dropdown (v0.1.420) ───
    //
    // Omnibox-style suggestions under the URL bar: ranked
    // history, bookmarks, file matches, internal pages, and a
    // web-search action, from backend.search_suggestions().
    // Non-modal Popup parented to the overlay so it isn't
    // clipped by the (clip:true) toolbar and floats above page
    // content. Positioned by mapping the urlPill's global rect.
    Popup {
        id: urlSuggestPopup
        parent: Overlay.overlay
        modal: false
        focus: false   // keep typing focus on urlBar
        closePolicy: Popup.NoAutoClose  // we manage open/close from urlBar state
        padding: 0
        background: Rectangle {
            color: th.sf
            border.color: th.bd
            border.width: 1
            radius: 8
        }
        // Suggestion model rows: {tag, label, target}.
        property var _rows: []
        // v0.1.682: keyboard selection index for arrow-key nav (-1 = none).
        property int _selIndex: -1
        // Map the urlPill to overlay coords each time we (re)open
        // or the bar moves, so we sit just under it.
        function _reposition() {
            if (typeof urlPill === "undefined" || !urlPill.visible) return
            width = urlPill.width
            // Default: drop DOWN from just below the pill.
            var below = urlPill.mapToItem(Overlay.overlay, 0, urlPill.height + 4)
            // If that would run off the bottom of the overlay (the
            // URL bar can live at the bottom of the screen via
            // _urlBarAtTop=false), flip to drop UP above the pill.
            var listH = Math.min(_suggestList.contentHeight, 320)
            if (below.y + listH > Overlay.overlay.height - 8) {
                var above = urlPill.mapToItem(Overlay.overlay, 0, -listH - 4)
                x = above.x
                y = Math.max(8, above.y)
            } else {
                x = below.x
                y = below.y
            }
        }
        // Debounce keystrokes so we don't hammer the backend.
        Timer {
            id: _suggestDebounce
            interval: 120
            repeat: false
            onTriggered: urlSuggestPopup._refresh()
        }
        function _refresh() {
            if (!backend || !backend.search_suggestions) { close(); return }
            var raw = backend.search_suggestions(urlBar.text).toString()
            var rows = []
            if (raw.length > 0) {
                var lines = raw.split("\n")
                for (var i = 0; i < lines.length; i++) {
                    var ln = lines[i]
                    if (ln.length === 0) continue
                    var parts = ln.split("\u001f")
                    if (parts.length >= 3) {
                        rows.push({ tag: parts[0], label: parts[1], target: parts[2] })
                    }
                }
            }
            _rows = rows
            // v0.1.675: also search note/script CONTENTS (the "cloak" gap —
            // before, only filenames/history were searched). Append content
            // matches below the quick suggestions. Bounded file IO in the
            // backend; the 120ms debounce above covers it.
            if (backend.note_content_search && urlBar.text.length >= 2) {
                var craw = backend.note_content_search(urlBar.text).toString()
                if (craw.length > 0) {
                    var clines = craw.split("\n")
                    for (var c = 0; c < clines.length; c++) {
                        if (clines[c].length === 0) continue
                        var cp = clines[c].split("\t")
                        if (cp.length >= 3) {
                            // label: "NoteName — snippet"; target: file path.
                            // v0.1.681: snippet carries «»-wrapped matches;
                            // convert to <b> and HTML-escape the rest so the
                            // dropdown (RichText) bolds the hit. richText flag
                            // tells the delegate to render as RichText.
                            var nm = cp[0].split("/").pop()
                            var snip = cp[2]
                                .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
                                .replace(/\u00AB/g, "<b>").replace(/\u00BB/g, "</b>")
                            rows.push({ tag: "c",
                                        label: nm + " — " + snip,
                                        richText: true,
                                        target: cp[0], line: cp[1] })
                        }
                    }
                    _rows = rows
                }
            }
            if (rows.length > 0 && urlBar.activeFocus) {
                _reposition()
                if (!opened) open()
            } else {
                close()
            }
            _selIndex = -1
        }
        // Act on a suggestion: navigate, open file, or web-search.
        function _act(row) {
            if (!backend) return
            close()
            if (row.tag === "w") {
                // Web search — route through nav with a search URL.
                // Use the HTML (non-JS) DDG endpoint — our
                // renderer parses it well, unlike the SPA at
                // duckduckgo.com/?q=. Matches the backend's
                // web_search path (main.rs).
                var u = "https://html.duckduckgo.com/html/?q=" + encodeURIComponent(row.target)
                backend.last_query = u
                backend.nav(u)
            } else {
                // history/bookmark/file/internal → navigate target.
                // v0.1.675: content match (tag "c") → open the file (it's a
                // path); the line number is carried for a future scroll-to.
                if (row.tag === "c" && row.target.indexOf("://") === -1) {
                    backend.last_query = "file://" + row.target
                    backend.nav("file://" + row.target)
                } else {
                    backend.last_query = row.target
                    backend.nav(row.target)
                }
            }
            helixKeys.forceActiveFocus()
        }
        // Icon per kind.
        function _icon(tag) {
            switch (tag) {
            case "h": return "\u21BA"   // history (anticlockwise arrow)
            case "b": return "\u2605"   // bookmark (star)
            case "f": return "\u25A4"   // file (document-ish BMP glyph)
            case "c": return "\uD83D\uDD0E" // content match (magnifier)
            case "w": return "\u2315"   // search (telephone-recorder / magnifier-ish BMP)
            case "i": return "\u26A1"   // internal (bolt)
            default: return "\u2192"
            }
        }
        contentItem: ListView {
            id: _suggestList
            implicitHeight: Math.min(contentHeight, 320)
            clip: true
            model: urlSuggestPopup._rows
            delegate: Rectangle {
                width: ListView.view.width
                height: 40
                // v0.1.682: highlight the keyboard-selected row (arrow nav)
                // as well as the hovered row.
                color: (index === urlSuggestPopup._selIndex)
                       ? Qt.lighter(th.sf, 1.5)
                       : (_sugMa.containsMouse ? Qt.lighter(th.sf, 1.3) : "transparent")
                Row {
                    anchors.fill: parent
                    anchors.leftMargin: 12
                    anchors.rightMargin: 12
                    spacing: 10
                    Text {
                        anchors.verticalCenter: parent.verticalCenter
                        text: urlSuggestPopup._icon(modelData.tag)
                        color: th.ac
                        font.pixelSize: 13
                        width: 18
                    }
                    Column {
                        anchors.verticalCenter: parent.verticalCenter
                        width: parent.width - 40
                        spacing: 1
                        Text {
                            text: modelData.label
                            textFormat: modelData.richText ? Text.RichText : Text.PlainText
                            color: th.tc
                            font.pixelSize: 12
                            elide: Text.ElideRight
                            width: parent.width
                        }
                        Text {
                            visible: modelData.tag !== "w"
                            text: modelData.target
                            color: th.tm
                            font.pixelSize: 9
                            elide: Text.ElideMiddle
                            width: parent.width
                        }
                    }
                }
                MouseArea {
                    id: _sugMa
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: urlSuggestPopup._act(modelData)
                }
            }
        }
        // Drive open/close + refresh from urlBar state.
        Connections {
            target: urlBar
            function onTextChanged() {
                if (urlBar.activeFocus) _suggestDebounce.restart()
            }
            function onActiveFocusChanged() {
                if (urlBar.activeFocus) {
                    _suggestDebounce.restart()
                } else {
                    // Small delay so a click on a suggestion (which
                    // pulls focus from the bar) still registers
                    // before we close.
                    _suggestCloseTimer.restart()
                }
            }
        }
        Timer {
            id: _suggestCloseTimer
            interval: 180
            repeat: false
            onTriggered: { if (!urlBar.activeFocus) urlSuggestPopup.close() }
        }
    }

    Popup {
        id: speakerRegistrationPopup
        parent: Overlay.overlay
        anchors.centerIn: parent
        width: Math.min(root.width - 40, 360)
        height: _regCol.implicitHeight + 32
        modal: true
        dim: true
        closePolicy: Popup.CloseOnEscape

        // v0.1.359: reset step state on each open so a previous
        // session's terminal state ("saved" / "error") doesn't
        // bleed into a new registration. _registeredSpeakerId
        // also resets because the popup will write a fresh value
        // when _doRegister succeeds. previewColor / speakerName
        // are NOT reset here because the caller (voicePopup flow)
        // populates them just before calling open().
        onOpened: {
            _step = 0
            _spokenState = "idle"
            _registeredSpeakerId = ""
            // Belt-and-suspenders: stop any leftover timers.
            _spokenPollTimer.stop()
            _spokenAutoCloseTimer.stop()
        }

        property string previewColor: ""
        property string speakerName: "Me"
        // v0.1.359: multi-step state machine.
        //
        //   0 = name + color (current "main" step)
        //   1 = spoken-name capture (PC2a — new)
        //
        // Step 1 appears AFTER speaker registration so the fingerprint
        // is built from the pangram audio (still in last_audio_buffer)
        // and the spoken-name capture happens on its own clock.
        // Skip-able; on skip we close immediately.
        property int _step: 0
        // v0.1.359: spoken-name capture sub-state.
        //   "idle" — ready to start capturing
        //   "recording" — capture in progress
        //   "saved" — captured + saved successfully
        //   "error" — capture failed (mic permission, disk, etc.)
        property string _spokenState: "idle"
        // v0.1.359: id assigned by speaker_register_current. Needed
        // for the corpus path on spoken-name save.
        property string _registeredSpeakerId: ""
        // v0.1.259: stored dedup-prompt state. When a dedup match is
        // detected, _commit stores the match here and shows the
        // _dedupConfirm dialog instead of committing immediately.
        // User picks: rename existing → calls speaker_rename;
        // register-as-new → calls speaker_register_current anyway.
        property string _dedupExistingName: ""
        property real _dedupSimilarity: 0
        // Cleanup on close — explicit (vs onClosed handler) so
        // we can call from Save handler without race.
        function _commit(save) {
            if (save && speakerName.length > 0) {
                // v0.1.259: check for voice-profile dedup BEFORE
                // committing. If existing speaker matches above
                // threshold, surface the confirmation dialog rather
                // than silently creating a duplicate entry.
                if (backend && backend.speaker_propose_dedup) {
                    var raw = backend.speaker_propose_dedup(speakerName)
                    if (raw && raw.length > 0) {
                        var parts = raw.split("\x1F")
                        if (parts.length >= 2) {
                            _dedupExistingName = parts[0]
                            _dedupSimilarity = parseFloat(parts[1]) || 0
                            _dedupConfirm.open()
                            return  // don't close until user decides
                        }
                    }
                }
                _doRegister()
                return
            }
            root.onboardingActive = false
            close()
        }

        // v0.1.259: the actual register-as-new path. Pulled out
        // of _commit so the dedup-confirm dialog can call it
        // when user picks "register as new."
        //
        // v0.1.359: instead of closing on success, transition to
        // step 1 (spoken-name capture). Errors and the no-backend
        // path still close immediately so we don't strand the
        // user on a broken step.
        function _doRegister() {
            if (backend && backend.speaker_register_current) {
                var registered = backend.speaker_register_current(speakerName)
                if (registered && registered.length > 0) {
                    if (typeof toast !== "undefined") {
                        toast.show("Registered: " + registered)
                    }
                    if (backend.set_job_status) {
                        backend.set_job_status("Voice profile ready!", 1.0)
                    }
                    // Auto-clear the job status after a beat.
                    _regClearJobTimer.start()
                    // v0.1.359: PC2a — advance to spoken-name step
                    // rather than closing. The registered name is
                    // what backend returned (may differ if a
                    // sanitizer collapsed whitespace or similar).
                    _registeredSpeakerId = registered
                    _step = 1
                    _spokenState = "idle"
                    return
                }
            }
            // Failure path: registration didn't take. Close the
            // popup so user isn't stranded on the spoken-name
            // step with no speaker to attach it to.
            root.onboardingActive = false
            close()
        }

        // v0.1.359: skip the spoken-name step entirely. The user
        // already finished the primary registration; spoken-name
        // is optional flavor.
        function _skipSpoken() {
            root.onboardingActive = false
            close()
        }

        // v0.1.359: start the spoken-name capture. Uses the
        // existing voice_listen_dual_async pipeline so audio
        // capture and silence-detection match the rest of the
        // app. When complete (poll observes a result), we drain
        // the audio buffer into the corpus via
        // corpus_save_spoken_name.
        function _startSpokenCapture() {
            if (!backend || !backend.voice_listen_dual_async) {
                _spokenState = "error"
                return
            }
            _spokenState = "recording"
            backend.voice_listen_dual_async()
            _spokenPollTimer.restart()
        }

        // v0.1.359: poll the async listen result. Fires every
        // 200ms while recording; stops on result or error.
        function _checkSpokenCapture() {
            if (_spokenState !== "recording") {
                _spokenPollTimer.stop()
                return
            }
            if (!backend || !backend.voice_listen_dual_poll) {
                _spokenState = "error"
                _spokenPollTimer.stop()
                return
            }
            var r = backend.voice_listen_dual_poll()
            if (!r || r.length === 0) return  // still recording
            // Result available — drain audio + save to corpus.
            _spokenPollTimer.stop()
            if (backend.voice_listen_dual_take_audio) {
                backend.voice_listen_dual_take_audio()
            }
            if (backend.corpus_save_spoken_name) {
                var ok = backend.corpus_save_spoken_name(
                    _registeredSpeakerId, speakerName)
                _spokenState = ok ? "saved" : "error"
                if (ok && typeof toast !== "undefined") {
                    toast.show("Saved spoken name")
                }
            } else {
                _spokenState = "error"
            }
            // Auto-close after a beat so the user sees the
            // success state without needing to tap again.
            _spokenAutoCloseTimer.restart()
        }

        // v0.1.259: rename-existing path. Called from the dedup
        // dialog. The existing speaker gets renamed to the new
        // name; no new entry is created. Voice profile of the
        // existing speaker is preserved (the audio captured
        // during this registration session is NOT folded in —
        // could be added later via a follow-up).
        function _doRenameExisting() {
            if (backend && backend.speaker_rename && _dedupExistingName.length > 0) {
                var ok = backend.speaker_rename(_dedupExistingName, speakerName)
                if (typeof toast !== "undefined") {
                    if (ok) {
                        toast.show("Renamed: " + _dedupExistingName + " → " + speakerName)
                    } else {
                        toast.show("Couldn't rename — registered as new instead", "error")
                        // Fall back to new-registration if rename failed.
                        _doRegister()
                        return
                    }
                }
            }
            root.onboardingActive = false
            close()
        }

        background: Rectangle {
            color: th.sf
            radius: 12
            border.color: th.bd
            border.width: 1
        }

        Column {
            id: _regCol
            width: parent.width
            padding: 16
            spacing: 12

            Text {
                text: speakerRegistrationPopup._step === 0
                    ? "Register your voice"
                    : "Now say your name"
                color: th.tc
                font.pixelSize: 14
                font.bold: true
            }

            Text {
                width: parent.width - 32
                text: speakerRegistrationPopup._step === 0
                    ? "We captured your voice and derived a color. You can change the name; tap Save to register."
                    : "Optional: tap the mic and say your name once. We'll save it alongside your typed name so the app knows how YOU pronounce it. Skip if you'd rather not."
                color: th.tm
                font.pixelSize: 11
                wrapMode: Text.WordWrap
            }

            // Color swatch + name row
            Row {
                width: parent.width - 32
                spacing: 12
                visible: speakerRegistrationPopup._step === 0
                Rectangle {
                    width: 40; height: 40; radius: 20
                    color: speakerRegistrationPopup.previewColor.length > 0
                        ? speakerRegistrationPopup.previewColor : "#888888"
                    border.color: th.bd
                    border.width: 1
                    anchors.verticalCenter: parent.verticalCenter
                }
                Rectangle {
                    width: parent.width - 52
                    height: 32
                    radius: 6
                    color: th.ib
                    border.color: _regName.activeFocus ? th.ac : th.bd
                    border.width: _regName.activeFocus ? 2 : 1
                    anchors.verticalCenter: parent.verticalCenter
                    TextInput {
                        id: _regName
                        anchors.fill: parent
                        anchors.leftMargin: 10
                        anchors.rightMargin: 10
                        verticalAlignment: TextInput.AlignVCenter
                        color: th.tc
                        font.pixelSize: 12
                        text: speakerRegistrationPopup.speakerName
                        selectByMouse: true
                        onTextChanged: speakerRegistrationPopup.speakerName = text
                        onAccepted: speakerRegistrationPopup._commit(true)
                    }
                    Text {
                        anchors.fill: parent
                        anchors.leftMargin: 10
                        verticalAlignment: Text.AlignVCenter
                        text: "Your name"
                        color: th.tm
                        font.pixelSize: 11
                        font.italic: true
                        visible: _regName.text.length === 0 && !_regName.activeFocus
                    }
                }
            }

            // v0.1.359: step-1 — spoken-name capture UI.
            //
            // Big mic button that visually shifts through three
            // states: idle (gray, "Tap to record"), recording
            // (red, pulsing, "Listening… say your name"), saved
            // (green check, "Got it"). Errors fall back to idle
            // with a brief toast.
            //
            // Voice capture uses the existing async pipeline so
            // silence-detection ends the recording — no separate
            // stop button needed.
            Column {
                width: parent.width - 32
                spacing: 12
                visible: speakerRegistrationPopup._step === 1

                // Mic button + status text in a row.
                Row {
                    width: parent.width
                    spacing: 14
                    Rectangle {
                        id: _spokenMicBtn
                        width: 64; height: 64; radius: 32
                        color: {
                            switch (speakerRegistrationPopup._spokenState) {
                                case "recording": return "#cc4438"
                                case "saved":     return "#2d8a4a"
                                case "error":     return "#8a4438"
                                default:          return _spokenMicMa.containsMouse
                                    ? Qt.lighter(th.ac, 1.15)
                                    : th.ac
                            }
                        }
                        Behavior on color { ColorAnimation { duration: 140 } }
                        anchors.verticalCenter: parent.verticalCenter
                        // Pulse animation while recording.
                        SequentialAnimation on scale {
                            running: speakerRegistrationPopup._spokenState === "recording"
                            loops: Animation.Infinite
                            NumberAnimation { from: 1.0; to: 1.08; duration: 500; easing.type: Easing.InOutSine }
                            NumberAnimation { from: 1.08; to: 1.0; duration: 500; easing.type: Easing.InOutSine }
                        }
                        Text {
                            anchors.centerIn: parent
                            // U+1F3A4 microphone, U+2713 check, U+26A0 warning
                            text: {
                                switch (speakerRegistrationPopup._spokenState) {
                                    case "saved": return "\u2713"
                                    case "error": return "\u26A0"
                                    default:      return "\uD83C\uDFA4"
                                }
                            }
                            color: "#ffffff"
                            font.pixelSize: 26
                        }
                        MouseArea {
                            id: _spokenMicMa
                            anchors.fill: parent
                            hoverEnabled: true
                            cursorShape: speakerRegistrationPopup._spokenState === "idle"
                                || speakerRegistrationPopup._spokenState === "error"
                                ? Qt.PointingHandCursor : Qt.ArrowCursor
                            // Allow re-record from error state; idle starts capture;
                            // recording / saved states ignore taps.
                            onClicked: {
                                var st = speakerRegistrationPopup._spokenState
                                if (st === "idle" || st === "error") {
                                    speakerRegistrationPopup._startSpokenCapture()
                                }
                            }
                        }
                    }
                    // Status text next to the mic.
                    Text {
                        width: parent.width - 78
                        anchors.verticalCenter: parent.verticalCenter
                        wrapMode: Text.WordWrap
                        font.pixelSize: 12
                        color: th.tc
                        text: {
                            switch (speakerRegistrationPopup._spokenState) {
                                case "recording": return "Listening… say your name."
                                case "saved":     return "Got it. Saved to your corpus."
                                case "error":     return "Couldn't capture. Tap to try again, or Skip."
                                default:          return "Tap the mic and say your name once."
                            }
                        }
                    }
                }

                // Skip / Done row.
                Row {
                    anchors.right: parent.right
                    spacing: 8
                    Rectangle {
                        width: 80; height: 32; radius: 16
                        color: _spokenSkipMa.containsMouse ? Qt.lighter(th.ib, 1.2) : th.ib
                        border.color: th.bd; border.width: 1
                        Text {
                            anchors.centerIn: parent
                            // "Skip" while idle; "Cancel" while recording (stops + closes);
                            // "Close" once saved (auto-close timer will fire too).
                            text: {
                                switch (speakerRegistrationPopup._spokenState) {
                                    case "recording": return "Cancel"
                                    case "saved":     return "Close"
                                    default:          return "Skip"
                                }
                            }
                            color: th.tc; font.pixelSize: 12
                        }
                        MouseArea {
                            id: _spokenSkipMa
                            anchors.fill: parent
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: {
                                // If a capture is in flight, cancel it cleanly.
                                if (speakerRegistrationPopup._spokenState === "recording"
                                    && backend && backend.voice_cancel) {
                                    backend.voice_cancel()
                                }
                                speakerRegistrationPopup._skipSpoken()
                            }
                        }
                    }
                }
            }

            // Save / Cancel row
            Row {
                anchors.right: parent.right
                anchors.rightMargin: 16
                spacing: 8
                visible: speakerRegistrationPopup._step === 0

                Rectangle {
                    width: 80; height: 32; radius: 16
                    color: _cancelMa.containsMouse ? Qt.lighter(th.ib, 1.2) : th.ib
                    border.color: th.bd; border.width: 1
                    Text {
                        anchors.centerIn: parent
                        text: "Cancel"
                        color: th.tc; font.pixelSize: 12
                    }
                    MouseArea {
                        id: _cancelMa
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: speakerRegistrationPopup._commit(false)
                    }
                }
                Rectangle {
                    width: 80; height: 32; radius: 16
                    color: _saveMa.containsMouse ? Qt.lighter(th.ac, 1.1) : th.ac
                    Text {
                        anchors.centerIn: parent
                        text: "Save"
                        color: "#ffffff"; font.pixelSize: 12; font.bold: true
                    }
                    MouseArea {
                        id: _saveMa
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: speakerRegistrationPopup._commit(true)
                    }
                }
            }
        }
    }

    // Auto-clear the "ready!" status 2 seconds after registration.
    Timer {
        id: _regClearJobTimer
        interval: 2000
        running: false
        repeat: false
        onTriggered: {
            if (backend && backend.clear_job_status) {
                backend.clear_job_status()
            }
        }
    }

    // v0.1.359: poll the async voice_listen_dual result for the
    // spoken-name capture step. 200ms tick — fast enough that the
    // user perceives the result as instant but slow enough not to
    // hammer the backend.
    Timer {
        id: _spokenPollTimer
        interval: 200
        running: false
        repeat: true
        onTriggered: speakerRegistrationPopup._checkSpokenCapture()
    }

    // v0.1.359: auto-close the spoken-name step after a successful
    // save so the user gets a "saw it work, moved on" finish
    // instead of needing to tap Close. 1.5s is long enough to see
    // the ✓ state without feeling slow.
    Timer {
        id: _spokenAutoCloseTimer
        interval: 1500
        running: false
        repeat: false
        onTriggered: {
            if (speakerRegistrationPopup._spokenState === "saved") {
                speakerRegistrationPopup._skipSpoken()
            }
        }
    }

    // v0.1.259 (dedup-on-register): confirmation dialog shown
    // when the registration popup detects that the captured
    // voice matches an existing speaker above 0.85 similarity.
    // Prevents the v0.1.251 hardware-test bug where the same
    // human voice got registered as both "Allison" and "Allison
    // Martin" — duplicate entries pointing to the same voice.
    Popup {
        id: _dedupConfirm
        parent: Overlay.overlay
        anchors.centerIn: parent
        width: Math.min(root.width - 40, 380)
        height: _dedupCol.implicitHeight + 32
        modal: true
        dim: true
        closePolicy: Popup.NoAutoClose

        background: Rectangle {
            color: th.sf
            radius: 12
            border.color: th.bd
            border.width: 1
        }

        Column {
            id: _dedupCol
            width: parent.width
            padding: 16
            spacing: 12

            Text {
                text: "This voice looks familiar"
                color: th.tc
                font.pixelSize: 14
                font.bold: true
            }

            Text {
                width: parent.width - 32
                text: "We've matched this voice to '"
                    + speakerRegistrationPopup._dedupExistingName
                    + "' ("
                    + Math.round(speakerRegistrationPopup._dedupSimilarity * 100)
                    + "% similarity). "
                    + "Did you mean to rename that speaker, or register a new one?"
                color: th.tm
                font.pixelSize: 11
                wrapMode: Text.WordWrap
            }

            // Side-by-side actions: rename existing / register new.
            Row {
                width: parent.width - 32
                spacing: 8

                Rectangle {
                    width: (parent.width - 8) / 2
                    height: 32
                    radius: 6
                    color: _dedupRenameMa.containsMouse ? th.ac : Qt.lighter(th.sf, 1.5)
                    border.color: th.ac
                    border.width: 1
                    Text {
                        anchors.centerIn: parent
                        text: "Rename to '" + speakerRegistrationPopup.speakerName + "'"
                        color: _dedupRenameMa.containsMouse ? "#fff" : th.tc
                        font.pixelSize: 11
                        elide: Text.ElideRight
                        width: parent.width - 12
                        horizontalAlignment: Text.AlignHCenter
                    }
                    MouseArea {
                        id: _dedupRenameMa
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            _dedupConfirm.close()
                            speakerRegistrationPopup._doRenameExisting()
                        }
                    }
                }

                Rectangle {
                    width: (parent.width - 8) / 2
                    height: 32
                    radius: 6
                    color: _dedupNewMa.containsMouse ? Qt.lighter(th.sf, 1.7) : "transparent"
                    border.color: th.bd
                    border.width: 1
                    Text {
                        anchors.centerIn: parent
                        text: "Register as new"
                        color: th.tm
                        font.pixelSize: 11
                    }
                    MouseArea {
                        id: _dedupNewMa
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            _dedupConfirm.close()
                            speakerRegistrationPopup._doRegister()
                        }
                    }
                }
            }
        }
    }

    // v0.1.262: Manage Speakers popup. Surfaces operations that
    // don't fit the tap/long-press dot interaction:
    //   - Merge two speakers (source → target). Used to clean
    //     up duplicate entries created before v0.1.259's
    //     dedup-on-register landed (e.g. the Allison + Allison
    //     Martin pair).
    //   - (Future) Delete, rename, view metadata.
    //
    // Selection model: tap a speaker to mark as SOURCE (orange
    // outline). Tap another to mark as TARGET (green outline).
    // Merge button activates when both selections are non-empty.
    // Tapping the source/target circles toggles their selection.
    Popup {
        id: _manageSpeakersPopup
        parent: Overlay.overlay
        anchors.centerIn: parent
        width: Math.min(root.width - 40, 420)
        height: Math.min(root.height - 80, _manageSpkCol.implicitHeight + 32)
        modal: true
        dim: true

        property string _sourceName: ""
        property string _targetName: ""
        property var _speakers: []

        function _refresh() {
            if (!backend || !backend.speaker_list) {
                _speakers = []
                return
            }
            var raw = backend.speaker_list()
            if (!raw || raw.length === 0) {
                _speakers = []
                return
            }
            var lines = raw.split("\n")
            var arr = []
            for (var i = 0; i < lines.length; ++i) {
                var parts = lines[i].split("\t")
                if (parts.length >= 2) {
                    arr.push({
                        name: parts[0],
                        color: parts[1],
                        allowed: parts.length >= 3 ? parts[2] === "true" : true,
                        deepMuted: parts.length >= 4 ? parts[3] === "true" : false
                    })
                }
            }
            _speakers = arr
        }

        function _toggleSelection(name) {
            // Tap logic:
            //   - If nothing selected: this becomes source
            //   - If this is already source: deselect it
            //   - If this is already target: deselect it
            //   - If source selected (and this isn't it): this
            //     becomes target
            //   - If both selected: clear and start over with
            //     this as the new source
            if (_sourceName === name) {
                _sourceName = ""
            } else if (_targetName === name) {
                _targetName = ""
            } else if (_sourceName === "") {
                _sourceName = name
            } else if (_targetName === "") {
                _targetName = name
            } else {
                // Both already selected, replace.
                _sourceName = name
                _targetName = ""
            }
        }

        background: Rectangle {
            color: th.sf
            radius: 12
            border.color: th.bd
            border.width: 1
        }

        Column {
            id: _manageSpkCol
            width: parent.width
            padding: 16
            spacing: 12

            Text {
                text: "Manage Speakers"
                color: th.tc
                font.pixelSize: 14
                font.bold: true
            }

            Text {
                width: parent.width - 32
                text: _manageSpeakersPopup._sourceName === ""
                    ? "Tap a speaker to mark as SOURCE (will be removed)."
                    : _manageSpeakersPopup._targetName === ""
                        ? "Now tap the TARGET (will keep — source merges into this)."
                        : "Ready: merge '" + _manageSpeakersPopup._sourceName
                            + "' into '" + _manageSpeakersPopup._targetName
                            + "'? Target's settings (allowed, mute) stay."
                color: th.tm
                font.pixelSize: 11
                wrapMode: Text.WordWrap
            }

            // Scrollable speaker list.
            ListView {
                width: parent.width - 32
                height: Math.min(_manageSpeakersPopup._speakers.length * 44, 260)
                clip: true
                model: _manageSpeakersPopup._speakers
                spacing: 4
                delegate: Rectangle {
                    width: ListView.view.width
                    height: 40
                    radius: 6
                    color: _spkDelMa.containsMouse
                        ? Qt.lighter(th.sf, 1.5)
                        : Qt.lighter(th.sf, 1.3)
                    border.width: (_manageSpeakersPopup._sourceName === modelData.name
                                   || _manageSpeakersPopup._targetName === modelData.name)
                        ? 2 : 1
                    border.color: _manageSpeakersPopup._sourceName === modelData.name
                        ? "#f59e0b"   // amber/orange = source
                        : _manageSpeakersPopup._targetName === modelData.name
                            ? "#10b981"   // emerald = target
                            : th.bd
                    Behavior on border.color { ColorAnimation { duration: 100 } }
                    Row {
                        anchors.fill: parent
                        anchors.leftMargin: 10
                        anchors.rightMargin: 10
                        spacing: 10
                        // Color dot
                        Rectangle {
                            anchors.verticalCenter: parent.verticalCenter
                            width: 16; height: 16; radius: 8
                            color: modelData.color
                            opacity: modelData.allowed ? 1.0
                                : (modelData.deepMuted ? 0.25 : 0.5)
                        }
                        Text {
                            anchors.verticalCenter: parent.verticalCenter
                            text: modelData.name
                            color: th.tc
                            font.pixelSize: 12
                        }
                        Text {
                            anchors.verticalCenter: parent.verticalCenter
                            text: _manageSpeakersPopup._sourceName === modelData.name
                                ? "SOURCE"
                                : _manageSpeakersPopup._targetName === modelData.name
                                    ? "TARGET"
                                    : ""
                            color: _manageSpeakersPopup._sourceName === modelData.name
                                ? "#f59e0b"
                                : "#10b981"
                            font.pixelSize: 10
                            font.bold: true
                            visible: text.length > 0
                        }
                        Item { width: 1; height: 1 }
                        Text {
                            anchors.verticalCenter: parent.verticalCenter
                            text: modelData.allowed ? "" : (modelData.deepMuted ? "(deep mute)" : "(muted)")
                            color: th.tm
                            font.pixelSize: 10
                            font.italic: true
                            visible: !modelData.allowed
                        }
                    }
                    MouseArea {
                        id: _spkDelMa
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            _manageSpeakersPopup._toggleSelection(modelData.name)
                        }
                    }
                }
            }

            // Action row: merge button + cancel.
            Row {
                width: parent.width - 32
                spacing: 8
                // Merge button — only enabled when both selected.
                Rectangle {
                    property bool _ready: _manageSpeakersPopup._sourceName.length > 0
                        && _manageSpeakersPopup._targetName.length > 0
                    width: 140
                    height: 32
                    radius: 6
                    color: _ready
                        ? (_mergeBtnMa.containsMouse ? Qt.lighter(th.ac, 1.2) : th.ac)
                        : Qt.rgba(0.3, 0.3, 0.3, 0.3)
                    border.color: _ready ? th.ac : th.bd
                    border.width: 1
                    Text {
                        anchors.centerIn: parent
                        text: "Merge"
                        color: parent._ready ? "#fff" : th.tm
                        font.pixelSize: 12
                        font.bold: true
                    }
                    MouseArea {
                        id: _mergeBtnMa
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: parent._ready ? Qt.PointingHandCursor : Qt.ArrowCursor
                        enabled: parent._ready
                        onClicked: {
                            if (!backend || !backend.speaker_merge) return
                            var src = _manageSpeakersPopup._sourceName
                            var tgt = _manageSpeakersPopup._targetName
                            var ok = backend.speaker_merge(src, tgt)
                            if (typeof toast !== "undefined") {
                                if (ok) {
                                    toast.show("Merged: " + src + " → " + tgt)
                                } else {
                                    toast.show("Merge failed", "error")
                                }
                            }
                            // Reset selection and refresh list.
                            _manageSpeakersPopup._sourceName = ""
                            _manageSpeakersPopup._targetName = ""
                            _manageSpeakersPopup._refresh()
                            // Also refresh the in-popup dots if
                            // they're visible.
                            if (typeof _spkRefreshTimer !== "undefined") {
                                _spkRefreshTimer.triggered()
                            }
                            // Close if no more merge candidates.
                            if (_manageSpeakersPopup._speakers.length < 2) {
                                _manageSpeakersPopup.close()
                            }
                        }
                    }
                }
                // Clear-selection button — visible when at least
                // one is selected.
                Rectangle {
                    visible: _manageSpeakersPopup._sourceName.length > 0
                        || _manageSpeakersPopup._targetName.length > 0
                    width: 100
                    height: 32
                    radius: 6
                    color: _clearBtnMa.containsMouse
                        ? Qt.lighter(th.sf, 1.7)
                        : "transparent"
                    border.color: th.bd
                    border.width: 1
                    Text {
                        anchors.centerIn: parent
                        text: "Clear"
                        color: th.tm
                        font.pixelSize: 12
                    }
                    MouseArea {
                        id: _clearBtnMa
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            _manageSpeakersPopup._sourceName = ""
                            _manageSpeakersPopup._targetName = ""
                        }
                    }
                }
                Item { width: 1; height: 1 }   // flex spacer
                // Done / close button.
                Rectangle {
                    width: 80
                    height: 32
                    radius: 6
                    color: _doneBtnMa.containsMouse
                        ? Qt.lighter(th.sf, 1.5)
                        : "transparent"
                    border.color: th.bd
                    border.width: 1
                    Text {
                        anchors.centerIn: parent
                        text: "Done"
                        color: th.tc
                        font.pixelSize: 12
                    }
                    MouseArea {
                        id: _doneBtnMa
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: _manageSpeakersPopup.close()
                    }
                }
            }
        }
    }

    // v0.1.263: muted-speaker enrollment offer popup. Shown when
    // a registered speaker speaks but is currently allowed=false
    // (their utterance gets the MUTED sentinel from the backend).
    //
    // Previous behavior (v0.1.119): just toast "Ignored (muted):
    // <name>" and close. The dead-end frustration was reported in
    // the v0.1.249 hardware test where Allison spoke 6+ times and
    // got silent rejection each time.
    //
    // New behavior: explain what happened, offer to allow them
    // going forward, or dismiss to keep them muted. Single tap to
    // unmute. The device owner can decide on the spot.
    Popup {
        id: _mutedEnrollPopup
        parent: Overlay.overlay
        anchors.centerIn: parent
        width: Math.min(root.width - 40, 380)
        height: _mutedEnrollCol.implicitHeight + 32
        modal: true
        dim: true

        property string _mutedName: ""

        background: Rectangle {
            color: th.sf
            radius: 12
            border.color: th.bd
            border.width: 1
        }

        Column {
            id: _mutedEnrollCol
            width: parent.width
            padding: 16
            spacing: 12

            Text {
                text: "Voice ignored: " + _mutedEnrollPopup._mutedName
                color: th.tc
                font.pixelSize: 14
                font.bold: true
            }

            Text {
                width: parent.width - 32
                text: _mutedEnrollPopup._mutedName
                    + " is registered but their voice commands are currently muted. "
                    + "Allow them to use voice commands?"
                color: th.tm
                font.pixelSize: 11
                wrapMode: Text.WordWrap
            }

            Row {
                width: parent.width - 32
                spacing: 8

                // Allow button (primary action).
                Rectangle {
                    width: (parent.width - 8) / 2
                    height: 32
                    radius: 6
                    color: _allowMa.containsMouse ? Qt.lighter(th.ac, 1.2) : th.ac
                    border.color: th.ac
                    border.width: 1
                    Text {
                        anchors.centerIn: parent
                        text: "Allow voice commands"
                        color: "#fff"
                        font.pixelSize: 11
                        font.bold: true
                        elide: Text.ElideRight
                        width: parent.width - 12
                        horizontalAlignment: Text.AlignHCenter
                    }
                    MouseArea {
                        id: _allowMa
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            if (backend && backend.speaker_set_allowed) {
                                var ok = backend.speaker_set_allowed(
                                    _mutedEnrollPopup._mutedName, true)
                                if (typeof toast !== "undefined") {
                                    if (ok) {
                                        toast.show(_mutedEnrollPopup._mutedName
                                            + " can now use voice commands")
                                    } else {
                                        toast.show("Couldn't update permissions", "error")
                                    }
                                }
                            }
                            _mutedEnrollPopup.close()
                            // Refresh dots if visible.
                            if (typeof _spkRefreshTimer !== "undefined") {
                                _spkRefreshTimer.triggered()
                            }
                        }
                    }
                }

                // Keep muted (dismiss).
                Rectangle {
                    width: (parent.width - 8) / 2
                    height: 32
                    radius: 6
                    color: _keepMutedMa.containsMouse
                        ? Qt.lighter(th.sf, 1.7) : "transparent"
                    border.color: th.bd
                    border.width: 1
                    Text {
                        anchors.centerIn: parent
                        text: "Keep muted"
                        color: th.tm
                        font.pixelSize: 11
                    }
                    MouseArea {
                        id: _keepMutedMa
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: _mutedEnrollPopup.close()
                    }
                }
            }
        }
    }

    // ═══ VOICE FAB — Floating Action Button ═══
    // Position: bottom-right, lifted above the bottom chrome.
    // Hidden while the popup is open (popup has its own controls).
    Rectangle {
        id: voiceFab
        visible: backend && backend.voice_available && backend.voice_available() && !voicePopup.visible && voicePopup.voiceMode > 0
        width: 56; height: 56; radius: 28
        anchors.right: parent.right; anchors.bottom: parent.bottom
        anchors.rightMargin: 16
        // v0.1.249: lift above bottom chrome. On terminal tab the
        // terminal toolbar (~46px) is the dominant element, so we
        // lift to 86px there. On browse, bottom chrome is tab bar
        // (48px) plus URL bar (50px when visible). Add ~16-24px
        // gap above for visual breathing room.
        anchors.bottomMargin: tabBar.currentIndex === 1
            ? 86
            : 48 + (topBar.visible ? 50 : 0) + 16
        Behavior on anchors.bottomMargin { NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }
        color: voicePopup.recording ? "#dc2626" : voicePopup.processing ? th.lh : th.ac
        z: 200
        Behavior on color { ColorAnimation { duration: 200 } }
        Behavior on scale { NumberAnimation { duration: 150; easing.type: Easing.OutBack } }
        scale: voiceFab._press ? 0.92 : (_voiceFabMa.containsMouse ? 1.06 : 1.0)
        property bool _press: false

        // Idle breathing animation
        SequentialAnimation on opacity {
            running: !voicePopup.recording && !voicePopup.processing && !voicePopup.visible
            loops: Animation.Infinite
            NumberAnimation { from: 0.7; to: 1.0; duration: 1500; easing.type: Easing.InOutQuad }
            NumberAnimation { from: 1.0; to: 0.7; duration: 1500; easing.type: Easing.InOutQuad }
        }

        // Recording pulse rings
        Rectangle {
            anchors.centerIn: parent; visible: voicePopup.recording
            width: parent.width; height: parent.height; radius: parent.radius
            color: "transparent"; border.color: "#dc2626"; border.width: 2
            SequentialAnimation on scale { running: voicePopup.recording; loops: Animation.Infinite
                NumberAnimation { from: 1.0; to: 1.6; duration: 800; easing.type: Easing.OutQuad }
                ScriptAction { script: { /* reset alpha */ } }
            }
            SequentialAnimation on opacity { running: voicePopup.recording; loops: Animation.Infinite
                NumberAnimation { from: 0.7; to: 0; duration: 800; easing.type: Easing.OutQuad }
                NumberAnimation { from: 0; to: 0; duration: 0 }
            }
        }

        Text { anchors.centerIn: parent
            text: voicePopup.processing ? "\u29D7" : voicePopup.recording ? "\u25A0" : "\uD83C\uDFA4"
            color: "#fff"; font.pixelSize: 22
            RotationAnimator on rotation { from: 0; to: 360; duration: 1200; loops: Animation.Infinite; running: voicePopup.processing }
        }

        MouseArea { id: _voiceFabMa; anchors.fill: parent
            hoverEnabled: true; cursorShape: Qt.PointingHandCursor
            onPressed: { voiceFab._press = true; if (backend && !voicePopup.recording) backend.voice_begin_capture() }
            onReleased: voiceFab._press = false
            onCanceled: voiceFab._press = false
            onClicked: voicePopup.startListening()
        }
    }

    // ═══ STOP-LISTENING BUTTON — appears next to FAB only while recording ═══
    Rectangle {
        id: voiceCancelFab
        visible: backend && voicePopup.recording && !voicePopup.visible
        width: 44; height: 44; radius: 22
        anchors.right: voiceFab.left; anchors.bottom: voiceFab.bottom
        anchors.rightMargin: 12
        anchors.bottomMargin: 6  // align centers
        color: th.bg2 ? th.bg2 : Qt.rgba(0.2, 0.2, 0.2, 0.95)
        border.color: th.bd; border.width: 1
        z: 200
        opacity: voicePopup.recording ? 1.0 : 0.0
        Behavior on opacity { NumberAnimation { duration: 180 } }
        scale: _voiceCancelFabMa.containsMouse ? 1.08 : 1.0
        Behavior on scale { NumberAnimation { duration: 150; easing.type: Easing.OutBack } }
        Text { anchors.centerIn: parent; text: "\u2715"; color: th.tc; font.pixelSize: 18 }
        MouseArea { id: _voiceCancelFabMa; anchors.fill: parent
            hoverEnabled: true; cursorShape: Qt.PointingHandCursor
            onClicked: {
                if (backend) backend.voice_cancel()
                voicePopup.recording = false
                voicePopup.processing = false
                voicePopup.close()
            }
        }
    }

    // ═══ TOAST ═══
    // Lightweight transient confirmation. Used for clipboard-copy
    // feedback after double-tap on terminal tokens, plus block-row
    // menu actions, voice intent dispatch, and startup probe results.
    // Auto-hides after 1500ms (info/success) or 2800ms (warning/error
    // — longer dwell since user needs to read).
    //
    // v0.1.151: severity variants. Previously toast was single-style
    // neutral. Now show(text, severity) accepts:
    //   - "info" (default — neutral dark fill, matches legacy callers)
    //   - "success" (green accent, used for confirmed actions)
    //   - "warning" (amber accent, used for "ok but check this" cases)
    //   - "error" (red accent, used for failed operations)
    // Existing call sites passing only `show(text)` keep working — the
    // severity defaults to "info" and they render exactly as before.
    Rectangle {
        id: toast
        anchors.bottom: parent.bottom; anchors.horizontalCenter: parent.horizontalCenter
        // v0.1.249: bottomMargin was a fixed 50 when there was only
        // the 48px tab bar at the bottom. With URL bar now also at
        // the bottom (v0.1.249), bottom chrome is up to 98px when
        // URL is visible. Bind margin to actual chrome height so
        // toast clears the URL bar without wasting space when the
        // bar is hidden on scroll.
        //
        // Math: tab bar is always ~48px (Layout.preferredHeight: 48).
        // URL bar is 50px when visible, 0 when hidden. Add 4px
        // clearance.
        anchors.bottomMargin: 48 + (topBar.visible ? 50 : 0) + 4
        z: 500
        opacity: 0
        Behavior on opacity { NumberAnimation { duration: 180; easing.type: Easing.OutQuad } }
        radius: 8

        // Current severity. Drives color + dwell time. Set by show().
        property string severity: "info"

        // Color per-severity. Background is the dark neutral panel with
        // a thin colored accent strip on the LEFT (4px) — same idea as
        // Material's snackbar action color, less visual noise than a
        // full-fill colored background. Border remains theme-bd so the
        // overall shape matches the rest of the UI.
        readonly property color _accent:
            severity === "success" ? "#7ddc7d"
          : severity === "warning" ? "#dcc97d"
          : severity === "error"   ? "#dc7d7d"
          :                          th.tm  // info — muted, no special pop

        color: Qt.rgba(0.1, 0.1, 0.12, 0.92)
        border.color: th.bd; border.width: 1
        width: _toastTxt.implicitWidth + 28 + (severity === "info" ? 0 : 4)
        height: _toastTxt.implicitHeight + 16
        visible: opacity > 0.01

        // Severity accent strip on the left edge. Width 0 for info
        // (legacy look) so existing callers see no visual change.
        Rectangle {
            visible: toast.severity !== "info"
            anchors.left: parent.left
            anchors.top: parent.top
            anchors.bottom: parent.bottom
            anchors.leftMargin: 1  // sit just inside the border
            anchors.topMargin: 1
            anchors.bottomMargin: 1
            width: 4
            radius: 2
            color: toast._accent
        }

        Text {
            id: _toastTxt
            anchors.centerIn: parent
            // Shift right by 4 to make room for the accent strip when
            // it's visible. Cancels out so info-mode text stays centered.
            anchors.horizontalCenterOffset: toast.severity === "info" ? 0 : 2
            text: ""
            color: "#f0f0f0"; font.pixelSize: 12
        }
        Timer { id: _toastTimer
            interval: toast.severity === "warning" || toast.severity === "error"
                      ? 2800 : 1500
            onTriggered: toast.opacity = 0
        }

        // Three-argument show() lets callers pick severity. Legacy
        // single-arg callers default to "info" and render identically
        // to the pre-v0.1.151 toast.
        function show(text, severity) {
            _toastTxt.text = text
            toast.severity = (severity !== undefined && severity !== "")
                             ? severity : "info"
            opacity = 1.0
            _toastTimer.restart()
        }
    }

    // ═══ WORKFLOW SUGGESTION TOAST ═══ (v0.1.406)
    //
    // Session arc — proactive suggestion. The backend emits
    // `workflow_suggestion_ready(name, cmds)` when a frequent
    // command combo crosses the suggestion threshold (3rd
    // match of a strong, non-destructive sequence). This is a
    // NON-MODAL, actionable toast: unlike the plain `toast`
    // (fire-and-forget message), this one has Save / Dismiss
    // affordances and dwells longer so the user can act.
    //
    // One-tap Save calls workflow_create_from_commands and
    // confirms via the plain toast. Dismiss just hides it.
    // Auto-hides after a generous dwell if ignored — the
    // backend dedups per session so we won't re-nag.
    Rectangle {
        id: workflowSuggestionToast
        anchors.bottom: parent.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        // Sit ABOVE the plain toast slot so the two never
        // overlap if both appear close together.
        anchors.bottomMargin: 48 + (topBar.visible ? 50 : 0) + 4 + 52
        z: 501
        opacity: 0
        visible: opacity > 0.01
        Behavior on opacity { NumberAnimation { duration: 200; easing.type: Easing.OutQuad } }
        radius: 8
        color: Qt.rgba(0.1, 0.1, 0.12, 0.95)
        border.color: th ? th.ac : "#7ddc7d"
        border.width: 1
        width: Math.min(root.width - 24, _wsContent.implicitWidth + 24)
        height: _wsContent.implicitHeight + 16

        // Payload for the pending suggestion.
        property string suggestName: ""
        property string suggestCmds: ""

        function present(name, cmds) {
            suggestName = name
            suggestCmds = cmds
            opacity = 1.0
            _wsTimer.restart()
        }
        function hide() {
            opacity = 0
        }

        // Accent strip on the left, matching the plain toast's
        // severity look (success-green family for "save").
        Rectangle {
            anchors.left: parent.left
            anchors.top: parent.top
            anchors.bottom: parent.bottom
            anchors.margins: 1
            width: 4
            radius: 2
            color: th ? th.ac : "#7ddc7d"
        }

        RowLayout {
            id: _wsContent
            anchors.centerIn: parent
            anchors.horizontalCenterOffset: 2
            spacing: 10

            Column {
                spacing: 1
                Text {
                    text: "Save this as a workflow?"
                    color: "#f0f0f0"
                    font.pixelSize: 12
                    font.bold: true
                }
                Text {
                    // Compact preview: first command + count hint.
                    text: {
                        var first = workflowSuggestionToast.suggestCmds.split("\n")[0] || ""
                        if (first.length > 34) first = first.substring(0, 32) + "…"
                        var n = workflowSuggestionToast.suggestCmds.split("\n").length
                        return first + (n > 1 ? "  +" + (n - 1) + " more" : "")
                    }
                    color: th ? th.tm : "#a0a0a0"
                    font.pixelSize: 10
                    font.family: "monospace"
                }
            }

            // Save button.
            Rectangle {
                Layout.preferredWidth: _wsSaveTxt.implicitWidth + 16
                Layout.preferredHeight: 24
                radius: 4
                color: _wsSaveMA.pressed ? Qt.darker(th ? th.ac : "#7ddc7d", 1.1)
                     : _wsSaveMA.containsMouse ? Qt.lighter(th ? th.ac : "#7ddc7d", 1.1)
                     : (th ? th.ac : "#7ddc7d")
                Text {
                    id: _wsSaveTxt
                    anchors.centerIn: parent
                    text: "Save"
                    color: "#10100c"
                    font.pixelSize: 11
                    font.bold: true
                }
                MouseArea {
                    id: _wsSaveMA
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: {
                        if (backend && backend.workflow_create_from_commands) {
                            var status = backend.workflow_create_from_commands(
                                workflowSuggestionToast.suggestName,
                                workflowSuggestionToast.suggestCmds)
                            // status is "ok:<name>" / "exists" / "err:<reason>"
                            if (typeof toast !== "undefined" && toast.show) {
                                if (status.indexOf("ok:") === 0) {
                                    toast.show("Saved workflow: " + status.substring(3), "success")
                                } else if (status === "exists") {
                                    // Route to the sessions-page save flow,
                                    // which offers an explicit overwrite link.
                                    toast.show("A workflow with that name exists", "warning")
                                } else {
                                    toast.show("Couldn't save workflow", "error")
                                }
                            }
                        }
                        workflowSuggestionToast.hide()
                    }
                }
            }

            // Dismiss (✕) button.
            Rectangle {
                Layout.preferredWidth: 22
                Layout.preferredHeight: 24
                radius: 4
                color: _wsDismissMA.containsMouse ? Qt.rgba(1,1,1,0.08) : "transparent"
                Text {
                    anchors.centerIn: parent
                    text: "✕"
                    color: th ? th.tm : "#a0a0a0"
                    font.pixelSize: 12
                }
                MouseArea {
                    id: _wsDismissMA
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: workflowSuggestionToast.hide()
                }
            }
        }

        // Generous dwell — a workflow suggestion is worth more
        // reading time than a status message. 8s, then fade.
        Timer {
            id: _wsTimer
            interval: 8000
            onTriggered: workflowSuggestionToast.hide()
        }
    }

    // React to the backend's proactive suggestion signal.
    Connections {
        target: backend
        function onWorkflow_suggestion_ready(name, cmds) {
            workflowSuggestionToast.present(name, cmds)
        }
    }

    // ═══ ASSIST BUBBLE ═══ (v0.1.666)
    // The single shared surfacing channel for active assists (debug→gdb
    // picker, slowness, session proposals). Transient, bottom-corner, never
    // furniture — the backend's BubbleScheduler gates it (anti-nag), so by
    // the time assist_bubble_ready fires we just show it. Carries a kind
    // (for dismiss/snooze), a title, and a tab-delimited options wire
    // ("label\tcommand" per line). Each option types its command (no
    // auto-run) via backend.assist_pick.
    Rectangle {
        id: assistBubble
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        anchors.rightMargin: 16
        anchors.bottomMargin: 48 + (topBar.visible ? 50 : 0) + 4
        z: 502
        opacity: 0
        visible: opacity > 0.01
        Behavior on opacity { NumberAnimation { duration: 180; easing.type: Easing.OutQuad } }
        radius: 8
        color: th ? th.sf : Qt.rgba(0.1, 0.1, 0.12, 0.97)
        border.color: th ? th.ac : "#e0a060"
        border.width: 1
        width: Math.min(root.width - 32, 360)
        height: _abContent.implicitHeight + 20

        property string bubbleKind: ""
        property string bubbleTitle: ""
        // model rows: { label, command }
        property var bubbleOptions: []

        function present(kind, title, optionsWire) {
            bubbleKind = kind
            bubbleTitle = title
            var rows = []
            if (optionsWire && optionsWire.length > 0) {
                var lines = optionsWire.split("\n")
                for (var i = 0; i < lines.length; i++) {
                    if (lines[i].length === 0) continue
                    var parts = lines[i].split("\t")
                    rows.push({ label: parts[0] || "",
                                command: parts.length > 1 ? parts[1] : "" })
                }
            }
            bubbleOptions = rows
            opacity = 1.0
            _abTimer.restart()
        }
        function hide() { opacity = 0 }

        // accent strip
        Rectangle {
            anchors.left: parent.left
            anchors.top: parent.top
            anchors.bottom: parent.bottom
            anchors.margins: 1
            width: 4
            radius: 2
            color: th ? th.ac : "#e0a060"
        }

        Column {
            id: _abContent
            anchors.fill: parent
            anchors.leftMargin: 14
            anchors.rightMargin: 10
            anchors.topMargin: 10
            anchors.bottomMargin: 10
            spacing: 8

            RowLayout {
                width: parent.width
                spacing: 8
                Text {
                    Layout.fillWidth: true
                    text: assistBubble.bubbleTitle
                    color: th ? th.tc : "#e8e8e8"
                    font.pixelSize: 13
                    font.bold: true
                    elide: Text.ElideRight
                }
                // "don't show this kind"
                Text {
                    text: "✕"
                    color: th ? th.tm : "#888"
                    font.pixelSize: 13
                    MouseArea {
                        anchors.fill: parent
                        anchors.margins: -6
                        onClicked: {
                            backend.assist_dismiss(assistBubble.bubbleKind)
                            assistBubble.hide()
                        }
                    }
                }
            }

            // option buttons — each types its command (no auto-run)
            Repeater {
                model: assistBubble.bubbleOptions
                Rectangle {
                    width: _abContent.width
                    height: 30
                    radius: 5
                    color: _abOptMouse.containsMouse
                        ? (th ? th.bb : "#3a3a44") : (th ? th.ib : "#2a2a32")
                    border.color: th ? th.bd : "#444"
                    border.width: 1
                    Text {
                        anchors.left: parent.left
                        anchors.leftMargin: 10
                        anchors.verticalCenter: parent.verticalCenter
                        width: parent.width - 20
                        text: modelData.label
                        color: th ? th.tc : "#e8e8e8"
                        font.pixelSize: 12
                        elide: Text.ElideRight
                    }
                    MouseArea {
                        id: _abOptMouse
                        anchors.fill: parent
                        hoverEnabled: true
                        onClicked: {
                            backend.assist_pick(assistBubble.bubbleKind,
                                                modelData.command)
                            assistBubble.hide()
                        }
                    }
                }
            }

            // "don't show this kind again" affordance
            Text {
                text: "don't show this again"
                color: th ? th.tm : "#888"
                font.pixelSize: 11
                font.underline: _abSnoozeMouse.containsMouse
                MouseArea {
                    id: _abSnoozeMouse
                    anchors.fill: parent
                    anchors.margins: -4
                    hoverEnabled: true
                    onClicked: {
                        backend.assist_snooze(assistBubble.bubbleKind)
                        assistBubble.hide()
                    }
                }
            }
        }

        // auto-dismiss after a dwell; backend dedups so no re-nag
        Timer {
            id: _abTimer
            interval: 12000
            onTriggered: {
                backend.assist_dismiss(assistBubble.bubbleKind)
                assistBubble.hide()
            }
        }
    }

    Connections {
        target: backend
        function onAssist_bubble_ready(kind, title, options) {
            assistBubble.present(kind, title, options)
        }
    }

    // v0.1.677: the open-hook — backend.open_note_editor() reads the current
    // .md and emits this; we present the editor with the file + completion
    // data. This is what makes the editor reachable.
    Connections {
        target: backend
        function onOpen_note_editor_ready(text, path, paths, notes, history) {
            noteEditor.present(text, path, paths, notes, history)
        }
    }

    // ═══ NOTE EDITOR — WYSIWYG blend (v0.1.672) ═══
    //
    // Live-preview note editor where ZBrackets come alive: the line the
    // cursor is on shows RAW markdown source (edit [[name]] syntax); every
    // other line RENDERS with ZBracket links live. Typing `[[` opens an
    // autocomplete dropdown (context-aware: local files + graph neighbors +
    // history). Picking inserts the link; clicking a rendered link routes via
    // classify_note_link (note→open, pdf→doc pane, url→browser).
    //
    // Backend pieces used: zb_editing_context, note_completions,
    // accept_zb_completion, render_note_zbrackets, classify_note_link.
    // NOTE: this widget's runtime behavior (rendering, focus, dropdown
    // placement) needs the aarch64 build to verify — the backend logic it
    // calls is unit-tested.
    Rectangle {
        id: noteEditor
        anchors.fill: parent
        z: 600
        visible: open
        color: th ? th.bg : "#16161a"

        property bool open: false
        // the note's raw markdown (source of truth)
        property string docText: ""
        // path of the note being edited (for link resolution)
        property string docPath: ""
        // '\n'-joined known note paths + "name\tmd" notes + history wires,
        // supplied by the host when opening (for completions/graph).
        property string knownPaths: ""
        property string knownNotes: ""
        property string histWire: ""
        // active line (raw) index, from zb_editing_context
        property int activeLine: 0
        // completion dropdown state
        property bool showCompletions: false
        property var completions: []
        // v0.1.721: selected completion row for arrow-key navigation.
        property int _completionIndex: 0
        // v0.1.689: live per-block blend state. _blocks drives the Repeater;
        // exactly one has active=true (the raw-editable block). _activeIdx is
        // its index; _activeLocalCursor is the caret offset WITHIN that block.
        property var _blocks: []
        property int _activeIdx: 0
        property int _activeLocalCursor: 0
        // v0.1.690 (feat 3): highlighted HTML of the active block's raw text,
        // shown behind the transparent editor for syntax coloring.
        property string _activeHighlight: ""
        // v0.1.691 (feat 5): typewriter mode — smooth-scroll the editor so the
        // active block stays framed. Toggle with the ⌨ button in the header.
        property bool typewriter: false
        // (feat 3) spring feel preset: "cinematic" (loose, filmic) or "tight"
        // (snappier). Shift+click the ⌨ toggle cycles it.
        property string _twPreset: "cinematic"
        property real _twSpring: _twPreset === "tight" ? 5.0 : 3.0
        property real _twDamping: _twPreset === "tight" ? 0.6 : 0.45
        // (feat 1) syntax-overlay toggle. If alignment ever drifts on a
        // platform, this can be flipped off to fall back to plain editing.
        property bool overlay: true

        function present(text, path, paths, notes, hist) {
            docText = text; docPath = path
            knownPaths = paths || ""; knownNotes = notes || ""; histWire = hist || ""
            open = true
            _activeLocalCursor = 0
            if (backend.editor_undo_init) backend.editor_undo_init(text, text.length)
            _resegment(text.length)
            _refreshContext(text.length)
            _refreshTicks()
            _refreshOutline()
            _refreshBacklinks()
        }
        function close() { open = false; showCompletions = false }

        // recompute active line + completion state for a cursor position
        function _refreshContext(cursor) {
            var ctx = backend.zb_editing_context(docText, cursor).split("\t")
            activeLine = parseInt(ctx[3] || "0")
            var inLink = (ctx[0] === "true")
            if (inLink) {
                var partial = ctx[1] || ""
                var wire = backend.note_completions(partial,
                    _noteName(docPath), docPath, knownPaths, knownNotes, histWire)
                var rows = []
                if (wire.length > 0) {
                    var lines = wire.split("\n")
                    for (var i = 0; i < lines.length; i++) {
                        if (lines[i].length === 0) continue
                        var p = lines[i].split("\t")
                        rows.push({ text: p[0], kind: p[1] || "" })
                    }
                }
                completions = rows
                showCompletions = rows.length > 0
                _completionIndex = 0
            } else {
                showCompletions = false
            }
        }
        function _noteName(path) {
            var base = path.split("/").pop()
            var dot = base.lastIndexOf(".")
            return dot > 0 ? base.substring(0, dot) : base
        }
        function _acceptCompletion(chosen, cursor) {
            var res = backend.accept_zb_completion(docText, cursor, chosen).split("\t")
            var newCursor = parseInt(res[0] || "0")
            // res[0] is cursor, the REST (may contain tabs/newlines) is the text
            docText = res.slice(1).join("\t")
            showCompletions = false
            _resegment(newCursor)
            _refreshContext(newCursor)
        }

        // v0.1.689: rebuild _blocks from docText, marking the block that
        // contains the GLOBAL cursor offset as active.
        function _resegment(globalCursor) {
            var wire = backend.note_blend_blocks(docText, globalCursor)
            var blocks = []
            var activeIdx = 0
            if (wire.length > 0) {
                var lines = wire.split("\n")
                for (var i = 0; i < lines.length; i++) {
                    if (lines[i].length === 0) continue
                    var p = lines[i].split("\t")
                    // start,end,kind,active,raw  (raw has \n escaped)
                    var raw = (p[4] || "").replace(/\\n/g, "\n")
                    var blk = { start: parseInt(p[0] || "0"),
                                end: parseInt(p[1] || "0"),
                                kind: p[2] || "p",
                                active: (p[3] === "true"),
                                raw: raw }
                    if (blk.active) activeIdx = blocks.length
                    blocks.push(blk)
                }
            }
            if (blocks.length === 0) {
                blocks.push({ start: 0, end: 0, kind: "p", active: true, raw: docText })
                activeIdx = 0
            }
            _blocks = blocks
            _activeIdx = activeIdx
            // (feat 3) refresh the syntax overlay for the new active block
            if (blocks[activeIdx]) _updateHighlight(blocks[activeIdx].raw)
            // (feat 5) reframe on the block-change event (event-driven)
            _typewriterReframe()
        }

        // (feat 3) recompute the highlight HTML for the active raw text
        function _updateHighlight(rawText) {
            _activeHighlight = backend.render_active_highlight(rawText, "")
        }

        // (feat 2) undo/redo: restore a snapshot from the backend history,
        // re-segment, and place the caret. Wire = "cursor\tdoc".
        function _applyHistory(wire) {
            if (!wire || wire.length === 0) return
            var tab = wire.indexOf("\t")
            if (tab < 0) return
            var cur = parseInt(wire.substring(0, tab) || "0")
            var doc = wire.substring(tab + 1)
            docText = doc
            _activeLocalCursor = 0
            _resegment(cur)
            _refreshContext(cur)
            _refreshTicks()
        }
        function _undo() { if (backend.editor_undo) _applyHistory(backend.editor_undo()) }
        function _redo() { if (backend.editor_redo) _applyHistory(backend.editor_redo()) }

        // (feat 2 + mic-on-new-section idea) voice dictation INTO the editor.
        // _dictating is armed by a section's mic button; when a freeform
        // transcription arrives while open+armed, insert it at the caret of
        // the active block and record it as ONE labeled voice undo unit.
        property bool _dictating: false
        // (feat 3) visual undo timeline: ticks = [{label, cur}] from the
        // backend history; refreshed after every history change.
        property var _undoTicks: []
        property bool _undoRailOpen: false
        // (feat 4) when non-empty, a read-only preview of a peeked history
        // state shown over the editor body (rail scrub-preview).
        property string _previewDoc: ""
        // (codemap) document outline: [{level,title,line}]. Pops open for voice
        // navigation ("jump to <section>") and is togglable from the header.
        property var _outline: []
        property bool _codemapOpen: false
        // v0.1.723: backlinks ("what links here") — [{path,display}]; toggled
        // from the header (🔗). Refreshed on open + on save.
        property var _backlinks: []
        property bool _backlinksOpen: false
        function _refreshBacklinks() {
            if (!backend || !backend.note_backlinks) { _backlinks = []; return }
            var wire = backend.note_backlinks(docPath)
            var rows = []
            if (wire.length > 0) {
                var lines = wire.split("\n")
                for (var i = 0; i < lines.length; i++) {
                    var p = lines[i].split("\t")
                    if (p.length >= 2) rows.push({ path: p[0], display: p[1] })
                }
            }
            _backlinks = rows
        }
        // (codemap live-follow) index of the outline entry the caret is in
        property int _activeSection: -1
        function _updateActiveSection() {
            if (_outline.length === 0) { _activeSection = -1; return }
            var blk = _blocks[_activeIdx]
            if (!blk) return
            var localText = blk.raw.substring(0, _activeLocalCursor)
            var localLine = (localText.match(/\n/g) || []).length
            var gLine = blk.start + localLine
            if (backend.outline_active_section)
                _activeSection = backend.outline_active_section(docText, gLine)
        }
        function _refreshOutline() {
            var wire = backend.note_outline ? backend.note_outline(docText) : ""
            var rows = []
            if (wire.length > 0) {
                var lines = wire.split("\n")
                for (var i = 0; i < lines.length; i++) {
                    var p = lines[i].split("\t")
                    if (p.length >= 3)
                        rows.push({ level: parseInt(p[0] || "0"), title: p[1], line: parseInt(p[2] || "0") })
                }
            }
            _outline = rows
        }
        // jump the caret/active block to a document line (codemap click/voice)
        function _jumpToLine(line) {
            var off = parseInt(backend.editor_line_offset(docText, line))
            _activeLocalCursor = 0
            _resegment(off)
            _refreshContext(off)
            if (typewriter) _typewriterReframe()
        }
        function _refreshTicks() {
            var wire = backend.editor_undo_ticks ? backend.editor_undo_ticks() : ""
            var rows = []
            if (wire.length > 0) {
                var lines = wire.split("\n")
                for (var i = 0; i < lines.length; i++) {
                    var bar = lines[i].lastIndexOf("|")
                    if (bar < 0) continue
                    rows.push({ label: lines[i].substring(0, bar),
                                cur: lines[i].substring(bar + 1) === "1",
                                idx: i })
                }
            }
            _undoTicks = rows
        }
        // (feat 1) extract resolved image srcs from a block's raw markdown
        // (file:// for relative). Used to decide collage vs inline.
        function _imagesIn(raw) {
            var out = []
            var re = /!\[[^\]]*\]\(([^)]+)\)/g
            var m
            while ((m = re.exec(raw)) !== null) {
                var src = m[1].trim()
                if (!/^(https?|file|data):/.test(src)) {
                    var dir = docPath.lastIndexOf("/") >= 0
                        ? docPath.substring(0, docPath.lastIndexOf("/")) : ""
                    src = "file://" + (dir.length ? dir + "/" : "") + src
                }
                out.push(src)
            }
            return out
        }
        function _insertDictation(spoken) {
            if (!spoken || spoken.length === 0) return
            var blk = _blocks[_activeIdx]
            var base = blk ? _blockBaseOffset(blk) : 0
            var at = base + _activeLocalCursor
            // insert into docText at the global caret, with a leading space if
            // we're mid-text and not already on whitespace
            var before = docText.substring(0, at)
            var after = docText.substring(at)
            var sep = (before.length > 0 && !/\s$/.test(before)) ? " " : ""
            var ins = sep + spoken
            docText = before + ins + after
            var newCur = at + ins.length
            // record as one voice unit (labeled with the utterance)
            if (backend.editor_undo_record_voice)
                backend.editor_undo_record_voice(docText, newCur, spoken)
            _activeLocalCursor = 0
            _resegment(newCur)
            _refreshContext(newCur)
            _refreshTicks()
            _dictating = false
        }
        // (feat 3) append a fresh blank section at the end and arm its mic so
        // you can voice-build it. If the doc doesn't end in a blank line, add
        // the separation first.
        function _newSection() {
            var sep = docText.length === 0 ? "" : (docText.endsWith("\n\n") ? "" : (docText.endsWith("\n") ? "\n" : "\n\n"))
            docText = docText + sep
            var cur = docText.length
            if (backend.editor_undo_record)
                backend.editor_undo_record(docText, cur, "")
            _activeLocalCursor = 0
            _resegment(cur)
            _refreshContext(cur)
            _refreshTicks()
            _dictating = true
            _beginListening()
        }
        // arm dictation for a given block (mic button), then request listening.
        function _armDictation(blockIdx) {
            if (blockIdx >= 0) _activateBlock(blockIdx)
            _dictating = true
            _beginListening()
        }
        // v0.1.860: actually start the listener for editor dictation. Previously
        // _armDictation/_newSection called a non-existent start_listening(), so the
        // mic button armed _dictating but nothing ever captured audio. Mirror the
        // palette mic: reuse the proven async listen path, poll for the transcript,
        // and insert it at the caret (one utterance per tap; _insertDictation
        // clears _dictating). The voice popup's _dictating branch still works as a
        // secondary path if dictation is driven that way instead.
        function _beginListening() {
            if (!(backend && backend.voice_listen_dual_async)) return
            backend.voice_listen_dual_async()
            _dictPoll.restart()
        }
        Timer {
            id: _dictPoll
            interval: 150; repeat: true
            onTriggered: {
                if (!backend || !backend.dictation_poll || !noteEditor._dictating || !noteEditor.open) {
                    stop(); return
                }
                var t = backend.dictation_poll()
                if (t && t.length > 0) {
                    noteEditor._insertDictation(t)   // clears _dictating
                    stop()
                } else if (backend.voice_listen_dual_running && !backend.voice_listen_dual_running()) {
                    stop(); noteEditor._dictating = false
                }
            }
        }

        // (nav idea) swing focus out of the block buffer back into the dock
        // (the header row). Deactivates the editing block; the header's done
        // control takes focus so keyboard users land somewhere sensible.
        function _escapeToDock() {
            showCompletions = false
            if (typeof _dockDone !== "undefined") _dockDone.forceActiveFocus()
        }

        // (feat 1) activate an adjacent block; toEnd=true places the caret at
        // its end (came from below via Up), else at its start (came via Down).
        function _activateAdjacent(idx, toEnd) {
            if (idx < 0 || idx >= _blocks.length) return
            var blk = _blocks[idx]
            _activeLocalCursor = toEnd ? blk.raw.length : 0
            _resegment(_blockBaseOffset(blk) + _activeLocalCursor)
        }

        // (feat 5, v0.1.692 — EVENT-DRIVEN per the camera-pan guidance) No
        // polling timer. On cursor/edit events we compute a TARGET scroll-top
        // and let the SpringAnimation on _editFlick.contentY interpolate (it
        // retains in-flight motion and re-targets with a constraint-satisfying
        // lerp — cinematic, no constant per-frame JS work). A large jump
        // (typewriter_last_cut) snaps instead of dollying.
        // (feat 1) measured line height from FontMetrics — no hardcoded 19px.
        FontMetrics { id: _editFm; font.family: "monospace"; font.pixelSize: 14 }

        function _typewriterReframe() {
            if (!typewriter || !open) return
            var blk = _blocks[_activeIdx]
            if (!blk) return
            var localText = blk.raw.substring(0, _activeLocalCursor)
            var localLine = (localText.match(/\n/g) || []).length
            var gLine = blk.start + localLine
            var lineH = _editFm.height > 0 ? _editFm.height : 19
            var vh = _editFlick.height
            var top = backend.typewriter_frame_target(gLine, lineH, vh,
                          _editFlick.contentHeight, _editFlick.contentY)
            if (top < 0) return  // hold (deadband)
            if (backend.typewriter_last_cut()) {
                _twAnimate = false       // snap
                _editFlick.contentY = top
                _twAnimate = true
            } else {
                _editFlick.contentY = top  // Behavior animates the lerp
            }
        }
        // guards the Behavior so cuts can bypass the animation
        property bool _twAnimate: true

        // global byte offset of a block's first line, via the backend
        function _blockBaseOffset(blk) {
            return parseInt(backend.editor_line_offset(docText, blk.start))
        }

        // render an inactive block to RichText (with smart image sizing:
        // pass the doc length + total image count so the heuristic can pick
        // medium/large/collage widths).
        function _renderBlock(blk) {
            return backend.render_blend_block(blk.raw, blk.kind, docPath, knownPaths,
                                              docText.length, _imageCount())
        }
        // count ![..](..) image links in the whole doc (cheap; drives sizing)
        function _imageCount() {
            var m = docText.match(/!\[[^\]]*\]\(/g)
            return m ? m.length : 0
        }

        // user clicked an inactive block → make it the active (raw) one
        function _activateBlock(idx) {
            if (idx < 0 || idx >= _blocks.length) return
            var blk = _blocks[idx]
            _activeLocalCursor = 0
            _resegment(_blockBaseOffset(blk))
        }

        // the active block's TextEdit changed → splice back into docText,
        // recompute the global cursor, and re-derive context (NOT a full
        // re-segment on every keystroke — that would steal focus; we only
        // re-segment when the active block CHANGES, on cursor move/click).
        function _spliceActive(blk, newText, localCursor) {
            docText = backend.editor_splice_block(docText, blk.start, blk.end, newText)
            _activeLocalCursor = localCursor
            // The edit may have changed the active block's line count; update
            // its end so the NEXT splice replaces the right range (we don't
            // full-resegment per keystroke to avoid stealing focus). end =
            // start + (number of lines in newText).
            var nLines = newText.split("\n").length
            blk.end = blk.start + nLines
            blk.raw = newText
            _refreshContext(_blockBaseOffset(blk) + localCursor)
        }

        Column {
            anchors.fill: parent
            anchors.margins: 14
            spacing: 8

            // header
            RowLayout {
                width: parent.width
                Text {
                    Layout.fillWidth: true
                    text: noteEditor._noteName(noteEditor.docPath) || "untitled"
                    color: th ? th.tc : "#eee"
                    font.pixelSize: 15; font.bold: true
                }
                // (codemap) outline toggle
                Text {
                    text: "\uD83D\uDDFA"  // 🗺
                    color: noteEditor._codemapOpen ? (th ? th.ac : "#7ddc7d")
                                                   : (th ? th.tm : "#888")
                    font.pixelSize: 15
                    rightPadding: 14
                    MouseArea { anchors.fill: parent; anchors.margins: -6
                        onClicked: {
                            noteEditor._codemapOpen = !noteEditor._codemapOpen
                            if (noteEditor._codemapOpen) {
                                noteEditor._refreshOutline()
                                noteEditor._updateActiveSection()
                            }
                        } }
                }
                // v0.1.723: backlinks ("what links here") toggle
                Text {
                    text: "\uD83D\uDD17"  // 🔗
                    color: noteEditor._backlinksOpen ? (th ? th.ac : "#7ddc7d")
                                                     : (th ? th.tm : "#888")
                    font.pixelSize: 14
                    rightPadding: 14
                    MouseArea { anchors.fill: parent; anchors.margins: -6
                        onClicked: {
                            noteEditor._backlinksOpen = !noteEditor._backlinksOpen
                            if (noteEditor._backlinksOpen) noteEditor._refreshBacklinks()
                        } }
                }
                // (feat 3) undo timeline rail toggle
                Text {
                    text: "\u21B6"  // ↶ history
                    color: noteEditor._undoRailOpen ? (th ? th.ac : "#7ddc7d")
                                                     : (th ? th.tm : "#888")
                    font.pixelSize: 16
                    rightPadding: 14
                    MouseArea { anchors.fill: parent; anchors.margins: -6
                        onClicked: {
                            noteEditor._undoRailOpen = !noteEditor._undoRailOpen
                            if (noteEditor._undoRailOpen) noteEditor._refreshTicks()
                        } }
                }
                // (feat 5) typewriter-mode toggle
                Text {
                    text: "\u2328"  // ⌨
                    color: noteEditor.typewriter ? (th ? th.ac : "#7ddc7d")
                                                 : (th ? th.tm : "#888")
                    font.pixelSize: 16
                    rightPadding: 14
                    MouseArea { anchors.fill: parent; anchors.margins: -6
                        onClicked: function(mouse) {
                            if (mouse.modifiers & Qt.ShiftModifier) {
                                // (feat 3) cycle the spring feel preset
                                noteEditor._twPreset = (noteEditor._twPreset === "cinematic")
                                    ? "tight" : "cinematic"
                            } else {
                                noteEditor.typewriter = !noteEditor.typewriter
                                if (noteEditor.typewriter) noteEditor._typewriterReframe()
                            }
                        } }
                }
                Text {
                    id: _dockDone
                    text: "done"
                    color: (th ? th.ac : "#7ddc7d")
                    font.pixelSize: 13
                    font.underline: activeFocus
                    focus: false
                    Keys.onPressed: function(e) {
                        // dock focus: Enter = done; Down/Escape returns to the
                        // buffer (swing back into the first block).
                        if (e.key === Qt.Key_Return || e.key === Qt.Key_Enter) {
                            if (backend && backend.save_note && noteEditor.docPath.length > 0)
                                backend.save_note(noteEditor.docPath, noteEditor.docText)
                            noteEditor.close(); e.accepted = true
                        } else if (e.key === Qt.Key_Down) {
                            noteEditor._activateAdjacent(0, false); e.accepted = true
                        }
                    }
                    MouseArea { anchors.fill: parent; anchors.margins: -6
                        onClicked: {
                            // v0.1.686: persist edits before closing (was
                            // discarding the buffer — "did not save on done").
                            if (backend && backend.save_note && noteEditor.docPath.length > 0) {
                                backend.save_note(noteEditor.docPath, noteEditor.docText)
                            }
                            noteEditor.close()
                        } }
                }
            }

            // v0.1.689: live per-block WYSIWYG blend. The document is
            // segmented into blocks (note_blend_blocks); the block under the
            // cursor stays a raw editable TextEdit, every other block renders
            // (render_blend_block → RichText) and updates live as you move
            // between blocks. A single master docText is the source of truth;
            // editing the active block splices back via editor_splice_block.
            //
            // _blocks: [{start,end,kind,active,raw}], _activeIdx: index of the
            // raw-editable block. _resegment() rebuilds from docText + a
            // global cursor offset.
            Flickable {
                id: _editFlick
                width: parent.width
                height: parent.height - 60
                contentHeight: _blendCol.implicitHeight
                clip: true
                // (feat 5, event-driven) cinematic interpolation of the
                // typewriter scroll. SpringAnimation retains in-flight motion
                // and re-targets smoothly when contentY's target changes
                // mid-animation. Disabled (_twAnimate=false) for cuts so a big
                // jump snaps. Only active in typewriter mode.
                Behavior on contentY {
                    enabled: noteEditor.typewriter && noteEditor._twAnimate
                    SpringAnimation {
                        spring: noteEditor._twSpring
                        damping: noteEditor._twDamping
                        epsilon: 0.25
                    }
                }

                Column {
                    id: _blendCol
                    width: parent.width
                    spacing: 2

                    Repeater {
                        id: _blockRep
                        model: noteEditor._blocks

                        // Each block: active → editable (raw, with syntax
                        // overlay + accent); inactive → rendered RichText.
                        Loader {
                            width: _blendCol.width
                            sourceComponent: modelData.active ? _activeBlock : _renderedBlock

                            property var blk: modelData
                            property int blkIndex: index

                            Component {
                                id: _activeBlock
                                // v0.1.690 (feat 2): accent the editable block
                                // — left border + faint tint so it's obvious
                                // which block is "hot."
                                Rectangle {
                                    width: parent.width
                                    implicitHeight: _activeEdit.implicitHeight + 8
                                    color: th ? Qt.rgba(th.ac.r, th.ac.g, th.ac.b, 0.06) : "#1d2430"
                                    Rectangle {  // left accent bar
                                        width: 2; height: parent.height
                                        color: th ? th.ac : "#7ddc7d"
                                    }
                                    // (feat 3 + feat 1) highlighted text BEHIND,
                                    // exactly aligned with the transparent editor
                                    // on top. Same font family/size/wrap AND same
                                    // padding + lineHeight so glyphs register
                                    // 1:1. Hidden when overlay is toggled off.
                                    Text {
                                        id: _hlOverlay
                                        visible: noteEditor.overlay
                                        x: 8; y: 4
                                        width: parent.width - 12
                                        text: noteEditor._activeHighlight
                                        textFormat: Text.RichText
                                        font.family: "monospace"
                                        font.pixelSize: 14
                                        lineHeight: 1.0
                                        wrapMode: Text.Wrap
                                        color: th ? th.tc : "#e8e8e8"
                                    }
                                    TextEdit {
                                        id: _activeEdit
                                        x: 8; y: 4
                                        width: parent.width - 12
                                        text: blk.raw
                                        // overlay ON → transparent glyphs (the
                                        // colored Text behind shows through);
                                        // overlay OFF → normal text color.
                                        color: noteEditor.overlay ? "transparent"
                                                                  : (th ? th.tc : "#e8e8e8")
                                        selectionColor: th ? Qt.rgba(th.ac.r, th.ac.g, th.ac.b, 0.3) : "#335"
                                        font.family: "monospace"
                                        font.pixelSize: 14
                                        selectByMouse: true
                                        wrapMode: TextEdit.Wrap
                                        textFormat: TextEdit.PlainText
                                        cursorVisible: true
                                        // match the overlay's box model exactly
                                        topPadding: 0; leftPadding: 0
                                        Component.onCompleted: {
                                            forceActiveFocus()
                                            cursorPosition = Math.min(noteEditor._activeLocalCursor, text.length)
                                            noteEditor._updateHighlight(text)
                                        }
                                        onTextChanged: {
                                            if (text !== blk.raw) {
                                                // detect the inserted char (if a single-char insert)
                                                var ins = ""
                                                if (text.length === blk.raw.length + 1) {
                                                    var cp = Math.max(0, cursorPosition - 1)
                                                    ins = text.charAt(cp)
                                                }
                                                noteEditor._spliceActive(blk, text, cursorPosition)
                                                // record into undo history (full doc snapshot)
                                                if (backend.editor_undo_record) {
                                                    backend.editor_undo_record(noteEditor.docText,
                                                        noteEditor._blockBaseOffset(blk) + cursorPosition, ins)
                                                    noteEditor._refreshTicks()
                                                }
                                            }
                                            noteEditor._updateHighlight(text)
                                        }
                                        onCursorPositionChanged: {
                                            noteEditor._activeLocalCursor = cursorPosition
                                            noteEditor._refreshContext(
                                                noteEditor._blockBaseOffset(blk) + cursorPosition)
                                            noteEditor._typewriterReframe()
                                            if (noteEditor._codemapOpen) noteEditor._updateActiveSection()
                                        }
                                        Keys.onPressed: function(e) {
                                            // (feat 2) undo / redo
                                            if ((e.modifiers & Qt.ControlModifier)
                                                && e.key === Qt.Key_Z) {
                                                if (e.modifiers & Qt.ShiftModifier) noteEditor._redo()
                                                else noteEditor._undo()
                                                e.accepted = true
                                                return
                                            }
                                            if ((e.modifiers & Qt.ControlModifier)
                                                && e.key === Qt.Key_Y) {
                                                noteEditor._redo(); e.accepted = true; return
                                            }
                                            // v0.1.721: completion keyboard nav.
                                            // Up/Down move the selection, Enter/
                                            // Tab accept the SELECTED row (was
                                            // always [0]), Escape dismisses.
                                            if (noteEditor.showCompletions && noteEditor.completions.length > 0) {
                                                if (e.key === Qt.Key_Down) {
                                                    noteEditor._completionIndex =
                                                        (noteEditor._completionIndex + 1) % noteEditor.completions.length
                                                    e.accepted = true; return
                                                }
                                                if (e.key === Qt.Key_Up) {
                                                    noteEditor._completionIndex =
                                                        (noteEditor._completionIndex - 1 + noteEditor.completions.length)
                                                        % noteEditor.completions.length
                                                    e.accepted = true; return
                                                }
                                                if (e.key === Qt.Key_Return || e.key === Qt.Key_Enter || e.key === Qt.Key_Tab) {
                                                    var idx = Math.max(0, Math.min(noteEditor._completionIndex,
                                                                                   noteEditor.completions.length - 1))
                                                    noteEditor._acceptCompletion(noteEditor.completions[idx].text,
                                                        noteEditor._blockBaseOffset(blk) + cursorPosition)
                                                    e.accepted = true
                                                    return
                                                }
                                            }
                                            if (e.key === Qt.Key_Escape) {
                                                if (noteEditor.showCompletions) {
                                                    noteEditor.showCompletions = false
                                                } else {
                                                    // escape out → back into the dock (header)
                                                    noteEditor._escapeToDock()
                                                }
                                                e.accepted = true
                                                return
                                            }
                                            // (feat 2) block-aware Enter: continue
                                            // lists / increment ordered markers;
                                            // empty item exits the list.
                                            if ((e.key === Qt.Key_Return || e.key === Qt.Key_Enter)
                                                && !(e.modifiers & Qt.ShiftModifier)) {
                                                var ls = text.lastIndexOf("\n", Math.max(0, cursorPosition - 1)) + 1
                                                var le = text.indexOf("\n", cursorPosition)
                                                if (le === -1) le = text.length
                                                var curLine = text.substring(ls, le)
                                                var act = backend.editor_enter_action(curLine).split("\t")
                                                var insert = (act[0] || "\n").replace(/\\n/g, "\n")
                                                var clearMarker = (act[1] === "true")
                                                if (clearMarker) {
                                                    // empty list item → drop the marker (clear the line),
                                                    // leaving a blank line + caret there.
                                                    var before = text.substring(0, ls)
                                                    var after = text.substring(le)
                                                    text = before + after
                                                    cursorPosition = ls
                                                    e.accepted = true
                                                    return
                                                } else if (insert !== "\n") {
                                                    var b = text.substring(0, cursorPosition)
                                                    var a = text.substring(cursorPosition)
                                                    text = b + insert + a
                                                    cursorPosition = b.length + insert.length
                                                    e.accepted = true
                                                    return
                                                }
                                                // plain newline falls through to default
                                            }
                                            // (feat 1 + nav) caret continuity +
                                            // escape-to-dock at the ends: Up on
                                            // the first block (or Down on the
                                            // last) swings focus back into the
                                            // dock instead of dead-ending.
                                            var atFirstLine = (text.lastIndexOf("\n", Math.max(0, cursorPosition - 1)) === -1)
                                            var lastNl = text.lastIndexOf("\n")
                                            var atLastLine = (cursorPosition > lastNl)
                                            if (e.key === Qt.Key_Up && atFirstLine) {
                                                if (noteEditor._activeIdx > 0) {
                                                    noteEditor._activateAdjacent(noteEditor._activeIdx - 1, true)
                                                } else {
                                                    noteEditor._escapeToDock()  // top → dock
                                                }
                                                e.accepted = true
                                            } else if (e.key === Qt.Key_Down && atLastLine) {
                                                if (noteEditor._activeIdx < noteEditor._blocks.length - 1) {
                                                    noteEditor._activateAdjacent(noteEditor._activeIdx + 1, false)
                                                } else {
                                                    noteEditor._escapeToDock()  // bottom → dock
                                                }
                                                e.accepted = true
                                            }
                                        }
                                    }
                                }
                            }
                            Component {
                                id: _renderedBlock
                                Loader {
                                    width: parent.width
                                    property var imgs: noteEditor._imagesIn(blk.raw)
                                    sourceComponent: (imgs.length >= 2) ? _collageBlock
                                        : (blk.kind === "blank" ? _blankBlock : _textBlock)

                                    // ≥2 images → justified collage. Each
                                    // Image reports its aspect (sourceSize) on
                                    // load; once all known we ask the backend
                                    // for a row-justified plan (collage_plan)
                                    // and size tiles to fill each row. Until
                                    // then, a sensible fixed-height fallback.
                                    Component {
                                        id: _collageBlock
                                        Item {
                                            id: _collageItem
                                            width: parent.width
                                            property var aspects: []
                                            property string plan: ""
                                            implicitHeight: _collageFlow.implicitHeight
                                            function _recompute() {
                                                if (aspects.length < imgs.length) return
                                                if (!backend.collage_plan) return
                                                plan = backend.collage_plan(aspects.join(","),
                                                    width, imgs.length >= 4 ? 150 : 220, 4)
                                            }
                                            function _tileAt(i) {
                                                if (plan.length === 0) return null
                                                var flat = []
                                                var rows = plan.split(";")
                                                for (var r = 0; r < rows.length; r++) {
                                                    var ts = rows[r].split(",")
                                                    for (var c = 0; c < ts.length; c++) {
                                                        var wh = ts[c].split("x")
                                                        flat.push({ w: parseFloat(wh[0]), h: parseFloat(wh[1]) })
                                                    }
                                                }
                                                return i < flat.length ? flat[i] : null
                                            }
