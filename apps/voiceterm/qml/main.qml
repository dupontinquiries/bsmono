                                    var rows = backend.term_visible_rows
                                        ? backend.term_visible_rows() : 24
                                    var sbPos = backend.term_scrollback_pos !== undefined
                                        ? backend.term_scrollback_pos : 0
                                    var topAbs = emitted - rows - sbPos
                                    var r = parseInt(_m.abs) - topAbs
                                    if (r < 0 || r >= rows) return -1
                                    return r
                                }

