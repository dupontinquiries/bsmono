                            for (var j = 0; j < pgs.length; j++) {
                                var pg = pgs[j]
                                var cx = pg.x + dx, cy = pg.y + dy
                                ctx.beginPath()
                                ctx.globalAlpha = (j <= cardsCanvas._walkStep) ? 1.0 : 0.4
                                ctx.fillStyle = th.ac
                                ctx.arc(cx, cy, 6, 0, 2*Math.PI)
                                ctx.fill()
                                // Pulsing ring on the current node.
