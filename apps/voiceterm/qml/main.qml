            // (and Ctrl-R / Ctrl-D / etc.) reaches the shell. Without this,
            // focus stays with whatever opened the popup or wanders to the
            // URL bar, and Keys.onShortcutOverride on termKeyArea can't fire
            // because termKeyArea no longer has activeFocus.
            if (tabBar.currentIndex === 1 && typeof termKeyArea !== "undefined") {
                termKeyArea.forceActiveFocus()
            }
        }
        property string recognizedText: ""
        property string intentKind: ""
        property string intentDesc: ""
        property string intentParam: ""
        property string intentParam2: ""
        property string whisperText: ""
        property string phoneticMatch: ""
        property real phoneticScore: 999
        property string phoneticMatch2: ""
        property real phoneticScore2: 999
        // Speaker match score from voice_listen_dual. 0..1. 0.5 means
        // no opinion yet (insufficient profile data). Used to surface
        // a low-confidence hint when the captured audio doesn't sound
        // like the established speaker (potentially a different person
        // OR the speaker is sick / different mic / unusual environment).
        property real speakerScore: 0.5
        // True if phonetic match is confident enough to suggest as alternative
        readonly property bool hasPhoneticAlt: phoneticMatch.length > 0 && phoneticScore < 12
                                              && phoneticMatch !== whisperText

        enter: Transition {
            NumberAnimation { property: "scale"; from: 0.7; to: 1.0; duration: 200; easing.type: Easing.OutBack }
            NumberAnimation { property: "opacity"; from: 0; to: 1; duration: 150 }
        }
        exit: Transition {
            // Fade out longer than fade in (250ms vs 120ms) so the user
            // gets to see the just-clicked / just-executed state for a
            // beat before the popup disappears. Combined with the 300ms
            // selection grace before executeIntent, that's ~550ms total
            // visual feedback after a click — enough to feel responsive
            // without feeling laggy.
            NumberAnimation { property: "opacity"; from: 1; to: 0; duration: 250 }
            NumberAnimation { property: "scale"; from: 1.0; to: 0.94; duration: 250; easing.type: Easing.InQuad }
        }

        // Inner padding from popup edges to content. Increased from the
        // default ~16px to give the popup more breathing room and feel
        // less cramped on phones especially.
        padding: 22
        topPadding: 22
        bottomPadding: 22
        leftPadding: 22
        rightPadding: 22

        background: Rectangle {
            // Slightly darker than surface for muted feel — th.sf is the
            // bright surface used for cards; the popup wants to feel a
            // notch quieter so attention goes to its content not its frame.
            color: Qt.darker(th.sf, 1.08)
            radius: 20
            // Border opacity reduced so the frame whispers rather than shouts.
            border.color: Qt.rgba(th.bd.r, th.bd.g, th.bd.b, 0.55)
            border.width: 1
            // Soft glow when active — kept, but at lower opacity to match
            // the muted overall aesthetic.
            Rectangle { anchors.fill: parent; anchors.margins: -3; radius: parent.radius + 3; z: -1
                color: "transparent"; border.color: voicePopup.recording ? "#dc2626" : th.ac
