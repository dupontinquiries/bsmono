            // v0.1.230: corpus visibility entry. The
            // ~/.config/web2qml/corpus/ directory has been
            // accumulating recordings since v0.1.192 but nothing
            // surfaced them. This nav entry routes to the
            // virtual `web2qml://corpus` manpage which lists
            // every captured recording (speaker, duration,
            // paragraph text, relative time).
            Text {
                anchors.horizontalCenter: parent.horizontalCenter
                text: "view recordings"
                color: th.ac
                font.pixelSize: 10
                font.underline: true
                MouseArea {
                    anchors.fill: parent
                    cursorShape: Qt.PointingHandCursor
                    onClicked: {
                        quickSettingsPopup.close()
                        if (backend && backend.open_web_tab) {
                            root.termPaneStrip = backend.open_web_tab("web2qml://corpus")
                        }
                    }
                }
            }
        }
    }

    // ═══ Cards Graph Canvas ═══ (v0.1.319, arc 2.5.6-qml)
    //
    // Pan/zoomable canvas that renders the connections graph
    // produced by backend.cards_layout(). Each node becomes a
    // card (Rectangle with title), each edge a line between
    // card centroids.
    //
    // The Backend serializes the layout as a two-section string
    // with `\x1F` field separators and `\n` records:
    //
    //     NODES\n
    //     id\x1Ftitle\x1Fkind\x1Fx\x1Fy\x1Fhw\x1Fhh\n ...
    //     EDGES\n
    //     from\x1Fto\n ...
    //
    // Parsing is done once per open (or refresh). The parsed
    // `cardData` array is the model for the card Repeater, and
    // `edgeData` is the model for the Canvas onPaint loop.
    //
    // What's wired in this ship:
    //   - Pan (Flickable on the inner Item)
    //   - Pinch zoom (PinchHandler with scale binding)
    //   - Card chip rendering (title + kind tint)
    //   - Edge rendering (Canvas lines between centroids)
    //   - Refresh button (re-runs layout)
    //   - Close button
    //
    // What's NOT yet wired (future ships):
    //   - Drag-with-reflow on individual cards
    //   - Card preview overlay on tap
    //   - Tag filter / search
    //   - Backend.set_card_pinned(id, x, y) for persisting drags
    Popup {
        id: cardsCanvas
        x: 0; y: 0
        width: root.width; height: root.height
        modal: false
        dim: true
        closePolicy: Popup.CloseOnEscape | Popup.CloseOnPressOutsideParent
        focus: true
        // v0.1.850 BUGFIX: Keys cannot attach to a Popup (it is not an Item) —
        // that runtime warning ("Could not attach Keys property to: Popup … is
        // not an Item") meant this entire keyboard-pan handler silently never
        // fired. Host it on a focus-catching Item child and focus that on open
        // (the popup's existing onOpened, below, calls forceActiveFocus()).
        Item {
            id: _cardsKeyCatcher
            anchors.fill: parent
            focus: true
            // v0.1.699 (keyboard pan): arrow keys move the selected node to the
            // neighbor in that direction; Tab/Shift+Tab cycle; +/- expand/collapse.
            Keys.onPressed: function(e) {
                if (e.key === Qt.Key_Up)    { _arrowPan(0); e.accepted = true }
                else if (e.key === Qt.Key_Down)  { _arrowPan(1); e.accepted = true }
                else if (e.key === Qt.Key_Left)  { _arrowPan(2); e.accepted = true }
                else if (e.key === Qt.Key_Right) { _arrowPan(3); e.accepted = true }
                else if (e.key === Qt.Key_Tab)   { _panFocus(true); e.accepted = true }
                else if (e.key === Qt.Key_Backtab) { _panFocus(false); e.accepted = true }
                else if (e.key === Qt.Key_Plus || e.key === Qt.Key_Equal) {
                    _expandDepth = Math.min((_expandDepth < 0 ? 0 : _expandDepth) + 1, 6)
                    _refreshExpansion(); e.accepted = true
                }
                else if (e.key === Qt.Key_Minus) {
                    _expandDepth = Math.max(_expandDepth - 1, 0)
                    _refreshExpansion(); e.accepted = true
                }
                else if (e.key === Qt.Key_S) {
                    // v0.1.701 (#3): toggle the per-layer depth shadow (off for
                    // dense technical docs).
                    _layerShadows = !_layerShadows
                    if (typeof toast !== "undefined")
                        toast.show(_layerShadows ? "Layer shadows on" : "Layer shadows off", "info")
                    e.accepted = true
                }
            }
        }
        // v0.1.319: cached parse results. cardData[i] = {
        //   id, title, kind, x, y, hw, hh
        // }; edgeData[i] = { from, to }.
        property var cardData: []
        // v0.1.733: graph card density — "compact"|"expanded"|"literal".
        // Mirrors backend.graph_density; the inline toolbar toggle cycles it
        // and re-runs the layout so cards resize to show more/less context.
        property string _density: "compact"
        function _setDensity(mode) {
            if (_density === mode) return
            _density = mode
            if (backend && backend.set_graph_density) backend.set_graph_density(mode)
            // re-run the layout for the open graph with the new sizing.
            // reload() re-fetches *_to_layout for whichever _sourceMode is
            // active (mermaid / niftyplot / connections).
            if (typeof reload === "function") reload()
        }
        property var edgeData: []
        // v0.1.758: subgraph group boxes [{id,title,x,y,w,h,depth}] drawn behind
        // the cards as labeled containers.
        property var groupData: []
        // Map id → cardData index for O(1) edge endpoint lookups
        // during canvas paint.
        property var idToIdx: ({})
        // v0.1.446: node-importance state for visual weighting +
        // auto-presentation. _degree maps id → edge count;
        // _maxDegree normalizes; _hubId is the most-connected node
        // (gets the entrance pulse). _degreeOf returns 0 for
        // unknown ids. _weightOf returns 0..1 importance.
        property var _degree: ({})
        property int _maxDegree: 1
        property string _hubId: ""
        function _degreeOf(id) {
            var d = _degree[id]
            return (d === undefined) ? 0 : d
        }
        function _weightOf(id) {
            if (_maxDegree <= 1) return 0.4
            return Math.min(1.0, 0.25 + 0.75 * (_degreeOf(id) / _maxDegree))
        }
        // v0.1.446: gentle idle "breathing" oscillation (0..1) that
        // drives the hub node's subtle scale pulse, so when the
        // graph opens the eye is drawn to the most important node
        // (auto-presentation) without anything jarring. Triangle
        // wave via a looping ping-pong NumberAnimation.
        property real _hubBreath: 0
        SequentialAnimation on _hubBreath {
            running: cardsCanvas.visible && cardsCanvas._hubId !== ""
            loops: Animation.Infinite
            NumberAnimation { from: 0; to: 1; duration: 1600; easing.type: Easing.InOutSine }
            NumberAnimation { from: 1; to: 0; duration: 1600; easing.type: Easing.InOutSine }
        }
        property real graphMinX: 0
        property real graphMinY: 0
        property real graphMaxX: 800
        property real graphMaxY: 600
        property bool dataLoaded: false
        // v0.1.320: client-side mirror of backend pin state. Used
        // to drive visual feedback (📌 prefix + thicker border)
        // without round-tripping a "is_pinned" query per frame.
        // Updated when the user drags a card (set true) and when
        // they tap Reset Layout (cleared).
        property var _pinned: ({})

        // v0.1.398 (destructive-action-safety arc step 2):
        // close gate. Diagram edits (pin drags, tilt
        // changes) now accumulate in
        // backend._pending_transforms instead of writing
        // immediately. When the user closes the canvas with
        // unsaved changes, we open ConfirmDialog rather
        // than dropping the edits silently.
        //
        // Call this INSTEAD of `cardsCanvas.close()` from
        // any close-trigger that should respect pending
        // state. Direct `.close()` still works for cases
        // where bypassing the gate is correct (e.g.,
        // emergency reset).
        function _requestClose() {
            if (backend
                && backend.has_pending_transforms
                && typeof _transformConfirmDialog !== "undefined")
            {
                _transformConfirmDialog.open()
            } else {
                close()
            }
        }

        // v0.1.322: card preview state. Set by _openPreview;
        // read by the preview overlay below.
        property bool _previewOpen: false
        property string _previewId: ""
        property string _previewTitle: ""
        property string _previewSubtitle: ""
        property string _previewKindLabel: ""
        property string _previewText: ""
        property string _previewTags: ""
        // v0.1.324: user-tags split out so the preview can
        // render them with × delete affordances. Auto-derived
        // tags stay in _previewTags (read-only chips).
        property string _previewUserTags: ""
        // v0.1.325 (cards arc 2.5.7): "Related to" list. Array
        // of { id, weight, title, kind } populated when the
        // preview opens. Tap a row → switch preview to that
        // node (without closing the canvas).
        property var _previewRelated: []

        // v0.1.324: refresh just the user-tag chip row after
        // an add/remove. Called by the voice dispatcher cases
        // and by the inline tag input button.
        function _refreshPreviewTags() {
            if (!_previewId || !backend || !backend.card_tags_get) return
            _previewUserTags = backend.card_tags_get(_previewId) || ""
        }

        // v0.1.325: populate _previewRelated for the current
        // preview node. Capped at 5 entries.
        function _refreshPreviewRelated() {
            if (!_previewId || !backend || !backend.card_related) {
                _previewRelated = []
                return
            }
            var blob = backend.card_related(_previewId, 5)
            var arr = []
            if (blob && blob.length > 0) {
                var rows = blob.split("\n")
                for (var i = 0; i < rows.length; i++) {
                    var row = rows[i]
                    if (row.length === 0) continue
                    var f = row.split("\x1F")
                    if (f.length < 4) continue
                    arr.push({
                        id: f[0],
                        weight: parseInt(f[1]) || 0,
                        title: f[2],
                        kind: f[3]
                    })
                }
            }
            _previewRelated = arr
        }

        // v0.1.433: content-similar pages (cosine over content
        // vectors), independent of metadata. Array of
        // { id, score, title, kind }. Populated alongside Related.
        property var _previewSimilar: []
        function _refreshPreviewSimilar() {
            if (!_previewId || !backend || !backend.card_similar) {
                _previewSimilar = []
                return
            }
            var blob = backend.card_similar(_previewId, 5)
            var arr = []
            if (blob && blob.length > 0) {
                var rows = blob.split("\n")
                for (var i = 0; i < rows.length; i++) {
                    var row = rows[i]
                    if (row.length === 0) continue
                    var f = row.split("\x1F")
                    if (f.length < 4) continue
                    arr.push({ id: f[0], score: parseInt(f[1]) || 0, title: f[2], kind: f[3] })
                }
            }
            _previewSimilar = arr
        }

        // v0.1.448: smart-tag SUGGESTIONS (NLP). Array of strings.
        // Tapping a chip adds it as a user tag, then refreshes both
        // lists so it moves from "suggested" to "your tags".
        property var _previewSuggestedTags: []
        function _refreshPreviewSuggestedTags() {
            if (!_previewId || !backend || !backend.card_suggested_tags) {
                _previewSuggestedTags = []
                return
            }
            var blob = backend.card_suggested_tags(_previewId, 6)
            var arr = []
            if (blob && blob.toString().length > 0) {
                var parts = blob.toString().split(",")
                for (var i = 0; i < parts.length; i++) {
                    var t = parts[i].trim()
                    if (t.length > 0) arr.push(t)
                }
            }
            _previewSuggestedTags = arr
        }
        function _acceptSuggestedTag(tag) {
            if (!_previewId || !backend || !backend.card_tag_add) return
            backend.card_tag_add(_previewId, tag)
            _refreshPreviewTags()
            _refreshPreviewSuggestedTags()
        }

        // v0.1.325: switch the preview to a different node
        // without closing the overlay. Used by tapping a
        // "Related to" row.
        function _switchPreview(id) {
            if (!id || id === _previewId) return
            // Find the idx in cardData; fall back to a synthetic
            // call if the node isn't visible (rare).
            var idx = idToIdx[id]
            if (idx !== undefined) {
                _openPreview(idx)
            }
        }

        // v0.1.323 (cards arc 2.5.2): fuzzy filter state.
        // _filterQuery is the live text in the search field.
        // _filterMatched is a set of node ids that match the
        // query (truthy values). Empty query → empty set →
        // ALL cards render at full opacity. Non-empty query →
        // only matched cards render full; the rest fade to
        // 0.18 (per the "filtered fade not disappear" pattern
        // from todo 2.5.6).
        property string _filterQuery: ""
        property var _filterMatched: ({})
        property bool _filterActive: false
        // v0.1.779: Ctrl+E toggles this — when a filter is active, excluded
        // (non-matched) nodes shrink instead of only fading, so matches stand out.
        property bool _compressExcluded: false

        function _isMatched(id) {
            if (!_filterActive) return true
            return !!_filterMatched[id]
        }

        function _applyFilter(q) {
            _filterQuery = q
            var trimmed = (q || "").replace(/^\s+|\s+$/g, "")
            if (trimmed.length === 0) {
                _filterMatched = ({})
                _filterActive = false
                edgeCanvas.requestPaint()
                return
            }
            if (!backend || !backend.cards_filter) {
                _filterMatched = ({})
                _filterActive = false
                return
            }
            // cap=0 → no cap from Backend's perspective.
            var blob = backend.cards_filter(trimmed, 0)
            var matched = ({})
            if (blob && blob.length > 0) {
                var ids = blob.split("\n")
                for (var i = 0; i < ids.length; i++) {
                    if (ids[i].length > 0) matched[ids[i]] = true
                }
            }
            _filterMatched = matched
            _filterActive = true
            edgeCanvas.requestPaint()
        }

        function _isPinned(id) {
            return !!_pinned[id]
        }

        function _openPreview(idx) {
            if (idx < 0 || idx >= cardData.length) return
            var c = cardData[idx]
            if (!backend || !backend.card_detail) {
                // Backend missing — fall back to model-only.
                _previewTitle = c.title
                _previewSubtitle = ""
                _previewKindLabel = c.kind
                _previewText = ""
                _previewTags = ""
                _previewUserTags = ""
                _previewRelated = []
                _previewSimilar = []
                _previewId = c.id
                _previewOpen = true
                return
            }
            var blob = backend.card_detail(c.id)
            if (!blob || blob.length === 0) {
                // Node disappeared mid-session; nothing useful
                // to show.
                return
            }
            var f = blob.split("\x1F")
            _previewTitle    = f.length > 0 ? f[0] : c.title
            _previewSubtitle = f.length > 1 ? f[1] : ""
            _previewKindLabel = f.length > 2 ? f[2] : c.kind
            _previewText     = f.length > 3 ? f[3] : ""
            // f[4] is created_at; we don't surface it in v1
            _previewTags     = f.length > 5 ? f[5] : ""
            _previewId = c.id
            // v0.1.324: pull user tags separately so the
            // preview overlay can offer × delete affordances
            // on each.
            _previewUserTags = backend.card_tags_get
                ? (backend.card_tags_get(c.id) || "") : ""
            // v0.1.325: populate "Related to" list.
            _refreshPreviewRelated()
            _refreshPreviewSimilar()
            // v0.1.448: NLP-suggested tags.
            _refreshPreviewSuggestedTags()
            _previewOpen = true
        }

        background: Rectangle { color: th.bg; opacity: 0.97 }
        enter: Transition { NumberAnimation { property: "opacity"; from: 0; to: 1; duration: 150 } }
        exit: Transition { NumberAnimation { property: "opacity"; from: 1; to: 0; duration: 120 } }

        // Parse the NODES/EDGES blob from backend.cards_layout().
        function _parseLayoutString(s) {
            var nodes = []
            var edges = []
            var idMap = {}
            if (!s || s.length === 0) {
                cardData = nodes; edgeData = edges; idToIdx = idMap
                groupData = []
                return
            }
            // Split on the EDGES\n boundary first; this is the
            // most robust marker since NODES titles can't contain
            // \n (sanitized by Backend).
            var edgesIdx = s.indexOf("EDGES\n")
            var nodesPart = ""
            var edgesPart = ""
            if (edgesIdx >= 0) {
                nodesPart = s.substring(0, edgesIdx)
                edgesPart = s.substring(edgesIdx + 6)
            } else {
                nodesPart = s
            }
            // v0.1.758: split off the trailing GROUPS section (subgraph boxes),
            // which follows EDGES. Lives in edgesPart after the split above.
            var groups = []
            var groupsIdx = edgesPart.indexOf("GROUPS\n")
            if (groupsIdx >= 0) {
                var groupsPart = edgesPart.substring(groupsIdx + 7)
                edgesPart = edgesPart.substring(0, groupsIdx)
                var glines = groupsPart.split("\n")
                for (var gi = 0; gi < glines.length; gi++) {
                    if (glines[gi].length === 0) continue
                    var gfld = glines[gi].split("\x1F")
                    if (gfld.length < 7) continue
                    groups.push({
                        id: gfld[0], title: gfld[1],
                        x: parseFloat(gfld[2]) || 0, y: parseFloat(gfld[3]) || 0,
                        w: parseFloat(gfld[4]) || 0, h: parseFloat(gfld[5]) || 0,
                        depth: parseInt(gfld[6]) || 0
                    })
                }
            }
            // Strip "NODES\n" prefix if present.
            if (nodesPart.indexOf("NODES\n") === 0) {
                nodesPart = nodesPart.substring(6)
            }
            // Parse node rows.
            var nodeLines = nodesPart.split("\n")
            var minX = 1e9, minY = 1e9, maxX = -1e9, maxY = -1e9
            for (var i = 0; i < nodeLines.length; i++) {
                var row = nodeLines[i]
                if (row.length === 0) continue
                var f = row.split("\x1F")
                if (f.length < 7) continue
                var card = {
                    id: f[0],
                    title: f[1],
                    kind: f[2],
                    x: parseFloat(f[3]) || 0,
                    y: parseFloat(f[4]) || 0,
                    hw: parseFloat(f[5]) || 80,
                    hh: parseFloat(f[6]) || 50,
                    // v0.1.343 (niftyplot arc): optional 8th
                    // field. Empty string means "no plane" / 
                    // top-level / not from niftyplot source.
                    // Used by _focusedPlane dimming binding.
                    plane: f.length >= 8 ? f[7] : "",
                    // v0.1.446: optional 9th field — one-char shape
                    // code (r/o/c/d/p/h/y/f/a/x). Empty/missing → "x"
                    // (default rounded rect) for backward compat with
                    // older Backend builds + cards_layout (no shape).
                    shape: f.length >= 9 ? f[8] : "x"
                }
                idMap[card.id] = nodes.length
                nodes.push(card)
                if (card.x - card.hw < minX) minX = card.x - card.hw
                if (card.y - card.hh < minY) minY = card.y - card.hh
                if (card.x + card.hw > maxX) maxX = card.x + card.hw
                if (card.y + card.hh > maxY) maxY = card.y + card.hh
            }
            // Parse edge rows. v0.1.325: rows now have a
            // third field (weight) for visual thickness.
            // Default weight 1 for backward compat if the field
            // is missing (older Backend builds).
            var edgeLines = edgesPart.split("\n")
            for (var j = 0; j < edgeLines.length; j++) {
                var erow = edgeLines[j]
                if (erow.length === 0) continue
                var ef = erow.split("\x1F")
                if (ef.length < 2) continue
                var w = ef.length >= 3 ? (parseInt(ef[2]) || 1) : 1
                // v0.1.327: style + arrowhead + label fields.
                // Backward compat: old format (3 fields) defaults
                // to arrow style with head, no label.
                var style = ef.length >= 4 ? ef[3] : "a"
                var hasArrow = ef.length >= 5 ? (ef[4] === "1") : true
                var lbl = ef.length >= 6 ? ef[5] : ""
                // v0.1.761: 7th field = back-edge (feedback) flag.
                var back = ef.length >= 7 ? (ef[6] === "1") : false
                edges.push({
                    from: ef[0], to: ef[1], weight: w,
                    style: style, arrow: hasArrow, label: lbl, back: back
                })
            }
            // v0.1.339: force Repeater + idToIdx rebind by
            // clearing the var properties before reassigning.
            // Without this, when reload() is called (especially
            // in mermaid mode where the new graph may be the
            // same SHAPE but with different node positions),
            // QML's optimizer sometimes keeps the existing
            // Repeater delegates with their OLD modelData
            // references — so the user sees the edges (which
            // we explicitly requestPaint) update but the nodes
            // stay at their pre-refresh positions.
            //
            // Setting to [] / {} first guarantees the change
            // signal fires with a clearly-different value, so
            // the second assignment forces a full rebuild.
            cardData = []
            edgeData = []
            idToIdx = ({})
            cardData = nodes
            edgeData = edges
            idToIdx = idMap
            groupData = groups  // v0.1.758: subgraph boxes
            // v0.1.446: compute per-node edge DEGREE so the
            // delegate can give well-connected nodes (the root, the
            // hubs) more visual weight — fixing the "everything
            // looks the same / nothing holds its own" feel. Degree
            // = count of edges touching the node. _maxDegree
            // normalizes the weight scale.
            var deg = ({})
            var maxDeg = 1
            for (var ei = 0; ei < edges.length; ei++) {
                var ef = edges[ei].from, et = edges[ei].to
                deg[ef] = (deg[ef] || 0) + 1
                deg[et] = (deg[et] || 0) + 1
                if (deg[ef] > maxDeg) maxDeg = deg[ef]
                if (deg[et] > maxDeg) maxDeg = deg[et]
            }
            _degree = deg
            _maxDegree = maxDeg
            // Identify the most-connected node — the one the
            // auto-presentation breathes/highlights on open.
            var topId = "", topDeg = -1
            for (var k in deg) { if (deg[k] > topDeg) { topDeg = deg[k]; topId = k } }
            _hubId = topId
            graphMinX = (minX === 1e9) ? 0 : minX - 40
            graphMinY = (minY === 1e9) ? 0 : minY - 40
            graphMaxX = (maxX === -1e9) ? 800 : maxX + 40
            graphMaxY = (maxY === -1e9) ? 600 : maxY + 40
            dataLoaded = true
            edgeCanvas.requestPaint()
        }

        function reload() {
            if (_sourceMode === "mermaid") {
                // v0.1.327 (arc 2.7.3): Mermaid source mode.
                if (backend && backend.mermaid_to_layout) {
                    var mblob = backend.mermaid_to_layout(_mermaidSource || "")
                    _parseLayoutString(mblob)
                }
                // v0.1.342: apply inline transforms AFTER layout.
                _applySidecarTransforms()
            } else if (_sourceMode === "niftyplot") {
                // v0.1.343: niftyplot source mode. Parser
                // handles pins/relative constraints internally,
                // so _applySidecarTransforms is NOT called here
                // (would double-apply).
                if (backend && backend.niftyplot_to_layout) {
                    var npblob = backend.niftyplot_to_layout(_mermaidSource || "")
                    _parseLayoutString(npblob)
                }
                // Pull warnings into _diagramWarnings so the
                // debug footer below the canvas can render them.
                if (backend && backend.niftyplot_warnings) {
                    _diagramWarnings = backend.niftyplot_warnings(_mermaidSource || "")
                } else {
                    _diagramWarnings = ""
                }
            } else {
                if (backend && backend.cards_layout) {
                    var blob = backend.cards_layout()
                    _parseLayoutString(blob)
                }
            }
            // v0.1.323: re-apply current filter after reload so
            // matched-set updates if the graph changed.
            if (_filterActive) {
                _applyFilter(_filterQuery)
            }
        }

        // v0.1.343: parser warnings blob from niftyplot_warnings,
        // newline-separated, severity\x1Fline\x1Fmessage\x1Fsource.
        // Empty when no niftyplot block is loaded or no warnings.
        property string _diagramWarnings: ""

        // v0.1.342: apply pin + tilt overrides from the source
        // file's sidecar. Called after reload() finishes the
        // backend-driven layout pass. Walks cardData and updates
        // any positions overridden in the sidecar; sets
        // _tiltAngle from sidecar if a value is set.
        function _setTiltAndPersist(angle) {
            // Single chokepoint for tilt changes that should
            // persist. Voice dispatchers and the long-press menu
            // chips route through here so the sidecar matches
            // the on-screen state.
            _tiltAngle = angle
            if (_sourceMode === "mermaid"
                && _mermaidSourceFile
                && backend
                && backend.save_transform_tilt)
            {
                backend.save_transform_tilt(
                    _mermaidSourceFile, _mermaidBlockId, angle)
            }
        }

        // v0.1.413 (graph view): "snap to North" — restore the
        // canvas to its canonical orientation in one gesture:
        // flat (tilt 0), default zoom (scale 1.0), and scrolled
        // to the graph origin (top-left). The compass metaphor:
        // North = upright, level, framed. Unifies what were
        // three separate actions (flatten + reset-zoom +
        // recenter) into one. The Behavior on _tiltAngle and a
        // scale animation make it a smooth "settle" rather than
        // a jarring jump. Tilt routes through
        // _setTiltAndPersist so the sidecar records flat as the
        // user's current preference.
        function _snapToNorth() {
            _setTiltAndPersist(0)
            // v0.1.428: explicitly reset targets — _fitToView may
            // have retargeted these animators to fit values.
            _northScaleAnim.stop(); _northScaleAnim.to = 1.0; _northScaleAnim.start()
            _northFlickXAnim.stop(); _northFlickXAnim.to = 0; _northFlickXAnim.start()
            _northFlickYAnim.stop(); _northFlickYAnim.to = 0; _northFlickYAnim.start()
            // v0.1.717: also flatten any graph rotation back to north.
            _northRotAnim.stop(); _northRotAnim.to = 0; _northRotAnim.start()
            // v0.1.699: also flatten the 3D layer fan back to front-on, and
            // clear any expansion so "snap to north" is one canonical
            // upright/level/full result.
            _layerYaw = 0; _layerPitch = 0
            _refreshLayerTransforms()
            _expandDepth = -1
            _refreshExpansion()
        }

        // v0.1.428: "Fit to view" — flatten + compute the scale
        // that fits the WHOLE graph bounding box inside the
        // viewport (with a small margin) and center it. Addresses
        // the recurring "graph hard to fit in view on the right
        // side": at fixed scale 1.0 a wide graph runs off-screen
        // and the rightmost cards sit out of reach. Fit picks a
        // scale ≤ 1.0 so everything is visible at once. Animates
        // via the same north animators (retargeted).
        function _fitToView() {
            _setTiltAndPersist(0)
            var gw = graphRoot.width
            var gh = graphRoot.height
            var vw = cardsFlick.width
            var vh = cardsFlick.height
            if (gw <= 0 || gh <= 0 || vw <= 0 || vh <= 0) {
                _snapToNorth(); return
            }
            // v0.1.717: looser fit — allow a small zoom-IN (so a tiny graph
            // fills the viewport instead of being stranded at 1.0) and only 4%
            // padding. Backend canvas_fit_scale owns the (tested) math.
            var fit = (backend && backend.canvas_fit_scale)
                ? backend.canvas_fit_scale(gw, gh, vw, vh)
                : Math.min(Math.min(vw / gw, vh / gh) * 0.96, 1.5)
            fit = Math.max(fit, 0.15)  // floor so huge graphs stay usable
            // Center the (scaled) content in the viewport.
            var cw = gw * fit
            var ch = gh * fit
            var tx = Math.max(0, (cw - vw) / 2)
            var ty = Math.max(0, (ch - vh) / 2)
            _northScaleAnim.stop(); _northScaleAnim.to = fit; _northScaleAnim.start()
            _northFlickXAnim.stop(); _northFlickXAnim.to = tx; _northFlickXAnim.start()
            _northFlickYAnim.stop(); _northFlickYAnim.to = ty; _northFlickYAnim.start()
        }
        function _applySidecarTransforms() {
            if (!backend || !_mermaidSourceFile) return
            // Pin overrides.
            if (backend.load_transform_pins) {
                var blob = backend.load_transform_pins(
                    _mermaidSourceFile, _mermaidBlockId)
                if (blob && blob.length > 0) {
                    var lines = blob.split("\n")
                    var newCardData = cardData.slice()
                    var applied = 0
                    for (var li = 0; li < lines.length; li++) {
                        var line = lines[li]
                        if (line.length === 0) continue
                        var parts = line.split("\x1F")
                        if (parts.length < 3) continue
                        var nodeId = parts[0]
                        var nx = parseFloat(parts[1])
                        var ny = parseFloat(parts[2])
                        if (!isFinite(nx) || !isFinite(ny)) continue
                        var idx = idToIdx[nodeId]
                        if (idx === undefined) continue
                        newCardData[idx] = Object.assign({}, newCardData[idx],
                            { x: nx, y: ny })
                        applied++
                    }
                    if (applied > 0) {
                        // Replace cardData via clear-then-set so
                        // the Repeater rebinds — same pattern as
                        // v0.1.339's reload fix.
                        cardData = []
                        cardData = newCardData
                        edgeCanvas.requestPaint()
                    }
                }
            }
            // Tilt override.
            if (backend.load_transform_tilt) {
                var savedTilt = backend.load_transform_tilt(
                    _mermaidSourceFile, _mermaidBlockId)
                if (savedTilt >= 0) {
                    _tiltAngle = savedTilt
                }
            }
        }

        // v0.1.327 (cards arc 2.7.3): source mode.
        //   "connections" → connections graph (default)
        //   "mermaid"     → render the Mermaid string in
        //                   _mermaidSource via the parser
        property string _sourceMode: "connections"
        property string _mermaidSource: ""
        // v0.1.342 (sidecar transforms arc): identifying info for
        // sidecar persistence. `_mermaidBlockId` is which mermaid
        // block in the source doc this is ("mermaid_0",
        // "mermaid_1", ...). `_mermaidSourceFile` is the absolute
        // filesystem path of the source .md file — empty string
        // for built-in manpages / corpus / etc. Both come from
        // the URL query of the "View as diagram" link.
        property string _mermaidBlockId: "mermaid_0"
        property string _mermaidSourceFile: ""

        // v0.1.343 (niftyplot arc): when set to a non-empty
        // plane name, the canvas dims all cards whose `plane`
        // field doesn't match. Empty string = no focus, full
        // visibility. Driven by the voice intent "focus
        // <plane>" / "unfocus" and by the live-preview scope
        // detection (when caret is inside a plane block).
        property string _focusedPlane: ""

        // v0.1.698 (niftyplot view-layer) — smart expansion + 3D layer rotate.
        // _expandDepth: rings visible around the focus node (0 = focus only,
        // -1 = show all, the default for a freshly opened graph). _expandFocus:
        // the node expansion radiates from. _visibleRing: id → hop distance for
        // nodes inside the current expansion (empty = show everything).
        property int _expandDepth: -1
        property string _expandFocus: ""
        property var _visibleRing: ({})
        // 3D layer rotation target (yaw,pitch radians). The per-plane
        // transforms are computed by the backend and interpolated by a
        // Behavior on each layer's transform (event-driven, retains motion).
        property real _layerYaw: 0
        property real _layerPitch: 0
        property var _layerTransforms: []   // [{dx,dy,scale,skew,op}] front→back
        property var _planeOrder: []        // plane names front→back
        // v0.1.701 (#3): soft per-layer depth shadow when fanned. Default ON;
        // toggleable (the user may want it off for dense technical docs).
        property bool _layerShadows: true

        // recompute the visible expansion set from the focus + depth.
        function _refreshExpansion() {
            // default the focus to the most-connected node (hub) if the user
            // hasn't tapped one yet.
            if (_expandFocus.length === 0 && _hubId.length > 0)
                _expandFocus = _hubId
            if (_expandDepth < 0 || _expandFocus.length === 0
                || !backend.nifty_expand) {
                _visibleRing = ({})   // show all
                requestPaint()
                return
            }
            var wire = backend.nifty_expand(_mermaidSource, _expandFocus, _expandDepth)
            var map = {}
            if (wire.length > 0) {
                var parts = wire.split(",")
                for (var i = 0; i < parts.length; i++) {
                    var kv = parts[i].split(":")
                    if (kv.length === 2) map[kv[0]] = parseInt(kv[1])
                }
            }
            _visibleRing = map
            requestPaint()
        }
        // is a node visible under the current expansion? (and its fade by ring)
        function _nodeVisible(id) {
            if (_expandDepth < 0) return true
            return _visibleRing[id] !== undefined
        }
        function _nodeRingFade(id) {
            var r = _visibleRing[id]
            if (r === undefined) return 1.0
            return Math.max(0.45, 1.0 - r * 0.18)  // outer rings dim
        }

        // recompute per-plane layer transforms for the current yaw/pitch.
        function _refreshLayerTransforms() {
            _planeOrder = (backend.nifty_planes
                ? backend.nifty_planes(_mermaidSource) : "").split(",").filter(function(s){return true})
            var n = _planeOrder.length
            if (n === 0 || !backend.nifty_layer_transforms) { _layerTransforms = []; return }
            var wire = backend.nifty_layer_transforms(n, _layerYaw, _layerPitch, 48)
            var rows = []
            if (wire.length > 0) {
                var segs = wire.split(";")
                for (var i = 0; i < segs.length; i++) {
                    var f = segs[i].split(",")
                    rows.push({ dx: parseFloat(f[0]), dy: parseFloat(f[1]),
                                scale: parseFloat(f[2]), skew: parseFloat(f[3]),
                                op: parseFloat(f[4]) })
                }
            }
            _layerTransforms = rows
            requestPaint()
        }
        // transform for a node's plane (front=0 if unknown).
        function _layerFor(plane) {
            var idx = _planeOrder.indexOf(plane)
            if (idx < 0) idx = 0
            if (idx >= _layerTransforms.length) return null
            return _layerTransforms[idx]
        }

        // v0.1.699 (graph pan) — move the selected node. _panFocus cycles to a
        // neighbor ("go down"/"go up"); _arrowPan picks the neighbor in a
        // screen direction (arrow keys). Both update _expandFocus and, if
        // expansion is active, re-reveal around the new focus.
        function _panFocus(forward) {
            if (_expandFocus.length === 0 && _hubId.length > 0) _expandFocus = _hubId
            if (_expandFocus.length === 0 || !backend.nifty_cycle_neighbor) return
            var nxt = backend.nifty_cycle_neighbor(_mermaidSource, _expandFocus, forward)
            if (nxt && nxt.length > 0) {
                _expandFocus = nxt
                if (_expandDepth >= 0) _refreshExpansion()
                _flashFocus()
            }
        }
        function _arrowPan(dir) {   // 0=up 1=down 2=left 3=right
            if (_expandFocus.length === 0 && _hubId.length > 0) _expandFocus = _hubId
            if (_expandFocus.length === 0 || !backend.nifty_step_focus) return
            // build candidate wire "id:x:y,…" from neighbors' card positions
            var fc = null
            for (var i = 0; i < cardData.length; i++)
                if (cardData[i].id === _expandFocus) { fc = cardData[i]; break }
            if (!fc) return
            var parts = []
            for (var j = 0; j < cardData.length; j++) {
                var c = cardData[j]
                if (c.id === _expandFocus) continue
                parts.push(c.id + ":" + c.x + ":" + c.y)
            }
            var nxt = backend.nifty_step_focus(fc.x, fc.y, parts.join(","), dir)
            if (nxt && nxt.length > 0) {
                _expandFocus = nxt
                if (_expandDepth >= 0) _refreshExpansion()
                _flashFocus()
            }
        }
        // brief highlight pulse on the focus change
        property real _focusFlash: 0
        // v0.1.701 (#2): focus breadcrumb trail — the path of nodes panned
        // through, with loop-collapse on revisit (matches breadcrumb_push).
        property var _crumbs: []
        function _flashFocus() {
            _focusFlash = 1; _focusFlashAnim.restart(); _centerOnFocus()
            if (_expandFocus.length > 0 && backend.nifty_breadcrumb_push)
                _crumbs = backend.nifty_breadcrumb_push(_crumbs.join("\u001f"), _expandFocus, 8)
                    .split("\u001f").filter(function(s){ return s.length > 0 })
        }
        NumberAnimation { id: _focusFlashAnim; target: cardsCanvas
            property: "_focusFlash"; from: 1; to: 0; duration: 500
            easing.type: Easing.OutQuad }

        // v0.1.700 (#2 auto-center): smoothly bring the focus node to the
        // center of the viewport when pan/expand changes it. Event-driven —
        // sets the target contentX/Y; SmoothedAnimations interpolate (retain
        // motion, re-target cleanly if focus changes again mid-flight).
        function _centerOnFocus() {
            if (_expandFocus.length === 0) return
            var fc = null
            for (var i = 0; i < cardData.length; i++)
                if (cardData[i].id === _expandFocus) { fc = cardData[i]; break }
            if (!fc) return
            var sc = graphRoot.scale
            // focus node center in content coords
            var cx = (fc.x - graphMinX) * sc
            var cy = (fc.y - graphMinY) * sc
            var tx = Math.max(0, Math.min(cx - cardsFlick.width / 2,
                Math.max(0, cardsFlick.contentWidth - cardsFlick.width)))
            var ty = Math.max(0, Math.min(cy - cardsFlick.height / 2,
                Math.max(0, cardsFlick.contentHeight - cardsFlick.height)))
            _centerTargetX = tx; _centerTargetY = ty
            _centerXAnim.stop(); _centerXAnim.to = tx; _centerXAnim.start()
            _centerYAnim.stop(); _centerYAnim.to = ty; _centerYAnim.start()
        }
        property real _centerTargetX: 0
        property real _centerTargetY: 0
        SmoothedAnimation { id: _centerXAnim; target: cardsFlick
            property: "contentX"; duration: 420; velocity: -1 }
        SmoothedAnimation { id: _centerYAnim; target: cardsFlick
            property: "contentY"; duration: 420; velocity: -1 }

        // graphRoot around the X axis to give a pseudo-3D
        // perspective view. Per-card Z (set by _depthForKind)
        // applies a vertical parallax so different node kinds
        // stratify into visible "layers" when tilted. Tilt 0 =
        // flat 2D; tilt 60 ≈ steep "looking down at a stack".
        // Animated via Behavior so toggling feels smooth.
        property real _tiltAngle: 0
        Behavior on _tiltAngle {
            NumberAnimation { duration: 380; easing.type: Easing.InOutQuad }
        }
        // v0.1.329: repaint edges on tilt change so they follow
        // the lifted cards in real time. The auto-generated
        // changed signal for `_tiltAngle` is `_tiltAngleChanged`.
        // v0.1.424: the Connections handler must be
        // `on_TiltAngleChanged` — QML uppercases the first letter
        // AFTER the leading `on`, and for an underscore-prefixed
        // property that's the char after the underscore (t -> T).
        // The previous `on_tiltAngleChanged` was rejected at load
        // ("not a properly capitalized signal handler name") so
        // edges did NOT repaint live during a tilt.
        Connections {
            target: cardsCanvas
            function on_TiltAngleChanged() {
                if (typeof edgeCanvas !== "undefined") {
                    edgeCanvas.requestPaint()
                }
            }
        }

        // v0.1.413: snap-to-North animations. Driven by
        // _snapToNorth(). Each targets a different object/prop
        // so they can run in parallel for a unified "settle"
        // motion (zoom back to 1.0 + scroll to origin), while
        // the tilt animates via its own Behavior above.
        // graphRoot / cardsFlick are component-scope ids defined
        // later in the file (inside the Flickable) — QML resolves
        // ids by scope, not textual order, so forward refs are
        // fine.
        NumberAnimation {
            id: _northScaleAnim
            target: graphRoot
            property: "scale"
            to: 1.0
            duration: 380
            easing.type: Easing.InOutQuad
        }
        NumberAnimation {
            id: _northFlickXAnim
            target: cardsFlick
            property: "contentX"
            to: 0
            duration: 380
            easing.type: Easing.InOutQuad
        }
        NumberAnimation {
            id: _northFlickYAnim
            target: cardsFlick
            property: "contentY"
            to: 0
            duration: 380
            easing.type: Easing.InOutQuad
        }
        // v0.1.717: rotation/north detent animator. OutBack gives the snap a
        // slight magnetic overshoot — the "notch catching" feel the user asked
        // for. Targets graphRoot.rotation (the PinchHandler's rotation axis).
        NumberAnimation {
            id: _northRotAnim
            target: graphRoot
            property: "rotation"
            duration: 300
            easing.type: Easing.OutBack
            easing.overshoot: 1.1
        }

        // ═══ v0.1.426: Prezi-style session walk ═══
        // "walk me through my last session's pages": fly the
        // camera card→card through the most recent browsing
        // session. Each stop pops the card (scale up) and, after a
        // beat, crossfades a preview → word-smush overlay. A
        // bottom slider scrubs; auto-play pauses on manual input.
        property bool _walkActive: false
        property var _walkPages: []      // [{id,title,domain,x,y,hw,hh,smush}]
        property int _walkStep: -1
        // v0.1.427: manual by default. Auto-play starts only on
        // the voice cues "keep going" / "vamos" / "dale"
        // (see _walkVoiceAdvance). Manual = tap dots / prev / next.
        property bool _walkAutoPlay: false
        property bool _walkSmushPhase: false  // false=preview, true=smush
        // Fly target zoom for a walk stop (zoomed in vs the 1.0
        // overview). 1.6 fills the viewport with the focused card
        // and a little context.
        readonly property real _walkZoom: 1.6

        // Camera fly animators (parallel): scale + contentX/Y.
        ParallelAnimation {
            id: _walkFlyAnim
            NumberAnimation { id: _walkScaleAnim; target: graphRoot; property: "scale"; duration: 620; easing.type: Easing.InOutCubic }
            NumberAnimation { id: _walkFlickXAnim; target: cardsFlick; property: "contentX"; duration: 620; easing.type: Easing.InOutCubic }
            NumberAnimation { id: _walkFlickYAnim; target: cardsFlick; property: "contentY"; duration: 620; easing.type: Easing.InOutCubic }
            onStopped: {
                // Arrived: after a beat, crossfade preview→smush.
                if (cardsCanvas._walkActive) _walkSmushTimer.restart()
            }
        }
        Timer {
            id: _walkSmushTimer
            interval: 700  // the "beat" after the pop before smush
            onTriggered: cardsCanvas._walkSmushPhase = true
        }
        Timer {
            id: _walkAutoTimer
            interval: 3200  // dwell per card in auto-play
            repeat: false
            onTriggered: {
                if (cardsCanvas._walkActive && cardsCanvas._walkAutoPlay) {
                    cardsCanvas._walkGo(cardsCanvas._walkStep + 1)
                }
            }
        }

        function _startSessionWalk() {
            if (!backend || !backend.session_walk_data) return
            var blob = backend.session_walk_data().toString()
            if (blob.length === 0) {
                _walkEmptyToast.open()
                return
            }
            var rows = blob.split("\n")
            var pages = []
            for (var i = 0; i < rows.length; i++) {
                if (rows[i].length === 0) continue
                var f = rows[i].split("\x1F")
                if (f.length < 8) continue
                pages.push({
                    id: f[0], title: f[1], domain: f[2],
                    x: parseFloat(f[3]), y: parseFloat(f[4]),
                    hw: parseFloat(f[5]), hh: parseFloat(f[6]),
                    smush: f[7]
                })
            }
            if (pages.length === 0) { _walkEmptyToast.open(); return }
            _walkPages = pages
            _walkActive = true
            _walkAutoPlay = false  // manual until a voice "keep going"
            _walkGo(0)
        }
        function _endSessionWalk() {
            _walkActive = false
            _walkStep = -1
            _walkSmushPhase = false
            _walkAutoTimer.stop()
            _walkSmushTimer.stop()
            _snapToNorth()  // settle back to flat overview
        }
        function _walkGo(step) {
            if (!_walkActive || _walkPages.length === 0) return
            if (step < 0) step = 0
            if (step >= _walkPages.length) { _endSessionWalk(); return }
            _walkStep = step
            _walkSmushPhase = false
            _walkSmushTimer.stop()
            _walkAutoTimer.stop()
            var pg = _walkPages[step]
            // Compute fly target to CENTER this card in the
            // viewport at _walkZoom. Card graph pos → content pos.
            var s = _walkZoom
            var cx = (pg.x - graphMinX) * s
            var cy = (pg.y - graphMinY) * s
            var tx = cx - cardsFlick.width / 2
            var ty = cy - cardsFlick.height / 2
            // Clamp into the Flickable's scrollable range.
            var maxX = Math.max(0, graphRoot.width * s - cardsFlick.width)
            var maxY = Math.max(0, graphRoot.height * s - cardsFlick.height)
            tx = Math.max(0, Math.min(tx, maxX))
            ty = Math.max(0, Math.min(ty, maxY))
            _walkFlyAnim.stop()
            _walkScaleAnim.to = s
            _walkFlickXAnim.to = tx
            _walkFlickYAnim.to = ty
            _walkFlyAnim.start()
            // Re-arm auto-play dwell (fly + beat + read).
            if (_walkAutoPlay) _walkAutoTimer.restart()
        }
        function _walkPauseAuto() {
            // Any manual interaction pauses auto-play.
            _walkAutoPlay = false
            _walkAutoTimer.stop()
        }

        // v0.1.427: one-shot voice capture during a walk. If the
        // phrase is an advance cue ("keep going" / "vamos" /
        // "dale" / …) start timed auto-play; otherwise advance one
        // step (treat any speech as a nudge forward). Reuses the
        // proven voice_listen() one-shot; phrase matching is the
        // tested backend walk_advance_cue().
        property bool _walkListening: false
        function _walkVoiceListen() {
            if (!backend || !backend.voice_listen) return
            _walkListening = true
            var heard = backend.voice_listen()  // blocking one-shot
            _walkListening = false
            if (!heard || heard.toString().startsWith("[")) return  // error/no speech
            if (backend.walk_advance_cue && backend.walk_advance_cue(heard)) {
                // Start auto-play and immediately advance.
                _walkAutoPlay = true
                _walkGo(_walkStep + 1)
            }
        }

        function _depthForKind(kind) {
            // Z offset (in pixels of vertical parallax at full
            // tilt) per node kind. Pages = base (0); workflows
            // and speakers float highest. Tuned so the stack
            // reads visually clear without overlapping confusion.
            switch (kind) {
                case "page":  return 0
                case "file":  return 25
                case "chat":  return 50
                case "voice": return 80
                case "spkr":  return 110
                case "wflw":  return 140
                default:      return 0
            }
        }

        // Per-card vertical parallax: depth × sin(tilt) so a
        // flat view shows nothing, full tilt shows the full
        // stratification. Cached as a function rather than a
        // binding to avoid per-frame recomputation in the
        // delegate.
        function _zOffset(kind) {
            var rad = _tiltAngle * Math.PI / 180.0
            return _depthForKind(kind) * Math.sin(rad)
        }

        function openMermaid(source) {
            _sourceMode = "mermaid"
            _mermaidSource = source || ""
            open()
        }

        function openConnections() {
            _sourceMode = "connections"
            _mermaidSource = ""
            open()
        }

        onOpened: { reload(); _openFitTimer.restart(); _cardsKeyCatcher.forceActiveFocus() }
        // v0.1.428: fit the graph to the viewport shortly after
        // open, once the force-directed layout has settled, so a
        // wide graph isn't off-screen from the start.
        Timer {
            id: _openFitTimer
            interval: 220
            onTriggered: {
                if (cardsCanvas._sourceMode === "connections"
                    && !cardsCanvas._walkActive) {
                    cardsCanvas._fitToView()
                }
            }
        }
        onClosed: {
            // v0.1.327: reset back to connections mode so the
            // next voice "show graph" doesn't accidentally reuse
            // the previous Mermaid source.
            _sourceMode = "connections"
            _mermaidSource = ""
            // v0.1.342: also clear the per-file sidecar refs so
            // the next open starts fresh (or with appropriate
            // values if it comes from a different file).
            _mermaidBlockId = "mermaid_0"
            _mermaidSourceFile = ""
        }

        // Tint per node kind. Falls back to accent for unknown.
        function _kindTint(kind) {
            switch (kind) {
                case "page":  return th.lk
                case "voice": return th.ac
                case "chat":  return th.lh
                case "wflw":  return th.tfg
                case "spkr":  return th.bf
                case "file":  return th.tm
                default:      return th.ac
            }
        }

        Item {
            anchors.fill: parent

            // Top bar: title + refresh + close.
            Rectangle {
                id: cardsTopBar
                anchors.top: parent.top
                anchors.left: parent.left
                anchors.right: parent.right
                height: 44
                color: th.sf
                border.color: th.bd
                border.width: 1

                Text {
                    anchors.left: parent.left; anchors.leftMargin: 16
                    anchors.verticalCenter: parent.verticalCenter
                    text: cardsCanvas._sourceMode === "mermaid"
                        ? "Diagram" : "Connections"
                    color: th.tc
                    font.pixelSize: 15
                    font.bold: true
                }
                Text {
                    anchors.left: parent.left; anchors.leftMargin: 140
                    anchors.verticalCenter: parent.verticalCenter
                    text: cardsCanvas.cardData.length + " cards · "
                        + cardsCanvas.edgeData.length + " edges"
                    color: th.tm
                    font.pixelSize: 12
                }

                // v0.1.733: inline density hint — compact / expanded / literal.
                // The minimal compact box is too small for context-rich mindmap
                // nodes, so this lets you trade card count visibility for per-
                // card context without leaving the graph.
                Row {
                    id: densityToggle
                    anchors.left: parent.left; anchors.leftMargin: 300
                    anchors.verticalCenter: parent.verticalCenter
                    spacing: 0
                    Repeater {
                        model: [
                            { k: "compact",  label: "Compact" },
                            { k: "expanded", label: "Expanded" },
                            { k: "literal",  label: "Literal" }
                        ]
                        delegate: Rectangle {
                            height: 22
                            width: _dseg.implicitWidth + 18
                            color: cardsCanvas._density === modelData.k
                                ? (th ? th.ac : "#7ddc7d") : "transparent"
                            border.color: th ? th.bd : "#444"
                            border.width: 1
                            // segmented look: round only the outer ends
                            radius: 0
                            Text {
                                id: _dseg
                                anchors.centerIn: parent
                                text: modelData.label
                                font.pixelSize: 11
                                color: cardsCanvas._density === modelData.k
                                    ? (th ? th.bg : "#15151a") : (th ? th.tm : "#aaa")
                            }
                            MouseArea {
                                anchors.fill: parent
                                cursorShape: Qt.PointingHandCursor
                                onClicked: cardsCanvas._setDensity(modelData.k)
                            }
                        }
                    }
                }

                Row {
                    anchors.right: parent.right; anchors.rightMargin: 8
                    anchors.verticalCenter: parent.verticalCenter
                    spacing: 8

                    // v0.1.428: "Fit" — flatten + zoom so the whole
                    // graph fits the viewport (fixes wide graphs
                    // running off the right edge).
                    Rectangle {
                        width: fitBtnRow.width + 16; height: 28
                        radius: 6
                        visible: cardsCanvas._sourceMode === "connections"
                            && !cardsCanvas._walkActive
                        color: fitBtnArea.pressed ? th.ac : th.ib
                        border.color: th.bd; border.width: 1
                        Row {
                            id: fitBtnRow
                            anchors.centerIn: parent
                            spacing: 4
                            Text { text: "\u26F6"; color: th.tc; font.pixelSize: 12; anchors.verticalCenter: parent.verticalCenter }
                            Text { text: "Fit"; color: th.tc; font.pixelSize: 12; anchors.verticalCenter: parent.verticalCenter }
                        }
                        MouseArea {
                            id: fitBtnArea
                            anchors.fill: parent
                            onClicked: cardsCanvas._fitToView()
                        }
                    }

                    // v0.1.426: "Walk last session" — starts the
                    // Prezi-style guided walk through the most
                    // recent browsing session's pages. Hidden
                    // while a walk is already running.
                    Rectangle {
                        width: walkBtnRow.width + 18; height: 28
                        radius: 6
                        visible: cardsCanvas._sourceMode === "connections"
                            && !cardsCanvas._walkActive
                        color: walkBtnArea.pressed ? th.ac : th.ib
                        border.color: th.ac; border.width: 1
                        Row {
                            id: walkBtnRow
                            anchors.centerIn: parent
                            spacing: 4
                            Text { text: "\u25B6"; color: th.ac; font.pixelSize: 11; anchors.verticalCenter: parent.verticalCenter }
                            Text { text: "Walk session"; color: th.tc; font.pixelSize: 12; anchors.verticalCenter: parent.verticalCenter }
                        }
                        MouseArea {
                            id: walkBtnArea
                            anchors.fill: parent
                            onClicked: cardsCanvas._startSessionWalk()
                        }
                    }

                    // v0.1.328 (cards arc): tap-and-hold multi-
                    // button. Default short tap = Refresh layout.
                    // Long-press reveals a row of secondary
                    // actions: Reset pins, Export as Mermaid,
                    // Copy current source. Releases when any
                    // secondary is tapped OR when the user taps
                    // outside the floating row.
                    //
                    // Design: the main button anchors a floating
                    // Row of secondary chips below it (anchored to
                    // its top so the row hangs below the topbar
                    // and doesn't get clipped). Show/hide driven
                    // by `_menuOpen`.
                    Item {
                        id: actionsMulti
                        width: 96; height: 28
                        property bool _menuOpen: false

                        Rectangle {
                            id: actionsMainBtn
                            anchors.fill: parent
                            color: actionsMainArea.pressed
                                || actionsMulti._menuOpen
                                ? th.bd : th.ib
                            border.color: actionsMulti._menuOpen
                                ? th.ac : th.bd
                            border.width: 1
                            radius: 6
                            Behavior on border.color {
                                ColorAnimation { duration: 120 }
                            }
                            Row {
                                anchors.centerIn: parent
                                spacing: 4
                                Text {
                                    text: "Refresh"
                                    color: th.tc
                                    font.pixelSize: 12
                                    anchors.verticalCenter: parent.verticalCenter
                                }
                                // Down-caret hints that long-press
                                // reveals more options. Visual cue
                                // matches the discovery affordance
                                // pattern: tap = primary, hold =
                                // menu.
                                Text {
                                    text: "⋯"
                                    color: th.tm
                                    font.pixelSize: 12
                                    anchors.verticalCenter: parent.verticalCenter
                                }
                            }
                            MouseArea {
                                id: actionsMainArea
                                anchors.fill: parent
                                pressAndHoldInterval: 380
                                onClicked: {
                                    // Short tap: primary action.
                                    if (actionsMulti._menuOpen) {
                                        actionsMulti._menuOpen = false
                                    } else {
                                        cardsCanvas.reload()
                                    }
                                }
                                onPressAndHold: {
                                    actionsMulti._menuOpen = true
                                }
                            }
                        }

                        // Floating row of secondary action chips.
                        // Anchored below the main button so it
                        // hangs into the canvas area.
                        Row {
                            id: actionsSecondaryRow
                            anchors.top: actionsMainBtn.bottom
                            anchors.right: actionsMainBtn.right
                            anchors.topMargin: 6
                            spacing: 6
                            visible: actionsMulti._menuOpen
                            opacity: actionsMulti._menuOpen ? 1.0 : 0.0
                            Behavior on opacity {
                                NumberAnimation { duration: 130 }
                            }
                            // Each chip is a self-contained
                            // Rectangle with a label and an action.
                            // List order = left-to-right discovery
                            // path. Most useful (Reset) closest to
                            // the main button.
                            Rectangle {
                                width: resetText.implicitWidth + 16
                                height: 26
                                color: resetBtnArea.pressed ? th.ac : th.sf
                                border.color: th.bd; border.width: 1
                                radius: 6
                                Text {
                                    id: resetText
                                    anchors.centerIn: parent
                                    text: "Reset pins"
                                    color: th.tc
                                    font.pixelSize: 11
                                }
                                MouseArea {
                                    id: resetBtnArea
                                    anchors.fill: parent
                                    onClicked: {
                                        if (backend && backend.clear_all_card_pins) {
                                            backend.clear_all_card_pins()
                                        }
                                        cardsCanvas._pinned = ({})
                                        cardsCanvas.reload()
                                        actionsMulti._menuOpen = false
                                        if (typeof toast !== "undefined") {
                                            toast.show("Pins cleared", "info")
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                width: exportText.implicitWidth + 16
                                height: 26
                                color: exportBtnArea.pressed ? th.ac : th.sf
                                border.color: th.bd; border.width: 1
                                radius: 6
                                Text {
                                    id: exportText
                                    anchors.centerIn: parent
                                    text: "View as Mermaid"
                                    color: th.tc
                                    font.pixelSize: 11
                                }
                                MouseArea {
                                    id: exportBtnArea
                                    anchors.fill: parent
                                    // v0.1.328: round-trip — fetch
                                    // current snapshot as Mermaid,
                                    // re-open canvas in mermaid
                                    // mode so the user sees the
                                    // same graph through the
                                    // parser → layout path. Tests
                                    // the round-trip + lets the
                                    // user copy the source by
                                    // re-opening, drilling in,
                                    // exporting back, etc.
                                    onClicked: {
                                        if (backend && backend.cards_to_mermaid) {
                                            var src = backend.cards_to_mermaid()
                                            cardsCanvas._mermaidSource = src
                                            cardsCanvas._sourceMode = "mermaid"
                                            cardsCanvas.reload()
                                        }
                                        actionsMulti._menuOpen = false
                                    }
                                }
                            }
                            Rectangle {
                                width: backText.implicitWidth + 16
                                height: 26
                                color: backBtnArea.pressed ? th.ac : th.sf
                                border.color: th.bd; border.width: 1
                                radius: 6
                                visible: cardsCanvas._sourceMode === "mermaid"
                                Text {
                                    id: backText
                                    anchors.centerIn: parent
                                    text: "← Connections"
                                    color: th.tc
                                    font.pixelSize: 11
                                }
                                MouseArea {
                                    id: backBtnArea
                                    anchors.fill: parent
                                    onClicked: {
                                        cardsCanvas._sourceMode = "connections"
                                        cardsCanvas._mermaidSource = ""
                                        cardsCanvas.reload()
                                        actionsMulti._menuOpen = false
                                    }
                                }
                            }
                            // v0.1.413 (graph view): snap-to-North.
                            // One tap restores the canonical view —
                            // flat (tilt 0), default zoom, scrolled
                            // to origin. Compass glyph + "N" label.
                            // Only meaningfully useful once the user
                            // has tilted/zoomed/panned away, but
                            // always shown so it's discoverable.
                            Rectangle {
                                width: northText.implicitWidth + 16
                                height: 26
                                color: northBtnArea.pressed ? th.ac : th.sf
                                border.color: th.bd; border.width: 1
                                radius: 6
                                Text {
                                    id: northText
                                    anchors.centerIn: parent
                                    text: "\uD83E\uDDED N"  // 🧭 N
                                    color: th.tc
                                    font.pixelSize: 11
                                }
                                MouseArea {
                                    id: northBtnArea
                                    anchors.fill: parent
                                    onClicked: {
                                        cardsCanvas._snapToNorth()
                                        actionsMulti._menuOpen = false
                                        if (typeof toast !== "undefined")
                                            toast.show("Snapped to North", "info")
                                    }
                                }
                            }
                            // v0.1.329 (cards arc): tilt chip.
                            // Toggles between 0° (flat) and a
                            // moderate tilt. The Behavior on
                            // _tiltAngle animates the transition.
                            // Shows "Tilt" when flat, "Flatten"
                            // when tilted — single button does
                            // both jobs.
                            Rectangle {
                                width: tiltText.implicitWidth + 16
                                height: 26
                                color: tiltBtnArea.pressed ? th.ac : th.sf
                                border.color: cardsCanvas._tiltAngle > 0.5
                                    ? th.ac : th.bd
                                border.width: 1
                                radius: 6
                                Text {
                                    id: tiltText
                                    anchors.centerIn: parent
                                    text: cardsCanvas._tiltAngle > 0.5
                                        ? "Flatten" : "Tilt 35°"
                                    color: th.tc
                                    font.pixelSize: 11
                                }
                                MouseArea {
                                    id: tiltBtnArea
                                    anchors.fill: parent
                                    onClicked: {
                                        var nextAngle = cardsCanvas._tiltAngle > 0.5
                                            ? 0 : 35
                                        cardsCanvas._setTiltAndPersist(nextAngle)
                                        actionsMulti._menuOpen = false
                                    }
                                }
                            }
                            // v0.1.329: steep tilt chip. Only
                            // visible when tilt is at 35° already
                            // so it acts as "lean further in".
                            // Lets the user reach a steeper
                            // angle without typing.
                            Rectangle {
                                width: tilt60Text.implicitWidth + 16
                                height: 26
                                visible: cardsCanvas._tiltAngle > 30
                                color: tilt60BtnArea.pressed ? th.ac : th.sf
                                border.color: th.bd; border.width: 1
                                radius: 6
                                Text {
                                    id: tilt60Text
                                    anchors.centerIn: parent
                                    text: "Steeper"
                                    color: th.tc
                                    font.pixelSize: 11
                                }
                                MouseArea {
                                    id: tilt60BtnArea
                                    anchors.fill: parent
                                    onClicked: {
                                        cardsCanvas._setTiltAndPersist(60)
                                        actionsMulti._menuOpen = false
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        width: 28; height: 28
                        color: closeArea.pressed ? th.bd : th.ib
                        border.color: th.bd; border.width: 1
                        radius: 6
                        Text {
                            anchors.centerIn: parent
                            text: "×"
                            color: th.tc
                            font.pixelSize: 18
                        }
                        MouseArea {
                            id: closeArea
                            anchors.fill: parent
                            onClicked: cardsCanvas._requestClose()
                        }
                    }
                }
            }

            // v0.1.323 (cards arc 2.5.2): search/filter row.
            // Below the topbar, above the canvas. Typing here
            // live-filters cards: matches stay fully opaque, the
            // rest fade to 0.18 so the user keeps spatial context
            // (the "fade not disappear" pattern from todo).
            Rectangle {
                id: cardsFilterRow
                anchors.top: cardsTopBar.bottom
                anchors.left: parent.left
                anchors.right: parent.right
                height: 38
                color: th.bg
                border.color: th.bd
                border.width: 0

                Rectangle {
                    anchors.fill: parent
                    anchors.margins: 6
                    color: th.ib
                    border.color: cardsCanvas._filterActive ? th.ac : th.bd
                    border.width: 1
                    radius: 6

                    Text {
                        id: cardsFilterIcon
                        anchors.left: parent.left
                        anchors.leftMargin: 10
                        anchors.verticalCenter: parent.verticalCenter
                        text: "⌕"
                        color: th.tm
                        font.pixelSize: 14
                    }

                    TextField {
                        id: cardsFilterField
                        anchors.left: cardsFilterIcon.right
                        anchors.leftMargin: 6
                        anchors.right: cardsFilterClear.left
                        anchors.top: parent.top
                        anchors.bottom: parent.bottom
                        anchors.rightMargin: 4
                        placeholderText: "Filter cards (title, tags, URL, content)…"
                        placeholderTextColor: th.tm
                        color: th.tc
                        font.pixelSize: 13
                        background: Item {}
                        verticalAlignment: TextInput.AlignVCenter
                        onTextChanged: cardsCanvas._applyFilter(text)
                        // Tab/Esc dismiss focus so the canvas
                        // pan/zoom gestures don't fight the
                        // keyboard.
                        Keys.onEscapePressed: focus = false
                    }

                    Text {
                        id: cardsFilterClear
                        anchors.right: cardsFilterMatchCount.left
                        anchors.rightMargin: 8
                        anchors.verticalCenter: parent.verticalCenter
                        visible: cardsFilterField.text.length > 0
                        text: "×"
                        color: th.tm
                        font.pixelSize: 16
                        MouseArea {
                            anchors.fill: parent
                            anchors.margins: -6
                            onClicked: cardsFilterField.text = ""
                        }
                    }

                    Text {
                        id: cardsFilterMatchCount
                        anchors.right: parent.right
                        anchors.rightMargin: 12
                        anchors.verticalCenter: parent.verticalCenter
                        visible: cardsCanvas._filterActive
                        text: {
                            var count = 0
                            for (var k in cardsCanvas._filterMatched) {
                                if (cardsCanvas._filterMatched[k]) count++
                            }
                            return count + " / " + cardsCanvas.cardData.length
                        }
                        color: th.tm
                        font.pixelSize: 11
                    }
                }
            }

            // Empty-state hint (shown when 0 cards).
            Text {
                anchors.centerIn: parent
                visible: cardsCanvas.dataLoaded && cardsCanvas.cardData.length === 0
                text: "No connections yet.\nBrowse some pages, have a chat, record voice notes —\nthey'll all appear here as cards."
                color: th.tm
                font.pixelSize: 14
                horizontalAlignment: Text.AlignHCenter
            }

            // Pan/zoom surface. Flickable handles pan; PinchHandler
            // on the inner Item handles zoom. Card positions are
            // in graph coordinates; transform translates+scales
            // to screen.
            // v0.1.699: graph-nav hint chip — shows the keyboard/voice
            // commands so the interaction is discoverable and the voice mode
            // has a clear boundary ("say exit"). Visible while expansion or
            // rotation is engaged; click to dismiss.
            Rectangle {
                id: graphNavHint
                visible: cardsCanvas.opened && _show
                property bool _show: cardsCanvas._expandDepth >= 0
                    || Math.abs(cardsCanvas._layerYaw) > 0.01
                anchors.bottom: parent.bottom
                anchors.horizontalCenter: parent.horizontalCenter
                anchors.bottomMargin: 14
                width: hintText.implicitWidth + 24
                height: 30
                radius: 15
                color: th ? Qt.rgba(th.sf.r, th.sf.g, th.sf.b, 0.94) : "#23232a"
                border.color: th ? th.ac : "#7ddc7d"
                border.width: 1
                z: 50
                opacity: _show ? 1.0 : 0.0
                Behavior on opacity { NumberAnimation { duration: 200 } }
                Text {
                    id: hintText
                    anchors.centerIn: parent
                    text: "↑↓←→ / “go up·down” move   +/− expand·collapse   “rotate / flatten”   “exit”"
                    color: th ? th.tc : "#e8e8e8"
                    font.pixelSize: 11
                }
                MouseArea { anchors.fill: parent
                    onClicked: graphNavHint._show = false }
            }

            // v0.1.701 (#2): focus breadcrumb — the path you've panned through,
            // newest last; click a crumb to jump back (collapses the loop).
            Row {
                id: graphCrumbs
                visible: cardsCanvas.opened && cardsCanvas._crumbs.length > 1
                anchors.top: parent.top
                anchors.left: parent.left
                anchors.topMargin: 44
                anchors.leftMargin: 12
                spacing: 4
                z: 51
                Repeater {
                    model: cardsCanvas._crumbs
                    delegate: Row {
                        spacing: 4
                        Text {
                            visible: index > 0
                            text: "›"; color: th ? th.tm : "#888"; font.pixelSize: 12
                            anchors.verticalCenter: parent.verticalCenter
                        }
                        Rectangle {
                            width: crumbLabel.implicitWidth + 12; height: 22; radius: 11
                            color: index === cardsCanvas._crumbs.length - 1
                                ? (th ? Qt.rgba(th.ac.r, th.ac.g, th.ac.b, 0.25) : "#2a3a2a")
                                : (crumbMa.containsMouse ? (th ? th.bb : "#33333d")
                                   : (th ? Qt.rgba(th.sf.r, th.sf.g, th.sf.b, 0.9) : "#23232a"))
                            border.color: th ? th.bd : "#333"; border.width: 1
                            Text {
                                id: crumbLabel
                                anchors.centerIn: parent
                                text: modelData
                                color: th ? th.tc : "#e8e8e8"; font.pixelSize: 11
                            }
                            MouseArea {
                                id: crumbMa; anchors.fill: parent; hoverEnabled: true
                                onClicked: {
                                    cardsCanvas._expandFocus = modelData
                                    if (cardsCanvas._expandDepth >= 0) cardsCanvas._refreshExpansion()
                                    cardsCanvas._flashFocus()
                                }
                            }
                        }
                    }
                }
            }

            Flickable {
                id: cardsFlick
                anchors.top: cardsFilterRow.bottom
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.bottom: parent.bottom
                contentWidth: graphRoot.width * graphRoot.scale
                contentHeight: graphRoot.height * graphRoot.scale
                // v0.1.418: trailing margins so the right and
                // bottom edges of the graph are always reachable.
                // The content extent (graphRoot.width/height ×
                // scale) is mathematically the node bounding box,
                // but in practice the rightmost/bottommost cards
                // sat flush against the edge and the Flickable's
                // bounds + the tilt transform + the v0.1.412
                // background-pan clamp left the last row/column
                // just out of reach. A fixed trailing margin (in
                // viewport px, NOT scaled) guarantees you can
                // always scroll until the last node clears the
                // edge with breathing room.
                // v0.1.718: generous, symmetric reachable margins. The user
                // reported the graph's TOP and RIGHT edges couldn't clear the
                // screen — the leading (top/left) margins were only 60px, so
                // _panMin didn't give enough headroom to push the top edge down
                // past the toolbar. Equal 160px on all sides lets every edge
                // clear with breathing room.
                bottomMargin: 160
                rightMargin: 160
                topMargin: 160
                leftMargin: 160
                clip: true
                visible: cardsCanvas.cardData.length > 0
                // v0.1.717: modern-browser feel. DragAndOvershootBounds lets a
                // FLICK overshoot the edge and rubber-band back (DragOverBounds
                // only allowed a *drag* past the edge, so fast flicks stopped
                // dead at the boundary — the "cramped/no-physics" complaint).
                // rebound gives the spring-back its own smooth animation.
                boundsBehavior: Flickable.DragAndOvershootBounds
                rebound: Transition {
                    NumberAnimation { properties: "contentX,contentY"
                        duration: 420; easing.type: Easing.OutBack; easing.overshoot: 0.6 }
                }
                // friction + glide: lower deceleration = longer coast (more
                // like a touch canvas). Higher max velocity so a hard swipe
                // travels. pixelAligned avoids sub-pixel text shimmer.
                flickDeceleration: 1200
                maximumFlickVelocity: 8000
                pixelAligned: true

                // v0.1.755/757: stuck-view recovery. The free pan/zoom could
                // strand the graph fully outside the viewport with no scroll
                // range back. v757 fixes a bounce loop + edge-scroll fighting:
                //  - fires ONLY when the content is COMPLETELY off-screen (zero
                //    overlap) — never when an edge is merely near the boundary,
                //    so it no longer yanks you back while scrolling to an edge.
                //  - a re-entry guard + a direct (non-animated) clamp instead of
                //    the animated _fitToView, so it can't retrigger itself via
                //    movementEnded → fit → movement → … (the infinite bounce).
                property bool _recovering: false
                function _recoverIfLost() {
                    if (_recovering) return
                    var s = graphRoot.scale
                    var cw = graphRoot.width * s
                    var ch = graphRoot.height * s
                    var left = -contentX, top = -contentY
                    var right = left + cw, bottom = top + ch
                    // fully off-screen = the whole content rect is past one edge
                    var fullyOff = (right <= 0) || (left >= width)
                                || (bottom <= 0) || (top >= height)
                    if (!fullyOff) return
                    _recovering = true
                    // direct clamp: bring the nearest corner just inside view,
                    // no animation (so no movement signal, no loop).
                    var maxX = Math.max(0, cw - width)
                    var maxY = Math.max(0, ch - height)
                    contentX = Math.max(-leftMargin, Math.min(contentX, maxX))
                    contentY = Math.max(-topMargin, Math.min(contentY, maxY))
                    // if content is smaller than the viewport, center it
                    if (cw <= width) contentX = -(width - cw) / 2
                    if (ch <= height) contentY = -(height - ch) / 2
                    _recovering = false
                }
                onMovementEnded: _recoverIfLost()

                Item {
                    id: graphRoot
                    // Width/height are graph extents — Flickable
                    // contentWidth/Height multiply by scale.
                    width: Math.max(400, cardsCanvas.graphMaxX - cardsCanvas.graphMinX)
                    height: Math.max(400, cardsCanvas.graphMaxY - cardsCanvas.graphMinY)
                    transformOrigin: Item.TopLeft
                    scale: 1.0

                    // v0.1.758: subgraph group boxes — labeled containers drawn
                    // BEHIND edges + cards (z: -2) so members read as grouped,
                    // like mermaid's subgraph blocks. Positioned in the same
                    // graph-space transform as the cards (minus graphMin origin).
                    Repeater {
                        model: cardsCanvas.groupData
                        delegate: Rectangle {
                            z: -2
                            x: modelData.x - cardsCanvas.graphMinX
                            y: modelData.y - cardsCanvas.graphMinY
                            width: Math.max(20, modelData.w)
                            height: Math.max(20, modelData.h)
                            radius: 10
                            color: "transparent"
                            border.width: 1
                            border.color: th ? th.bd : "#3a3a44"
                            // faint tinted fill, lighter for deeper nesting
                            Rectangle {
                                anchors.fill: parent
                                radius: parent.radius
                                color: th ? th.ac : "#7ddc7d"
                                opacity: 0.05 + Math.max(0, 2 - modelData.depth) * 0.015
                            }
                            // title tab, top-left inside the box
                            Text {
                                x: 8; y: 3
                                text: modelData.title
                                color: th ? th.tm : "#908d85"
                                font.pixelSize: 11
                                font.bold: true
                                opacity: 0.85
                            }
                        }
                    }

                    // v0.1.700 (#3 layer labels): when the 3D fan is engaged,
                    // show each plane's name on its layer (offset by the
                    // layer's transform) so the rotated view is self-describing.
                    Repeater {
                        model: cardsCanvas._planeOrder
                        delegate: Text {
                            visible: Math.abs(cardsCanvas._layerYaw) > 0.01
                                && modelData.length > 0
                            property var _lt: cardsCanvas._layerFor(modelData)
                            x: 8 + (_lt ? _lt.dx : 0)
                            y: 8 + index * 22 + (_lt ? _lt.dy : 0)
                            text: "▤ " + modelData
                            color: th ? th.ac : "#7ddc7d"
                            opacity: (_lt ? _lt.op : 1.0) * 0.85
                            font.pixelSize: 12
                            font.bold: true
                            z: 40
                            Behavior on x { NumberAnimation { duration: 420; easing.type: Easing.OutCubic } }
                            Behavior on y { NumberAnimation { duration: 420; easing.type: Easing.OutCubic } }
                        }
                    }

                    // v0.1.329 (cards arc): tilt transform. Rotates
                    // the graph around the X axis (at the canvas
                    // horizontal centerline) so the user gets a
                    // pseudo-3D perspective. Tilt 0 = flat 2D;
                    // _tiltAngle drives the rotation. Combined
                    // with per-card _zOffset on the delegate's
                    // y-position to give the depth illusion.
                    transform: [
                        Rotation {
                            origin.x: graphRoot.width * 0.5
                            origin.y: graphRoot.height * 0.5
                            angle: cardsCanvas._tiltAngle
                            axis { x: 1; y: 0; z: 0 }
                        }
                    ]

                    PinchHandler {
                        target: graphRoot
                        minimumScale: 0.3
                        maximumScale: 3.0
                        // v0.1.637: continuous north DETENT. The user
                        // reported repeatedly that there's "not enough
                        // detent on perfect north alignment" — _snapToNorth
                        // was only a one-shot button action, with no
                        // magnetic catch during a manual pinch. Here, when
                        // the pinch ENDS (active → false), if the scale has
                        // settled NEAR 1.0 (within ~8%), animate it exactly
                        // to 1.0 via the existing north scale animator. The
                        // catch zone is wide enough to feel grabby but not
                        // so wide it fights an intentional zoom (anything
                        // past ~8% off is left alone). Pan/tilt detents can
                        // follow once this scale detent's feel is tuned.
                        onActiveChanged: {
                            if (!active) {
                                // scale detent → 1.0 within ~8%
                                var s = graphRoot.scale
                                if (Math.abs(s - 1.0) <= 0.08 && Math.abs(s - 1.0) > 0.001) {
                                    _northScaleAnim.stop()
                                    _northScaleAnim.to = 1.0
                                    _northScaleAnim.start()
                                }
                                // v0.1.717: rotation/NORTH detent. The deferred
                                // tilt detent, now wired: on release, snap the
                                // graph's rotation to the nearest cardinal
                                // (north emphasized) when within ~12°, via the
                                // tested backend canvas_detent_snap. A magnetic
                                // catch at north — the long-standing request.
                                if (backend && backend.canvas_detent_snap
                                    && (backend.north_detent_enabled === undefined
                                        || backend.north_detent_enabled)) {
                                    var r = graphRoot.rotation
                                    var res = backend.canvas_detent_snap(r, 12.0)
                                    var parts = res.split("\t")
                                    var snapped = parseFloat(parts[0])
                                    if (parts[1] === "1" && Math.abs(snapped - ((r % 360) + 360) % 360) > 0.001) {
