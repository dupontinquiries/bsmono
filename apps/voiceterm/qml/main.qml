                                        return
                                    }
                                }
                            }
                            onTextChanged: {
                                if (processing||!backend) return; processing=true
                                if (text.length>sentinel.length) {
                                    var a=text.substring(sentinel.length);
                                    for (var i=0;i<a.length;i++) {
                                        var c=a.charAt(i);
                                        if(c==="\n"||c==="\r") termKeyArea._sendEnterOnce();
                                        else {
                                            backend.pty_write(c)
                                            // Fire bouncy overlay for
                                            // visible char. Cheap — just
                                            // appends to a ListModel.
