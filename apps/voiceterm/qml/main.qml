                        // chips. Tapping a chip opens the blocks drawer;
                        // tapping the strip's collapse handle hides the
                        // body of the strip (saves space on small
                        // screens — only the chevron tab remains).
                        //
                        // This is a foundation step toward "fire inline
                        // on buffer history" — full inline-in-grid
                        // overlay (cards anchored to specific scrollback
                        // rows) needs row-tracking math that's a bigger
                        // refactor. The strip is the practical "I just
                        // ran something, here's what it was" surface
                        // that's visible without leaving the terminal.
                        Item {
                            id: _summaryStrip
                            Layout.fillWidth: true
                            // User-visible state — collapsed = body
                            // hidden, only the 12px chevron handle
                            // shows. _stripData is the cached array
                            // of {id, text, isDumb, model} for the
                            // most recent N blocks that have summaries.
                            property bool _collapsed: false
                            property var _stripData: []
                            property bool _stripVisible: backend !== null
                                && _summaryRevision >= 0
                                && _stripData.length > 0
                            property int _expandedH: Math.min(96,
                                _stripCol.implicitHeight + 8)
                            Layout.preferredHeight: _stripVisible
                                ? (_collapsed ? 14 : _expandedH)
                                : 0
                            visible: _stripVisible
                            Behavior on Layout.preferredHeight {
                                NumberAnimation { duration: 180; easing.type: Easing.OutCubic }
                            }

                            function _refreshStripData() {
                                if (!backend || !backend.term_blocks_list) {
                                    _stripData = []
                                    return
                                }
                                var raw = backend.term_blocks_list(3)
                                if (!raw || raw.length === 0) {
                                    _stripData = []
                                    return
                                }
                                var rows = raw.split("\n")
                                var out = []
                                for (var i = 0; i < rows.length; i++) {
                                    if (!rows[i]) continue
                                    var parts = rows[i].split("\x1F")
                                    if (parts.length < 1) continue
                                    var id = parseInt(parts[0]) || 0
                                    if (id <= 0) continue
                                    var text = backend.log_summary_get
                                        ? backend.log_summary_get(id) : ""
                                    if (!text) continue
                                    out.push({
                                        id: id,
                                        text: text,
                                        // LINT-OK: object literal keys, not bindings.
                                        isDumb: backend.log_summary_is_dumb
                                            ? backend.log_summary_is_dumb(id) : false,
                                        // LINT-OK: object literal keys, not bindings.
                                        model: backend.log_summary_model
                                            ? backend.log_summary_model(id) : ""
                                    })
                                }
                                // Reverse so newest is at the bottom
                                // (closer to the live prompt). Matches
                                // user expectation: "the thing I just
                                // did is right here next to where I'm
                                // typing the next thing."
                                _stripData = out.reverse()
                            }

                            // Refresh whenever a new summary lands.
                            Connections {
                                target: root
                                function on_SummaryRevisionChanged() {
                                    _summaryStrip._refreshStripData()
                                }
                            }
                            Component.onCompleted: _refreshStripData()

                            Rectangle {
                                anchors.fill: parent
                                color: Qt.rgba(0.0, 0.0, 0.0, 0.18)
                                clip: true

                                ColumnLayout {
                                    id: _stripCol
                                    anchors.fill: parent
                                    anchors.margins: 4
                                    anchors.topMargin: 14  // leave room for handle
                                    spacing: 3
                                    visible: !_summaryStrip._collapsed

                                    Repeater {
                                        model: _summaryStrip._stripData
                                        delegate: Rectangle {
                                            Layout.fillWidth: true
                                            Layout.preferredHeight: 22
                                            radius: 4
                                            color: modelData.isDumb
                                                ? Qt.rgba(0.4, 0.4, 0.4, 0.22)
                                                : Qt.rgba(0.2, 0.4, 0.6, 0.22)
                                            border.color: modelData.isDumb
                                                ? Qt.rgba(0.5, 0.5, 0.5, 0.4)
                                                : Qt.rgba(0.4, 0.6, 0.8, 0.4)
                                            border.width: 1

                                            RowLayout {
                                                anchors.fill: parent
                                                anchors.leftMargin: 6
                                                anchors.rightMargin: 6
                                                spacing: 4
                                                Text {
                                                    text: modelData.isDumb ? "\u2699" : "\u2728"
                                                    color: th.tm
                                                    font.pixelSize: 10
                                                }
                                                Text {
                                                    Layout.fillWidth: true
                                                    text: modelData.text
                                                    color: th.tc
                                                    font.pixelSize: 10
                                                    elide: Text.ElideRight
                                                    maximumLineCount: 1
                                                }
                                            }

                                            // Tap → blocks drawer at this block.
                                            // (We don't have a per-block scroll
                                            // target yet; just open the drawer.)
                                            MouseArea {
                                                anchors.fill: parent
                                                cursorShape: Qt.PointingHandCursor
                                                onClicked: blocksDrawer.open()
                                            }
                                        }
                                    }
                                }

                                // Collapse / expand handle along top.
                                Rectangle {
                                    anchors.left: parent.left
                                    anchors.right: parent.right
                                    anchors.top: parent.top
                                    height: 14
                                    color: _stripHandleMa.containsMouse
                                        ? Qt.rgba(1, 1, 1, 0.10)
                                        : "transparent"
                                    Behavior on color { ColorAnimation { duration: 120 } }
                                    Text {
                                        anchors.centerIn: parent
                                        text: _summaryStrip._collapsed
                                            ? "\u25B4 summaries (\u2728\u2009"
                                              + _summaryStrip._stripData.length + ")"
                                            : "\u25BE"
                                        color: th.tm
                                        font.pixelSize: 9
                                    }
                                    MouseArea {
                                        id: _stripHandleMa
                                        anchors.fill: parent
                                        anchors.margins: -2
                                        hoverEnabled: true
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: {
                                            _summaryStrip._collapsed = !_summaryStrip._collapsed
                                        }
                                    }

                                    // ─── Missing-package badge ───
                                    //
                                    // Right-aligned chip showing how
                                    // many missing packages have been
                                    // detected across recent blocks.
                                    // Hidden when zero. Tap opens the
                                    // missingPkgDrawer with the full
                                    // list. The badge polls the
                                    // backend on a slow (1.5s) timer
                                    // since this only changes when
                                    // commands fail.
                                    Rectangle {
                                        id: _missingPkgBadge
                                        anchors.right: parent.right
                                        anchors.rightMargin: 8
                                        anchors.verticalCenter: parent.verticalCenter
                                        height: 12
                                        radius: 6
                                        property int _count: 0
                                        property int _revision: 0
                                        // Cache padding by computing
                                        // implicit width of the text
                                        width: _count > 0 ? _mpLabel.implicitWidth + 14 : 0
                                        visible: _count > 0
                                        color: _mpBadgeMa.containsMouse
                                            ? Qt.rgba(0.8, 0.4, 0.2, 0.6)
                                            : Qt.rgba(0.8, 0.4, 0.2, 0.4)
                                        Behavior on color { ColorAnimation { duration: 120 } }
                                        Text {
                                            id: _mpLabel
                                            anchors.centerIn: parent
                                            text: "\u26A0 " + _missingPkgBadge._count
                                                + " missing"
                                            color: "#fff"
                                            font.pixelSize: 9
                                            font.bold: true
                                        }
                                        MouseArea {
                                            id: _mpBadgeMa
                                            anchors.fill: parent
                                            // Don't let our hover bleed
                                            // up to the strip-handle's
                                            // collapse click. We want
                                            // tap-here to open drawer,
                                            // not collapse strip.
                                            hoverEnabled: true
                                            cursorShape: Qt.PointingHandCursor
                                            preventStealing: true
                                            onClicked: {
                                                missingPkgDrawer.open()
                                            }
                                        }
                                        Timer {
                                            id: _mpBadgePoll
                                            interval: 1500
                                            running: backend !== null
                                                && tabBar.currentIndex === 1
                                            repeat: true
                                            triggeredOnStart: true
                                            onTriggered: {
                                                if (!backend
                                                    || !backend.missing_pkg_revision)
                                                    return
                                                var rev = backend.missing_pkg_revision()
                                                if (rev === _missingPkgBadge._revision)
                                                    return
                                                _missingPkgBadge._revision = rev
                                                // Refresh count from
                                                // current list. Cheap
                                                // — string parse.
                                                var lst = backend.missing_pkg_list
                                                    ? backend.missing_pkg_list()
                                                    : ""
                                                if (!lst) {
                                                    _missingPkgBadge._count = 0
                                                } else {
                                                    var rows = lst.split("\n")
                                                        .filter(function(r) { return r && r.length > 0 })
                                                    _missingPkgBadge._count = rows.length
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        TextInput { id: termKeyArea; Layout.fillWidth: true; Layout.preferredHeight: 1; opacity: 0; focus: true
                            // v0.1.874: this is an invisible keystroke/IME capture
                            // sink (opacity 0, 1px tall) — never a place the user
                            // should see a caret. opacity:0 hides the QML caret but
                            // NOT the platform IME caret/handle on mobile, which
                            // surfaced as a second cursor at the input's position
                            // (bottom of the layout), unaligned to the terminal grid.
                            // Disable the caret outright so only the termCursor
                            // overlay draws a cursor.
                            cursorVisible: false
                            inputMethodHints: Qt.ImhNoPredictiveText|Qt.ImhNoAutoUppercase|Qt.ImhSensitiveData
                            property string sentinel: "  "; property bool processing: false
