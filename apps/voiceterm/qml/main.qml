                                termScreen.currentMatchIndex = -1
                                // v0.1.361: tear down fs state too.
                                if (backend && backend.fs_find_cancel) {
                                    backend.fs_find_cancel()
                                }
                                fsResults = []
                                fsSelectedIndex = -1
                                fsRunning = false
                                if (typeof fsPollTimer !== "undefined") {
