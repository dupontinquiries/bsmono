        {n:"Nord",bg:"#2e3440",sf:"#3b4252",tc:"#d8dee9",tm:"#7b88a1",bd:"#4c566a",ac:"#88c0d0",lk:"#88c0d0",lh:"#ebcb8b",ib:"#3b4252",ig:"#eceff4",bb:"#434c5e",bf:"#e5e9f0",tbg:"#2e3440",tfg:"#a3be8c"},
