            // hints panel sits below the main column inside the same
            // popup, growing height instead of width.
            return _hintsLayoutMode === "sidebar" ? withSidebar : base
        }
        height: Math.min(root.height - 16,
            // v0.1.263: bumped padding margin 40 → 56 to fix
            // "bottom overflow in initial waiting state"
