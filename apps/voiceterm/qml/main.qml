        onClosed: {
            // Resume wake-word detection — popup closed, listener can
            // fire again on the next "Yo Big K". Reset openedByWake
            // for the next opening (manual or wake-driven).
            if (backend && backend.voice_set_wake_suppressed) {
                backend.voice_set_wake_suppressed(false)
            }
            openedByWake = false
            openedForWakeRegistration = false
            // v0.1.127: clear the "+ another speaker" override flag
            // so the next popup open doesn't show the register
            // prompt unexpectedly.
            if (typeof _registerBox !== "undefined") {
                _registerBox._userRequestedAdd = false
                _registerBox._needPrompt = false
            }
