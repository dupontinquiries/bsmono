    // v0.1.241: shared helpers for hex color manipulation.
    // Avoids three near-duplicate parseInt-substr-divide-255
    // sequences (root window bg, outer terminal pane, inner
    // termScreen) and a slightly different version inline in
    // the theme tile delegate.
    //
    // hexRgba(hexColor, alpha) takes a "#RRGGBB" string and an
    // alpha 0.0-1.0, returns a Qt.rgba() color. Used wherever a
    // theme color needs an opacity applied.
    //
    // hexLuminance(hexColor) returns BT.601 perceived luminance
    // 0-255. Used to determine if a theme reads as light or
    // dark for the dark_theme flag (threshold 128).
    function hexRgba(hex, alpha) {
        return Qt.rgba(
            parseInt(hex.substr(1, 2), 16) / 255,
            parseInt(hex.substr(3, 2), 16) / 255,
            parseInt(hex.substr(5, 2), 16) / 255,
            alpha)
    }
    function hexLuminance(hex) {
        var r = parseInt(hex.substr(1, 2), 16)
        var g = parseInt(hex.substr(3, 2), 16)
        var b = parseInt(hex.substr(5, 2), 16)
        return 0.299 * r + 0.587 * g + 0.114 * b
    }
    // Terminal cursor display mode.
    //   0 = disabled (no cursor overlay; rely on what the shell renders)
    //   1 = static (no blink animation, just the rectangle) — DEFAULT
    //   2 = animated (pulse/blink — opt-in via Settings)
    //   3 = interpolated (smoothly slides between positions on cursor move)
    // Future modes (eye-tracked, etc.) added here without breaking save/load.
    //
    // v0.1.99 default changed from 2 (animated) to 1 (static) per user
    // request — most folks find blinking distracting. Animation modes
    // remain available via Settings.
    //
    // v0.1.106: persisted via backend.cursor_mode property. Initial
    // value comes from settings.conf (loaded by Backend::new). When
    // user changes it via Settings UI, we write back to backend
    // and call save_settings so the next launch sees the same mode.
    property int cursorMode: backend ? backend.cursor_mode : 1
    onCursorModeChanged: {
        if (backend && backend.cursor_mode !== cursorMode) {
            backend.cursor_mode = cursorMode
            if (backend.save_settings) backend.save_settings()
        }
    }
