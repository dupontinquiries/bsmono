                                    else if(model.url==="_archive"&&backend){backend.archive_page();rebuildBrowserPalette();return}
                                    else if(model.url==="_discover_site"&&backend){var d=backend.last_query.toString().replace(/https?:\/\//,"").split("/")[0];backend.site_discover(d);rebuildBrowserPalette();return}
                                    browserDrawer.close()
