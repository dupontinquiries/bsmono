                            var ctx = getContext("2d")
                            ctx.clearRect(0, 0, width, height)
                            var pgs = cardsCanvas._walkPages
                            if (!cardsCanvas._walkActive || pgs.length === 0) return
                            var dx = -cardsCanvas.graphMinX
                            var dy = -cardsCanvas.graphMinY
                            // Polyline through all walk pages.
                            ctx.lineCap = "round"
                            ctx.lineJoin = "round"
                            for (var i = 0; i < pgs.length - 1; i++) {
                                var a = pgs[i], b = pgs[i+1]
                                var traversed = (i < cardsCanvas._walkStep)
                                ctx.beginPath()
                                ctx.moveTo(a.x + dx, a.y + dy)
                                ctx.lineTo(b.x + dx, b.y + dy)
                                ctx.globalAlpha = traversed ? 0.9 : 0.25
                                ctx.lineWidth = traversed ? 4 : 2
                                ctx.strokeStyle = th.ac
                                ctx.stroke()
                            }
