            // height calculation occasionally undercounts —
            // typically when an embedded Layout uses
            // preferredHeight that doesn't match actual
            // rendered height — leaving content clipped at the
            // bottom. The extra 16px buffer absorbs the
            // discrepancy without visibly changing the layout
            // (it just becomes white-space at the bottom of
            // the popup when content fits exactly).
            contentColV.implicitHeight + (_hintsLayoutMode === "stacked" ? hintsStacked.height + 16 : 0) + 56)
        property bool recording: false
        property bool processing: false
        property real topScore: 0.0
        property bool showCandidates: false
        property string diagText: ""
