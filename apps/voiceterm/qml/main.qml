                                // the WRONG position).
                                // v0.1.845 PANE_VOICE: when the gate is on AND a
                                // target/broadcast is set, the command routes to
                                // another pane — so skip the active-pane type
                                // overlay (it would animate on the wrong pane).
                                var pvRoute = backend.pane_voice_enabled
                                    && backend.pane_voice_enabled()
                                    && (backend.voice_broadcast_list().length > 0
                                        || backend.voice_target_pane_id() >= 0)
                                if (_typeOverlay && _typeOverlay.visible
                                    && intentParam && intentParam.length > 0 && !pvRoute) {
                                    _typeOverlay.spawnSequence(intentParam)
                                }
                                // Route through pane_voice_dispatch (addressable /
                                // broadcast); it falls back to the focused pane's
                                // pty_write when the gate is off → no behavior
                                // change unless WEB2QML_PANE_VOICE=1.
                                if (backend.pane_voice_dispatch) {
                                    var _pvr = backend.pane_voice_dispatch(intentParam + "\r")
                                    // v0.1.849: a "cmd\t<detail>\t<speaker>" result means a
                                    // spoken routing command was applied (nothing typed) —
                                    // toast it so the user gets confirmation. "broadcast\t.."
                                    // means it fanned out to N panes; also worth a toast.
                                    if (_pvr && _pvr.length > 0 && typeof toast !== "undefined" && toast.show) {
                                        var _pvp = _pvr.split("\t")
                                        if (_pvp[0] === "cmd") toast.show("Voice: " + _pvp[1])
                                        else if (_pvp[0] === "broadcast") toast.show("Broadcast → " + _pvp[1] + " pane(s)")
                                        else if (_pvp[0] === "target") toast.show("Voice → pane " + _pvp[1])
                                    }
                                } else {
                                    backend.pty_write(intentParam + "\r")
                                }
                                // v0.1.106: undo toast for cd commands.
                                // After a cd lands, OSC 7 will fire from
                                // the shell and update block_tracker's
                                // current_cwd, pushing the old value into
                                // previous_cwd. Schedule a delayed check
                                // (300ms gives the shell time to emit OSC
                                // 7 and us to process it) — if previous_cwd
                                // is non-empty AND differs from a stored
                                // baseline, show the undo toast.
                                if (intentParam.trim().match(/^cd($|\s)/)) {
                                    _smartCdUndoTimer.restart()
                                }
                            }
                        }
                    }
                    break
                case "settings": settingsPopup.open(); break
                case "homepage": showHomepage(); break
                case "quit":
                    // Voice "quit" is dangerous and ambiguous. We NEVER let it
                    // directly close the app. Three layers of defense:
                    //   1. Backend filter removes Quit from candidates on
                    //      terminal tab (cands.retain in voice_parse_candidates)
                    //   2. On terminal tab here, route to :q\r (helix/vim) so
                    //      the user exits the running TUI, not the whole app
                    //   3. On browser tab, show a confirmation popup rather
                    //      than calling Qt.quit() directly — voice
                    //      misrecognitions and accidental triggers happen,
                    //      and losing the whole session is too costly to
                    //      accept as an unconfirmed action.
                    if (tabBar.currentIndex === 1) {
                        console.log("[quit] terminal tab: routing to :q\\r")
                        if (backend) {
                            backend.pty_write_byte(0x1b)  // ESC (helix/vim normal mode)
                            backend.pty_write_byte(0x3a)  // :
                            backend.pty_write_byte(0x71)  // q
                            backend.pty_write_byte(0x0d)  // Enter
                        }
                    } else {
                        console.log("[quit] browser tab: opening confirmQuitDialog")
                        confirmQuitDialog.open()
                    }
                    break
                case "sysinfo":
                    // Description was already shown — nothing more to do
                    break
                case "email":
                    backend.open_email(intentParam, intentParam2 || "")
                    break
                case "file_append":
                    backend.file_append(intentParam, intentParam2 || "")
                    break
                case "llm":
                    // Async — popup re-opens with a "Thinking..." state, then result fills in
                    _reopenDuringDispatch = true  // v0.1.458: keep popup open for the async result
                    voicePopup.recognizedText = "\u23F3 Asking local LLM..."
                    voicePopup.intentKind = ""
                    voicePopup.open()
                    backend.llm_query_async(intentParam)
                    llmPollTimer.start()
                    break
                case "freeform":
                    {
                        var hpw = (recognizedText || intentParam || "").trim().toLowerCase()
                        // v0.1.710: if the notes wizard is open, its walk-through
                        // phrases ("next", "timestamps", "create"…) drive it.
                        if (notesWizard.visible && notesWizard.handleVoice(hpw)) break
                        // open the wizard: "set up my notes" / "new zettelkasten"
                        if (/^(set up (my )?notes|notes wizard|new zettelkasten|set up (a |my )?zettelkasten|start (a )?zettelkasten)$/.test(hpw)) {
                            notesWizard.open()
                            break
                        }
                        // open the peer handshake: "connect to a peer" / "peer
                        // handshake" / "share my workspace".
                        if (/^(connect to (a )?peer|peer handshake|handshake|share (my )?workspace|pair with (a )?developer)$/.test(hpw)) {
                            peerPanel.open()
                            break
                        }
                        // v0.1.725: recent-fact lookup — "insert that last IP",
                        // "insert the IP for kwin", "scroll up to the hash". The
                        // backend parses + acts (insert = typed at cursor).
                        if (/^(insert|type|paste|put in|write|scroll back to|scroll up to|scroll to|go back to|jump back to|jump to) /.test(hpw)
                            && backend.recent_fact) {
                            var rf = backend.recent_fact(recognizedText || intentParam || "").split("\t")
                            if (rf[0] === "inserted") {
                                // already typed at the cursor; surface to the user.
                                if (typeof showToast === "function") showToast("Inserted: " + rf[1])
                                break
                            } else if (rf[0] === "scroll") {
                                // reuse the terminal find bar's proven search +
                                // jump path: switch to the terminal, open find,
                                // pre-fill the literal, run the search.
                                tabBar.currentIndex = 1; swipeView.currentIndex = 1
                                if (typeof termFindBar !== "undefined") {
                                    termFindBar.visible = true
                                    termFindField.text = rf[1]
                                    termFindField.accepted()
                                }
                                break
                            }
                            // "none" → fall through to normal handling below.
                        }
                    }
                    // v0.1.703 (#2): mux help — "what can I say" / "zellij
                    // help" / "tmux commands" lists the voice vocabulary.
                    {
                        var hp = (recognizedText || intentParam || "").trim().toLowerCase()
                        if (/^(what can i say|mux help|zellij help|zellij commands|tmux help|tmux commands|gitmind help|gitmind commands|gin help|gin commands|show commands)$/.test(hp)) {
                            var inZ = backend.zellij_active && backend.zellij_active()
                            var inT = backend.tmux_active && backend.tmux_active()
                            var inG = backend.gitmind_active && backend.gitmind_active()
                            var vocab = inZ ? (backend.zellij_commands ? backend.zellij_commands() : "")
                                : inT ? (backend.tmux_commands ? backend.tmux_commands() : "")
                                : inG ? (backend.gitmind_commands ? backend.gitmind_commands() : "") : ""
                            if (vocab.length > 0) {
                                muxHelpOverlay.rows = vocab.split("\n").map(function(l){
                                    var pp = l.split("\t"); return { label: pp[0], hint: pp[1] || "" } })
                                muxHelpOverlay.title = (inZ ? "zellij" : inT ? "tmux" : "gitmind") + " voice commands"
                                muxHelpOverlay.open = true
                                break
                            }
                        }
                    }
                    // multiplexer + ssh voice control. In a zellij/tmux session
                    // a phrase is tried as a mux command first; "connect to
                    // <host>" routes to ssh. Falls through to web search.
                    if (backend.zellij_active && backend.zellij_active()
                        && backend.zellij_translate) {
                        var zw = backend.zellij_translate(recognizedText || intentParam || "")
                        if (zw && zw.length > 0) {
                            _runMuxCommand(zw, "zellij")
                            break
                        }
                    }
                    if (backend.tmux_active && backend.tmux_active()
                        && backend.tmux_translate) {
                        var tw = backend.tmux_translate(recognizedText || intentParam || "")
                        if (tw && tw.length > 0) {
                            _runMuxCommand(tw, "tmux")
                            break
                        }
                    }
                    // gitmind (gin) CLI: in a gitmind repo a phrase is tried as
                    // a `gin` command. Unlike the mux query path, gin output is
                    // shown in the terminal directly (it's not pane/tab JSON), so
                    // we just run it — only the overwriting `extract` confirms.
                    if (backend.gitmind_active && backend.gitmind_active()
                        && backend.gitmind_translate) {
                        var gw = backend.gitmind_translate(recognizedText || intentParam || "")
                        if (gw && gw.length > 0) {
                            var gp = gw.split("\t")
                            var gcmd = gp[0]
                            if (gp[1] === "1") { // confirm (restore/extract)
                                _pendingZellijCmd = gcmd
                                zellijConfirm.bodyText = "Run \u201c" + gcmd + "\u201d?"
                                zellijConfirm.open()
                            } else {
                                backend.pty_write(gcmd + "\r")
                                if (typeof toast !== "undefined") toast.show(gcmd, "info")
                            }
                            break
                        }
                    }
                    if (backend.ssh_connect) {
                        var sc = backend.ssh_connect(recognizedText || intentParam || "")
                        if (sc && sc.length > 0) {
                            backend.pty_write(sc + "\r")
                            if (typeof toast !== "undefined") toast.show(sc, "info")
                            break
                        }
                    }
                    if (intentParam.indexOf(".") >= 0 && intentParam.indexOf(" ") < 0) {
                        urlBar.text = intentParam; loading = true; backend.last_query = intentParam
                        backend.nav(intentParam)
                    } else { backend.search_web(intentParam); loading = true }
                    break
                case "find_anywhere":
                    findAnywhereChooser.term = intentParam
                    findAnywhereChooser.open()
                    break
                case "workflow_rec_start":
                    // v0.1.115: voice trigger "start recording <name>".
                    // intentParam = workflow name.
                    if (backend && backend.workflow_start_recording) {
                        var ok = backend.workflow_start_recording(intentParam)
                        if (typeof toast !== "undefined" && toast.show) {
                            toast.show(ok
                                ? "Recording workflow: " + intentParam
                                : "Couldn't start recording")
                        }
                    }
                    break
                case "workflow_rec_stop":
                    // "stop recording" / "save workflow" / etc.
                    if (backend && backend.workflow_stop_recording) {
                        var saved = backend.workflow_stop_recording()
                        if (typeof toast !== "undefined" && toast.show) {
                            toast.show(saved && saved.length > 0
                                ? "Saved workflow: " + saved
                                : "No active recording")
                        }
                    }
                    break
                case "workflow_playback":
                    // "run workflow <name>" / "replay <name>".
                    // Starts the playback state machine; _wfPlaybackTimer
                    // pulls commands one at a time and feeds them into PTY
                    // with a 600ms gap (enough for most quick commands;
                    // slow ones will queue and run sequentially).
                    if (backend && backend.workflow_start_playback) {
                        var ok = backend.workflow_start_playback(intentParam)
                        if (ok) {
                            if (typeof toast !== "undefined" && toast.show) {
                                toast.show("Playing workflow: " + intentParam)
                            }
                            _wfPlaybackTimer.restart()
                        } else {
                            if (typeof toast !== "undefined" && toast.show) {
                                toast.show("Workflow not found: " + intentParam)
                            }
                        }
                    }
                    break
                case "click_link":
                    // v0.1.724: search-then-act. Instead of a blind fuzzy
                    // click, ask the backend to plan it: one strong match →
                    // confirm chip; a few → numbered chooser; many → list.
                    if (backend.click_search) {
                        var plan = backend.click_search(intentParam).split("\n")
                        var head = plan[0].split("\t")
                        var verb = head[0]
                        if (verb === "confirm") {
                            clickChooser.openConfirm(head[1], head[2], parseFloat(head[3] || "0"))
                        } else if (verb === "few" || verb === "many") {
                            var items = []
                            // first row's payload starts at head[1]/head[2]
                            if (head.length >= 3) items.push({ id: head[1], label: head[2] })
                            for (var ci = 1; ci < plan.length; ci++) {
                                var pr = plan[ci].split("\t")
                                if (pr.length >= 2) items.push({ id: pr[0], label: pr[1] })
                            }
                            clickChooser.openChoose(intentParam, items)
                        } else {
                            // none → fall back to find-on-page
                            findBar.visible = true; findField.text = intentParam; findField.accepted()
                        }
                        break
                    }
                    var url = backend.find_link_fuzzy(intentParam)
                    if (url) {
                        loading = true; backend.last_query = url
                        backend.nav(url)
                    } else {
                        findBar.visible = true; findField.text = intentParam; findField.accepted()
                    }
                    break
                case "scroll_heading":
                    var anchor = backend.find_heading_fuzzy(intentParam)
                    if (anchor) {
                        backend.anchor_fragment = anchor
                        backend.anchor_changed()
                    } else {
                        // Fallback: find-in-page
                        findBar.visible = true; findField.text = intentParam; findField.accepted()
                    }
                    break
                case "copy":
                    var clipboardText = ""
                    switch (intentParam) {
                        case "url":
                            clipboardText = backend.last_query; break
                        case "title":
                            clipboardText = root.title; break
                        case "selection":
                            // Use whatever's selected; if nothing, fall back to URL
                            clipboardText = root.title; break
                        case "page_text":
                            clipboardText = backend.last_query  // best we have without DOM access
                            break
                        case "last_terminal_output":
                            clipboardText = backend.last_terminal_output(); break
                        case "last_command":
                            clipboardText = backend.last_terminal_command(); break
                    }
                    if (clipboardText) {
                        backend.clipboard_set(clipboardText)
                    }
                    break
                case "paste":
                    var pasteText = backend.clipboard_get()
                    if (!pasteText) break
                    if (intentParam === "term" || (intentParam === "auto" && tabBar.currentIndex === 1)) {
                        backend.pty_paste(pasteText)
                    } else if (intentParam === "find") {
                        findBar.visible = true; findField.text = pasteText; findField.accepted()
                    } else {
                        urlBar.text = pasteText; urlBar.forceActiveFocus()
                    }
                    break
                case "rerun_last":
                    tabBar.currentIndex = 1; swipeView.currentIndex = 1
                    backend.rerun_last_command()
                    break
                case "hist_search":
                    tabBar.currentIndex = 1; swipeView.currentIndex = 1
                    backend.pty_write("\x12")  // Ctrl+R for reverse history search
                    backend.pty_write(intentParam)
                    break
                case "toggle":
                    switch (intentParam) {
                        case "ads": backend.filter_ads = (backend.filter_ads + 1) % 3; break
                        case "monospace": backend.use_monospace = !backend.use_monospace; break
                        case "compat_ua": backend.compat_ua = backend.compat_ua > 0 ? 0 : 1; break
                    }
                    break
                case "dictate":
                    // Type into focused input. Easiest path: set URL bar text if visible
                    if (urlBar.activeFocus) urlBar.text = intentParam
                    else if (findField.activeFocus) findField.text = intentParam
                    else if (tabBar.currentIndex === 1) backend.pty_write(intentParam)
                    else { urlBar.text = intentParam; urlBar.forceActiveFocus() }
                    break
            }
        }

        // Wait for start chime to fully finish (~140ms) plus audio settling
        // before recording. With 100ms the chime tail bled into the buffer and
        // whisper hallucinated leading "and ..." on every utterance.
        Timer { id: voiceStartTimer; interval: 250; onTriggered: voiceTimer.start() }

        // The voice_listen_dual call returns whisper text + top phonetic matches.
        // It blocks for ~1-7s recording (VAD-controlled) + ~500ms whisper.
        //
        // v0.1.135: now uses the ASYNC variant so the UI thread isn't
        // blocked during recording + whisper inference. voiceTimer
        // kicks off the worker; voicePollTimer ticks at 100ms checking
        // for completion. On mobile this is the difference between a
        // multi-second freeze and a responsive UI.
        Timer { id: voiceTimer; interval: 50; onTriggered: {
            if (!backend) { voicePopup.recording = false; return }
            if (backend.voice_listen_dual_async) {
                backend.voice_listen_dual_async()
                voicePollTimer.start()
            } else {
                // Fallback for builds without async support.
                var raw0 = backend.voice_listen_dual()
                voicePopup._handleListenResult(raw0)
            }
        } }

        // Poll the async listen worker. Started by voiceTimer; stops
        // itself when the worker reports a non-empty result. Ticks at
        // 100ms — short enough to feel snappy, long enough not to
        // hammer the lock.
        //
        // Hard timeout at 15s — handles edge cases where the worker
        // gets stuck (audio device removed mid-capture, etc.). If
        // triggered we bail out gracefully rather than leave the
        // popup waiting forever.
        Timer { id: voicePollTimer; interval: 100; repeat: true
            property int _ticks: 0
            onTriggered: {
                if (!backend) { stop(); _ticks = 0; voicePopup.recording = false; return }
                _ticks++
                if (_ticks > 150) {
                    stop(); _ticks = 0
                    voicePopup.recording = false
                    voicePopup.processing = false
                    voicePopup.close()
                    if (typeof toast !== "undefined" && toast.show) {
                        toast.show("Voice capture timed out")
                    }
                    return
                }
                var raw = backend.voice_listen_dual_poll
                    ? backend.voice_listen_dual_poll() : ""
                if (raw && raw.length > 0) {
                    stop(); _ticks = 0
                    // Drain the audio into self.last_audio_buffer
                    // before processing the result so downstream
                    // voice_confirm / speaker_register_current sees
                    // the right buffer.
                    if (backend.voice_listen_dual_take_audio) {
                        backend.voice_listen_dual_take_audio()
                    }
                    voicePopup._handleListenResult(raw)
                }
            }
            onRunningChanged: { if (!running) _ticks = 0 }
        }

        // Result-handling logic, extracted so both sync and async
        // paths share it. The processing here is cheap (string
        // parsing, property assignments) — only the recording+
        // inference work needed to be moved off the UI thread.
        function _handleListenResult(raw) {
            // Backend sentinel: refused due to password mode. Don't
            // proceed with the recording flow — close popup and toast
            // a clear explanation. The whole point of password-mode
            // suppression is the user shouldn't be vocalizing while
            // typing a password; surfacing the refusal helps them
            // notice if they triggered the popup by accident.
            if (raw === "\x01PWMODE\x01") {
                voicePopup.recording = false
                voicePopup.processing = false
                voicePopup.close()
                if (typeof toast !== "undefined" && toast.show) {
                    toast.show("Voice paused — password prompt active")
                }
                return
            }
            // v0.1.267: corpus-confirmed filler sentinel. Format:
            // "\x01FILLER:<text>\x01". The backend detected this
            // utterance matches one the user has explicitly marked
            // (or repeatedly rejected) as filler — short-circuit
            // the popup with a subtle toast so the user knows
            // we heard them, just chose to skip parsing.
            //
            // The toast text is INFORMATIONAL, not actionable.
            // If user wants to un-mark, they go through settings.
            // Keeping the popup quiet for fillers is the whole
            // point — the bug case was "Mh mhmmm" repeatedly
            // surfacing a popup with garbage suggestions.
            if (raw.indexOf("\x01FILLER:") === 0) {
                var fillerEnd = raw.indexOf("\x01", 8)
                var fillerText = fillerEnd > 0 ? raw.substring(8, fillerEnd) : ""
                voicePopup.recording = false
                voicePopup.processing = false
                voicePopup.close()
                if (typeof toast !== "undefined" && toast.show) {
                    // Truncate long text for toast readability.
                    var disp = fillerText.length > 30
                        ? fillerText.substring(0, 30) + "..."
                        : fillerText
                    toast.show("Filler: \"" + disp + "\"")
                }
                return
            }
            // v0.1.624: new-speaker sentinel. Format: "\x01NEWSPEAKER\x01".
            // The backend's new-speaker detector saw a brand-new UNKNOWN
            // voice recur in a clustered run (a guest who wants to jump
            // in), and is offering the OWNER an enroll prompt. We reuse
            // the PROVEN register flow (_registerBox) rather than a new
            // popup: set _userRequestedAdd so the registration UI surfaces
            // to whoever holds the device (owner confirms first). The
            // utterance audio was kept by the backend (last_audio_buffer)
            // so the enroll uses this voice as the first sample. We reset
            // the detector either way so it can offer again for a later
            // newcomer (the register flow's finish path calls
            // backend.new_speaker_reset()).
            if (raw.indexOf("\x01NEWSPEAKER\x01") === 0) {
                voicePopup.recording = false
                voicePopup.processing = false
                voicePopup.close()
                if (typeof _registerBox !== "undefined") {
                    _registerBox._userRequestedAdd = true
                    _registerBox._refreshNeed()
                    if (typeof toast !== "undefined" && toast.show)
                        toast.show("Someone new is speaking — add them?")
                } else if (typeof toast !== "undefined" && toast.show) {
                    toast.show("A new voice was detected")
                }
                // reset so a later newcomer can offer again even if the
                // owner ignores this one (avoids a permanently-latched
                // detector if the register UI isn't acted on).
                if (backend && backend.new_speaker_reset) backend.new_speaker_reset()
                return
            }
            // v0.1.119: muted-speaker sentinel. Format: "\x01MUTED:<name>\x01".
            // Backend identified a disallowed speaker and discarded
            // the utterance.
            //
            // v0.1.263: instead of just toast-and-close, offer the
            // muted speaker an explicit unmute/enroll path. This
            // fixes the v0.1.249 hardware-test bug where Allison
            // (a guest tester) spoke 6+ times and was silently
            // muted each time, with no clear path for the OWNER
            // to enable her. The popup explains the situation and
            // gives a single tap option to allow her voice
            // commands going forward.
            if (raw.indexOf("\x01MUTED:") === 0) {
                var endIdx = raw.indexOf("\x01", 7)
                var mutedName = endIdx > 0 ? raw.substring(7, endIdx) : "speaker"
                voicePopup.recording = false
                voicePopup.processing = false
                voicePopup.close()
                // Surface enrollment popup with the muted name.
                if (typeof _mutedEnrollPopup !== "undefined") {
                    _mutedEnrollPopup._mutedName = mutedName
                    _mutedEnrollPopup.open()
                } else if (typeof toast !== "undefined" && toast.show) {
                    // Fallback: just toast if popup missing.
                    toast.show("Ignored (muted): " + mutedName)
                }
                return
            }
            var parts = raw.split("\x1F")
            voicePopup.whisperText = parts[0] || ""
            if (voicePopup.whisperText && voicePopup.whisperText.length >= 3) {
                root._recentUtterance = voicePopup.whisperText
                root._utteranceTickMs = Date.now()
            }
            voicePopup.phoneticMatch = parts.length > 1 ? parts[1] : ""
            voicePopup.phoneticScore = parts.length > 2 ? parseFloat(parts[2]) || 999 : 999
            voicePopup.phoneticMatch2 = parts.length > 3 ? parts[3] : ""
            voicePopup.phoneticScore2 = parts.length > 4 ? parseFloat(parts[4]) || 999 : 999
            voicePopup.speakerScore = parts.length > 5 ? parseFloat(parts[5]) || 0.5 : 0.5
            if (voicePopup.openedForWakeRegistration) {
                if (!voicePopup.whisperText || voicePopup.whisperText.length < 2) {
                    toast.show("No speech captured — try again")
                    voicePopup.recording = false
                    voicePopup.processing = false
                    return
                }
                if (backend.voice_register_wake_word) {
                    var ok = backend.voice_register_wake_word(voicePopup.whisperText)
                    if (ok) {
                        toast.show("Wake word registered: \"" + voicePopup.whisperText + "\"")
                    } else {
                        toast.show("Couldn't register — no audio captured")
                    }
                }
                voicePopup.openedForWakeRegistration = false
                voicePopup.close()
                return
            }
            // v0.1.212 (ship 2.6.5): onboarding capture routing. If
            // onboardingActive is set, the user just read a paragraph
            // aloud for the registration flow. Instead of dispatching
            // their words as a command (which would try to navigate
            // somewhere or run a terminal command from the captured
            // text), open the registration dialog with the derived
            // color preview.
            //
            // The last_audio_buffer is populated by the voice listen
            // path before we get here; speaker_preview_color reads
            // from it directly. Same buffer is used by
            // speaker_register_current on Save, so the derived color
            // is the one stored.
            if (root.onboardingActive) {
                if (!voicePopup.whisperText || voicePopup.whisperText.length < 2) {
                    toast.show("No speech captured — try reading again")
                    voicePopup.recording = false
                    voicePopup.processing = false
                    return
                }
                var color = backend && backend.speaker_preview_color
                    ? backend.speaker_preview_color() : ""
                speakerRegistrationPopup.previewColor = color
                voicePopup.close()
                speakerRegistrationPopup.open()
                return
            }
            voicePopup.processResult(voicePopup.whisperText)
        }

        // ─── Auto-listen confirmation flow ───
        // After candidates appear, we start a SECOND listening pass so the
        // user can say "yes" / "no" / or even a fragment of a candidate
        // name without tapping. The flow:
        //   1. processIntentTimer resolves → calls startConfirmListen()
        //   2. confirmListenStartTimer fires → arms ring buffer + chimes
        //   3. confirmListenTimer fires → blocks on voice_listen_dual
        //   4. result lands → processConfirmResult() handles yes/no/skip
        //      / matches candidate phonetically / falls through to new
        //      command parse if utterance is long enough
        // Cancellation: any tap (inside popup, outside, anywhere) calls
        // cancelConfirmListen() which sets voice_cancel on the backend.
        //
        // We deliberately use a separate set of timers from the primary
        // voice flow so a confirm listen can't collide with a fresh
        // user-initiated capture if they happen to overlap.
        Timer { id: confirmListenStartTimer; interval: 200
            // v0.1.122: was 350ms. Reduced because user reported
            // confirm-listen feels slow now that multi-user backend
            // work adds per-utterance latency elsewhere. 200ms is
            // still long enough for the "ok" tone to mostly finish
            // before the mic opens; if start-tones are an issue,
            // user can disable them via voiceMode=1.
            onTriggered: {
                if (!voicePopup._confirmListening) return
                if (!backend) return
                backend.voice_begin_capture()
                confirmListenTimer.start()
            } }
        Timer { id: confirmListenTimer; interval: 50
            onTriggered: {
                if (!voicePopup._confirmListening) return
                if (!backend) { voicePopup._confirmListening = false; return }
                // Hint to backend: this transcription will be SHORT
                // (yes/no/cancel/single candidate name). Use Tiny model
                // only — finishes in ~200-400ms vs Base's ~1000ms.
                // One-shot flag, backend clears it after use.
                if (backend.voice_set_force_tiny) {
                    backend.voice_set_force_tiny(true)
                }
                // v0.1.122: also arm fast-finalize so VAD doesn't wait
                // the full 825ms after "yes" stops. Tightens to 450ms.
                if (backend.voice_set_fast_finalize) {
                    backend.voice_set_fast_finalize(true)
                }
                // v0.1.135: async listen so we don't freeze the UI for
                // the 200-1000ms whisper inference on "yes"/"no" replies.
                // confirmPollTimer polls until completion.
                if (backend.voice_listen_dual_async) {
                    backend.voice_listen_dual_async()
                    confirmPollTimer.start()
                } else {
                    var raw0 = backend.voice_listen_dual()
                    voicePopup._handleConfirmResult(raw0)
                }
            } }

        // Async poll for confirm-listen result.
        Timer { id: confirmPollTimer; interval: 80; repeat: true
            property int _ticks: 0
            onTriggered: {
                if (!backend || !voicePopup._confirmListening) {
                    stop(); _ticks = 0; return
                }
                _ticks++
                if (_ticks > 100) {  // ~8s timeout
                    stop(); _ticks = 0
                    voicePopup._confirmListening = false
                    return
                }
                var raw = backend.voice_listen_dual_poll
                    ? backend.voice_listen_dual_poll() : ""
                if (raw && raw.length > 0) {
                    stop(); _ticks = 0
                    if (backend.voice_listen_dual_take_audio) {
                        backend.voice_listen_dual_take_audio()
                    }
                    voicePopup._handleConfirmResult(raw)
                }
            }
            onRunningChanged: { if (!running) _ticks = 0 }
        }

        function _handleConfirmResult(raw) {
            if (raw && raw.indexOf("\x01MUTED:") === 0) {
                voicePopup._confirmListening = false
                if (typeof toast !== "undefined" && toast.show) {
                    var endIdx = raw.indexOf("\x01", 7)
                    var mutedName = endIdx > 0 ? raw.substring(7, endIdx) : "speaker"
                    toast.show("Ignored (muted): " + mutedName)
                }
                return
            }
            var parts = raw.split("\x1F")
            var text = parts[0] || ""
            voicePopup._confirmListening = false
            voicePopup.processConfirmResult(text)
        }

        // Poll for async LLM result. Started by case "llm". Stops when result arrives.
        Timer { id: llmPollTimer; interval: 200; repeat: true
            property int _ticks: 0
            onTriggered: {
                if (!backend) { stop(); return }
                _ticks++
                if (_ticks > 60) { // 12s hard cap on UI side too
                    stop(); _ticks = 0
                    voicePopup.recognizedText = "[LLM timed out]"
                    return
                }
                var r = backend.llm_poll_result()
                if (r && r.length > 0) {
                    stop(); _ticks = 0
                    voicePopup.recognizedText = "LLM: " + r
                }
            }
            onRunningChanged: { if (!running) _ticks = 0 }
        }

        Timer { id: processIntentTimer; interval: 200; onTriggered: {
            if (!backend) return
            voicePopup.processing = false
            if (!voicePopup.recognizedText || voicePopup.recognizedText.startsWith("[")) {
                voicePopup.intentKind = "error"
                voicePopup.intentDesc = voicePopup.recognizedText || "No speech detected"
                backend.play_tone("error")
                return
            }
            // Get ranked candidates instead of single best parse
            // Tell backend the current tab BEFORE parsing so it can demote
            // browser-targeted intents when user is in the terminal.
            // NOTE: previously this was guarded by `if (backend.voice_set_context_tab)`
            // but qmetaobject methods don't expose as truthy properties in QML —
            // the guard ALWAYS failed, the setter NEVER fired, and context_tab
            // silently stayed at the default "browser" for the entire app lifetime.
            // That's why voice "quit" wasn't being filtered on the terminal tab,
            // why bluetooth bootstrap was never firing as terminal-context, and
            // why every [parse] log line said context_tab="browser" regardless
            // of which tab the user was on.
            var currentTab = tabBar.currentIndex === 1 ? "terminal" : "browser"
            console.log("[voice] currentTab=" + currentTab + " (tabBar.currentIndex=" + tabBar.currentIndex + ")")
            backend.voice_set_context_tab(currentTab)
            var raw = backend.voice_parse_candidates(voicePopup.recognizedText)
            voicePopup.candidates.clear()
            voicePopup.diagText = ""
            var topKind = "unknown", topDesc = "", topP1 = "", topP2 = "", topScore = 0.0
            var allLines = raw.split("\n").filter(function(l){return l.length > 0})
            var visibleIdx = 0
            for (var i = 0; i < allLines.length; i++) {
                var p = allLines[i].split("\x1F")
                if (p.length < 6) continue
                // Diagnostic candidate marker
                if (p[5] === "_diag") {
                    voicePopup.diagText = p[2] || ""
                    continue
                }
                var score = parseFloat(p[4]) || 0
                // v0.1.358: destructive flag arrives as "0"/"1"
                // in p[6]. Default false when the field is
                // missing (older builds, diag rows, etc.).
                var destructive = (p.length >= 7 && p[6] === "1")
                voicePopup.candidates.append({
                    kind: p[0], desc: p[1], p1: p[2], p2: p[3],
                    score: score, reason: p[5],
                    destructive: destructive,
                })
                if (visibleIdx === 0) {
                    topKind = p[0]; topDesc = p[1]; topP1 = p[2]; topP2 = p[3]; topScore = score
                }
                visibleIdx++
            }
            // Set top candidate as the active one
            voicePopup.intentKind = topKind
            voicePopup.intentDesc = topDesc
            voicePopup.intentParam = topP1
            voicePopup.intentParam2 = topP2
            voicePopup.topScore = topScore
            // Show the picker if 2+ candidates and the gap between top-1 and top-2 is small
            voicePopup.showCandidates = false
            if (voicePopup.candidates.count >= 2) {
                var sec = voicePopup.candidates.get(1).score
                if (topScore - sec < 0.2 || topScore < 0.7) {
                    voicePopup.showCandidates = true
                }
            }
            if (voicePopup.intentKind === "unknown") backend.play_tone("error")
            else backend.play_tone("ok")
            // After candidates resolve, automatically start a short
            // confirmation-listen so the user can say "yes" / "no" / a
            // candidate name without tapping again. We only auto-listen
            // when there's at least one usable intent — no point listening
            // if we have nothing actionable to confirm.
            if (voicePopup.intentKind && voicePopup.intentKind !== "unknown"
                && voicePopup.intentKind !== "error" && voicePopup.opened)
            {
                voicePopup.startConfirmListen()
            }
        } }

        ColumnLayout {
            id: contentColV
            // Width: leave room for the sidebar when present. Without
            // sidebar, fill the popup. Without this binding the column
            // would always span the full width and the sidebar would
            // overlap the candidate buttons.
            anchors.left: parent.left; anchors.top: parent.top
            // Bottom anchor varies: in sidebar mode the column fills the
            // popup height alongside the right-anchored sidebar. In stacked
            // mode the column shrinks to its content and the hints panel
            // sits below it.
            anchors.bottom: voicePopup._hintsLayoutMode === "sidebar" ? parent.bottom : undefined
            anchors.margins: 20
            // Width: in sidebar mode, leave 240+gutter for the right panel.
            // Otherwise fill the popup minus default margins.
            width: voicePopup._hintsLayoutMode === "sidebar"
                ? parent.width - 240 - 30
                : parent.width - 40
            spacing: 14

            // Header
            RowLayout { Layout.fillWidth: true; spacing: 10
                Rectangle { width: 44; height: 44; radius: 22
                    color: voicePopup.recording ? "#dc2626" : voicePopup.processing ? th.lh : th.ac
                    Behavior on color { ColorAnimation { duration: 150 } }
                    Text { anchors.centerIn: parent
                        text: voicePopup.recording ? "\u25CF" : voicePopup.processing ? "\u29D7" : "\uD83C\uDFA4"
                        color: "#fff"; font.pixelSize: 20
                        RotationAnimator on rotation { from: 0; to: 360; duration: 1200; loops: Animation.Infinite; running: voicePopup.processing }
                        SequentialAnimation on opacity { running: voicePopup.recording; loops: Animation.Infinite
                            NumberAnimation { from: 1.0; to: 0.4; duration: 600 }
                            NumberAnimation { from: 0.4; to: 1.0; duration: 600 }
                        }
                    }
                }
                ColumnLayout { Layout.fillWidth: true; spacing: 2
                    Text {
                        text: voicePopup.recording
                                ? (voicePopup.openedForWakeRegistration
                                    ? "Recording wake word..."
                                    : voicePopup.openedByWake
                                        ? "Listening... (wake)"
                                        : "Listening...")
                                : voicePopup.processing ? "Transcribing..."
                                : voicePopup.intentKind === "error" ? "Couldn't hear you"
                                : voicePopup.intentKind ? "Understood" : "Voice"
                        color: th.tc; font.pixelSize: 16; font.bold: true
                    }
                    Text {
                        text: voicePopup.recording
                                ? (voicePopup.openedForWakeRegistration
                                    ? "Say \"Yo Big K\" once, clearly"
                                    : voicePopup.openedByWake
                                        ? "Heard \"Yo Big K\" — speak your command"
                                        : "Speak now (up to 12s, pause 1s when done)")
                                : voicePopup.processing ? ""
                                : voicePopup.intentKind ? "Tap below to confirm"
                                : "Tap mic to start"
                        color: th.tm; font.pixelSize: 11; visible: text.length > 0
                    }
                }
                // X close moved to top-right corner of the popup (see
                // the Item _closeBtn near voicePopup background) to free
                // up header horizontal space and make the close target
                // more discoverable.
            }

            // During recording: prominent "Done" + small "Cancel" buttons.
            // Done finishes recording NOW and proceeds to transcription (keeps audio).
            // Cancel drops the audio and closes the popup.
            //
            // Defensive sizing in v0.1.68 after user reported these
            // weren't clickable in v0.1.67: explicit preferredHeight,
            // explicit z-order so nothing else can sit on top, and
            // explicit MouseArea preferredSize to make sure the hit area
            // is full-button. The bug we suspect is that QML was sizing
            // the row at 0 in some layout-stretch corner case.
            RowLayout { Layout.fillWidth: true; spacing: 8
                visible: voicePopup.recording
                Layout.preferredHeight: visible ? 46 : 0
                Layout.minimumHeight: visible ? 46 : 0
                z: 100
                Rectangle { id: _doneBtn
                    Layout.fillWidth: true; Layout.preferredHeight: 42; Layout.minimumHeight: 42; radius: 21
                    z: 100  // ensure above any sibling
                    // Press-state visual feedback (act-then-verify
                    // policy from v0.1.77 — applied here in v0.1.84
                    // per user request "more immediate visual response
                    // to mouse hover and touch events in voice popup").
                    property bool _pressed: false
                    color: _pressed ? Qt.darker("#16a34a", 1.2)
                        : (_doneMa.containsMouse ? Qt.lighter("#16a34a", 1.15) : "#16a34a")
                    scale: _pressed ? 0.97 : 1.0
                    Behavior on color { ColorAnimation { duration: 80 } }
                    Behavior on scale { NumberAnimation { duration: 100; easing.type: Easing.OutCubic } }
                    Text { anchors.centerIn: parent; text: "\u2713 Done — transcribe now"
                        color: "#fff"; font.pixelSize: 13; font.bold: true }
                    MouseArea { id: _doneMa; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                        propagateComposedEvents: false
                        onPressed: _doneBtn._pressed = true
                        onReleased: _doneBtn._pressed = false
                        onCanceled: _doneBtn._pressed = false
                        onClicked: {
                            if (backend && backend.log_message) {
                                backend.log_message("[ui] voice Done clicked")
                            }
                            if (backend) backend.voice_finish()
                        } }
                }
                Rectangle { id: _cancBtn
                    Layout.preferredWidth: 90; Layout.preferredHeight: 42; Layout.minimumHeight: 42; radius: 21
                    z: 100
                    property bool _pressed: false
                    color: _pressed ? Qt.darker(th.sf, 0.85)
                        : (_cancMa.containsMouse ? Qt.lighter(th.sf, 1.4) : Qt.lighter(th.sf, 1.2))
                    scale: _pressed ? 0.94 : 1.0
                    Behavior on color { ColorAnimation { duration: 80 } }
                    Behavior on scale { NumberAnimation { duration: 100; easing.type: Easing.OutCubic } }
                    border.color: th.bd; border.width: 1
                    Text { anchors.centerIn: parent; text: "Cancel"; color: th.tc; font.pixelSize: 12 }
                    MouseArea { id: _cancMa; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                        propagateComposedEvents: false
                        onPressed: _cancBtn._pressed = true
                        onReleased: _cancBtn._pressed = false
                        onCanceled: _cancBtn._pressed = false
                        onClicked: {
                            if (backend && backend.log_message) {
                                backend.log_message("[ui] voice Cancel clicked")
                            }
                            if (backend) backend.voice_cancel()
                            voicePopup.recording = false
                            voicePopup.processing = false
                            voicePopup.close()
                        } }
                }
            }

            // Recognized text (when available)
            // AI thinking row — shown when an async fragment check is in
            // flight. Small spinner + caption. Animates in/out so it
            // doesn't pop visually. Hidden when no async work is running.
            Rectangle {
                Layout.fillWidth: true
                Layout.preferredHeight: voicePopup._fragmentCheckJobId !== 0 ? 28 : 0
                visible: Layout.preferredHeight > 0
                clip: true; radius: 8
                color: Qt.rgba(th.ac.r, th.ac.g, th.ac.b, 0.12)
                border.color: Qt.rgba(th.ac.r, th.ac.g, th.ac.b, 0.4)
                border.width: 1
                Behavior on Layout.preferredHeight { NumberAnimation { duration: 180; easing.type: Easing.OutQuad } }
                // Use a RowLayout (not Row) so children's vertical center
                // works properly via Layout.alignment. Plain Row with
                // anchors.verticalCenter on children triggers QML warnings
                // and can confuse the parent ColumnLayout's hit-testing,
                // which was likely contributing to the "Done/Cancel
                // unclickable" regression in v0.1.66.
                RowLayout {
                    anchors.left: parent.left; anchors.leftMargin: 10
                    anchors.verticalCenter: parent.verticalCenter
                    spacing: 8
                    BusyIndicator {
                        running: voicePopup._fragmentCheckJobId !== 0
                        Layout.preferredWidth: 16
                        Layout.preferredHeight: 16
                        Layout.alignment: Qt.AlignVCenter
                    }
                    Text {
                        text: "Thinking… (say 'cancel' to skip)"
                        color: th.tc; font.pixelSize: 11
                        Layout.alignment: Qt.AlignVCenter
                    }
                }
            }

            // ── Speaker circles overlay (v0.1.117) ──
            //
            // Shows a horizontal row of small circles, one per
            // registered speaker. When backend.speaker_active_name()
            // matches a circle's speaker, that circle pulses
            // (scale 1.0 → 1.15 → 1.0 over 600ms). Tap to register
            // self if none active.
            //
            // The circles row only appears when at least one speaker
            // is registered. Solo users (registry empty) see only the
            // legacy preview line.
            Item {
                id: _spkRow
                Layout.fillWidth: true
                // v0.1.127: show during recording AND while a recognized
                // utterance is on screen. Previously hidden as soon as
                // recording stopped, which meant the "+ another
                // speaker" button vanished right when the user would
                // want to claim the just-finished utterance.
                Layout.preferredHeight: (voicePopup.recording
                    || voicePopup.recognizedText.length > 0)
                    && _spkRow._hasSpeakers ? 28 : 0
                visible: Layout.preferredHeight > 0
                clip: true
                Behavior on Layout.preferredHeight { NumberAnimation { duration: 160; easing.type: Easing.OutQuad } }
                property bool _hasSpeakers: false
                property string _activeName: ""
                property var _speakers: []
                // Periodic refresh of speaker list (cheap; ~5 entries
                // typical) plus active-name polling for pulse trigger.
                Timer {
                    id: _spkRefreshTimer
                    interval: 150
                    repeat: true
                    running: voicePopup.recording
                        || voicePopup.recognizedText.length > 0
                    onTriggered: {
                        if (!backend || !backend.speaker_list || !backend.speaker_active_name) return
                        var raw = backend.speaker_list()
                        if (raw && raw.length > 0) {
                            var lines = raw.split("\n")
                            var arr = []
                            for (var i = 0; i < lines.length; ++i) {
                                var parts = lines[i].split("\t")
                                if (parts.length >= 2) {
                                    arr.push({
                                        name: parts[0],
                                        color: parts[1],
                                        allowed: parts.length >= 3 ? parts[2] === "true" : true,
                                        // v0.1.133: 4th field. Older
                                        // backends emitting 3 fields
                                        // default this to false.
                                        deepMuted: parts.length >= 4 ? parts[3] === "true" : false
                                    })
                                }
                            }
                            _spkRow._speakers = arr
                            _spkRow._hasSpeakers = arr.length > 0
                        } else {
                            _spkRow._speakers = []
                            _spkRow._hasSpeakers = false
                        }
                        _spkRow._activeName = backend.speaker_active_name() || ""
                        // v0.1.294 (TAB-4): on every poll where the
                        // active speaker might have changed, ask
                        // backend to detect + swap workspaces. The
                        // method is cheap when nothing changed
                        // (single string compare); only does disk
                        // I/O when an actual swap happens. Toast
                        // surfaces the swap to the user.
                        if (backend.workspace_check_speaker_swap) {
                            var didSwap = backend.workspace_check_speaker_swap()
                            if (didSwap && typeof toast !== "undefined"
                                && _spkRow._activeName.length > 0)
                            {
                                toast.show("→ " + _spkRow._activeName + "'s workspace")
                            }
                        }
                    }
                }
                Row {
                    anchors.centerIn: parent
                    spacing: 10
                    Repeater {
                        model: _spkRow._speakers
                        delegate: Rectangle {
                            width: 20; height: 20; radius: 10
                            color: modelData.allowed ? modelData.color : Qt.rgba(0.4, 0.4, 0.4, 0.6)
                            border.width: _spkRow._activeName === modelData.name ? 2 : 0
                            border.color: Qt.lighter(modelData.color, 1.5)
                            // v0.1.133: deep-muted speakers render
                            // with a slash through them — at-a-glance
                            // signal that this circle's audio is
                            // dropped entirely. Background-muted
                            // (allowed=false, deepMuted=false) stays
                            // dim like before.
                            opacity: modelData.allowed ? 1.0
                                : (modelData.deepMuted ? 0.25 : 0.5)
                            // Pulse animation when this speaker is
                            // currently active. SequentialAnimation
                            // on running creates the breathing effect.
                            // When _activeName changes away from this
                            // speaker, the binding stops the animation
                            // (transform.scale returns to 1.0).
                            scale: 1.0
                            // v0.1.841: removed a second scale interceptor (a
                            // Behavior) that sat here alongside the breathing
                            // animation below — two interceptors on one property is
                            // unsupported, so Qt warned and silently dropped the
                            // breathing. Keep only the SequentialAnimation.
                            SequentialAnimation on scale {
                                running: _spkRow._activeName === modelData.name
                                loops: Animation.Infinite
                                NumberAnimation { to: 1.18; duration: 280; easing.type: Easing.OutQuad }
                                NumberAnimation { to: 1.0; duration: 320; easing.type: Easing.InQuad }
                            }
                            // Slash overlay when deep-muted.
                            Rectangle {
                                anchors.centerIn: parent
                                width: parent.width * 1.4
                                height: 2
                                color: "#cc4444"
                                rotation: -45
                                visible: modelData.deepMuted === true
                            }
                            ToolTip.visible: _hover
                            ToolTip.text: {
                                // v0.1.137: tack on cadence stats if any
                                // accumulated. Format keeps it minimal —
                                // the tooltip is informational, not a
                                // dashboard. Empty cadence string returns
                                // nothing additional.
                                var base = modelData.name
                                    + (modelData.allowed ? ""
                                        : (modelData.deepMuted
                                            ? " (deep muted — long-press to undo)"
                                            : " (background muted — long-press to deep-mute)"))
                                if (backend && backend.speaker_cadence) {
                                    var cad = backend.speaker_cadence(modelData.name)
                                    if (cad && cad.length > 0) {
                                        return base + "\n" + cad
                                    }
                                }
                                return base
                            }
                            property bool _hover: false
                            MouseArea {
                                anchors.fill: parent
                                hoverEnabled: true
                                onEntered: parent._hover = true
                                onExited: parent._hover = false
                                onClicked: {
                                    // Tap toggles allowed status.
                                    if (backend && backend.speaker_set_allowed) {
                                        backend.speaker_set_allowed(modelData.name, !modelData.allowed)
                                        _spkRefreshTimer.triggered()
                                    }
                                }
                                // v0.1.133: long-press cycles the
                                // mute state. Three positions:
                                //   allowed=true                  → tap = mute (background)
                                //   allowed=false, deep=false     → long-press = deep mute
                                //   allowed=false, deep=true      → long-press = un-mute (back to allowed)
                                // Tap on muted always toggles back
                                // to allowed (consistent with prior
                                // behavior).
                                onPressAndHold: {
                                    if (!backend) return
                                    if (modelData.allowed) {
                                        // From allowed → background mute first
                                        // (matches the typical user flow:
                                        // long-press jumps straight into
                                        // the muted states).
                                        if (backend.speaker_set_allowed) {
                                            backend.speaker_set_allowed(modelData.name, false)
                                        }
                                    } else if (!modelData.deepMuted) {
                                        // From background mute → deep mute
                                        if (backend.speaker_set_deep_muted) {
                                            backend.speaker_set_deep_muted(modelData.name, true)
                                        }
                                    } else {
                                        // From deep mute → un-mute entirely.
                                        // Clear deep_muted AND restore allowed.
                                        if (backend.speaker_set_deep_muted) {
                                            backend.speaker_set_deep_muted(modelData.name, false)
                                        }
                                        if (backend.speaker_set_allowed) {
                                            backend.speaker_set_allowed(modelData.name, true)
                                        }
                                    }
                                    _spkRefreshTimer.triggered()
                                }
                            }
                        }
                    }
                    // v0.1.127: "+ another speaker" affordance. Tapping
                    // forces the registration prompt below to surface
                    // so the user can claim the most-recent utterance
                    // for a new identity. Only visible when at least
                    // one speaker exists (else the registration UI is
                    // already shown by default).
                    Rectangle {
                        visible: _spkRow._speakers.length > 0
                        width: 20; height: 20; radius: 10
                        color: _addSpkMa.containsMouse
                            ? Qt.lighter(th.sf, 1.6)
                            : Qt.rgba(0.3, 0.3, 0.3, 0.4)
                        border.width: 1
                        border.color: Qt.lighter(th.bd, 1.3)
                        Behavior on color { ColorAnimation { duration: 100 } }
                        Text {
                            anchors.centerIn: parent
                            text: "+"
                            color: th.tc
                            font.pixelSize: 14
                            font.bold: true
                        }
                        ToolTip.visible: _addSpkMa.containsMouse
                        ToolTip.text: "Add another speaker"
                        MouseArea {
                            id: _addSpkMa
                            anchors.fill: parent
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: {
                                // Force the register prompt to surface
                                // for the most-recent utterance, even
                                // though one speaker already exists.
                                if (typeof _registerBox !== "undefined") {
                                    _registerBox._userRequestedAdd = true
                                    _registerBox._refreshNeed()
                                    // Focus the name field for typing.
                                    if (typeof _registerNameField !== "undefined") {
                                        _registerNameField.forceActiveFocus()
                                    }
                                }
                            }
                        }
                    }
                    // v0.1.262: ⚙ manage-speakers button. Surfaces a
                    // dedicated popup for operations that don't fit
                    // the tap/long-press dot interaction: merging two
                    // speakers (cleans up pre-v0.1.259 duplicates),
                    // and future delete/rename actions. Only visible
                    // when 2+ speakers exist — merge needs at least
                    // two to be meaningful.
                    Rectangle {
                        visible: _spkRow._speakers.length >= 2
                        width: 20; height: 20; radius: 10
                        color: _mgrSpkMa.containsMouse
                            ? Qt.lighter(th.sf, 1.6)
                            : Qt.rgba(0.3, 0.3, 0.3, 0.4)
                        border.width: 1
                        border.color: Qt.lighter(th.bd, 1.3)
                        Behavior on color { ColorAnimation { duration: 100 } }
                        Text {
                            anchors.centerIn: parent
                            text: "\u2699"   // ⚙ gear
                            color: th.tc
                            font.pixelSize: 11
                        }
                        ToolTip.visible: _mgrSpkMa.containsMouse
                        ToolTip.text: "Manage speakers (merge duplicates)"
                        MouseArea {
                            id: _mgrSpkMa
                            anchors.fill: parent
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: {
                                _manageSpeakersPopup._refresh()
                                _manageSpeakersPopup.open()
                            }
                        }
                    }
                }
            }

            // ── Multicolor live transcript view (v0.1.117) ──
            //
            // Shows whisper-streamed words colored by speaker. Each
            // word fades in over ~280ms from arrival_ms. Replaces
            // the legacy single-line preview when at least one
            // speaker is registered AND the words list isn't empty.
            //
            // Polled from backend.voice_partial_preview_words(): each
            // line is text\tspeaker\tcolor\tarrived_ms.
            Flow {
                id: _wordsView
                Layout.fillWidth: true
                Layout.preferredHeight: voicePopup.recording && _wordsView._hasWords
                    ? Math.min(implicitHeight, 80) : 0
                visible: Layout.preferredHeight > 0
                clip: true
                spacing: 5
                Behavior on Layout.preferredHeight { NumberAnimation { duration: 160; easing.type: Easing.OutQuad } }
                property bool _hasWords: false
                property var _words: []
                property real _now: Date.now()
                Timer {
                    id: _wordsPollTimer
                    interval: 200
                    repeat: true
                    running: voicePopup.recording
                    onTriggered: {
                        if (!backend || !backend.voice_partial_preview_words) return
                        var raw = backend.voice_partial_preview_words()
                        _wordsView._now = Date.now()
                        if (raw && raw.length > 0) {
                            var lines = raw.split("\n")
                            var arr = []
                            for (var i = 0; i < lines.length; ++i) {
                                var parts = lines[i].split("\t")
                                if (parts.length >= 4) {
                                    // v0.1.131: wire format is now 6
                                    // fields; older builds emit 4.
                                    // Parse defensively for both.
                                    arr.push({
                                        text: parts[0],
                                        speaker: parts[1],
                                        color: parts[2],
                                        arrived: parseFloat(parts[3]) || 0,
                                        audioStart: parts.length >= 5
                                            ? (parseFloat(parts[4]) || 0) : 0,
                                        muted: parts.length >= 6 && parts[5] === "1"
                                    })
                                }
                            }
                            _wordsView._words = arr
                            _wordsView._hasWords = arr.length > 0
                        } else {
                            _wordsView._words = []
                            _wordsView._hasWords = false
                        }
                    }
                }
                Connections {
                    target: voicePopup
                    function onRecordingChanged() {
                        if (!voicePopup.recording) {
                            _wordsView._words = []
                            _wordsView._hasWords = false
                        }
                    }
                }
                Repeater {
                    model: _wordsView._words
                    delegate: Text {
                        text: modelData.text
                        font.pixelSize: 13
                        // v0.1.131: muted speakers get italic styling
                        // to mark them as "background channel" — heard
                        // but not driving commands. Combined with the
                        // lowered opacity below, they read as
                        // secondary chatter without disappearing.
                        font.italic: modelData.muted === true
                        // Word color from speaker. Fallback to neutral
                        // grey when no speaker (registry empty or
                        // unknown speaker).
                        color: modelData.color && modelData.color.length > 0
                            ? modelData.color : Qt.rgba(0.75, 0.75, 0.78, 1.0)
                        // Fade in over ~280ms from arrival. Words
                        // beyond 280ms after their arrival render at
                        // full opacity (or 0.45 if muted — they're
                        // background-channel chatter, not primary
                        // transcript). The animation is driven by the
                        // poll timer's _now update (every 200ms);
                        // not silky-smooth but visible.
                        opacity: {
                            var age = _wordsView._now - modelData.arrived
                            var target = modelData.muted === true ? 0.45 : 1.0
                            return Math.min(target, Math.max(0.3, age / 280))
                        }
                        Behavior on opacity { NumberAnimation { duration: 180 } }
                        // Tooltip clarifies for users who notice the
                        // styling difference but don't know what it
                        // signals.
                        ToolTip.visible: modelData.muted === true && _muteWordMa.containsMouse
                        ToolTip.text: "Muted speaker — heard but ignored"
                        MouseArea {
                            id: _muteWordMa
                            anchors.fill: parent
                            hoverEnabled: modelData.muted === true
                            acceptedButtons: Qt.NoButton  // don't steal click
                        }
                    }
                }
            }

            // ── Streaming preview (v0.1.108) ──
            //
            // Shown DURING recording (voicePopup.recording === true).
            // Polls backend.voice_partial_preview() every 250ms and
            // shows the dumb-DB phonetic best match as grey italic
            // "preview" text. Replaced by the real recognizedText
            // when whisper finishes and recording → false.
            //
            // The preview is opportunistic — only fires if the user
            // has voiced this utterance before AND the dumb-DB has a
            // confident match. New utterances stay blank until
            // whisper lands. Better than nothing: confirms we're
            // listening AND lets the user predict what we'll act on.
            //
            // v0.1.117: hidden when the multicolor _wordsView is
            // showing real whisper-streamed text. The two surfaces
            // overlap conceptually so we don't want both at once.
            Rectangle {
                id: _previewBox
                Layout.fillWidth: true
                Layout.preferredHeight: voicePopup.recording
                    && _previewBox._previewText.length > 0
                    && !_wordsView._hasWords
                    ? _previewTxt.implicitHeight + 14 : 0
                visible: Layout.preferredHeight > 0
                clip: true
                radius: 8
                color: Qt.rgba(0.20, 0.20, 0.22, 0.5)
                Behavior on Layout.preferredHeight { NumberAnimation { duration: 160; easing.type: Easing.OutQuad } }
                property string _previewText: ""
                Text {
                    id: _previewTxt
                    anchors.fill: parent
                    anchors.margins: 8
                    text: _previewBox._previewText
                    color: Qt.rgba(0.75, 0.75, 0.78, 1.0)
                    font.pixelSize: 12
                    font.italic: true
                    wrapMode: Text.WordWrap
                }
                Timer {
                    id: _previewPollTimer
                    interval: 250
                    repeat: true
                    running: voicePopup.recording
                    onTriggered: {
                        if (!backend || !backend.voice_partial_preview) return
                        var s = backend.voice_partial_preview()
                        if (s && s.length > 0) {
                            _previewBox._previewText = "preview: " + s
                        }
                    }
                }
                Connections {
                    target: voicePopup
                    function onRecordingChanged() {
                        if (!voicePopup.recording) {
                            _previewBox._previewText = ""
                        }
                    }
                }
            }

            Rectangle { Layout.fillWidth: true; Layout.preferredHeight: voicePopup.recognizedText && !voicePopup.recording ? _rtxt.implicitHeight + 20 : 0
                visible: Layout.preferredHeight > 0; clip: true; radius: 10; color: th.ib
                Behavior on Layout.preferredHeight { NumberAnimation { duration: 180; easing.type: Easing.OutQuad } }
                Text { id: _rtxt; anchors.fill: parent; anchors.margins: 10
                    text: "\u201C" + voicePopup.recognizedText + "\u201D"
                    color: th.tc; font.pixelSize: 14; font.italic: true; wrapMode: Text.WordWrap }
            }

            // v0.1.119: register-self affordance. Visible after a
            // recognized utterance (when last_audio_buffer holds the
            // sample to fingerprint). Tap → prompts for a name and
            // registers the current audio as a speaker profile.
            //
            // Why here: the moment right after speaking is the only
            // natural place to enroll your voice — last_audio_buffer
            // is fresh, recognition is over, the user has a moment
            // of attention before confirming an intent.
            //
            // Hidden once you have any speakers registered (else
            // the prompt becomes annoying). Re-show via Settings →
            // Manage speakers (TODO future).
            Rectangle {
                id: _registerBox
                Layout.fillWidth: true
                Layout.preferredHeight: !voicePopup.recording
                    && voicePopup.recognizedText.length > 0
                    && _registerBox._needPrompt
                    ? 36 : 0
                visible: Layout.preferredHeight > 0
                clip: true
                radius: 8
                color: Qt.rgba(0.15, 0.35, 0.50, 0.30)
                border.color: th.ac; border.width: 1
                Behavior on Layout.preferredHeight { NumberAnimation { duration: 180; easing.type: Easing.OutQuad } }
                property bool _needPrompt: false
                property string _nameInput: ""
                // v0.1.127: when user taps the "+" button on the
                // speakers row, this becomes true and forces the
                // register UI open even though speakers already
                // exist. Reset on successful registration or popup
                // close (handled via Connections below).
                property bool _userRequestedAdd: false
                Component.onCompleted: _registerBox._refreshNeed()
                function _refreshNeed() {
                    // Show when zero speakers registered OR user
                    // explicitly tapped "+" to add another.
                    if (_userRequestedAdd) {
                        _needPrompt = true
                        return
                    }
                    if (!backend || !backend.speaker_list) {
                        _needPrompt = false
                        return
                    }
                    var raw = backend.speaker_list()
                    _needPrompt = (!raw || raw.length === 0)
                }
                Connections {
                    target: voicePopup
                    function onRecognizedTextChanged() {
                        _registerBox._refreshNeed()
                    }
                }
                RowLayout {
                    anchors.fill: parent; anchors.margins: 6; spacing: 6
                    Text {
                        text: "\uD83C\uDFA4 Register your voice as:"
                        color: th.tc; font.pixelSize: 11; font.italic: true
                    }
                    TextField {
                        id: _registerNameField
                        Layout.preferredWidth: 100
                        Layout.preferredHeight: 26
                        placeholderText: "Me"
                        font.pixelSize: 11
                        text: _registerBox._nameInput
                        onTextChanged: _registerBox._nameInput = text
                    }
                    Rectangle {
                        Layout.preferredWidth: 60; Layout.preferredHeight: 26
                        radius: 13
                        color: _regBtnMa.containsMouse ? Qt.lighter(th.ac, 1.2) : th.ac
                        Behavior on color { ColorAnimation { duration: 100 } }
                        Text { anchors.centerIn: parent; text: "Register"; color: "#fff"; font.pixelSize: 11; font.bold: true }
                        MouseArea {
                            id: _regBtnMa
                            anchors.fill: parent; hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: {
                                if (!backend || !backend.speaker_register_current) return
                                var name = _registerBox._nameInput.trim()
                                if (name.length === 0) name = "Me"
                                var ok = backend.speaker_register_current(name)
                                if (ok && ok.length > 0) {
                                    _registerBox._needPrompt = false
                                    _registerBox._userRequestedAdd = false
                                    _registerBox._nameInput = ""
                                    if (typeof toast !== "undefined" && toast.show) {
                                        toast.show("Registered as " + ok)
                                    }
                                    // Trigger circles refresh.
                                    _spkRefreshTimer.triggered()
                                }
                            }
                        }
                    }
                    Item { Layout.fillWidth: true }
                }
            }

            // Phonetic alternative — show if MFCC matched a different command than whisper said
            Rectangle { Layout.fillWidth: true; Layout.preferredHeight: voicePopup.hasPhoneticAlt && !voicePopup.recording && !voicePopup.processing ? _altCol.implicitHeight + 16 : 0
                visible: Layout.preferredHeight > 0; clip: true; radius: 10
                color: Qt.rgba(0.5, 0.4, 0.1, 0.2); border.color: th.lh; border.width: 1
                Behavior on Layout.preferredHeight { NumberAnimation { duration: 180; easing.type: Easing.OutQuad } }
                ColumnLayout { id: _altCol; anchors.fill: parent; anchors.margins: 8; spacing: 4
                    Text { text: "\u26A1 Phonetic match (" + voicePopup.phoneticScore.toFixed(1) + "): " + voicePopup.phoneticMatch
                        color: th.lh; font.pixelSize: 12; font.bold: true; wrapMode: Text.WordWrap; Layout.fillWidth: true }
                    Rectangle { Layout.fillWidth: true; Layout.preferredHeight: 30; radius: 15
                        color: _altma.containsMouse ? Qt.lighter(th.lh, 1.2) : Qt.lighter(th.lh, 1.05)
                        Text { anchors.centerIn: parent; text: "Use this instead"; color: "#fff"; font.pixelSize: 11; font.bold: true }
                        MouseArea { id: _altma; anchors.fill: parent; cursorShape: Qt.PointingHandCursor; hoverEnabled: true
                            onClicked: {
                                voicePopup.recognizedText = voicePopup.phoneticMatch
                                processIntentTimer.restart()
                            } } }
                }
            }

            // Speaker mismatch hint. Surfaced when the captured audio's
            // tonal profile doesn't match the established speaker
            // profile (likely a different person, or sick / different
            // mic / unusual environment). Below 0.4 = strong mismatch.
            // We don't reject — just inform — since false negatives on
            // yourself would be terrible. The hint is a small banner
            // above the intent confirmation.
            //
            // Only shown when speakerScore came back from the backend
            // AND it's clearly low (< 0.4) AND we have an intent to
            // act on. Otherwise we'd flash hints for tiny waveforms,
            // first-utterance bootstrap, etc.
            Rectangle {
                Layout.fillWidth: true
                Layout.preferredHeight: voicePopup.speakerScore < 0.4
                                         && voicePopup.speakerScore > 0
                                         && voicePopup.intentKind
                                         && !voicePopup.recording
                                         && !voicePopup.processing ? 32 : 0
                visible: Layout.preferredHeight > 0
                clip: true; radius: 8
                color: Qt.rgba(0.6, 0.3, 0.1, 0.18)
                border.color: Qt.rgba(0.8, 0.5, 0.2, 0.5); border.width: 1
                Behavior on Layout.preferredHeight { NumberAnimation { duration: 180; easing.type: Easing.OutQuad } }
                Text {
                    anchors.fill: parent; anchors.margins: 8
                    text: "\u26A0 Wasn't sure that was you (speaker score "
                          + voicePopup.speakerScore.toFixed(2)
                          + "). Confirm if this looks right."
                    color: "#fcd34d"; font.pixelSize: 10
                    verticalAlignment: Text.AlignVCenter
                    wrapMode: Text.WordWrap
                }
            }

            // Intent confirmation
            Rectangle { Layout.fillWidth: true; Layout.preferredHeight: voicePopup.intentKind && !voicePopup.recording && !voicePopup.processing ? 80 : 0
                visible: Layout.preferredHeight > 0; clip: true; radius: 10
                color: voicePopup.intentKind === "error" ? "#3a1f1f" : Qt.lighter(th.sf, 1.15)
                Behavior on Layout.preferredHeight { NumberAnimation { duration: 200; easing.type: Easing.OutQuad } }
                ColumnLayout { anchors.fill: parent; anchors.margins: 12; spacing: 4
                    Text { text: voicePopup.intentKind === "error" ? "\u26A0 " + voicePopup.intentDesc : "\u279C " + voicePopup.intentDesc
                        color: voicePopup.intentKind === "error" ? "#fca5a5" : th.tc; font.pixelSize: 14; font.bold: true; wrapMode: Text.WordWrap; Layout.fillWidth: true }
                    Text { visible: voicePopup.intentParam.length > 0
                        text: voicePopup.intentParam; color: th.tm; font.pixelSize: 11; elide: Text.ElideRight; Layout.fillWidth: true }
                }
            }

            // Multi-candidate picker — appears when top candidate is uncertain or
            // multiple candidates score similarly. Tapping a candidate makes IT the
            // active one; the user then taps Execute. Pick is training signal.
            Rectangle { Layout.fillWidth: true
                Layout.preferredHeight: voicePopup.showCandidates && !voicePopup.recording && !voicePopup.processing ? _candCol.implicitHeight + 16 : 0
                visible: Layout.preferredHeight > 0; clip: true; radius: 10
                color: Qt.rgba(0.12, 0.18, 0.28, 0.4); border.color: th.bd; border.width: 1
                Behavior on Layout.preferredHeight { NumberAnimation { duration: 200; easing.type: Easing.OutQuad } }
                ColumnLayout { id: _candCol; anchors.fill: parent; anchors.margins: 8; spacing: 4
                    Text { text: "\uD83D\uDCA1 Or did you mean:"; color: th.tm; font.pixelSize: 11; font.italic: true }
                    Repeater { model: voicePopup.candidates
                        delegate: Rectangle { id: _candItem
                            Layout.fillWidth: true; height: 38; radius: 6
                            // Three-state color: SELECTED (just-clicked, awaiting
                            // execute), ACTIVE (top item, default candidate),
                            // HOVER (mouse over, idle), IDLE (everything else).
                            // Selected gets the brightest highlight to confirm
                            // the user's tap visually before the 300ms execute
                            // delay.
                            property bool _selected: false
                            color: _selected ? Qt.lighter(th.ac, 1.25)
                                : (model.index === 0 ? Qt.lighter(th.ac, 0.6)
                                : (_candma.containsMouse ? Qt.lighter(th.sf, 1.4)
                                : Qt.lighter(th.sf, 1.15)))
                            Behavior on color { ColorAnimation { duration: 100 } }
                            // Hover lifts the item slightly (1.5%) — like a
                            // real button. Selected pumps bigger to make the
                            // click feel responsive. The Behavior eases the
                            // transition; SequentialAnimation below adds an
                            // initial spike for selection.
                            scale: _selected ? 1.05
                                : (_candma.containsMouse ? 1.015 : 1.0)
                            Behavior on scale { NumberAnimation { duration: 140; easing.type: Easing.OutBack } }
                            // Border brightens on hover and selection.
                            // v0.1.358: destructive ops get an amber
                            // border at rest too — visual cue that
                            // this candidate mutates state.
                            border.color: _selected ? th.ac
                                : (_candma.containsMouse ? Qt.lighter(th.bd, 1.4)
                                : (model.destructive ? "#d6a14a"
                                : "transparent"))
                            border.width: _candma.containsMouse || _selected
                                || model.destructive ? 1 : 0
                            Behavior on border.color { ColorAnimation { duration: 120 } }
                            // Confirm-pulse: when _selected flips, fire a
                            // sharp scale spike so the user gets a clear
                            // "got it" feedback within the 300ms grace
                            // before executeIntent.
                            SequentialAnimation {
                                id: _confirmPulse
                                running: _candItem._selected
                                NumberAnimation { target: _candItem; property: "scale"
                                    from: 1.0; to: 1.10; duration: 90; easing.type: Easing.OutCubic }
                                NumberAnimation { target: _candItem; property: "scale"
                                    from: 1.10; to: 1.05; duration: 110; easing.type: Easing.OutBack }
                            }
                            // Confirm flash: a thin white overlay that
                            // sweeps across on selection — adds a
                            // distinctive "ack" beyond the color/scale
                            // changes for users with reduced color
                            // contrast settings.
                            Rectangle {
                                anchors.fill: parent
                                radius: parent.radius
                                color: "#fff"
                                opacity: 0
                                NumberAnimation on opacity {
                                    running: _candItem._selected
                                    from: 0.32; to: 0.0
                                    duration: 380
                                    easing.type: Easing.OutQuad
                                }
                            }
                            RowLayout { anchors.fill: parent; anchors.leftMargin: 10; anchors.rightMargin: 10; spacing: 8
                                // Score pill
                                Rectangle { width: 36; height: 18; radius: 9
                                    color: model.score > 0.7 ? "#2d6a3a" : model.score > 0.5 ? "#5a4a1a" : "#5a2a2a"
                                    Text { anchors.centerIn: parent; text: Math.round(model.score * 100) + "%"
                                        color: "#fff"; font.pixelSize: 10; font.bold: true } }
                                // v0.1.358: destructive marker. Amber
                                // warning glyph sitting between the
                                // score pill and the description text,
                                // visible only when the candidate
                                // mutates state. The border color and
                                // this glyph together signal "this
                                // changes things" at a glance.
                                Rectangle {
                                    visible: model.destructive === true
                                    width: 20; height: 18; radius: 4
                                    color: Qt.rgba(0.84, 0.63, 0.29, 0.25)
                                    border.color: "#d6a14a"
                                    border.width: 1
                                    Text {
                                        anchors.centerIn: parent
                                        text: "\u26A0"  // warning sign
                                        color: "#e8a04a"
                                        font.pixelSize: 11
                                    }
                                    ToolTip.visible: _destrTipMa.containsMouse
                                    ToolTip.text: "Destructive — mutates state"
                                    MouseArea {
                                        id: _destrTipMa
                                        anchors.fill: parent
                                        hoverEnabled: true
                                        // Don't intercept clicks — let
                                        // them propagate to the row's
                                        // confirm handler.
                                        propagateComposedEvents: true
                                        onPressed: function(mouse) { mouse.accepted = false }
                                    }
                                }
                                Text { Layout.fillWidth: true; text: model.desc
                                    color: th.tc; font.pixelSize: 12; elide: Text.ElideRight }
                                Text { visible: model.index === 0 && !_candItem._selected; text: "(active)"; color: th.tm; font.pixelSize: 10; font.italic: true }
                                Text { visible: _candItem._selected; text: "\u2713 running…"; color: "#fff"; font.pixelSize: 10; font.bold: true }
                                // v0.1.133: "wrong" feedback button.
                                // Tapping registers the recognized
                                // audio as a NEGATIVE fingerprint for
                                // this candidate's command label —
                                // teaching the system that what you
                                // just said is acoustically near, but
                                // NOT meant to invoke this command.
                                //
                                // The MouseArea here is INSIDE the
                                // candidate's main click area but
                                // stops event propagation so the
                                // candidate doesn't fire.
                                Rectangle {
                                    width: 22; height: 22; radius: 11
                                    color: _wrongMa.containsMouse
                                        ? Qt.rgba(0.6, 0.2, 0.2, 0.5)
                                        : Qt.rgba(0.4, 0.4, 0.4, 0.3)
                                    visible: !_candItem._selected
                                    Behavior on color { ColorAnimation { duration: 80 } }
                                    Text {
                                        anchors.centerIn: parent
                                        text: "\u2715"
                                        color: th.tm
                                        font.pixelSize: 11
                                    }
                                    ToolTip.visible: _wrongMa.containsMouse
                                    ToolTip.text: "Not what I meant — record as negative"
                                    MouseArea {
                                        id: _wrongMa
                                        anchors.fill: parent
                                        hoverEnabled: true
                                        cursorShape: Qt.PointingHandCursor
                                        propagateComposedEvents: false
                                        onClicked: function(mouse) {
                                            mouse.accepted = true
                                            if (!backend || !backend.voice_feedback_wrong) return
                                            // Use the candidate's command param as the
                                            // label for the negative. For term_cmd that's
                                            // the literal command string ("ls -lh"); for
                                            // navigate it's the URL; etc. Same label
                                            // the cache and dispatch path use.
                                            var label = model.p1 || model.desc || ""
                                            if (label.length === 0) return
                                            var ok = backend.voice_feedback_wrong(label)
                                            if (ok && typeof toast !== "undefined" && toast.show) {
                                                // v0.1.290: explicit hint about the
                                                // forward effect. Original message only
                                                // confirmed the logging happened; users
                                                // were left guessing whether anything
                                                // would change. New wording calls out
                                                // the learning behavior so they know
                                                // their feedback is doing work even
                                                // before they hear themselves again.
                                                toast.show("Logged — next time, similar audio won't match \"" + label.substring(0, 24) + "\"")
                                            }
                                            if (backend.log_message) {
                                                backend.log_message("[feedback] candidate " + model.index
                                                    + " marked wrong: " + label)
                                            }
                                        }
                                    }
                                }
                            }
                            // Click on a candidate now: promote it to the
                            // active slot, mark it visually selected, then
                            // execute after a 300ms grace so the user gets
                            // to see what they clicked. Previous behavior
                            // (just promote, require Execute click) was an
                            // extra step that nearly nobody used — most
                            // users either say yes/no or want the click to
                            // be the action itself.
                            MouseArea { id: _candma; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                                propagateComposedEvents: false
                                // v0.1.123: enabled when popup isn't
                                // already executing. Once any
                                // candidate is clicked, _executed flips
                                // and all candidate clicks become
                                // no-ops until close → reopen. Fixes
                                // user-reported "click 12 times,
                                // popup unresponsive" — the click was
                                // registering but UI feedback was
                                // ambiguous.
                                enabled: !voicePopup._executed
                                onClicked: {
                                    if (voicePopup._executed) {
                                        if (backend && backend.log_message) {
                                            backend.log_message("[ui] candidate click ignored — intent already executing")
                                        }
                                        return
                                    }
                                    if (backend && backend.log_message) {
                                        backend.log_message("[ui] voice candidate " + model.index + " clicked: " + model.desc)
                                    }
                                    voicePopup.intentKind = model.kind
                                    voicePopup.intentDesc = model.desc
                                    voicePopup.intentParam = model.p1
                                    voicePopup.intentParam2 = model.p2
                                    var idx = model.index
                                    if (idx > 0) {
                                        voicePopup.candidates.move(idx, 0, 1)
                                    }
                                    _candItem._selected = true
                                    // Cancel any in-flight auto-listen so
                                    // an utterance landing during the 180ms
                                    // grace doesn't override our action.
                                    voicePopup.cancelConfirmListen()
                                    _execTimer.start()
                                }
                            }
                            Timer { id: _execTimer; interval: 180
                                // Tightened from 300ms in v0.1.77 per
                                // user feedback "UI delay and timers
                                // could be a little bit quicker." 180ms
                                // is the lower bound where the eye
                                // still has time to register the
                                // selection animation but nothing
                                // feels laggy. Below ~150ms users
                                // perceive the action as instantaneous
                                // (which defeats the purpose of the
                                // grace at all).
                                onTriggered: voicePopup.executeIntent() }
                        } } }
            }

            // Action buttons
            RowLayout { Layout.fillWidth: true; spacing: 8
                visible: voicePopup.intentKind && !voicePopup.recording && !voicePopup.processing && voicePopup.intentKind !== "error"
                Rectangle {
                    id: _execBtn
                    Layout.fillWidth: true; Layout.preferredHeight: 38; radius: 19
                    // Immediate visual feedback policy: pressed state
                    // gets a darker color + slight scale-down. The user's
                    // tap is acknowledged before the executeIntent call
                    // completes its async work.
                    property bool _pressed: false
                    color: _pressed ? Qt.darker(th.ac, 1.2)
                        : (_exma.containsMouse ? Qt.lighter(th.ac, 1.15) : th.ac)
                    scale: _pressed ? 0.97 : 1.0
                    Behavior on color { ColorAnimation { duration: 80 } }
                    Behavior on scale { NumberAnimation { duration: 100; easing.type: Easing.OutCubic } }
                    Text { anchors.centerIn: parent; text: "Execute"; color: "#fff"; font.pixelSize: 13; font.bold: true }
                    MouseArea { id: _exma; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                        onPressed: _execBtn._pressed = true
                        onReleased: _execBtn._pressed = false
                        onCanceled: _execBtn._pressed = false
                        onClicked: voicePopup.executeIntent() } }
                Rectangle {
                    id: _retryBtn
                    Layout.preferredWidth: 38; Layout.preferredHeight: 38; radius: 19
                    property bool _pressed: false
                    color: _pressed ? Qt.darker(th.sf, 0.8)
                        : (_ryma.containsMouse ? Qt.lighter(th.sf, 1.4) : Qt.lighter(th.sf, 1.2))
                    scale: _pressed ? 0.94 : 1.0
                    Behavior on scale { NumberAnimation { duration: 100; easing.type: Easing.OutCubic } }
                    Behavior on color { ColorAnimation { duration: 80 } }
                    Text { anchors.centerIn: parent; text: "\u21BB"; color: th.tc; font.pixelSize: 16 }
                    ToolTip.visible: _ryma.containsMouse
                    ToolTip.text: "Try again"
                    ToolTip.delay: 400
                    MouseArea { id: _ryma; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                        onPressed: _retryBtn._pressed = true
                        onReleased: _retryBtn._pressed = false
                        onCanceled: _retryBtn._pressed = false
                        onClicked: voicePopup.startListening()
                    }
                }
            }

            // Quick action chips when idle
            Flow { Layout.fillWidth: true; spacing: 6; visible: !voicePopup.recording && !voicePopup.processing && !voicePopup.intentKind
                Repeater { model: ["\"open hacker news\"", "\"search rust async\"", "\"go back\"", "\"show history\"", "\"man find\""]
                    delegate: Rectangle { width: _hint.implicitWidth + 16; height: 26; radius: 13
                        color: Qt.lighter(th.sf, 1.3); border.color: th.bd; border.width: 1
                        Text { id: _hint; anchors.centerIn: parent; text: modelData; color: th.tm; font.pixelSize: 10; font.italic: true }
                    }
                }
            }

            // Diagnostic footer: shows entity-extraction state. Tiny, dim, only
            // visible when we have something to say. This makes the entity flow
            // observable without needing stderr access.
            Text { Layout.fillWidth: true
                visible: voicePopup.diagText.length > 0 && !voicePopup.recording && !voicePopup.processing
                text: "[diag] " + voicePopup.diagText
                color: th.tm; font.pixelSize: 9; font.family: "monospace"
                wrapMode: Text.WrapAnywhere; opacity: 0.6 }
        }

        // Live hints panel — populated from tab-completion in the visible
        // shell, plus fuzzy-path candidates from path_fuzzy module. Empty
        // (and invisible) when on browser tab, in alt-screen, or when the
        // shell returned nothing.
        //
        // Two layout modes computed in voicePopup._hintsLayoutMode:
        //   - "sidebar": shown to the right of contentColV at 240px wide.
        //     Used on viewports >= 620px (desktops, tablets in landscape).
        //   - "stacked": shown BELOW contentColV inside the popup, full
        //     popup width. Used on phones / narrow windows where 240px
        //     sidebar would crush the main content. Default-collapsed
        //     to a 28px header strip so the popup stays compact; tap to
        //     expand the list.
        // The Loader pattern below avoids duplicating the inner ListView
        // delegate code across modes.
        property bool _stackedHintsExpanded: false
        Component {
            id: hintsContent
            ColumnLayout {
                spacing: 6
                Text { text: "Shell hints"; color: th.tm; font.pixelSize: 10
                    font.bold: true; Layout.fillWidth: true }
                Text { text: liveHintsModel.count + " match" + (liveHintsModel.count === 1 ? "" : "es")
                    color: th.tm; font.pixelSize: 9; opacity: 0.7
                    Layout.fillWidth: true; Layout.bottomMargin: 4 }
                ListView {
                    Layout.fillWidth: true; Layout.fillHeight: true
                    Layout.minimumHeight: 80
                    clip: true
                    model: liveHintsModel
                    spacing: 2
                    boundsBehavior: Flickable.StopAtBounds
                    ScrollBar.vertical: ScrollBar { policy: ScrollBar.AsNeeded }
                    delegate: Rectangle {
                        width: ListView.view.width; height: 28; radius: 4
                        color: hintMa.containsMouse ? Qt.lighter(th.sf, 1.2) : "transparent"
                        Text {
                            anchors.left: parent.left; anchors.right: parent.right
                            anchors.verticalCenter: parent.verticalCenter
                            anchors.leftMargin: 6; anchors.rightMargin: 6
                            text: model.label
                            color: th.tc; font.pixelSize: 12; font.family: "monospace"
                            elide: Text.ElideMiddle
                        }
                        MouseArea {
                            id: hintMa
                            anchors.fill: parent
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: {
                                if (backend) {
                                    backend.pty_write(model.label)
                                    voicePopup.close()
                                }
                            }
                        }
                    }
                }
            }
        }

        // Sidebar variant — right-anchored panel, shown only in "sidebar" mode.
        Rectangle {
            id: hintsSidebar
            visible: voicePopup._hintsLayoutMode === "sidebar"
            anchors.right: parent.right; anchors.top: parent.top; anchors.bottom: parent.bottom
            anchors.margins: 12
            width: 240
            color: Qt.darker(th.sf, 1.1)
            radius: 8
            border.color: th.bd; border.width: 1
            Loader {
                anchors.fill: parent; anchors.margins: 10
                sourceComponent: voicePopup._hintsLayoutMode === "sidebar" ? hintsContent : null
            }
        }

        // Stacked variant — full-width panel below contentColV. Used on
        // narrow viewports (phones, tablets in portrait). On open, shows
        // a single 32px header strip with "N hints — tap to expand". Tap
        // expands to a 220px list. Collapsed by default keeps the popup
        // compact on small screens; user can opt in to seeing details.
        Rectangle {
            id: hintsStacked
            visible: voicePopup._hintsLayoutMode === "stacked"
            anchors.left: parent.left; anchors.right: parent.right
            anchors.top: contentColV.bottom; anchors.topMargin: 8
            anchors.leftMargin: 20; anchors.rightMargin: 20
            color: Qt.darker(th.sf, 1.1)
            radius: 8
            border.color: th.bd; border.width: 1
            // ACTUAL height (not just implicitHeight — Rectangles don't
            // auto-size from implicit). Collapsed: just the header.
            // Expanded: header + bounded list.
            height: voicePopup._stackedHintsExpanded
                ? Math.min(240, 32 + liveHintsModel.count * 30 + 12)
                : 32
            Behavior on height { NumberAnimation { duration: 150; easing.type: Easing.OutQuad } }
            // Header strip — always visible, tap to toggle expand.
            Item {
                id: hintsHeader
                anchors.left: parent.left; anchors.right: parent.right; anchors.top: parent.top
                height: 32
                Text {
                    anchors.left: parent.left; anchors.leftMargin: 10
                    anchors.verticalCenter: parent.verticalCenter
                    text: liveHintsModel.count + " shell hint"
                        + (liveHintsModel.count === 1 ? "" : "s")
                    color: th.tm; font.pixelSize: 11; font.bold: true
                }
                Text {
                    anchors.right: parent.right; anchors.rightMargin: 10
                    anchors.verticalCenter: parent.verticalCenter
                    text: voicePopup._stackedHintsExpanded ? "▾ collapse" : "▸ expand"
                    color: th.ac; font.pixelSize: 10
                }
                MouseArea {
                    id: _hintsHeaderMa
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: voicePopup._stackedHintsExpanded = !voicePopup._stackedHintsExpanded
                }
            }
            // List body — only visible when expanded.
            ListView {
                anchors.left: parent.left; anchors.right: parent.right
                anchors.top: hintsHeader.bottom; anchors.bottom: parent.bottom
                anchors.margins: 10; anchors.topMargin: 0
                clip: true
                visible: voicePopup._stackedHintsExpanded
                model: liveHintsModel
                spacing: 2
                boundsBehavior: Flickable.StopAtBounds
                ScrollBar.vertical: ScrollBar { policy: ScrollBar.AsNeeded }
                delegate: Rectangle {
                    width: ListView.view.width; height: 28; radius: 4
                    color: hsHintMa.containsMouse ? Qt.lighter(th.sf, 1.2) : "transparent"
                    Text {
                        anchors.left: parent.left; anchors.right: parent.right
                        anchors.verticalCenter: parent.verticalCenter
                        anchors.leftMargin: 6; anchors.rightMargin: 6
                        text: model.label
                        color: th.tc; font.pixelSize: 12; font.family: "monospace"
                        elide: Text.ElideMiddle
                    }
                    MouseArea {
                        id: hsHintMa
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            if (backend) {
                                backend.pty_write(model.label)
                                voicePopup.close()
                            }
                        }
                    }
                }
            }
        }
    }

    // ═══ "Find this term" multi-action chooser ═══
    Popup {
        id: findAnywhereChooser; modal: true; dim: true
        x: (root.width - width) / 2; y: 80
        width: Math.min(root.width - 40, 460)
        height: _faaCol.implicitHeight + 30
        property string term: ""
        enter: Transition {
            NumberAnimation { property: "scale"; from: 0.9; to: 1.0; duration: 140; easing.type: Easing.OutBack }
            NumberAnimation { property: "opacity"; from: 0; to: 1; duration: 100 }
        }
        background: Rectangle { color: th.sf; radius: 14; border.color: th.bd; border.width: 1 }
        ColumnLayout { id: _faaCol; anchors.fill: parent; anchors.margins: 14; spacing: 8
            RowLayout { Layout.fillWidth: true
                Text { Layout.fillWidth: true; text: "Find: \u201C" + findAnywhereChooser.term + "\u201D"
                    color: th.tc; font.pixelSize: 16; font.bold: true; elide: Text.ElideRight }
                Text { text: "\u2715"; color: th.tm; font.pixelSize: 16
                    MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: findAnywhereChooser.close() } }
            }
            Rectangle { Layout.fillWidth: true; height: 1; color: th.bd }
            Repeater {
                model: [
                    {label: "On this page",        icon: "\uD83D\uDCC4", act: "page"},
                    {label: "Search the web",      icon: "\uD83C\uDF10", act: "web"},
                    {label: "On this site only",   icon: "\uD83D\uDD0D", act: "site"},
                    {label: "In command history",  icon: "\u26A1",       act: "history"},
                    {label: "In terminal output",  icon: "\u2B05",       act: "terminal"},
                    {label: "In archived pages",   icon: "\uD83D\uDCDA", act: "archive"},
                    {label: "On Wikipedia",        icon: "W",            act: "wikipedia"},
                    {label: "On GitHub",           icon: "\uD83D\uDC19", act: "github"},
                    {label: "Ask local LLM",       icon: "\uD83E\uDD16", act: "llm"}
                ]
                delegate: Rectangle {
                    Layout.fillWidth: true; height: 44; radius: 8
                    color: _famh.containsMouse ? Qt.lighter(th.sf, 1.3) : Qt.lighter(th.sf, 1.1)
                    Behavior on color { ColorAnimation { duration: 100 } }
                    RowLayout { anchors.fill: parent; anchors.leftMargin: 12; anchors.rightMargin: 12; spacing: 10
                        Text { text: modelData.icon; color: th.ac; font.pixelSize: 18 }
                        Text { Layout.fillWidth: true; text: modelData.label; color: th.tc; font.pixelSize: 14 }
                        Text { text: "\u203A"; color: th.tm; font.pixelSize: 16 }
                    }
                    MouseArea { id: _famh; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            findAnywhereChooser.runAction(modelData.act, findAnywhereChooser.term)
                            findAnywhereChooser.close()
                        } }
                }
            }
        }
        function runAction(act, term) {
            if (!backend) return
            switch (act) {
                case "page":
                    findBar.visible = true; findField.text = term; findField.accepted()
                    break
                case "web":
                    backend.search_web(term); loading = true
                    break
                case "site":
                    var domain = ""
                    var url = backend.last_query || ""
                    var m = url.match(/https?:\/\/([^\/]+)/)
                    if (m) domain = m[1]
                    var q = domain ? ("site:" + domain + " " + term) : term
                    backend.search_web(q); loading = true
                    break
                case "history":
                    tabBar.currentIndex = 1; swipeView.currentIndex = 1
                    backend.pty_write("\x12"); backend.pty_write(term)
                    // v0.1.481: command-history is one of the two
                    // requested entry points for the setup assistant.
                    if (typeof _setupHint !== "undefined") _setupHint.maybeOffer()
                    break
                case "terminal":
                    var out = backend.last_terminal_output() || ""
                    var lines = out.split("\n").filter(function(l){ return l.toLowerCase().indexOf(term.toLowerCase()) >= 0 })
                    if (lines.length > 0) {
                        backend.clipboard_set(lines.join("\n"))
                    }
                    findBar.visible = true; findField.text = term; findField.accepted()
                    break
                case "archive":
                    browserDrawer.open()
                    pageSearchField.text = term
                    applyFuzzy()
                    break
                case "wikipedia":
                    backend.nav("https://en.wikipedia.org/w/index.php?search=" + encodeURIComponent(term))
                    loading = true
                    break
                case "github":
                    backend.nav("https://github.com/search?q=" + encodeURIComponent(term))
                    loading = true
                    break
                case "llm":
                    voicePopup.recognizedText = "\u23F3 Asking local LLM..."
                    voicePopup.intentKind = ""
                    voicePopup.open()
                    backend.llm_query_async(term)
                    llmPollTimer.start()
                    break
            }
        }
    }

    // ═══ Confirm Quit Dialog ═══
    // Voice misrecognitions and accidental "quit" triggers shouldn't be able
    // to close the whole app silently. Show a 2-button confirmation so the
    // user gets a moment to cancel.
    Popup {
        id: confirmQuitDialog
        anchors.centerIn: Overlay.overlay
        width: 320; height: 180
        modal: true; dim: true
        closePolicy: Popup.CloseOnEscape | Popup.CloseOnPressOutside
        background: Rectangle { color: th.sf; radius: 12; border.color: th.bd; border.width: 1 }
        contentItem: ColumnLayout {
            anchors.fill: parent
            anchors.margins: 16
            spacing: 12
            Text { text: "Quit Web2QML?"; color: th.tc; font.pixelSize: 16; font.bold: true
                Layout.alignment: Qt.AlignHCenter }
            Text { text: "Voice command requested to close the app."
                color: th.tm; font.pixelSize: 12; horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap; Layout.fillWidth: true }
            Item { Layout.fillHeight: true }
            RowLayout {
                Layout.alignment: Qt.AlignHCenter; spacing: 12
                Rectangle { width: 110; height: 36; radius: 18
                    color: th.sf; border.color: th.bd; border.width: 1
                    Text { anchors.centerIn: parent; text: "Cancel"; color: th.tc; font.pixelSize: 13; font.bold: true }
                    MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor
                        onClicked: confirmQuitDialog.close() } }
                Rectangle { width: 110; height: 36; radius: 18
                    color: "#dc2626"
                    Text { anchors.centerIn: parent; text: "Quit"; color: "#fff"; font.pixelSize: 13; font.bold: true }
                    MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor
                        onClicked: { confirmQuitDialog.close(); Qt.quit() } } }
            }
        }
    }

    // ═══ Quick Settings Popup ═══ (v0.1.202)
    //
    // Tap on the settings gear → this popup. Long-press → full
    // settingsPopup. Starter set: theme toggle + voice on/off.
    // Pattern: 2 fast-flip items, narrow popup, instant feel.
    // More items can be seeded later as we learn which are
    // touched most often.
    //
    // The "open full settings" link at the bottom lets the user
    // promote a quick action to the full panel without re-tapping
    // the gear.
    Popup {
        id: quickSettingsPopup
        x: root.width - width - 8
        y: 54
        width: 240
        // Height computes from content; minimal chrome
        height: _qsCol.implicitHeight + 24
        modal: true
        dim: true
        enter: Transition { NumberAnimation { property: "opacity"; from: 0; to: 1; duration: 100 } }
        exit: Transition { NumberAnimation { property: "opacity"; from: 1; to: 0; duration: 80 } }
        background: Rectangle {
            color: th.sf
            radius: 12
            border.color: th.bd
            border.width: 1
        }
        Column {
            id: _qsCol
            width: parent.width
            padding: 12
            spacing: 10

            Text {
                text: "Quick Settings"
                color: th.tc
                font.pixelSize: 13
                font.bold: true
            }

            // Theme toggle: tap to cycle dark/light. Label shows
            // current state.
            //
            // v0.1.206: replaced fragile Row+spacer math with
            // anchored labels — left text anchored left, right
            // cluster anchored right. The previous spacer formula
            // missed the "Theme" Text width and caused overlap.
            Rectangle {
                width: parent.width - 24
                height: 38
                radius: 6
                color: _themeMA.containsMouse ? Qt.lighter(th.ib, 1.2) : th.ib
                border.color: th.bd
                border.width: 1
                Text {
                    anchors.left: parent.left
                    anchors.leftMargin: 10
                    anchors.verticalCenter: parent.verticalCenter
                    text: "Theme"
                    color: th.tc
                    font.pixelSize: 12
                }
                Row {
                    anchors.right: parent.right
                    anchors.rightMargin: 10
                    anchors.verticalCenter: parent.verticalCenter
                    spacing: 8
                    Text {
                        anchors.verticalCenter: parent.verticalCenter
                        text: backend && backend.dark_theme ? "dark" : "light"
                        color: th.tm
                        font.pixelSize: 11
                        font.italic: true
                    }
                    Text {
                        anchors.verticalCenter: parent.verticalCenter
                        text: "→ flip"
                        color: th.ac
                        font.pixelSize: 11
                    }
                }
                MouseArea {
                    id: _themeMA
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: {
                        if (!backend) return
                        // Cycle theme_idx: 0 (default dark) → 1 (light) → 0
                        // The full settings has more themes; quick toggle
                        // is just dark/light flip.
                        backend.theme_idx = (backend.theme_idx === 1) ? 0 : 1
                    }
                }
            }

            // Voice toggle: tap flips wake-suppressed state.
            //
            // v0.1.206: same anchor-based rewrite as theme row.
            // Gave the Rectangle an id so children can reference
            // `_voiceRow.muted` without the parent-chain dance.
            Rectangle {
                id: _voiceRow
                width: parent.width - 24
                height: 38
                radius: 6
                color: _voiceMA.containsMouse ? Qt.lighter(th.ib, 1.2) : th.ib
                border.color: th.bd
                border.width: 1
                property bool muted: backend && backend.voice_is_wake_suppressed
                    ? backend.voice_is_wake_suppressed() : false
                Text {
                    anchors.left: parent.left
                    anchors.leftMargin: 10
                    anchors.verticalCenter: parent.verticalCenter
                    text: "Voice"
                    color: th.tc
                    font.pixelSize: 12
                }
                Row {
                    anchors.right: parent.right
                    anchors.rightMargin: 10
                    anchors.verticalCenter: parent.verticalCenter
                    spacing: 8
                    Text {
                        anchors.verticalCenter: parent.verticalCenter
                        text: _voiceRow.muted ? "muted" : "listening"
                        color: _voiceRow.muted ? th.tm : "#7cb342"
                        font.pixelSize: 11
                        font.italic: true
                    }
                    Text {
                        anchors.verticalCenter: parent.verticalCenter
                        text: _voiceRow.muted ? "→ unmute" : "→ mute"
                        color: th.ac
                        font.pixelSize: 11
                    }
                }
                MouseArea {
                    id: _voiceMA
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: {
                        if (!backend || !backend.voice_set_wake_suppressed) return
                        var nowMuted = backend.voice_is_wake_suppressed
                            ? backend.voice_is_wake_suppressed() : false
                        backend.voice_set_wake_suppressed(!nowMuted)
                        _voiceRow.muted = !nowMuted
                    }
                }
            }

            // Footer: "long-press for full settings" hint on left,
            // "open full" link on right. v0.1.206: replaced Row +
            // spacer math with anchors on an Item, same as toggle
            // rows above. The previous spacer's `- 200` magic was
            // arbitrary and overlapped on narrow popups.
            Item {
                width: parent.width - 24
                height: _qsFullLink.implicitHeight + 4
                Text {
                    anchors.left: parent.left
                    anchors.verticalCenter: parent.verticalCenter
                    text: "(long-press gear for full settings)"
                    color: th.tm
                    font.pixelSize: 9
                    font.italic: true
                }
                Text {
                    id: _qsFullLink
                    anchors.right: parent.right
                    anchors.verticalCenter: parent.verticalCenter
