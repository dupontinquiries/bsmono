    function doPageSearch(){if(!backend||pageSearchField.text.trim().length<2)return
        var r=backend.search_page(pageSearchField.text).split("\n"); rebuildBrowserPalette()
        var idx=1; for(var j=0;j<browserModel.count;j++){if(browserModel.get(j).isHeader&&browserModel.get(j).label!=="Actions"){idx=j;break}}
        browserModel.insert(idx,{isHeader:true,label:"Search Results",text:"",url:"",kind:""}); idx++
        var c=0; for(var i=0;i<r.length;i++){if(!r[i])continue;var sp=r[i].split("\x1F");if(sp.length>=3){browserModel.insert(idx,{isHeader:false,label:"",text:sp[1],url:sp[2]?"#"+sp[2]:"",kind:"search"});idx++;c++}}
        if(c===0)browserModel.insert(idx,{isHeader:false,label:"",text:"No results",url:"",kind:"info"}) }

    // Live fuzzy filter — hides non-matching items in browser palette
    property var _fullPaletteData: []
    function applyFuzzy() {
        if (!backend) return
        var query = pageSearchField.text.trim().toLowerCase()
        // Save full data on first call
        if (_fullPaletteData.length === 0) {
            for (var i = 0; i < browserModel.count; i++) {
                _fullPaletteData.push(JSON.parse(JSON.stringify(browserModel.get(i))))
            }
        }
        if (query.length === 0) {
            browserModel.clear()
            for (var j = 0; j < _fullPaletteData.length; j++) browserModel.append(_fullPaletteData[j])
            return
        }
        // Filter: keep headers if any of their items match, items if their text matches
        browserModel.clear()
        var lastHeader = null; var headerHasMatch = false
        for (var k = 0; k < _fullPaletteData.length; k++) {
            var item = _fullPaletteData[k]
            if (item.isHeader) {
                if (headerHasMatch && lastHeader) browserModel.append(lastHeader)
                lastHeader = item; headerHasMatch = false
                continue
            }
            // Fuzzy match: all query chars must appear in order
            var t = (item.text || "").toLowerCase()
            var qi = 0
            for (var ti = 0; ti < t.length && qi < query.length; ti++) {
                if (t.charAt(ti) === query.charAt(qi)) qi++
            }
            if (qi === query.length) {
                if (!headerHasMatch && lastHeader) { browserModel.append(lastHeader); headerHasMatch = true }
                browserModel.append(item)
            }
        }
    }

    // ═══ Terminal Blocks (Warp-style command history with output) ═══
    // ─── Missing packages drawer ───
    //
    // Right-edge sidebar showing packages reported as missing across
    // recent command blocks. Each entry: name, ecosystem, suggested
    // install command, hit count. User can tap the install hint
    // to copy it to clipboard, or tap "Dismiss" to hide.
    //
    // Populated from backend.missing_pkg_list() — newline-separated
    // rows with \x1F field separator.
    //   ecosystem \x1F name \x1F install_hint \x1F hit_count \x1F last_seen
    Drawer {
        id: missingPkgDrawer
        width: Math.min(420, root.width * 0.85)
        height: root.height
        edge: Qt.RightEdge
        dim: true
        Behavior on position { NumberAnimation { duration: 180; easing.type: Easing.OutCubic } }
        property int _revision: -1
        ListModel { id: _mpModel }
        function rebuild() {
            _mpModel.clear()
            if (!backend || !backend.missing_pkg_list) return
            var raw = backend.missing_pkg_list()
            if (!raw || raw.length === 0) return
            var rows = raw.split("\n")
            for (var i = 0; i < rows.length; i++) {
                if (!rows[i]) continue
                var p = rows[i].split("\x1F")
                if (p.length < 5) continue
                _mpModel.append({
                    ecosystem: p[0],
                    name: p[1],
                    installHint: p[2],
                    hitCount: parseInt(p[3]) || 1,
                    lastSeen: parseInt(p[4]) || 0
                })
            }
        }
        onOpened: rebuild()
        // Re-build on revision change so the drawer updates live as
        // new misses come in while it's open.
        Timer {
            interval: 1000
            running: missingPkgDrawer.opened
            repeat: true
            onTriggered: {
                if (!backend || !backend.missing_pkg_revision) return
                var rev = backend.missing_pkg_revision()
                if (rev !== missingPkgDrawer._revision) {
                    missingPkgDrawer._revision = rev
                    missingPkgDrawer.rebuild()
                }
            }
        }
        background: Rectangle { color: th.sf; border.color: th.bd; border.width: 1 }
        ColumnLayout {
            anchors.fill: parent
            anchors.margins: 12
            spacing: 8
            Text {
                text: "Missing packages"
                color: th.tc
                font.pixelSize: 16
                font.bold: true
            }
            Text {
                Layout.fillWidth: true
                text: _mpModel.count > 0
                    ? "Detected from recent command output. Tap an install hint to copy it."
                    : "No missing packages detected. When commands fail with 'command not found' or similar, they'll show up here."
                color: th.tm
                font.pixelSize: 10
                wrapMode: Text.WordWrap
            }
            Rectangle { Layout.fillWidth: true; height: 1; color: th.bd }
            Flickable {
                Layout.fillWidth: true
                Layout.fillHeight: true
                contentHeight: _mpCol.implicitHeight
                clip: true
                ScrollBar.vertical: ScrollBar { policy: ScrollBar.AsNeeded }
                Column {
                    id: _mpCol
                    width: parent.width
                    spacing: 6
                    Repeater {
                        model: _mpModel
                        delegate: Rectangle {
                            width: _mpCol.width
                            height: _mpRow.implicitHeight + 16
                            radius: 8
                            color: Qt.rgba(0.8, 0.4, 0.2, 0.10)
                            border.color: Qt.rgba(0.8, 0.4, 0.2, 0.30)
                            border.width: 1
                            ColumnLayout {
                                id: _mpRow
                                anchors.fill: parent
                                anchors.margins: 8
                                spacing: 4
                                RowLayout {
                                    Layout.fillWidth: true
                                    spacing: 6
                                    Text {
                                        text: model.ecosystem === "Python" ? "\uD83D\uDC0D"
                                            : model.ecosystem === "Node" ? "\uD83D\uDFE2"
                                            : model.ecosystem === "Rust" ? "\uD83E\uDD80"
                                            : model.ecosystem === "Shell" ? "\u2699"
                                            : "\uD83D\uDCE6"
                                        font.pixelSize: 13
                                    }
                                    Text {
                                        Layout.fillWidth: true
                                        text: model.name
                                        color: th.tc
                                        font.pixelSize: 12
                                        font.bold: true
                                        elide: Text.ElideRight
                                    }
                                    Text {
                                        text: model.hitCount > 1
                                            ? "×" + model.hitCount : ""
                                        color: th.tm
                                        font.pixelSize: 9
                                    }
                                }
                                // Install hint — tap to copy.
                                Rectangle {
                                    Layout.fillWidth: true
                                    Layout.preferredHeight: 24
                                    radius: 4
                                    color: _hintMa.containsMouse
                                        ? Qt.lighter(th.sf, 1.4)
                                        : Qt.lighter(th.sf, 1.2)
                                    Behavior on color { ColorAnimation { duration: 80 } }
                                    Text {
                                        anchors.left: parent.left
                                        anchors.leftMargin: 6
                                        anchors.verticalCenter: parent.verticalCenter
                                        text: model.installHint
                                        color: th.tc
                                        font.pixelSize: 10
                                        font.family: "monospace"
                                        elide: Text.ElideRight
                                        width: parent.width - 60
                                    }
                                    Text {
                                        anchors.right: parent.right
                                        anchors.rightMargin: 6
                                        anchors.verticalCenter: parent.verticalCenter
                                        text: _hintMa.containsMouse ? "tap to copy" : ""
                                        color: th.tm
                                        font.pixelSize: 8
                                    }
                                    MouseArea {
                                        id: _hintMa
                                        anchors.fill: parent
                                        hoverEnabled: true
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: {
                                            // v0.1.502: was backend.set_clipboard —
                                            // no such method (it's clipboard_set), so
                                            // the guard was always false and this
                                            // button silently did nothing. Found by
                                            // the QML→backend reference check.
                                            if (backend && backend.clipboard_set) {
                                                backend.clipboard_set(model.installHint)
                                                if (typeof toast !== "undefined" && toast.show) {
                                                    toast.show("Copied: " + model.installHint)
                                                }
                                            }
                                        }
                                    }
                                }
                                // Action row: Run, Dismiss
                                RowLayout {
                                    Layout.fillWidth: true
                                    spacing: 6
                                    Item { Layout.fillWidth: true }  // spacer
                                    Rectangle {
                                        Layout.preferredWidth: 70
                                        Layout.preferredHeight: 22
                                        radius: 11
                                        property bool _pressed: false
                                        color: _pressed ? Qt.darker(th.ac, 1.2)
                                            : (_runMa.containsMouse
                                                ? Qt.lighter(th.ac, 1.15)
                                                : th.ac)
                                        scale: _pressed ? 0.95 : 1.0
                                        Behavior on color { ColorAnimation { duration: 80 } }
                                        Behavior on scale { NumberAnimation { duration: 100 } }
                                        Text {
                                            anchors.centerIn: parent
                                            text: "Run"
                                            color: "#fff"
                                            font.pixelSize: 9
                                            font.bold: true
                                        }
                                        MouseArea {
                                            id: _runMa
                                            anchors.fill: parent
                                            hoverEnabled: true
                                            cursorShape: Qt.PointingHandCursor
                                            onPressed: parent._pressed = true
                                            onReleased: parent._pressed = false
                                            onCanceled: parent._pressed = false
                                            onClicked: {
                                                // Switch to terminal tab + paste
                                                // the install hint as a confirmable
                                                // command. Don't auto-execute —
                                                // user might want to adapt for
                                                // their package manager.
                                                tabBar.currentIndex = 1
                                                missingPkgDrawer.close()
                                                if (backend && backend.pty_write) {
                                                    backend.pty_write(model.installHint)
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        Layout.preferredWidth: 70
                                        Layout.preferredHeight: 22
                                        radius: 11
                                        property bool _pressed: false
                                        color: _pressed ? Qt.darker(th.sf, 0.85)
                                            : (_dmMa.containsMouse
                                                ? Qt.lighter(th.sf, 1.4)
                                                : Qt.lighter(th.sf, 1.2))
                                        scale: _pressed ? 0.95 : 1.0
                                        border.color: th.bd; border.width: 1
                                        Behavior on color { ColorAnimation { duration: 80 } }
                                        Behavior on scale { NumberAnimation { duration: 100 } }
                                        Text {
                                            anchors.centerIn: parent
                                            text: "Dismiss"
                                            color: th.tm
                                            font.pixelSize: 9
                                        }
                                        MouseArea {
                                            id: _dmMa
                                            anchors.fill: parent
                                            hoverEnabled: true
                                            cursorShape: Qt.PointingHandCursor
                                            onPressed: parent._pressed = true
                                            onReleased: parent._pressed = false
                                            onCanceled: parent._pressed = false
                                            onClicked: {
                                                if (backend && backend.missing_pkg_dismiss) {
                                                    backend.missing_pkg_dismiss(
                                                        model.ecosystem, model.name)
                                                    missingPkgDrawer.rebuild()
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ─── Proactive install card (v0.1.470, TODO #2) ───
    //
    // When the voice layer references a tool that isn't on PATH, it
    // calls backend.check_tool_available(name); if that returns a
    // non-empty install command, it calls installCard.offer(name,
    // cmd) to surface THIS card. It's the proactive complement to the
    // reactive missingPkgDrawer (which lists tools that already FAILED
    // in command output). Red-bordered per the TODO spec; one-tap
    // Install pastes the system-appropriate command into the terminal
    // (paste-not-execute, so the user confirms with Enter and can
    // adapt it), mirroring the missingPkgDrawer "Run" action.
    //
    // Self-contained: shows only when offer() has been called and not
    // yet dismissed/installed. All backend calls are null-guarded.
    Item {
        id: installCard
        anchors.fill: parent
        // Render above page content but below modal dialogs.
        z: 50
        visible: _tool.length > 0

        // ── public API (called by the voice wiring) ──
        property string _tool: ""
        property string _cmd: ""
        // offer(toolName, installCommand): show the card. Called after
        // check_tool_available returns a non-empty command.
        function offer(tool, cmd) {
            if (!tool || !cmd) return
            installCard._tool = tool
            installCard._cmd = cmd
        }
        function clear() {
            installCard._tool = ""
            installCard._cmd = ""
        }

        // Auto-dismiss after a while so a stale card doesn't linger if
        // the user ignores it. 12s is long enough to read + decide.
        Timer {
            id: _installCardTimeout
            interval: 12000
            running: installCard._tool.length > 0
            onTriggered: installCard.clear()
        }

        // The card itself — bottom-center banner, slides up on appear.
        Rectangle {
            id: _cardBody
            width: Math.min(440, parent.width - 32)
            implicitHeight: _cardCol.implicitHeight + 24
            height: implicitHeight
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.bottom: parent.bottom
            anchors.bottomMargin: installCard.visible ? 24 : -height - 24
            Behavior on anchors.bottomMargin {
                NumberAnimation { duration: 220; easing.type: Easing.OutCubic }
            }
            radius: 10
            color: th.sf
            // Red border per the TODO spec — signals "action needed".
            border.color: Qt.rgba(0.90, 0.34, 0.28, 1.0)
            border.width: 2
            opacity: installCard.visible ? 1.0 : 0
            Behavior on opacity { NumberAnimation { duration: 180 } }

            ColumnLayout {
                id: _cardCol
                anchors.fill: parent
                anchors.margins: 12
                spacing: 8

                Text {
                    Layout.fillWidth: true
                    text: "\u26A0  " + installCard._tool + " isn't installed"
                    color: th.tc
                    font.pixelSize: 14
                    font.bold: true
                    elide: Text.ElideRight
                }
                // The detected install command, shown monospace so the
                // user sees exactly what will be pasted.
                Rectangle {
                    Layout.fillWidth: true
                    implicitHeight: _cmdText.implicitHeight + 12
                    radius: 6
                    color: Qt.darker(th.sf, 1.25)
                    border.color: th.bd; border.width: 1
                    Text {
                        id: _cmdText
                        anchors.fill: parent
                        anchors.margins: 6
                        text: installCard._cmd
                        color: th.tm
                        font.family: "monospace"
                        font.pixelSize: 12
                        wrapMode: Text.WrapAnywhere
                    }
                }
                RowLayout {
                    Layout.fillWidth: true
                    spacing: 8
                    Item { Layout.fillWidth: true }
                    // Dismiss
                    Rectangle {
                        Layout.preferredWidth: 80
                        Layout.preferredHeight: 30
                        radius: 15
                        property bool _pressed: false
                        color: _pressed ? Qt.darker(th.sf, 0.85)
                            : (_icDismissMa.containsMouse
                                ? Qt.lighter(th.sf, 1.4) : Qt.lighter(th.sf, 1.2))
                        border.color: th.bd; border.width: 1
                        scale: _pressed ? 0.95 : 1.0
                        Behavior on color { ColorAnimation { duration: 80 } }
                        Behavior on scale { NumberAnimation { duration: 100 } }
                        Text {
                            anchors.centerIn: parent; text: "Dismiss"
                            color: th.tm; font.pixelSize: 11
                        }
                        MouseArea {
                            id: _icDismissMa
                            anchors.fill: parent; hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onPressed: parent._pressed = true
                            onReleased: parent._pressed = false
                            onCanceled: parent._pressed = false
                            onClicked: installCard.clear()
                        }
                    }
                    // Install — paste the command to the terminal
                    // (NOT auto-execute; user confirms with Enter and
                    // can adapt). Same flow as missingPkgDrawer's Run.
                    Rectangle {
                        Layout.preferredWidth: 90
                        Layout.preferredHeight: 30
                        radius: 15
                        property bool _pressed: false
                        color: _pressed ? Qt.darker(th.ac, 0.85)
                            : (_icRunMa.containsMouse ? Qt.lighter(th.ac, 1.15) : th.ac)
                        scale: _pressed ? 0.95 : 1.0
                        Behavior on color { ColorAnimation { duration: 80 } }
                        Behavior on scale { NumberAnimation { duration: 100 } }
                        Text {
                            anchors.centerIn: parent; text: "Install"
                            color: "#fff"; font.pixelSize: 11; font.bold: true
                        }
                        MouseArea {
                            id: _icRunMa
                            anchors.fill: parent; hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onPressed: parent._pressed = true
                            onReleased: parent._pressed = false
                            onCanceled: parent._pressed = false
                            onClicked: {
                                // Switch to terminal + paste the command.
                                // Strip a leading "# " comment form (the
                                // Unknown-manager fallback hint) so the
                                // user gets something runnable; if it's a
                                // pure comment, paste as-is for them to edit.
                                tabBar.currentIndex = 1
                                var cmd = installCard._cmd
                                if (backend && backend.pty_write) {
                                    backend.pty_write(cmd)
                                }
                                installCard.clear()
                            }
                        }
                    }
                }
            }
        }
    }

    // ─── Favorites picker popup ───
    //
    // Lightweight overlay showing the user's Home anchor + any
    // Dolphin/KDE favorites parsed from user-places.xbel. Each
    // entry is tap-to-cd: tapping switches to the terminal tab
    // and pastes a properly-quoted `cd <path>` (without auto-
    // executing — same safety rule as missing-pkg Run button).
    //
    // Hidden by default. Open via voice "show favorites" or
    // tap the home icon in the terminal toolbar (added below).
    //
    // Falls back gracefully on non-KDE systems: only the Home
    // anchor appears. The list refreshes on every open() so a
    // user who edits Dolphin's favorites mid-session sees changes
    // without restart.
    Popup {
        id: favoritesPopup
        modal: true
        dim: true
        closePolicy: Popup.CloseOnEscape | Popup.CloseOnPressOutside
        // Centered, sized to content with sensible caps.
        x: Math.round((root.width - width) / 2)
        y: Math.round((root.height - height) / 2)
        width: Math.min(380, root.width - 32)
        height: Math.min(_favCol.implicitHeight + 32, root.height - 80)
        background: Rectangle { color: th.sf; radius: 12; border.color: th.bd; border.width: 1 }

        ListModel { id: _favModel }

        function rebuild() {
            _favModel.clear()
            if (!backend) return
            // Always include Home as first anchor.
            var home = backend.home_path ? backend.home_path() : ""
            if (home && home.length > 0) {
                _favModel.append({
                    name: "Home",
                    path: home,
                    isAnchor: true
                })
            }
            // Dolphin favorites. Guard `backend` itself before
            // accessing methods — checking `backend.X` directly
            // crashes when backend is null (v0.1.157 lint finding).
            if (backend && backend.dolphin_favorites_list) {
                var raw = backend.dolphin_favorites_list()
                if (raw && raw.length > 0) {
                    var rows = raw.split("\n")
                    for (var i = 0; i < rows.length; i++) {
                        if (!rows[i]) continue
                        var p = rows[i].split("\x1F")
                        if (p.length < 2) continue
                        _favModel.append({
                            name: p[0],
                            path: p[1],
                            isAnchor: false
                        })
                    }
                }
            }
        }

        onOpened: rebuild()

        contentItem: ColumnLayout {
            id: _favCol
            anchors.fill: parent
            anchors.margins: 14
            spacing: 8
            Text {
                text: "Favorites"
                color: th.tc
                font.pixelSize: 16
                font.bold: true
            }
            Text {
                Layout.fillWidth: true
                text: _favModel.count <= 1
                    ? "Tap a destination. Add more places by bookmarking them in Dolphin (KDE)."
                    : "Tap a destination to navigate there."
                color: th.tm
                font.pixelSize: 10
                wrapMode: Text.WordWrap
            }
            Rectangle { Layout.fillWidth: true; height: 1; color: th.bd }
            Flickable {
                Layout.fillWidth: true
                Layout.preferredHeight: Math.min(_favList.implicitHeight, 360)
                contentHeight: _favList.implicitHeight
                clip: true
                ScrollBar.vertical: ScrollBar { policy: ScrollBar.AsNeeded }
                Column {
                    id: _favList
                    width: parent.width
                    spacing: 4
                    Repeater {
                        model: _favModel
                        delegate: Rectangle {
                            width: _favList.width
                            height: 38
                            radius: 8
                            property bool _pressed: false
                            color: _pressed
                                ? Qt.darker(th.sf, 0.85)
                                : (_favMa.containsMouse
                                    ? Qt.lighter(th.sf, 1.4)
                                    : Qt.lighter(th.sf, 1.2))
                            scale: _pressed ? 0.97 : 1.0
                            Behavior on color { ColorAnimation { duration: 80 } }
                            Behavior on scale { NumberAnimation { duration: 100 } }
                            border.color: model.isAnchor
                                ? Qt.rgba(0.4, 0.7, 0.4, 0.4)
                                : th.bd
                            border.width: 1
                            RowLayout {
                                anchors.fill: parent
                                anchors.leftMargin: 10
                                anchors.rightMargin: 10
                                spacing: 8
                                Text {
                                    text: model.isAnchor ? "\uD83C\uDFE0" : "\u2B50"
                                    font.pixelSize: 13
                                }
                                ColumnLayout {
                                    Layout.fillWidth: true
                                    spacing: 0
                                    Text {
                                        Layout.fillWidth: true
                                        text: model.name
                                        color: th.tc
                                        font.pixelSize: 12
                                        font.bold: true
                                        elide: Text.ElideRight
                                    }
                                    Text {
                                        Layout.fillWidth: true
                                        text: model.path
                                        color: th.tm
                                        font.pixelSize: 9
                                        font.family: "monospace"
                                        elide: Text.ElideMiddle
                                    }
                                }
                            }
                            MouseArea {
                                id: _favMa
                                anchors.fill: parent
                                hoverEnabled: true
                                cursorShape: Qt.PointingHandCursor
                                onPressed: parent._pressed = true
                                onReleased: parent._pressed = false
                                onCanceled: parent._pressed = false
                                onClicked: {
                                    favoritesPopup.close()
                                    tabBar.currentIndex = 1
                                    if (backend && backend.pty_write) {
                                        // v0.1.217: use the shared
                                        // shellQuote helper. Previously
                                        // had inline quoting that only
                                        // triggered on space/quote/paren
                                        // — shellQuote uses the full
                                        // shell-safe rule (any non
                                        // alnum-and-friends triggers).
                                        backend.pty_write("cd " + shellQuote(model.path) + "\r")
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    Drawer { id: blocksDrawer; width: Math.min(540, root.width*0.95); height: root.height; edge: Qt.LeftEdge; dim: true
        Behavior on position { NumberAnimation { duration: 180; easing.type: Easing.OutCubic } }
        onOpened: rebuildBlocks()
        function rebuildBlocks() {
            blocksModel.clear()
            if (!backend) return
            var rows = backend.term_blocks_list(50).split("\n")
            // Reverse so most recent is at top
            for (var i = rows.length - 1; i >= 0; i--) {
                if (!rows[i]) continue
                var p = rows[i].split("\x1F")
                if (p.length < 7) continue
                // v0.1.255 (GITLOG-3): hasTree is the 8th field
                // when present (older serialize formats may have
                // only 7). Default false when absent.
                blocksModel.append({
                    blockId: parseInt(p[0]) || 0,
                    cmd: p[1] || "",
                    outputPreview: p[2] || "",
                    duration: p[3] || "",
                    exitCode: p[4] || "?",
                    cwd: p[5] || "",
                    started: p[6] || "",
                    hasTree: (p.length >= 8 && p[7] === "1")
                })
            }
        }
        ListModel { id: blocksModel }
        // v0.1.255 (GITLOG-3): tracks the most-recently-rolled-back
        // block id and a counter that bumps on each rollback. Block
        // delegates bind their flash animation to this — when the
        // counter changes AND their blockId matches, they flash.
        // The counter is needed because rolling back the SAME block
        // twice should re-trigger the animation; binding only to id
        // wouldn't fire.
        property int _rbLastId: -1
        property int _rbCounter: 0
        Connections {
            target: backend
            ignoreUnknownSignals: true
            function on_RollbackDidRun(blockId) {
                blocksDrawer._rbLastId = blockId
                blocksDrawer._rbCounter += 1
                // Refresh the model so any newly-snapshot-less
                // blocks (none currently, but future state changes)
                // get re-evaluated for the rollback button.
                blocksDrawer.rebuildBlocks()
            }
        }
        Rectangle { anchors.fill: parent; color: th.sf
            ColumnLayout { anchors.fill: parent; anchors.margins: 10; spacing: 6
                RowLayout { Layout.fillWidth: true
                    Text { Layout.fillWidth: true; text: "Command Blocks"; color: th.tc; font.pixelSize: 17; font.bold: true }
                    // v0.1.156: refresh button. Was a bare "↻" with no
                    // tooltip — easy to confuse with the row-level
                    // ↻ from pre-v0.1.144 (which then became ▶ for
                    // rerun). Added the explicit text label so the
                    // intent is unmistakable, plus a tooltip on hover.
                    // Doesn't widen the drawer noticeably since
                    // RowLayout still gives the title fillWidth.
                    Rectangle {
                        Layout.preferredWidth: 70
                        Layout.preferredHeight: 24
                        radius: 5
                        color: _refreshMa.containsMouse ? Qt.lighter(th.sf, 1.5) : "transparent"
                        border.width: _refreshMa.containsMouse ? 0 : 1
                        border.color: Qt.rgba(th.tm.r, th.tm.g, th.tm.b, 0.30)
                        RowLayout {
                            anchors.centerIn: parent
                            spacing: 4
                            Text { text: "\u21BB"; color: th.tm; font.pixelSize: 13 }
                            Text { text: "Refresh"; color: th.tm; font.pixelSize: 10 }
                        }
                        MouseArea {
                            id: _refreshMa
                            anchors.fill: parent
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            ToolTip.visible: containsMouse
                            ToolTip.text: "Reload the block list from the backend"
                            onClicked: blocksDrawer.rebuildBlocks()
                        }
                    }
                }
                Rectangle { Layout.fillWidth: true; height: 1; color: th.bd }
                Text { Layout.fillWidth: true; visible: blocksModel.count === 0
                    text: "No commands yet. Run something in the terminal."
                    color: th.tm; font.pixelSize: 12; horizontalAlignment: Text.AlignHCenter; padding: 20 }
                ListView { Layout.fillWidth: true; Layout.fillHeight: true; clip: true; model: blocksModel
                    flickDeceleration: 1500; maximumFlickVelocity: 8000; boundsBehavior: Flickable.DragAndOvershootBounds
                    spacing: 8
                    ScrollBar.vertical: ScrollBar { policy: ScrollBar.AsNeeded }
                    delegate: Rectangle {
                        id: _blockDelegate
                        width: ListView.view.width; radius: 8
                        color: _bma.containsMouse ? Qt.lighter(th.tbg, 1.3) : Qt.lighter(th.tbg, 1.15)
                        border.width: 1
                        border.color: model.exitCode === "0" ? Qt.rgba(0.3,0.8,0.4,0.4)
                                    : model.exitCode === "?" ? th.bd
                                    : Qt.rgba(0.9,0.4,0.4,0.4)
                        property bool expanded: false
                        height: expanded ? 220 : 70
                        Behavior on height { NumberAnimation { duration: 180; easing.type: Easing.OutQuad } }
                        Behavior on color { ColorAnimation { duration: 100 } }

                        // v0.1.255 (GITLOG-3): rollback flash overlay.
                        // When the blocksDrawer's _rbCounter ticks AND
                        // _rbLastId matches this delegate's blockId, run
                        // the wipe animation. The animation fires whether
                        // the rollback came from voice or from a button
                        // click on this same delegate.
                        //
                        // Animation: a horizontal sweep of a desaturated
                        // overlay that goes left→right, then a brief
                        // hold, then fades. The "Star Wars wipe" the user
                        // asked about — full wipe on a confirmed rollback,
                        // half-wipe-on-utterance variant deferred until
                        // partial-utterance detection lands in voice
                        // pipeline.
                        Rectangle {
                            id: _rbFlash
                            anchors.fill: parent
                            radius: parent.radius
                            color: "#8866ddff"   // soft cyan, transparent
                            opacity: 0
                            visible: opacity > 0.01
                            // Wipe mask: animate width from 0 → parent.width.
                            property real _wipeFrac: 0
                            // Clip via a child Item bounding the colored
                            // rectangle. We can't directly mask radius, so
                            // we just animate opacity for v1 — wipe-style
                            // motion lives in a child instead.
                            Rectangle {
                                anchors.left: parent.left
                                anchors.top: parent.top
                                anchors.bottom: parent.bottom
                                width: parent.width * _rbFlash._wipeFrac
                                radius: parent.radius
                                color: "#aa00d4ff"   // brighter leading edge
                                opacity: 0.55
                            }
                        }

                        // Trigger: when the counter ticks AND ids match,
                        // fire the animation. A hidden Item watches the
                        // counter via a plain property binding, and
                        // onCounterWatchChanged fires the animation. Plain
                        // (no underscore prefix) name so the auto-generated
                        // signal handler is the simple onCounterWatchChanged
                        // form.
                        Item {
                            visible: false
                            property int counterWatch: blocksDrawer._rbCounter
                            onCounterWatchChanged: {
                                if (blocksDrawer._rbLastId === model.blockId) {
                                    _rbAnim.restart()
                                }
                            }
                        }

                        SequentialAnimation {
                            id: _rbAnim
                            // Wipe in from left.
                            ParallelAnimation {
                                NumberAnimation { target: _rbFlash; property: "opacity"
                                    from: 0; to: 0.9; duration: 80
                                    easing.type: Easing.OutCubic }
                                NumberAnimation { target: _rbFlash; property: "_wipeFrac"
                                    from: 0; to: 1; duration: 320
                                    easing.type: Easing.InOutCubic }
                            }
                            // Hold briefly.
                            PauseAnimation { duration: 120 }
                            // Fade out.
                            ParallelAnimation {
                                NumberAnimation { target: _rbFlash; property: "opacity"
                                    from: 0.9; to: 0; duration: 280
                                    easing.type: Easing.InCubic }
                                NumberAnimation { target: _rbFlash; property: "_wipeFrac"
                                    to: 1.05; duration: 280
                                    easing.type: Easing.InCubic }
                            }
                            // Reset for next time.
                            ScriptAction { script: _rbFlash._wipeFrac = 0 }
                        }

                        ColumnLayout {
                            anchors.fill: parent; anchors.margins: 10; spacing: 4
                            // Header row: command + exit + duration + actions
                            RowLayout { Layout.fillWidth: true; spacing: 6
                                Rectangle { width: 8; height: 8; radius: 4
                                    color: model.exitCode === "0" ? "#7ddc7d" : model.exitCode === "?" ? th.tm : "#dc7d7d" }
                                Text { Layout.fillWidth: true
                                    text: "$ " + model.cmd
                                    color: th.tfg; font.family: "monospace"; font.pixelSize: 13; font.bold: true
                                    elide: Text.ElideRight }
                                Text { visible: model.duration !== "-" && model.duration !== ""
                                    text: parseInt(model.duration) > 999 ? Math.round(parseInt(model.duration)/1000)+"s" : model.duration+"ms"
                                    color: th.tm; font.pixelSize: 10; font.family: "monospace" }
                                // Inline action buttons
                                //
                                // v0.1.144: icon clarity pass. Previous
                                // icons were ↻ ⎘ ☰ — confusing because
                                // ↻ "looks like reload not rerun", ⎘
                                // is the Unicode "copy" but reads as
                                // "next page", and ☰ is "hamburger" but
                                // here labeled "Copy output". Switched to
                                // ▶ (rerun, like a play button), 📋 (copy
                                // command — universal clipboard icon),
                                // and 📥 (copy output — "inbox" hints at
                                // pulling the output OUT of the block).
                                //
                                // Also: added console.log + return-value
                                // checks on the copy buttons. v0.1.143
                                // user reported "copy does nothing". The
                                // backend.term_block_copy_output call
                                // returns false silently when (a) no
                                // clipboard tool installed (wl-copy /
                                // xclip / xsel / pbcopy), or (b) the
                                // block id wasn't found. Logging both
                                // surfaces which case happened.
                                Rectangle { width: 26; height: 22; radius: 6; color: _rrma.containsMouse ? th.ac : "transparent"
                                    Text { anchors.centerIn: parent; text: "\u25B6"; color: _rrma.containsMouse ? "#fff" : th.tm; font.pixelSize: 11 }
                                    MouseArea { id: _rrma; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                                        ToolTip.visible: containsMouse; ToolTip.text: "Re-run"
                                        // v0.1.151: visible toast confirms the
                                        // rerun fired. Drawer closes anyway so
                                        // the toast is the only persistent cue
                                        // the user has that anything happened.
                                        onClicked: {
                                            backend.term_block_rerun(model.blockId)
                                            blocksDrawer.close()
                                            if (typeof toast !== "undefined") {
                                                toast.show("Re-running…", "info")
                                            }
                                        } } }
                                Rectangle { width: 26; height: 22; radius: 6; color: _cpma.containsMouse ? th.ac : "transparent"
                                    Text { anchors.centerIn: parent; text: "\uD83D\uDCCB"; color: _cpma.containsMouse ? "#fff" : th.tm; font.pixelSize: 12 }
                                    MouseArea { id: _cpma; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                                        ToolTip.visible: containsMouse; ToolTip.text: "Copy command"
                                        // v0.1.151: toast on success AND failure
                                        // — replaces the v0.1.144 console-only
                                        // diagnostic. Success uses the green
                                        // accent; failure uses red with a hint
                                        // pointing at the most likely root
                                        // cause (no clipboard tool installed).
                                        onClicked: {
                                            var ok = backend.term_block_copy_command(model.blockId)
                                            console.log("[blocks] copy command id=" + model.blockId + " ok=" + ok)
                                            if (typeof toast !== "undefined") {
                                                if (ok) {
                                                    toast.show("Copied command", "success")
                                                } else {
                                                    toast.show("Copy failed — check clipboard tool", "error")
                                                }
                                            }
                                        } } }
                                Rectangle { width: 26; height: 22; radius: 6; color: _coma.containsMouse ? th.ac : "transparent"
                                    Text { anchors.centerIn: parent; text: "\uD83D\uDCE5"; color: _coma.containsMouse ? "#fff" : th.tm; font.pixelSize: 12 }
                                    MouseArea { id: _coma; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                                        ToolTip.visible: containsMouse; ToolTip.text: "Copy output"
                                        onClicked: {
                                            var ok = backend.term_block_copy_output(model.blockId)
                                            console.log("[blocks] copy output id=" + model.blockId + " ok=" + ok)
                                            if (typeof toast !== "undefined") {
                                                if (ok) {
                                                    toast.show("Copied output", "success")
                                                } else {
                                                    toast.show("Copy failed — check clipboard tool", "error")
                                                }
                                            }
                                        } } }
                                // v0.1.255 (GITLOG-3): per-block rollback
                                // button. Only visible when the block has a
                                // tree snapshot (model.hasTree). Restores
                                // the cwd's pre-command state. Additive
                                // restore — files created since are not
                                // deleted. Backend emits rollback_did_run
                                // afterward; the scrollback Connections
                                // handler picks up the signal to animate.
                                Rectangle {
                                    width: 26; height: 22; radius: 6
                                    visible: model.hasTree === true
                                        || model.hasTree === "1"
                                        || model.hasTree === 1
                                    color: _rbma.containsMouse ? "#a44" : "transparent"
                                    Text {
                                        anchors.centerIn: parent
                                        // Counterclockwise arrow with a tail —
                                        // reads as "undo" / "go back" without
                                        // being confusable with the ▶ rerun
                                        // button next door.
                                        text: "\u21A9"
                                        color: _rbma.containsMouse ? "#fff" : th.tm
                                        font.pixelSize: 13
                                    }
                                    MouseArea {
                                        id: _rbma
                                        anchors.fill: parent
                                        hoverEnabled: true
                                        cursorShape: Qt.PointingHandCursor
                                        ToolTip.visible: containsMouse
                                        ToolTip.text: "Rollback to before this command"
                                        onClicked: {
                                            if (!backend || !backend.term_block_rollback) return
                                            var msg = backend.term_block_rollback(model.blockId)
                                            console.log("[blocks] rollback id=" + model.blockId + " → " + msg)
                                            if (typeof toast !== "undefined" && msg && msg.length > 0) {
                                                toast.show(msg, "info")
                                            }
                                            blocksDrawer.close()
                                        }
                                    }
                                }
                                // v0.1.148 STAGE M: per-block gesture-menu host.
                                // Inline 4-handler pattern (v0.1.146) replaced
                                // with the GestureHost wrapper — see
                                // qml/GestureHost.qml. Same observable behavior;
                                // proves the abstraction works across both
                                // toolbar (Flickable parent) and drawer
                                // (ListView+Drawer parent) contexts.
                                //
                                // v0.1.150: visual differentiation from the
                                // sibling ▶ 📋 📥 action buttons. Subtle
                                // border in the resting state hints "this
                                // is a different kind of control" — a menu
                                // trigger, not a one-tap action. Also +4px
                                // wider so the thumb-target is more
                                // prominent. Filed under v0.1.146 follow-ups
                                // as the "looks identical to the icons next
                                // to it" item.
                                GestureHost {
                                    id: _moreBtn
                                    popup: _blockRowPopup
                                    gestureContext: model.blockId
                                    hoverEnabled: true
                                    width: 30; height: 22
                                    ToolTip.visible: _moreBtn.containsMouse
                                    ToolTip.text: "Actions"
                                    Rectangle {
                                        anchors.fill: parent
                                        radius: 6
                                        color: _moreBtn.containsMouse ? th.ac : "transparent"
                                        // Subtle border in the resting state
                                        // hints "menu trigger" vs the
                                        // borderless one-tap actions next door.
                                        // On hover the border fades into the
                                        // hover-color fill so it looks normal.
                                        border.width: _moreBtn.containsMouse ? 0 : 1
                                        border.color: Qt.rgba(
                                            th.tm.r, th.tm.g, th.tm.b, 0.35)
                                        Text {
                                            anchors.centerIn: parent
                                            text: "\u22EF"  // ⋯
                                            color: _moreBtn.containsMouse ? "#fff" : th.tm
                                            font.pixelSize: 14
                                        }
                                    }
                                }
                            }

                            // ─── AI summary section ───
                            //
                            // When log summarization is enabled, render
                            // a friendly summary above the raw output.
                            // The summary is loaded reactively via a
                            // binding that re-evaluates when the
                            // backend's revision counter changes (we
                            // poll it on a timer below).
                            //
                            // Summary text is read via backend.log_summary_get(blockId).
                            // When the worker hasn't produced one yet,
                            // the binding returns "" — we show a
                            // "Thinking..." chip so users know
                            // something's coming.
                            //
                            // The chevron to the right of the summary
                            // toggles whether the raw output is shown
                            // beneath. When summary is present and we
                            // have a chevron, the default state is
                            // SUMMARY-ONLY — raw output is hidden until
                            // the user taps to peek under the hood.
                            Rectangle {
                                id: _summaryChip
                                Layout.fillWidth: true
                                // Visible whenever there's a summary,
                                // dumb or AI. Previously gated on
                                // log_summary_is_enabled() which hid
                                // the dumb fallback when AI was off
                                // — we now WANT to show dumb either
                                // way since it's the no-AI mode the
                                // user explicitly requested.
                                visible: backend && (_summaryChip.summaryText.length > 0
                                            || (backend.log_summary_is_enabled
                                                && backend.log_summary_is_enabled()))
                                Layout.preferredHeight: visible ? Math.max(28, _blockSummaryText.implicitHeight + 14) : 0
                                radius: 8
                                color: _isDumb
                                    ? Qt.rgba(0.4, 0.4, 0.4, 0.18)   // muted neutral for dumb
                                    : Qt.rgba(0.2, 0.4, 0.6, 0.18)   // blue tint for AI
                                border.color: _isDumb
                                    ? Qt.rgba(0.5, 0.5, 0.5, 0.4)
                                    : Qt.rgba(0.4, 0.6, 0.8, 0.4)
                                border.width: 1
                                Behavior on Layout.preferredHeight { NumberAnimation { duration: 140 } }

                                // The summary text itself. Re-evaluated
                                // when _summaryRevision changes.
                                property string summaryText: backend && _summaryRevision >= 0
                                    ? backend.log_summary_get(model.blockId)
                                    : ""
                                property string summaryModel: backend && _summaryRevision >= 0
                                    ? backend.log_summary_model(model.blockId)
                                    : ""
                                property bool _isDumb: backend && _summaryRevision >= 0
                                    && backend.log_summary_is_dumb
                                    ? backend.log_summary_is_dumb(model.blockId)
                                    : false
                                // Relevance score from utterance (0..1).
                                // Re-evaluated when root._recentUtterance
                                // or _summaryRevision changes.
                                property real _relevance: backend
                                    && backend.log_summary_relevance
                                    && root._recentUtterance.length > 0
                                    && _summaryRevision >= 0
                                    ? backend.log_summary_relevance(model.blockId, root._recentUtterance)
                                    : 0.0
                                // Progress percentage from detected
                                // ASCII bars in the block's output,
                                // -1 if none. When >= 0 we render a
                                // small inline bar between the icon
                                // and the text.
                                property int _progress: backend
                                    && backend.log_summary_progress
                                    && _summaryRevision >= 0
                                    ? backend.log_summary_progress(model.blockId)
                                    : -1

                                RowLayout {
                                    anchors.fill: parent
                                    anchors.margins: 7
                                    spacing: 6
                                    Text {
                                        // Sparkle for AI, gear for dumb,
                                        // hourglass for pending.
                                        text: _summaryChip.summaryText.length > 0
                                            ? (_summaryChip._isDumb ? "\u2699" : "\u2728")
                                            : "\u23F3"
                                        color: th.tm
                                        font.pixelSize: 12
                                    }
                                    // Inline progress sparkline. Visible
                                    // only when the block had a detected
                                    // progress bar. Width 36px, height 6px.
                                    // Fill proportional to percent.
                                    // Foundation step toward richer
                                    // ASCII-as-chart rendering — for now
                                    // we surface the parsed percentage
                                    // visually so users see at-a-glance
                                    // "this command made progress" in
                                    // the chip.
                                    Rectangle {
                                        Layout.preferredWidth: visible ? 36 : 0
                                        Layout.preferredHeight: 6
                                        Layout.alignment: Qt.AlignVCenter
                                        radius: 3
                                        color: Qt.rgba(1, 1, 1, 0.10)
                                        visible: _summaryChip._progress >= 0
                                        Rectangle {
                                            anchors.left: parent.left
                                            anchors.top: parent.top
                                            anchors.bottom: parent.bottom
                                            radius: parent.radius
                                            width: parent.width
                                                * Math.max(0, Math.min(1, _summaryChip._progress / 100))
                                            // Color shifts green as it
                                            // approaches 100% — gives
                                            // the "we're getting there"
                                            // feedback.
                                            color: _summaryChip._progress >= 95
                                                ? "#16a34a"
                                                : (_summaryChip._progress >= 50 ? Qt.lighter(th.ac, 1.2) : th.ac)
                                            Behavior on width { NumberAnimation { duration: 200 } }
                                        }
                                    }
                                    Text {
                                        // Numeric percent next to the bar.
                                        visible: _summaryChip._progress >= 0
                                        Layout.preferredWidth: visible ? implicitWidth : 0
                                        text: _summaryChip._progress + "%"
                                        color: th.tm
                                        font.pixelSize: 9
                                    }
                                    Text {
                                        id: _blockSummaryText
                                        Layout.fillWidth: true
                                        text: _summaryChip.summaryText.length > 0
                                            ? _summaryChip.summaryText
                                            : "Generating summary…"
                                        color: _summaryChip.summaryText.length > 0
                                            ? th.tc
                                            : th.tm
                                        font.pixelSize: 11
                                        font.italic: _summaryChip.summaryText.length === 0
                                        wrapMode: Text.WordWrap
                                    }
                                    // Chevron — toggles raw output on/off.
                                    Text {
                                        text: "\u203A"
                                        color: th.tm
                                        font.pixelSize: 14
                                        rotation: parent.parent.parent.parent._showRaw ? 90 : 0
                                        Behavior on rotation {
                                            NumberAnimation { duration: 140; easing.type: Easing.OutCubic }
                                        }
                                        MouseArea {
                                            anchors.fill: parent
                                            anchors.margins: -4
                                            cursorShape: Qt.PointingHandCursor
                                            onClicked: {
                                                parent.parent.parent.parent.parent._showRaw =
                                                    !parent.parent.parent.parent.parent._showRaw
                                            }
                                        }
                                    }
                                }

                                // Voice-relevance slider. Sits at the
                                // bottom edge of the chip. Width
                                // proportional to the relevance score.
                                // Width 0 when no recent utterance OR
                                // score is 0 — invisible by default.
                                Rectangle {
                                    anchors.left: parent.left
                                    anchors.right: parent.right
                                    anchors.bottom: parent.bottom
                                    height: _summaryChip._relevance > 0.05 ? 2 : 0
                                    radius: 1
                                    color: th.ac
                                    opacity: _summaryChip._relevance
                                    Behavior on height { NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }
                                    Behavior on opacity { NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }
                                    // Inner fill: portion of width
                                    // proportional to score.
                                    Rectangle {
                                        anchors.left: parent.left
                                        anchors.top: parent.top
                                        anchors.bottom: parent.bottom
                                        width: parent.width * _summaryChip._relevance
                                        radius: 1
                                        color: Qt.lighter(th.ac, 1.4)
                                        Behavior on width { NumberAnimation { duration: 250; easing.type: Easing.OutCubic } }
                                    }
                                }
                            }
                            // Tiny model attribution under the summary —
                            // ONLY for AI summaries. Dumb summaries
                            // suppress this since "via dumb" is noise.
                            Text {
                                Layout.fillWidth: true
                                visible: _summaryChip.visible
                                         && _summaryChip.summaryModel.length > 0
                                         && !_summaryChip._isDumb
                                Layout.preferredHeight: visible ? implicitHeight : 0
                                text: "via " + _summaryChip.summaryModel
                                color: th.tm
                                font.pixelSize: 9
                                font.italic: true
                                horizontalAlignment: Text.AlignRight
                            }

                            // Output preview. Hidden when there's a
                            // summary (dumb or AI) AND user hasn't
                            // toggled raw view via the chevron. The
                            // friendly summary is the lead; raw is
                            // opt-in.
                            Text { Layout.fillWidth: true
                                text: model.outputPreview
                                color: th.tm; font.family: "monospace"; font.pixelSize: 11
                                wrapMode: Text.WordWrap
                                maximumLineCount: parent.parent.expanded ? 99 : 2
                                elide: Text.ElideRight
                                visible: !parent.parent.expanded
                                    && (parent.parent._showRaw
                                        || _summaryChip.summaryText.length === 0)
                            }
                            // Full output (when expanded)
                            ScrollView { Layout.fillWidth: true; Layout.fillHeight: true
                                visible: parent.parent.expanded
                                clip: true
                                Text { text: backend && parent.parent.parent.expanded ? backend.term_block_output(model.blockId) : ""
                                    color: th.tfg; font.family: "monospace"; font.pixelSize: 11
                                    wrapMode: Text.WordWrap
                                    textFormat: Text.PlainText }
                            }
                        }
                        // Property tracking whether the user has revealed
                        // the raw output in summary mode. Default false
                        // so the friendly summary leads, raw is opt-in
                        // via the chevron.
                        property bool _showRaw: false
                        MouseArea { id: _bmaRaw; anchors.fill: parent; hoverEnabled: true
                            propagateComposedEvents: true; acceptedButtons: Qt.LeftButton
                            onClicked: function(mouse) {
                                // Don't toggle if click was on an action button
                                var localY = mouse.y
                                if (localY < 32) return  // header area, let buttons handle
                                parent.expanded = !parent.expanded
                            }
                        }
                    }
                }
            }
        }
        // Summary-revision poll. This timer ticks when the drawer is
        // open, polling backend.log_summary_revision() — when it
        // changes, we update _summaryRevision which is bound by the
        // delegates above. Cheap (single atomic load) but only running
        // while the drawer is visible so it doesn't burn cycles when
        // nobody's looking.
        property int _summaryRevision: 0
        Timer {
            interval: 800
            running: blocksDrawer.visible && backend !== null
                     && backend.log_summary_is_enabled !== undefined
                     && backend.log_summary_is_enabled()
            repeat: true
            onTriggered: {
                if (!backend || !backend.log_summary_revision) return
                var rev = backend.log_summary_revision()
                if (rev !== blocksDrawer._summaryRevision) {
                    blocksDrawer._summaryRevision = rev
                }
            }
        }
    }

    // Track summary revision at top level so block delegates can
    // bind their summary text to it. The blocksDrawer's timer above
    // also writes to this — having the property here makes it
    // visible to delegates without going through the drawer scope.
    property int _summaryRevision: 0
    Connections {
        target: blocksDrawer
        function on_SummaryRevisionChanged() {
            root._summaryRevision = blocksDrawer._summaryRevision
        }
    }

    // Recent voice utterance — set by voicePopup whenever whisper
    // returns a transcription. Block delegates read this to compute
    // relevance scores via backend.log_summary_relevance(). When the
    // user speaks, blocks containing matching keywords light up via
    // a thin slider bar at the bottom of each summary chip.
    //
    // Cleared after _utteranceFadeMs of inactivity so the highlight
    // doesn't linger forever.
    property string _recentUtterance: ""
    property int _utteranceTickMs: 0  // monotonic: set when utterance lands
    Timer {
        // Fade the recent-utterance state after 12s. The slider on
        // each block goes back to 0 width.
        interval: 1000
        running: root._recentUtterance.length > 0
        repeat: true
        onTriggered: {
            if (Date.now() - root._utteranceTickMs > 12000) {
                root._recentUtterance = ""
            }
        }
    }

    // ═══ Terminal Palette (right) ═══
    Drawer { id: paletteDrawer; width: Math.min(360,root.width*0.85); height: root.height; edge: Qt.RightEdge; dim: true
        Behavior on position { NumberAnimation { duration: 180; easing.type: Easing.OutCubic } }
        onOpened: rebuildPalette()
        function rebuildPalette(){ paletteModel.clear(); if(!backend)return
            var rows=backend.palette_flat_list().split("\n"); for(var i=0;i<rows.length;i++){if(!rows[i])continue;var sep=rows[i].indexOf("\x1F");if(sep<0)continue
                paletteModel.append({isHeader:rows[i].substring(0,sep)==="H",label:rows[i].substring(sep+1),cmd:rows[i].substring(0,sep)==="H"?"":rows[i].substring(sep+1)})}}
        ListModel { id: paletteModel }
        Rectangle { anchors.fill: parent; color: th.sf
            ColumnLayout { anchors.fill: parent; anchors.margins: 10; spacing: 6
                Text { text: "Terminal Commands"; color: th.tc; font.pixelSize: 17; font.bold: true }
                Rectangle { Layout.fillWidth: true; height: 1; color: th.bd }
                ListView { Layout.fillWidth: true; Layout.fillHeight: true; clip: true; model: paletteModel; flickDeceleration: 1500; maximumFlickVelocity: 8000; boundsBehavior: Flickable.DragAndOvershootBounds
                    ScrollBar.vertical: ScrollBar { policy: ScrollBar.AsNeeded }
                    delegate: Rectangle { width: ListView.view.width; height: model.isHeader?30:_ct.implicitHeight+8
                        color: _cma.containsMouse?Qt.lighter(th.sf,1.2):"transparent"; radius: 6
                        Text { id: _ct; anchors.fill: parent; anchors.margins: 5; anchors.leftMargin: model.isHeader?5:16
                            text: model.isHeader?("\u25B6 "+model.label):("$ "+model.cmd); color: model.isHeader?th.tc:th.tfg
                            font.pixelSize: model.isHeader?13:12; font.family: model.isHeader?ffam:"monospace"; font.bold: model.isHeader; wrapMode: Text.WordWrap }
                        MouseArea { id: _cma; anchors.fill: parent; hoverEnabled: true; visible: !model.isHeader
                            onClicked: { if(backend)backend.pty_write(model.cmd); paletteDrawer.close(); termKeyArea.forceActiveFocus() }
                            onPressAndHold: { if(backend)backend.pty_write(model.cmd+"\r"); paletteDrawer.close(); termKeyArea.forceActiveFocus() } } } }
                Rectangle { Layout.fillWidth: true; Layout.preferredHeight: 34; radius: 17; color: th.ib
                    RowLayout { anchors.fill: parent; anchors.leftMargin: 10; anchors.rightMargin: 10; spacing: 4
                        TextInput { id: addCmdField; Layout.fillWidth: true; verticalAlignment: TextInput.AlignVCenter; color: th.tc; font.pixelSize: 12; font.family: "monospace"
                            onAccepted: { if(backend&&text.trim().length>0){backend.palette_add_auto(text);text="";paletteDrawer.rebuildPalette()} } }
                        Text { text: "+"; color: th.ac; font.pixelSize: 18; font.bold: true; MouseArea { anchors.fill: parent
                            onClicked: { if(addCmdField.text.trim().length>0){backend.palette_add_auto(addCmdField.text);addCmdField.text="";paletteDrawer.rebuildPalette()} } } }
                    }
                }
            }
        }
    }

    // ═══ STAGE M — SlidePopup instances (v0.1.142) ═══
    //
    // Top-level placement so they render above modRow and adjacent UI.
    // Each instance is positioned dynamically by its host's onPressed
    // (via popup.beginFrom(host, x, y)), and reparents its PointHandler
    // to root on activation so the gesture is tracked across the whole
    // window. Both start hidden; beginFrom() shows and animates them in.
    //
    // pipe: simple 3x2 selection, single-variant emit.
    // brace: 3x6 with deadband; emits open/close/both variants. Host
    //   handler maps variant → pty_write sequence.

    // v0.1.538: dismiss scrim for the tap-select link menu. SlidePopup
    // normally relies on the GestureHost's release to dismiss; in tap-
    // select mode there's no host, so an outside tap must cancel it.
    MouseArea {
        anchors.fill: parent
        z: 1099
        visible: linkSlidePopup.visible
        enabled: linkSlidePopup.visible
        onClicked: linkSlidePopup.cancel()
    }

    // v0.1.538: link action menu in the terminal-toolbar SlidePopup
    // style (replaces the radial arc). Opened at the tap point by the
    // onLink_menu_requested handler; the user taps an intent. Holds the
    // pending URL the actions operate on.
    SlidePopup {
        id: linkSlidePopup
        animMs: root.globalAnimMs  // v0.1.814: respect the global animation-speed slider
        z: 1100
        hostRoot: root.contentItem
        model: linkMenuModel
        enableDeadband: false
        tapSelect: true
        property string targetUrl: ""
        onSelected: function(optionId, variant, context) {
            if (!backend) return
            var u = linkSlidePopup.targetUrl
            if (u.length === 0) return
            if (optionId === "open") {
                // v0.1.880: open in the focused pane via the workspace
                // infra (was backend.nav → the legacy single web view,
                // which the pane-based UI no longer surfaces).
                if (backend.open_web_here) root.termPaneStrip = backend.open_web_here(u)
                else backend.nav(u)
            } else if (optionId === "read") {
                // Same call as Open — the reading overlay engages off the
                // loaded content, as it did on the legacy nav path.
                if (backend.open_web_here) root.termPaneStrip = backend.open_web_here(u)
                else backend.nav(u)
            } else if (optionId === "copy") {
                if (backend.clipboard_set) backend.clipboard_set(u)
            } else if (optionId === "newtab") {
                // v0.1.880: open in a NEW workspace tab via the pane infra
                // (was the legacy _tabs/tab_open browser-tab model).
                if (backend.open_web_tab) root.termPaneStrip = backend.open_web_tab(u)
                else if (backend.tab_open_background) backend.tab_open_background(u)
                else backend.nav(u)
            }
        }
        onCancelled: { /* dismissed */ }
    }

    SlidePopup {
        id: _pipePopup
        animMs: root.globalAnimMs  // v0.1.814: respect the global animation-speed slider
        // v0.1.145 fix: ApplicationWindow is a Window not an Item, so
        // mapToItem() calls against it raise TypeError. Use contentItem,
        // which is the Item ApplicationWindow exposes for coordinate
        // mapping. Same workaround as the v0.1.124 copyMenuPopup fix.
        hostRoot: root.contentItem
        model: pipeMenuModel
        enableDeadband: false
        onSelected: function(optionId, variant, context) {
            if (!backend) return
            for (var i = 0; i < pipeMenuModel.length; i++) {
                if (pipeMenuModel[i].id === optionId) {
                    backend.pty_write(pipeMenuModel[i].char)
                    return
                }
            }
        }
        onCancelled: { /* no-op; user dismissed */ }
    }

    // v0.1.790: per-tab hold menu. Context = the held tab's idx. Tap-select so
    // the hold-then-release-then-tap flow works without a drag hand-off.
    SlidePopup {
        id: tabActionPopup
        animMs: root.globalAnimMs  // v0.1.814: respect the global animation-speed slider
        hostRoot: root.contentItem
        model: tabActionMenuModel
        // v0.1.801: drag-select (the "drag multimenu") — hold a tab, drag to a
        // cell, release to pick. The host MouseAreas drive update()/commit();
        // a release without dragging (below threshold) cancels.
        tapSelect: false
        onSelected: function(optionId, variant, context) {
            if (!backend) return
            var idx = (context === undefined || context === null) ? 0 : context
            if (optionId === "fence") {
                if (backend.toggle_tab_fence) root.termPaneStrip = backend.toggle_tab_fence(idx)
            } else if (optionId === "pin") {
                if (backend.toggle_tab_pin) root.termPaneStrip = backend.toggle_tab_pin(idx)
            } else if (optionId === "newtab") {
                if (backend.ws_command) root.termPaneStrip = backend.ws_command("new tab")
            } else {
                // split/webpane/close act on the held tab → make it active first.
                if (backend.ws_command) backend.ws_command("go to tab " + (idx + 1))
                if (optionId === "split") {
                    // v0.1.812: merged directional split — variant "vertical"
                    // (dragged up) → split down; otherwise horizontal → split right.
                    var dir = (variant === "vertical") ? "split down" : "split right"
                    if (backend.ws_command) root.termPaneStrip = backend.ws_command(dir)
                } else if (optionId === "webpane") {
                    // v0.1.812: add a WEB pane to the tab instead of a terminal pane.
                    if (backend.open_web_pane) root.termPaneStrip = backend.open_web_pane("")
                } else if (optionId === "close") {
                    // v0.1.813: directional close — variant "pane" (dragged down)
                    // closes the focused pane; otherwise (right/default) the tab.
                    var what = (variant === "pane") ? "close pane" : "close tab"
                    if (backend.ws_command) root.termPaneStrip = backend.ws_command(what)
                }
            }
        }
        onCancelled: { /* dismissed */ }
    }

    // v0.1.838: the pane long-press marking menu — a real SlidePopup, driven
    // by the focused pane's long-press MouseArea (_paneMenuTrigger) through the
    // same show/update/commit/cancel contract as GestureHost. Replaces the old
    // hand-rolled overlay; inherits the directional split/close gestures and the
    // shared card styling. micOn tracks the push-to-talk capture started on open.
    SlidePopup {
        id: paneActionPopup
        animMs: root.globalAnimMs
        hostRoot: root.contentItem
        model: paneActionMenuModel
        tapSelect: false
        property bool micOn: false
        onSelected: function(optionId, variant, context) {
            // Center mic: keep listening + hand off to the voice popup.
            if (optionId === "mic") {
                if (typeof voicePopup !== "undefined") voicePopup.startListening()
                micOn = false
                return
            }
            // Any non-mic pick discards the push-to-talk capture started on open.
            if (micOn && backend && backend.voice_cancel) backend.voice_cancel()
            micOn = false
            if (!backend) return
            // split/close/newtab act on the focused (long-pressed) pane directly.
            if (optionId === "split") {
                var dir = (variant === "vertical") ? "split down" : "split right"
                if (backend.ws_command) root.termPaneStrip = backend.ws_command(dir)
            } else if (optionId === "newtab") {
                if (backend.ws_command) root.termPaneStrip = backend.ws_command("new tab")
            } else if (optionId === "close") {
                var what2 = (variant === "pane") ? "close pane" : "close tab"
                if (backend.ws_command) root.termPaneStrip = backend.ws_command(what2)
            } else if (optionId === "cmds") {
                commandPalette.openPalette()
            } else if (optionId === "copy") {
                // v0.1.899: copy the terminal selection to the clipboard
                // (mirrors the touch-row Copy button). No-op with nothing
                // selected, with a nudge so the tap isn't silent.
                var _cpTxt = ""
                if (termScreen.selActive && backend.term_selection_text) {
                    _cpTxt = backend.term_selection_text(
                        termScreen.selStartRow, termScreen.selStartCol,
                        termScreen.selEndRow, termScreen.selEndCol)
                }
                if (_cpTxt && _cpTxt.length > 0) {
                    if (backend.clipboard_set) backend.clipboard_set(_cpTxt)
                    if (typeof toast !== "undefined") toast.show("Copied " + _cpTxt.length + " chars")
                } else if (typeof toast !== "undefined") {
                    toast.show("Select text first, then Copy")
                }
            } else if (optionId === "paste") {
                // v0.1.899: paste the system clipboard into the terminal
                // (mirrors the touch-row Paste button; pty_paste normalizes
                // line endings + brackets the paste).
                if (backend.clipboard_get) {
                    var _psTxt = backend.clipboard_get()
                    if (_psTxt && _psTxt.length > 0 && backend.pty_paste) backend.pty_paste(_psTxt)
                }
            } else if (optionId === "clear") {
                // v0.1.899: Ctrl+L (form feed) — clears the visible screen
                // without wiping scrollback or command state; works in shells
                // and full-screen TUIs alike.
                if (backend.pty_write) backend.pty_write("\f")
            } else if (optionId === "scroll") {
                // v0.1.899: page up through scrollback (repeatable). Uses the
                // visible row count for a PageUp-sized step, minus one row of
                // overlap for context; the poll repaints the scrolled view.
                var _pg = (termScreen.lastR && termScreen.lastR > 1) ? (termScreen.lastR - 1) : 10
                if (backend.pty_scroll_back) backend.pty_scroll_back(_pg)
            } else if (typeof toast !== "undefined") {
                toast.show(optionId + " \u2014 coming soon")
            }
        }
        onCancelled: {
            if (micOn && backend && backend.voice_cancel) backend.voice_cancel()
            micOn = false
        }
    }

    SlidePopup {
        id: _bracePopup
        animMs: root.globalAnimMs  // v0.1.814: respect the global animation-speed slider
        hostRoot: root.contentItem  // v0.1.145 fix — see _pipePopup
        model: braceMenuModel
        enableDeadband: true
        // v0.1.155: dynamic sizing based on root.braceCompact.
        // Compact = quicker thumb travel, requires precise drag
        //   (deadbandPx=14, itemSize=80; each side zone = (80/2 - 14) = 26px)
        // Comfort = forgiving, takes more screen
        //   (deadbandPx=28, itemSize=120; each side zone = (120/2 - 28) = 32px)
        // The pre-v0.1.155 hardcoded values (deadbandPx=20, itemSize=96)
        // sat between these — comfort moves us slightly larger, compact
        // slightly smaller.
        deadbandPx: root.braceCompact ? 14 : 28
        itemSize: root.braceCompact ? 80 : 120
        onSelected: function(optionId, variant, context) {
            if (!backend) return
            // Look up the pair.
            var pair = null
            for (var i = 0; i < braceMenuModel.length; i++) {
                if (braceMenuModel[i].id === optionId) { pair = braceMenuModel[i]; break }
            }
            if (!pair) return

            if (variant === "open") {
                backend.pty_write(pair.openChar)
            } else if (variant === "close") {
                backend.pty_write(pair.closeChar)
            } else {
                // "both" — emit pair and position cursor between.
                // pty_write the two chars, then send Left arrow to
                // back up between them. ESC[D = Left in xterm.
                backend.pty_write(pair.openChar + pair.closeChar)
                backend.pty_write("\x1b[D")
                // Arm the brace-insert state machine for the drag-forward
                // gesture (v0.1.144 will hook this; v0.1.143 just guards
                // against accidental re-triggering).
                root._braceInsertActive = true
                if (backend.term_cursor_row !== undefined) {
                    root._braceCursorRowAtInsert = backend.term_cursor_row
                }
                _braceInsertGuard.restart()
            }
        }
        onCancelled: { /* no-op; user dismissed */ }
    }

    // v0.1.146 STAGE M: shared per-block-row gesture popup. One instance
    // serves every row in blocksDrawer; the host (the ⋯ button on each
    // row) passes model.blockId as the third arg to show(), and the
    // popup echoes it back as context in onSelected. That's how a single
    // popup handles N rows without per-row instantiation.
    //
    // Positioning: SlidePopup positions itself so the press point lands
    // on the center of the option grid (v0.1.144 fix), so per-row
    // positioning works without any per-row math — the popup appears
    // where the ⋯ was clicked, regardless of which row it was.
    //
    // Parented to Overlay.overlay (rather than root.contentItem like
    // the toolbar popups) because its host lives inside blocksDrawer,
    // and Qt Drawer renders on the overlay layer. A regular child of
    // contentItem would render BEHIND the open drawer. Overlay.overlay
    // shares contentItem's coord space, so the hostRoot binding can
    // stay as contentItem (mapping is consistent).
    SlidePopup {
        id: _blockRowPopup
        animMs: root.globalAnimMs  // v0.1.814: respect the global animation-speed slider
        parent: Overlay.overlay
        hostRoot: root.contentItem
        model: blockRowMenuModel
        enableDeadband: false
        // v0.1.151: every dispatched action surfaces a toast so the
        // user has a visible confirmation. The console.log lines
        // remain for journal diagnostics; the toast is the user-
        // facing feedback. Error toasts use the red accent + longer
        // dwell so failures are noticed (previously copies could
        // silently fail with only a stderr log).
        onSelected: function(optionId, variant, context) {
            if (!backend) return
            var blockId = context  // passed through from show(host, x, y, model.blockId)
            console.log("[blocks-menu] action=" + optionId + " blockId=" + blockId)
            var t = (typeof toast !== "undefined") ? toast : null
            switch (optionId) {
                case "rerun":
                    backend.term_block_rerun(blockId)
                    blocksDrawer.close()
                    if (t) t.show("Re-running…", "info")
                    break
                case "copy-cmd":
                    var ok1 = backend.term_block_copy_command(blockId)
                    console.log("[blocks-menu] copy-cmd ok=" + ok1)
                    if (t) {
                        if (ok1) t.show("Copied command", "success")
                        else t.show("Copy failed — check clipboard tool", "error")
                    }
                    break
                case "copy-out":
                    var ok2 = backend.term_block_copy_output(blockId)
                    console.log("[blocks-menu] copy-out ok=" + ok2)
                    if (t) {
                        if (ok2) t.show("Copied output", "success")
                        else t.show("Copy failed — check clipboard tool", "error")
                    }
                    break
                case "summary":
                    // Toggle global AI summarization. Per-block toggle
                    // would need new backend state — filed for later.
                    if (backend.log_summary_is_enabled && backend.log_summary_set_enabled) {
                        var enabled = backend.log_summary_is_enabled()
                        backend.log_summary_set_enabled(!enabled)
                        console.log("[blocks-menu] summary toggled to " + !enabled)
                        if (t) {
                            t.show(enabled ? "AI summary off" : "AI summary on", "info")
                        }
                    }
                    break
            }
        }
        onCancelled: { /* no-op; user dismissed */ }
    }

    // v0.1.152 STAGE M: shared per-file-row gesture popup. One instance
    // serves every row in filePickerDrawer; the host (the ⋯ button on
    // each row) passes a {columnIndex, entryName, entryKind} object as
    // gestureContext, and the popup echoes it back in onSelected.
    //
    // Same overlay-parenting trick as _blockRowPopup (v0.1.146): the
    // host lives inside a Drawer which renders on the overlay layer,
    // so a regular top-level child of ApplicationWindow renders BEHIND
    // the open drawer. Parenting to Overlay.overlay places this on the
    // same layer as the drawer; declaring after it makes us render on
    // top. Coord space matches contentItem (both fill the window).
    //
    // Three actions in a horizontal 3x1 layout — center "📂 Open"
    // commits on tap-without-drag (popup positions itself so the
    // press point lands on the center cell). Drag left for Copy path,
    // drag right for Insert path at cursor.
    SlidePopup {
        id: _filePickerRowPopup
        animMs: root.globalAnimMs  // v0.1.814: respect the global animation-speed slider
        parent: Overlay.overlay
        hostRoot: root.contentItem
        model: filePickerRowMenuModel
        enableDeadband: false
        onSelected: function(optionId, variant, context) {
            if (!backend) return
            if (!context || typeof context !== "object") return
            var t = (typeof toast !== "undefined") ? toast : null
            console.log("[filepicker-menu] action=" + optionId
                        + " col=" + context.columnIndex
                        + " name=" + context.entryName
                        + " kind=" + context.entryKind)

            // Resolve the full path of the selected entry by joining
            // the column's path with the entry name. The columns
            // store an absolute path on each column object.
            var col = filePickerDrawer._columns.items[context.columnIndex]
            if (!col) return
            var colPath = col.path || ""
            // Path-join: handle root case ("/") without double-slash.
            var sep = (colPath === "/" || colPath.endsWith("/")) ? "" : "/"
            var fullPath = colPath + sep + context.entryName

            switch (optionId) {
                case "open":
                    // Same as tap-to-open. Reuse the existing
                    // navigation function so behavior matches exactly.
                    filePickerDrawer._navigateIntoFromColumn(
                        context.columnIndex,
                        context.entryName,
                        context.entryKind
                    )
                    break
                case "copy-path":
                    if (backend.clipboard_set) {
                        var ok = backend.clipboard_set(fullPath)
                        if (t) {
                            if (ok) t.show("Copied path", "success")
                            else t.show("Copy failed — check clipboard tool", "error")
                        }
                    }
                    break
                case "insert-path":
                    // Send the path as keystrokes into the PTY at
                    // the current cursor position. Quote-wrap if the
                    // path contains spaces or shell-special chars so
                    // the shell receives it as a single token.
                    var needsQuotes = /[ \t'"$&|;<>(){}*?[\]\\]/.test(fullPath)
                    var toSend = needsQuotes
                        ? "'" + fullPath.replace(/'/g, "'\\''") + "'"
                        : fullPath
                    if (backend.pty_write) {
                        backend.pty_write(toSend)
                        // Close the drawer so the user sees the
                        // terminal with the path inserted at their
                        // cursor — they were navigating to find a
                        // file to use in a command, this is the
                        // moment they want.
                        filePickerDrawer.close()
                        if (t) t.show("Inserted path", "success")
                    } else if (t) {
                        t.show("Insert failed — no PTY", "error")
                    }
                    break
            }
        }
        onCancelled: { /* no-op; user dismissed */ }
    }

    // v0.1.163: send-terminal-context popup. Driven by the
    // GestureHost'd warning button in the settings drawer (see
    // _sendCtxBtn). Two cells: ⊘ commits OFF, 📋 commits ON.
    //
    // Lives at the root for the same reason as the file-picker
    // popup — needs Overlay.overlay parent + root.contentItem
    // hostRoot so coordinates resolve correctly regardless of
    // which scrollable container the button is nested under.
    SlidePopup {
        id: _sendCtxPopup
        animMs: root.globalAnimMs  // v0.1.814: respect the global animation-speed slider
        parent: Overlay.overlay
        hostRoot: root.contentItem
        model: sendCtxMenuModel
        enableDeadband: false
        onSelected: function(optionId, variant, context) {
            if (!backend) return
            var t = (typeof toast !== "undefined") ? toast : null
            // v0.1.164: four-cell tier selection. Cancel turns
            // send-context fully OFF (tier irrelevant). Each lock
            // tier turns send-context ON and sets the corresponding
            // redaction strength.
            switch (optionId) {
                case "off":
                    if (backend.send_terminal_context) {
                        backend.send_terminal_context = false
                        if (backend.save_settings) backend.save_settings()
                        if (t) t.show("Terminal context: OFF", "info")
                    }
                    break
                case "tier1":
                    backend.send_terminal_context = true
                    backend.redaction_tier = 1
                    if (backend.save_settings) backend.save_settings()
                    if (t) t.show("Context ON — light redaction (1 lock)", "info")
                    break
                case "tier2":
                    backend.send_terminal_context = true
                    backend.redaction_tier = 2
                    if (backend.save_settings) backend.save_settings()
                    if (t) t.show("Context ON — medium redaction (2 locks)", "info")
                    break
                case "tier3":
                    backend.send_terminal_context = true
                    backend.redaction_tier = 3
                    if (backend.save_settings) backend.save_settings()
                    if (t) t.show("Context ON — assured redaction (3 locks)", "info")
                    break
            }
        }
        onCancelled: { /* no-op */ }
    }

    // ═══ Components ═══
    component ToolBtn: Rectangle {
        id: _tb
        property string icon: ""; property bool dim: false; property bool accent: false
        // v0.1.202: emit `tapped` on click, `heldDown` on long-press.
        // Consumers can wire either or both. Pattern matches existing
        // onPressAndHold usages elsewhere (palette, terminal toolbar).
        signal tapped()
        signal heldDown()

        // v0.1.206: hold-progress feedback. While the user is
        // pressing, a thin progress bar at the bottom of the
        // button fills clockwise from 0 to full over
        // `pressAndHoldInterval`. If they release before the
        // interval elapses, the bar snaps back (a `tapped` fires
        // instead of `heldDown`). If they hold to completion, the
        // bar reaches full and the `heldDown` action runs. Without
        // this feedback the tap-vs-hold distinction feels arbitrary
        // ("did I hold long enough?"). With it, the user sees the
        // commit happening.
        //
        // The progress only appears when a heldDown handler is
        // actually wired. We detect this with onHeldDown.connections.
        // QML doesn't expose that directly, so we use a property
        // `enableHoldProgress` that consumers can set true to opt
        // in. Defaults false so other ToolBtns (back, forward,
        // hamburger, etc.) don't show a confusing bar.
        property bool enableHoldProgress: false
        property real _holdProgress: 0.0
        // The default pressAndHoldInterval is 800ms but QML doesn't
        // expose it as a readable constant. Match it here so the
        // animation finishes exactly when onPressAndHold fires.
        readonly property int _holdInterval: 800

        width: Math.max(_tbi.implicitWidth+16,36); height: 36; radius: 18
        color: accent?th.ac:_tbma.containsMouse?Qt.lighter(th.sf,1.3):"transparent"; opacity: dim?0.3:1.0

        // v0.1.269 (settings-icon antialiasing fix): explicitly use
        // Qt.QtRendering for the icon glyph. The default `Text.NativeRendering`
        // can fall back to monochrome bitmaps for Unicode symbol
        // glyphs at certain sizes, producing hard-edged "8-bit
        // looking" icons. QtRendering uses Qt's own compositor with
        // proper antialiasing across the glyph cache, fixing the
        // ⚙ / ▶ / ◀ / ☰ / ⚡ / ⏏ icons that the v0.1.249 hardware
        // test reported as having "lost antialiasing." Cost is
        // negligible — these are 1-glyph buttons rendered once.
        Text { id: _tbi; anchors.centerIn: parent; text: icon; color: accent?"#fff":th.tc; font.pixelSize: 15; renderType: Text.QtRendering }

        // Progress bar at the bottom of the button. Width animates
        // from 0 to button-width over the hold interval.
        Rectangle {
            id: _tbProgress
            anchors.bottom: parent.bottom
            anchors.bottomMargin: 3
            anchors.horizontalCenter: parent.horizontalCenter
            height: 2
            radius: 1
            // Width is driven by _holdProgress (0..1). Cap at 60%
            // of button width so it visually sits inside the
            // rounded corners.
            width: parent.width * 0.6 * _tb._holdProgress
            color: th.ac
            visible: _tb.enableHoldProgress && _tb._holdProgress > 0.01
            opacity: _tb._holdProgress
        }

        // Animation that drives _holdProgress while pressed.
        // Triggered by onPressed; cancelled by onReleased.
        // Reaches 1.0 right when onPressAndHold fires (800ms).
        NumberAnimation on _holdProgress {
            id: _tbHoldAnim
            from: 0
            to: 1.0
            duration: _tb._holdInterval
            running: false
        }
        // Quick snap-back when the user releases early. Makes the
        // "I gave up" path feel responsive instead of leaving a
        // half-filled bar.
        NumberAnimation on _holdProgress {
            id: _tbReleaseAnim
            to: 0
            duration: 120
            easing.type: Easing.OutQuad
            running: false
        }

        MouseArea {
            id: _tbma; anchors.fill: parent; hoverEnabled: true
            cursorShape: Qt.PointingHandCursor; enabled: !dim
            // v0.1.207: accept right-click too. Right-click is a
            // common alt-path to "open the fuller version" in desktop
            // UIs (right-click → context menu). We route it to
            // heldDown so users with a mouse can reach the full
            // settings without holding.
            acceptedButtons: Qt.LeftButton | Qt.RightButton
            onPressed: {
                if (!_tb.enableHoldProgress) return
                _tbReleaseAnim.stop()
                _tb._holdProgress = 0
                _tbHoldAnim.restart()
            }
            onReleased: {
                if (!_tb.enableHoldProgress) return
                _tbHoldAnim.stop()
                // Don't reset if hold already completed (heldDown
                // fired); the progress bar fade-out is handled by
                // the next press cycle.
                if (_tb._holdProgress < 1.0) {
                    _tbReleaseAnim.restart()
                }
            }
            onClicked: function(mouse) {
                // v0.1.207: right-click → heldDown (full action).
                if (mouse.button === Qt.RightButton && _tb.enableHoldProgress) {
                    heldDown()
                    return
                }
                tapped()
            }
            // v0.1.207: double-click → heldDown. The first click
            // already fired `tapped` (popup opens). The second
            // promotes to the full action; the consumer's heldDown
            // handler is responsible for closing the popup if it
            // was opened by the first tap.
            onDoubleClicked: {
                if (_tb.enableHoldProgress) heldDown()
            }
            onPressAndHold: {
                heldDown()
                // Reset after a short delay so the bar visibly
                // hits 100% before disappearing.
                _tbReleaseAnim.restart()
            }
        }
    }
    component Pill: Rectangle {
        property string label: ""; property bool active: false; signal toggled()
        implicitWidth: _pl.implicitWidth+20; implicitHeight: 26; radius: 13
        color: active ? th.ac
              : (_pillMa.containsMouse ? Qt.lighter(th.sf, 1.5) : Qt.lighter(th.sf, 1.3))
        border.color: active?th.ac:th.bd; border.width: 1
        Behavior on color { ColorAnimation { duration: 100 } }
        Text { id: _pl; anchors.centerIn: parent; text: label; color: active?"#fff":th.tm; font.pixelSize: 10; font.bold: active }
        MouseArea { id: _pillMa; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor; onClicked: toggled() }
    }

    // ═══ ThoughtBubble ═══ (v0.1.204, substrate B of onboarding arc)
    //
    // A directive overlay that points at a target item. Used by the
    // guided tour driver (2.6.3, future) to walk the user through
    // app features.
    //
    // Usage:
    //   ThoughtBubble {
    //       id: myBubble
    //       target: someItem        // what to point at
    //       text: "tap me!"         // bubble content
    //       onAcknowledged: { ... } // user tapped to dismiss
    //   }
    //   myBubble.show()             // make it visible
    //
    // Geometry: positioned automatically below the target with a
    // pointer tail. Clamps to viewport edges if the centered position
    // would overflow. The tail re-aligns to point at the target
    // center even when the bubble is shifted.
    //
    // Limits in v1:
    //   - Below-target placement only (no flip when target is near
    //     the bottom). The tour driver should scroll target into
    //     view above the lower half of the screen.
    //   - One bubble at a time (no stacking). Tour driver sequences
    //     via show()/hide().
    //   - Text-only content (no rich formatting). Plain string.
    //   - Bubble follows target when target moves (binding-driven),
    //     so resizing the window keeps the bubble aligned.
    component ThoughtBubble: Item {
        id: _tb
        property Item target: null
        property string text: ""
        property bool dismissOnTap: true
        // Padding inside the bubble around the text.
        property int padding: 12
        // Max width before wrapping kicks in.
        property int maxWidth: 280
        // Vertical gap between target and bubble (where the tail lives).
        property int gap: 10
        // Manual visibility — caller invokes show()/hide(). We don't
        // auto-show when text is set, because the tour driver wants
        // to control timing precisely.
        property bool _shown: false

        signal acknowledged()

        function show() { _shown = true }
        function hide() { _shown = false }

        visible: _shown && target !== null && target.visible
        // Cover the full root so we can position the bubble anywhere.
        // Don't intercept clicks outside the bubble (only the bubble
        // rectangle has a MouseArea, so taps elsewhere fall through).
        anchors.fill: parent
        z: 1000

        // Target position in our coordinate space. Re-evaluates when
        // the target moves (e.g. scroll, resize). The mapToItem call
        // is reactive — it depends on target.x/y/width and ancestor
        // transforms.
        property real _targetX: target ? target.mapToItem(_tb, 0, 0).x : 0
        property real _targetY: target ? target.mapToItem(_tb, 0, 0).y : 0
        property real _targetW: target ? target.width : 0
        property real _targetH: target ? target.height : 0
        property real _targetCenterX: _targetX + _targetW / 2

        // The actual text element drives bubble sizing. Bubble width
        // is max(text width + padding, min) clamped to maxWidth.
        property real _bubbleW: Math.min(_tbText.implicitWidth + padding * 2, maxWidth)
        property real _bubbleH: _tbText.implicitHeight + padding * 2

        // Centered placement: bubble's left edge = target center - bubbleW/2.
        // Clamped to viewport with 8px margin.
        property real _idealLeft: _targetCenterX - _bubbleW / 2
        property real _bubbleLeft: Math.max(8, Math.min(_idealLeft, _tb.width - _bubbleW - 8))
        property real _bubbleTop: _targetY + _targetH + gap

        // Tail position (in bubble's local coords) re-targets even
        // when bubble was shifted. Clamped so the tail base stays
        // within the bubble width.
        property real _tailX: Math.max(12, Math.min(_targetCenterX - _bubbleLeft, _bubbleW - 12))

        // ─── The tail (small triangle pointing up at target) ───
        //
        // Implemented as a rotated square with one corner cut off via
        // a clip. Simpler: a Rectangle rotated 45° with the bottom
        // half hidden by being placed under the bubble. The bubble's
        // rectangle covers the bottom half of the tail rectangle.
        Rectangle {
            id: _tbTail
            width: 12
            height: 12
            color: th.ac
            // border.color: th.ac; border.width: 0
            x: _tb._bubbleLeft + _tb._tailX - width / 2
            // Position so that the tail's bottom half is hidden by
            // the bubble. Specifically: bubble top = _bubbleTop, so
            // tail center y should be at _bubbleTop (top half visible
            // above, bottom half hidden behind bubble).
            y: _tb._bubbleTop - height / 2
            rotation: 45
            // Antialias the rotated edges.
            antialiasing: true
            visible: _tb._shown
        }

        // ─── The bubble rectangle ───
        Rectangle {
            id: _tbBubble
            x: _tb._bubbleLeft
            y: _tb._bubbleTop
            width: _tb._bubbleW
            height: _tb._bubbleH
            radius: 8
            color: th.ac
            // Slight border to define edge against background.
            border.color: Qt.darker(th.ac, 1.2)
            border.width: 1
            // Drop shadow effect via a slightly larger, slightly
            // offset rectangle underneath. Cheap and theme-aware.
            // We don't use Qt's Effects module to keep deps minimal.

            Text {
                id: _tbText
                anchors.fill: parent
                anchors.margins: _tb.padding
                text: _tb.text
                color: "#ffffff"
                font.pixelSize: 13
                wrapMode: Text.WrapAtWordBoundaryOrAnywhere
                verticalAlignment: Text.AlignVCenter
                horizontalAlignment: Text.AlignHCenter
            }

            MouseArea {
                anchors.fill: parent
                cursorShape: Qt.PointingHandCursor
                enabled: _tb.dismissOnTap
                onClicked: {
                    _tb.hide()
                    _tb.acknowledged()
                }
            }
        }

        // Fade in/out animation on show/hide so the bubble doesn't
        // pop abruptly. Tied to the visible property.
        Behavior on opacity { NumberAnimation { duration: 150; easing.type: Easing.OutQuad } }
        opacity: _shown ? 1.0 : 0.0
    }
}
