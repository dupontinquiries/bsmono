    // ═══ READING OVERLAY ═══ (v0.1.191, ship 2.2)
    //
    // Three-state UI surface for the read-aloud flow:
    //   "idle"    — hidden, no reading activity
    //   "waiting" — user tapped yes on a prompt; instructs them
    //               to tap a paragraph
    //   "ready"   — paragraph is selected; offers to start
    //   "reading" — word-by-word highlight is active
    //
    // Single Rectangle that swaps its content based on the state
    // property. Sits at the bottom of the viewport, above the
    // prompt toasts (z higher).
    //
    // The reading-mode WPM advance uses a QML Timer that increments
    // currentWordIndex every (60/wpm) seconds. The selected
    // paragraph text comes from backend.current_paragraph_text
    // (set when the user tapped a paragraph and forwarded via
    // paragraph_selection_changed signal).
    //
    // 2.2 is highlight-only — no recording yet. Ship 2.3 adds the
    // actual mic capture when readingState === "reading".
    Rectangle {
        id: readingOverlay
        z: 1200
        // v0.1.241: moved from bottom of screen to JUST BELOW the
        // URL bar. User feedback: "reading at the bottom of the
        // screen is going to cause the reader to lose focus on
        // their knowledge and turns the savings back into a
        // chore." Anchoring to topBar.bottom puts the highlight
        // up near where the user's eye is already focused for
        // navigation cues — same vertical zone as the URL/header.
        //
        // v0.1.249: topBar moved from TOP to BOTTOM of layout.
        // Reading overlay now anchors to parent.top directly —
        // the top zone is empty (no chrome competes for it),
        // which is precisely the v0.1.241 framing's ideal state.
        // The previous `topBar.bottom` anchor would have placed
        // this overlay at the BOTTOM of the window (below the
        // URL bar's new position), which is the opposite of
        // what's wanted.
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        // v0.1.241: bigger reading-state area (was 140) to fit
        // the teleprompter-style centered word scroll. Other
        // states unchanged. v0.1.257: scale with wordFontSize so
        // larger fonts get more viewport (~7x line-height covers
        // 5 visible lines of words for context).
        height: state === "idle" ? 0
              : state === "reading" ? Math.max(220, wordFontSize * 7 + 60)
              : 56
        Behavior on height { NumberAnimation { duration: 200; easing.type: Easing.OutQuad } }
        color: Qt.rgba(0.08, 0.08, 0.10, 0.97)
        border.color: th.ac
        border.width: state === "idle" ? 0 : 1
        visible: state !== "idle"

        // State property. Drives the visible content. Default idle.
        property string state: "idle"

        // v0.1.226: default 180 WPM (was 250). User feedback:
        // "the animations on the bottom are too fast and don't
        // quite follow the help reading." 250 wpm = ~240ms/word
        // is on the upper end of conversational reading and
        // creates a sense that the visual is leading rather than
        // following the user.
        //
        // v0.1.231: further drop to 160. User: "slightly lower
        // the reading rate so it matches more speaking rate."
        // 160 wpm = ~375ms/word — natural conversational pace
        // for read-aloud content.
        //
        // v0.1.234: user-tunable via the slow/med/fast button in
        // the overlay header (see _rateBtn below). 160 is now
        // the MED preset. Cycling button sets wpm to one of
        // SLOW=130, MED=160, FAST=200.
        //
        // v0.1.238: persisted to `~/.config/web2qml/reading_wpm`
        // via backend.reading_wpm_get/set so the user's preferred
        // rate survives across launches. Initial value loaded at
        // Component.onCompleted; subsequent changes (cycleRate,
        // slider) write via persistWpm().
        property int wpm: 160
        property int currentWordIndex: -1
        property var words: []  // populated when entering "reading"
        
        // v0.1.242 (PA1, phoneme alignment arc): per-content-type
        // WPM multiplier. Set when entering reading state based on
        // the selected paragraph's _contentType. Default 1.0 (prose-
        // equivalent, no slowdown) is used if no content type was
        // emitted (e.g., older cached page renders, or content paths
        // that haven't been migrated yet).
        //
        // Effective WPM used by the Timer = wpm * activeMultiplier.
        // The slider/cycle button still operates on `wpm` directly;
        // the multiplier rides on top.
        property real activeMultiplier: 1.0
        property string activeContentType: "prose"

        // v0.1.257 (teleprompter readability): font size for the
        // reading words, parameterized so the user can size it up
        // when sharing screen with a second reader (Allison
        // hardware test showed default 16px wasn't readable at
        // arm's length). Default chosen as 28px — large enough to
        // be readable across a table during shared registration,
        // but not so large that long paragraphs overflow the
        // viewport even on phone widths. User can adjust via the
        // ±A buttons in the overlay header (added below) or by
        // pinch-zoom on the viewport.
        //
        // Persisted across sessions in
        // ~/.config/web2qml/reading_font_px so users who set a
        // bigger size for accessibility don't have to re-set it.
        property int wordFontSize: 28

        // Persistence helpers. wordFontSize is bounded so a saved
        // value of 1 or 999 doesn't break layout.
        function _clampFont(px) {
            if (px < 12) return 12
            if (px > 64) return 64
            return px
        }
        
        // PA1 baseline multipliers — hand-tuned, no auto-tuning yet.
        // PA2-7 will refine these per-user with persistence and
        // tier-2 phoneme-classifier feedback.
        //
        //   prose=0.95 — slight slowdown from 160 wpm default
        //                addresses "still a little too fast"
        //                v0.1.241 user feedback at the default
        //   code =0.70 — code reads ~30% slower than prose
        //                (punctuation pauses, indentation breath,
        //                identifier-syllable rhythm). v0.1.244
        //                wired <pre>/<code> blocks through
        //                maybe_wrap_extended so they ARE now
        //                selectable; this multiplier applies.
        //   list =0.90 — inter-item bullet rhythm
        //   table=0.85 — cell-by-cell rhythm
        //   heading=0.80 — v0.1.306: distinct from prose since
        //                  headings tend to be shorter and read
        //                  with more emphasis/deliberation. 20%
        //                  slower than prose reflects that.
        function _baseMultiplierFor(t) {
            if (t === "code")    return 0.70
            if (t === "heading") return 0.80
            if (t === "table")   return 0.85
            if (t === "list")    return 0.90
            return 0.95  // prose default (and unknown/empty)
        }

        // v0.1.369 (PA2 reading-overlay wiring): voice-silence-driven
        // multiplier. Stacks on top of activeMultiplier. Reads
        // backend.voice_silence_ms via the Connections object below.
        //
        // Mapping bucketed silence_ms → multiplier:
        //   0     (active speech) → 1.0
        //   250   (very recent)   → 1.0
        //   1000  (brief pause)   → 0.95  slight slowdown
        //   3000  (moderate)      → 0.85  noticeable slowdown
        //   10000 (long pause)    → 0.70  significant slowdown
        //   MAX   (idle, no voice)→ 1.0   user not engaged via voice;
        //                                  don't second-guess them
        //
        // The "MAX = 1.0" choice is deliberate: when voice isn't
        // happening at all (typed-only reading session, or user has
        // mic off), we don't have signal to slow down for. Falling
        // back to 1.0 means the content-type multiplier is the only
        // factor, matching pre-v0.1.369 behavior.
        property real silenceMultiplier: 1.0
        // Last observed bucketed silence_ms — purely for the UI
        // indicator. Updated by the Connections handler below.
        property int observedSilenceMs: -1

        function _silenceMultiplierFor(ms) {
            // MAX sentinel: no silence data, no adjustment.
            if (ms < 0 || ms >= 4294967295) return 1.0  // u32::MAX
            if (ms === 0)      return 1.0
            if (ms < 500)      return 1.0
            if (ms < 2000)     return 0.95
            if (ms < 5000)     return 0.85
            if (ms < 15000)    return 0.70
            return 1.0  // very-long silence: assume disengagement
        }

        // Connect to the backend signal that fires when the
        // silence bucket transitions. Cheap — the signal is
        // bucket-gated so it doesn't fire on every voice tick.
        Connections {
            target: backend
            ignoreUnknownSignals: true
            function onVoice_silence_ms_changed() {
                if (!backend) return
                var ms = backend.voice_silence_ms
                readingOverlay.observedSilenceMs = ms
                readingOverlay.silenceMultiplier =
                    readingOverlay._silenceMultiplierFor(ms)
            }
        }
        
        // Effective WPM read by the Timer for interval calculation.
        // Clamped at the bottom to prevent crawling pace; tier 2
        // (PA4-7) will refine the floor logic.
        //
        // v0.1.369: silenceMultiplier stacks on top of the
        // content-type multiplier. With both at their slowest
        // (code=0.70 × long-pause=0.70 = 0.49), effectiveWpm can
        // drop to ~half the user's chosen wpm — significant but
        // not unreadable. The floor (60) prevents pathological
        // multiplication from producing crawl-speed reading.
        readonly property real effectiveWpm: Math.max(60, wpm * activeMultiplier * silenceMultiplier)

        Component.onCompleted: {
            if (backend) {
                var stored = backend.reading_wpm_get()
                if (stored >= 80 && stored <= 300) {
                    wpm = stored
                }
                // v0.1.257: also load persisted font size.
                if (backend.reading_font_get) {
                    var fs = backend.reading_font_get()
                    if (fs >= 12 && fs <= 64) {
                        wordFontSize = fs
                    }
                }
            }
        }
        function persistWpm() {
            if (backend) backend.reading_wpm_set(wpm)
        }

        // v0.1.238: long-press slider visibility flag. When the
        // rate button is long-pressed, this turns on and a
        // Slider overlay appears for fine-control of WPM. Tap
        // anywhere outside the slider (or the button again) to
        // dismiss.
        property bool _showRateSlider: false

        // v0.1.234: rate-cycle presets. Three steps mapped to a
        // single button that cycles on tap. The labels (slow/med/
        // fast) align with everyday English speed words so the
        // user doesn't need to read raw WPM numbers.
        readonly property int rateSlow: 130
        readonly property int rateMed: 160
        readonly property int rateFast: 200
        function rateLabel() {
            if (wpm <= rateSlow + 5) return "slow"
            if (wpm >= rateFast - 5) return "fast"
            return "med"
        }
        function cycleRate() {
            // Cycle slow → med → fast → slow. The threshold check
            // mirrors rateLabel's logic so a wpm value set via
            // another path (env var, future settings) still
            // cycles predictably.
            if (wpm <= rateSlow + 5) wpm = rateMed
            else if (wpm <= rateMed + 5) wpm = rateFast
            else wpm = rateSlow
            // v0.1.238: persist for next launch.
            persistWpm()
        }

        // v0.1.257 (teleprompter readability): font-size cycling.
        // Four presets cover the range from "phone, single
        // reader, close to face" up to "shared screen, second
        // reader across a table." 28 is the default (medium).
        // The 44 preset addresses the v0.1.251 hardware test
        // where Allison couldn't read the registration prompt.
        readonly property int fontSmall: 20
        readonly property int fontMed: 28
        readonly property int fontLarge: 36
        readonly property int fontXLarge: 44
        function cycleFontSize() {
            if (wordFontSize <= fontSmall + 2) wordFontSize = fontMed
            else if (wordFontSize <= fontMed + 2) wordFontSize = fontLarge
            else if (wordFontSize <= fontLarge + 2) wordFontSize = fontXLarge
            else wordFontSize = fontSmall
            persistFontSize()
        }
        function persistFontSize() {
            if (backend && backend.reading_font_set) {
                backend.reading_font_set(wordFontSize)
            }
        }

        // Called from the SoloPrompt / CoreadPrompt "yes" handlers.
        // Enters waiting state. If a paragraph is already selected
        // (rare — user pre-tapped a paragraph before the prompt
        // fired), transition straight to ready.
        function enterWaitingState() {
            if (backend && backend.current_paragraph_text.toString().length > 0) {
                state = "ready"
            } else {
                state = "waiting"
            }
        }

        // Listen for paragraph selection. When user is in "waiting"
        // and they tap a paragraph, transition to "ready." If
        // they're already in "ready" and tap a different paragraph,
        // re-arm with the new paragraph's text. Ignore if state is
        // "idle" or "reading" (those have their own flow).
        //
        // v0.1.225: paragraph select auto-arms the reading state.
        // Previously the user had to tap the mic button AFTER
        // selecting a paragraph to actually start reading — two
        // gestures for what they thought was one. Now: paragraph
        // select → jumps to "reading" directly (skips the
        // waiting/ready/start-button overhead). The mic is already
        // open (persistent stream); corpus_start just arms the
        // "save these samples" flag, so this is not a new audio
        // capture being initiated — the stream was already
        // running. User cancels via the overlay's cancel button.
        //
        // The waiting/ready path still works for the SoloPrompt
        // "yes" flow which expects an explicit confirm step.
        Connections {
            target: backend
            function onParagraph_selection_changed() {
                if (!backend) return
                var t = backend.current_paragraph_text.toString()
                if (t.length === 0) {
                    // Selection cleared (page nav). Drop back to idle.
                    // v0.1.192 (ship 2.3): also commit partial recording
                    // if one was active. The mid-paragraph audio is
                    // probably truncated and not useful for training,
                    // but saving it preserves the user's actual read
                    // attempt and keeps the writer logic uniform.
                    //
                    // v0.1.236: routed through stopReading() which
                    // also cancels the start-delay timer (so a
                    // pending fire doesn't sneak through after nav)
                    // and only calls corpus_stop if corpus_start
                    // had actually fired.
                    if (readingOverlay.state === "reading") {
                        readingOverlay.stopReading(true)
                    } else {
                        readingOverlay.state = "idle"
                    }
                    return
                }
                if (readingOverlay.state === "waiting"
                    || readingOverlay.state === "ready") {
                    readingOverlay.state = "ready"
                } else if (readingOverlay.state === "idle") {
                    // v0.1.225: auto-arm. Split paragraph into words
                    // and enter "reading" state directly.
                    //
                    // v0.1.236: routed through beginReading() which
                    // adds a 300ms start-delay before the highlight
                    // moves and mic begins capturing — gives the
                    // user a beat to register the overlay appearing.
                    readingOverlay.beginReading(t)
                }
                // "reading" stays — don't disrupt an active read by
                // switching the underlying paragraph. User has to
                // explicitly stop first.
            }
        }

        // WPM advance timer. Active only in "reading" state AND
        // after the start-delay has elapsed (currentWordIndex >= 0).
        //
        // v0.1.236: gated on currentWordIndex too. The start path
        // sets currentWordIndex=-1 initially, holds for 300ms
        // (via _startDelayTimer), THEN flips to 0 + corpus_start.
        // The 300ms gives the user a beat to register the
        // overlay appearing before words start advancing and the
        // mic begins capturing — previously the highlight popped
        // and the mic armed simultaneously with the tap, with no
        // visual confirmation.
        Timer {
            id: _wpmTimer
            // v0.1.242 (PA1): interval driven by effectiveWpm
            // (= wpm * activeMultiplier) so content-type slowdown
            // applies. Was `60000 / readingOverlay.wpm` before PA1.
            interval: 60000 / readingOverlay.effectiveWpm
            repeat: true
            running: readingOverlay.state === "reading"
                  && readingOverlay.currentWordIndex >= 0
            onTriggered: {
                var next = readingOverlay.currentWordIndex + 1
                if (next >= readingOverlay.words.length) {
                    // Reached the end. v0.1.236: route through
                    // stopReading() so cleanup is uniform.
                    // currentWordIndex was >= 0 (we got here from
                    // a positive value), so hadStarted=true and
                    // corpus_stop will fire.
                    readingOverlay.stopReading(true)
                    return
                }
                readingOverlay.currentWordIndex = next
            }
        }

        // v0.1.236: 300ms start-delay timer. Fires once when state
        // transitions to "reading" (via auto-arm or start-button).
        // While it's pending: state IS "reading" (overlay visible,
        // words rendered), currentWordIndex IS -1 (no highlight on
        // a specific word), and the WPM timer is gated off.
        //
        // When the timer fires:
        //   - currentWordIndex flips to 0 — highlight settles on
        //     the first word
        //   - corpus_start fires — mic capture begins
        //   - WPM timer's `running` condition now true — first
        //     advance happens `60000/wpm` ms later
        //
        // The pre-fire visual: with currentWordIndex=-1 and the
        // opacity formula `offset = index - currentWordIndex`,
        // words 0/1/2 have offsets 1/2/3 → opacity 0.55/0.25/0,
        // creating a soft "about to start" preview that
        // crossfades when currentWordIndex flips to 0.
        property string _pendingText: ""
        Timer {
            id: _startDelayTimer
            interval: 300
            repeat: false
            onTriggered: {
                readingOverlay.currentWordIndex = 0
                if (backend && readingOverlay._pendingText.length > 0) {
                    backend.corpus_start(readingOverlay._pendingText)
                }
                readingOverlay._pendingText = ""
            }
        }
        function beginReading(text) {
            // Helper called by both start paths (auto-arm and
            // explicit start button). Splits text, primes state,
            // kicks the start-delay timer. The timer's onTriggered
            // handles the actual currentWordIndex=0 + corpus_start.
            //
            // v0.1.242 (PA1): also captures the selected paragraph's
            // content type from the backend property so we can pick
            // the right WPM multiplier. Backend publishes this
            // alongside current_paragraph_text in paragraph_selected.
            words = text.split(/\s+/).filter(function(w) { return w.length > 0 })
            currentWordIndex = -1
            _pendingText = text
            var ct = "prose"
            if (backend && backend.current_paragraph_content_type) {
                var raw = backend.current_paragraph_content_type.toString()
                if (raw.length > 0) ct = raw
            }
            activeContentType = ct
            // v0.1.371 (PA arc): if a persisted calibration value
            // exists for this content type, use it INSTEAD of the
            // PA1 baseline. Persistence carries personalized
            // adjustment learned across sessions. Returns 0.0 when
            // no data is stored, in which case we fall back to the
            // PA1 baseline.
            //
            // This ship lands the read path. Writes still come
            // from manual `reading_calibration_set` calls (auto-
            // blending of in-session observations TODO future PA
            // ship).
            var persistedMul = (backend && backend.reading_calibration_get)
                ? backend.reading_calibration_get(ct) : 0.0
            activeMultiplier = (persistedMul > 0.0)
                ? persistedMul
                : _baseMultiplierFor(ct)
            state = "reading"
            _startDelayTimer.restart()
        }
        function stopReading(callCorpusStop) {
            // v0.1.236: unified cleanup. Handles cancel and natural
            // end-of-paragraph. callCorpusStop=true commits any
            // partial recording; false skips (for the case where
            // we cancel BEFORE the 300ms delay fired and
            // corpus_start was never called).
            //
            // Always stops the start-delay timer so a pending fire
            // doesn't sneak through after the user said cancel.
            _startDelayTimer.stop()
            var hadStarted = (currentWordIndex >= 0)
            state = "idle"
            currentWordIndex = -1
            _pendingText = ""
            // v0.1.242 (PA1): reset multiplier so next paragraph
            // starts fresh from its own content type's baseline.
            activeMultiplier = 1.0
            activeContentType = "prose"
            if (callCorpusStop && hadStarted && backend) {
                backend.corpus_stop()
            }
        }

        // === waiting/ready state UI ===
        // Single row with instruction text + (in ready state) start/cancel buttons
        Row {
            id: _readingHintRow
            visible: readingOverlay.state === "waiting"
                  || readingOverlay.state === "ready"
            anchors.verticalCenter: parent.verticalCenter
            anchors.horizontalCenter: parent.horizontalCenter
            spacing: 14
            Text {
                anchors.verticalCenter: parent.verticalCenter
                text: readingOverlay.state === "waiting"
                    ? "tap a paragraph to read aloud"
                    : "ready — start reading at " + readingOverlay.wpm + " wpm?"
                color: "#e0e0e0"
                font.pixelSize: 13
                font.italic: readingOverlay.state === "waiting"
            }
            // v0.1.234: pre-start rate selector. Mirrors the
            // bottom-row button in reading state — lets the user
            // set their pace BEFORE starting rather than only
            // adjusting mid-read.
            Rectangle {
                visible: readingOverlay.state === "ready"
                anchors.verticalCenter: parent.verticalCenter
                // v0.1.248: height 28→30, radius 14→8.
                width: _readRatePreTxt.implicitWidth + 16; height: 30
                radius: 8
                color: "transparent"
                border.color: th.bd; border.width: 1
                Text {
                    id: _readRatePreTxt
                    anchors.centerIn: parent
                    text: readingOverlay.rateLabel()
                    color: "#b0b0b0"
                    font.pixelSize: 12
                }
                TapHandler {
                    onTapped: readingOverlay.cycleRate()
                    onLongPressed: readingOverlay._showRateSlider = !readingOverlay._showRateSlider
                }
            }
            // v0.1.370 (PA2 visual indicator): silence-multiplier
            // pill. Visible only when silenceMultiplier ≠ 1.0
            // (i.e. when the voice runtime is observing a pause
            // worth slowing for). Helps the user understand why
            // pace just changed without it feeling magical.
            //
            // Anchored to the same row as the rate button so the
            // user's eye finds it naturally; collapses to 0 width
            // when inactive so the layout doesn't shift.
            Rectangle {
                id: _readSilencePill
                anchors.verticalCenter: parent.verticalCenter
                readonly property bool isActive:
                    readingOverlay.silenceMultiplier < 0.99
                    || readingOverlay.silenceMultiplier > 1.01
                visible: isActive
                    && (readingOverlay.state === "reading"
                        || readingOverlay.state === "ready")
                width: visible ? (_readSilenceTxt.implicitWidth + 12) : 0
                height: 22
                radius: 11
                color: Qt.rgba(0.18, 0.30, 0.45, 0.85)
                border.color: Qt.rgba(0.35, 0.55, 0.80, 0.7)
                border.width: 1
                Behavior on width { NumberAnimation { duration: 150 } }
                Text {
                    id: _readSilenceTxt
                    anchors.centerIn: parent
                    text: "voice " + readingOverlay.silenceMultiplier.toFixed(2) + "×"
                    color: "#d6e4ff"
                    font.pixelSize: 10
                    font.italic: true
                }
            }
            // Start button (only in ready state)
            Rectangle {
                visible: readingOverlay.state === "ready"
                anchors.verticalCenter: parent.verticalCenter
                // v0.1.248: height 28→30, radius 14→8.
                width: _readStartTxt.implicitWidth + 16; height: 30
                radius: 8
                color: th.ac
                Text { id: _readStartTxt; anchors.centerIn: parent; text: "start"; color: "#fff"; font.pixelSize: 12; font.bold: true }
                TapHandler {
                    onTapped: {
                        // Split the paragraph into words and enter
                        // reading state. The WPM timer takes over
                        // from here.
                        //
                        // v0.1.236: routed through beginReading()
                        // which adds the 300ms start-delay before
                        // the highlight moves and mic captures.
                        var text = backend ? backend.current_paragraph_text.toString() : ""
                        readingOverlay.beginReading(text)
                    }
                }
            }
            // Cancel button — exits the flow without starting
            Rectangle {
                anchors.verticalCenter: parent.verticalCenter
                // v0.1.248: height 28→30, radius 14→8.
                width: _readCancelTxt.implicitWidth + 16; height: 30
                radius: 8
                color: "transparent"
                border.color: th.bd; border.width: 1
                Text { id: _readCancelTxt; anchors.centerIn: parent; text: "cancel"; color: "#b0b0b0"; font.pixelSize: 12 }
                TapHandler {
                    onTapped: {
                        // v0.1.236: cancel from ready (paragraph
                        // selected but not yet reading). No corpus
                        // capture in progress, so callCorpusStop=false.
                        readingOverlay.stopReading(false)
                    }
                }
            }
        }

        // === reading state UI ===
        // v0.1.226: replaces the prior bold + high-saturation
        // accent-colored highlight (ship 2.2) with a 5-word
        // opacity window. User feedback on v0.1.224 + earlier:
        //   - "too distracting because they are colored"
        //   - "max five word buffer that 1 or 2s fades brighter"
        //   - "too fast and don't quite follow the help reading"
        //
        // Design:
        //   - The Flow still holds ALL the paragraph's words for
        //     layout; no scrolling logic needed.
        //   - Each word's opacity is bound to its OFFSET from the
        //     current word index:
        //       offset === 0   →  1.00  (current word, brightest)
        //       |offset| === 1 →  0.55  (immediate neighbors)
        //       |offset| === 2 →  0.25  (window edges)
        //       else           →  0.00  (outside the 5-word window)
        //   - `Behavior on opacity` with a 1200ms NumberAnimation
        //     means when the current index advances, BOTH the old
        //     current (fading to 0.55) AND the new current (rising
        //     to 1.0) animate simultaneously over 1.2s. That's the
        //     crossfade effect — at any moment one word is
        //     brightest but the eye sees the transition continuous.
        //   - Single text color (`th.tc`), no bold. The brightness
        //     does the work; no hue change. Less eye-pull.
        //
        // Limitations of sub-ship A (filed as sub-ship B / C):
        //   - No active scrolling. Long paragraphs that wrap to
        //     a second line still wrap normally; the window can
        //     straddle a line break.
        //   - Hard advance every (60/wpm)ms, not aligned to
        //     actual reading rate.
        //   - No syllable-level matching.
        Column {
            visible: readingOverlay.state === "reading"
            anchors.fill: parent
            anchors.margins: 12
            spacing: 8

            // v0.1.241: teleprompter-style viewport. User feedback:
            // "the highlighted words should also be centered
            // vertically for things that expand beyond the bottom
            // border because otherwise you can't see them... this
            // is why teleprompters scroll."
            //
            // Wraps the word Flow in a clipped Item with a fixed
            // visible height. The Flow's y is computed so the
            // current word's vertical center aligns with the
            // viewport's vertical center. Behavior on y animates
            // the scroll smoothly between word advances.
            //
            // Layout math: each word item has a `y` within the
            // Flow (its line position) and a `height` (line
            // height of its Text). To center: Flow.y =
            // viewport.height/2 - (item.y + item.height/2).
            //
            // When currentWordIndex < 0 (300ms pre-start delay),
            // we hold Flow.y at 0 so the user sees the start of
            // the paragraph waiting to begin.
            Item {
                id: _wordsViewport
                width: parent.width
                // Reserve room for the bottom Row (progress + rate
                // + stop button). Overlay height 220 minus 12*2
                // margin minus ~28 bottom row minus 8 spacing
                // leaves ~140 for words.
                height: parent.height - 36
                clip: true
                Flow {
                    id: _wordsFlow
                    width: parent.width
                    spacing: 6
                    y: {
                        if (readingOverlay.currentWordIndex < 0) return 0
                        var item = _wordsRepeater.itemAt(readingOverlay.currentWordIndex)
                        if (!item) return 0
                        // Center the current word's middle in the
                        // viewport. Clamp so we don't scroll past
                        // the start (positive y) or unnecessarily
                        // past the end.
                        var target = _wordsViewport.height / 2 - (item.y + item.height / 2)
                        // Never push the first line below the top
                        // of the viewport — i.e., if natural target
                        // is positive (first few words don't need
                        // scrolling), clamp to 0.
                        if (target > 0) target = 0
                        return target
                    }
                    Behavior on y {
                        NumberAnimation {
                            duration: 300
                            easing.type: Easing.OutQuad
                        }
                    }
                    Repeater {
                        id: _wordsRepeater
                        model: readingOverlay.words
                        Text {
                            text: modelData
                            // v0.1.257 (teleprompter readability):
                            // size bound to readingOverlay.wordFontSize
                            // so the user can scale up for
                            // shared-screen registration. Default 28.
                            font.pixelSize: readingOverlay.wordFontSize
                            color: th.tc
                            opacity: {
                                var offset = index - readingOverlay.currentWordIndex
                                if (offset === 0) return 1.0
                                if (offset === 1 || offset === -1) return 0.7
                                if (offset === 2 || offset === -2) return 0.45
                                if (offset >= 3 && offset <= 5) return 0.25
                                if (offset <= -3 && offset >= -5) return 0.25
                                return 0.1
                            }
                            // v0.1.241: visible opacity floor 0.1
                            // (was 0.0) so the surrounding context
                            // stays faintly readable. With
                            // teleprompter scroll the user can SEE
                            // upcoming and recent words; making
                            // them fully invisible defeats the
                            // purpose of having them on screen.
                            Behavior on opacity {
                                NumberAnimation {
                                    duration: 1200
                                    easing.type: Easing.InOutQuad
                                }
                            }
                        }
                    }
                }
            }

            // Bottom row: progress + rate-cycle button + stop button
            Row {
                width: parent.width
                spacing: 12
                Text {
                    id: _readProgressTxt
                    anchors.verticalCenter: parent.verticalCenter
                    text: (readingOverlay.currentWordIndex + 1) + " / " + readingOverlay.words.length
                    color: "#909090"
                    font.pixelSize: 11
                }
                // Spacer — Row doesn't support Layout.fillWidth, so
                // we compute the explicit width to fill remaining
                // space (parent.width minus progress text, rate
                // button, stop button, and the row's spacings).
                // v0.1.234: updated to also subtract _readRateBtn.
                // v0.1.242 (PA1): also subtract _readMultPill when
                // visible (when activeMultiplier != 1.0).
                Item {
                    height: 1
                    width: parent.width - _readProgressTxt.width
                        - (_readMultPill.visible ? (_readMultPill.width + 6) : 0)
                        - _readFontBtn.width
                        - _readRateBtn.width - _readStopBtn.width - 48
                }
                // v0.1.257 (teleprompter readability): font-size
                // cycle button. Tap cycles small/med/large/xlarge
                // (20/28/36/44 px). For shared-screen registration
                // where the second reader needs to see the words
                // from across a table. The default 28 is already
                // readable for most cases; this lets users size up
                // when needed. Persisted to disk so accessibility
                // preference survives across launches.
                Rectangle {
                    id: _readFontBtn
                    anchors.verticalCenter: parent.verticalCenter
                    width: _readFontTxt.implicitWidth + 16; height: 26
                    radius: 7
                    color: "transparent"
                    border.color: th.bd; border.width: 1
                    Text {
                        id: _readFontTxt
                        anchors.centerIn: parent
                        text: "A " + readingOverlay.wordFontSize
                        color: "#b0b0b0"
                        font.pixelSize: 11
                    }
                    TapHandler {
                        onTapped: readingOverlay.cycleFontSize()
                    }
                }
                // v0.1.242 (PA1): per-content-type multiplier pill.
                // Shows e.g. "list ×0.90" when the active paragraph
                // is using a non-1.0 multiplier so the user knows
                // why pace differs from the rate-button label.
                // Hidden when multiplier is 1.0 (prose-default).
                Rectangle {
                    id: _readMultPill
                    anchors.verticalCenter: parent.verticalCenter
                    visible: Math.abs(readingOverlay.activeMultiplier - 1.0) > 0.001
                    // v0.1.248: bumped height 20→22 for descender
                    // clearance ("g","p","y" in content-type labels)
                    // and radius 10→6 (softer rounded-rect instead
                    // of pure stadium). User feedback after v0.1.247:
                    // "just a little too round and bottom padding
                    // suffers on words."
                    width: _readMultTxt.implicitWidth + 12; height: 22
                    radius: 6
                    color: "transparent"
                    border.color: th.ac; border.width: 1
                    opacity: 0.85
                    Text {
                        id: _readMultTxt
                        anchors.centerIn: parent
                        text: readingOverlay.activeContentType + " ×" + readingOverlay.activeMultiplier.toFixed(2)
                        color: th.ac
                        font.pixelSize: 10
                    }
                }
                // v0.1.234: rate-cycle button. Tap = slow → med →
                // fast → slow. Shows current label.
                //
                // v0.1.238: long-press toggles the fine-control
                // slider visibility (100-280 WPM range).
                Rectangle {
                    id: _readRateBtn
                    anchors.verticalCenter: parent.verticalCenter
                    // v0.1.248: height 24→26, radius 12→7 (see
                    // _readMultPill comment for rationale).
                    width: _readRateTxt.implicitWidth + 16; height: 26
                    radius: 7
                    color: "transparent"
                    border.color: th.bd; border.width: 1
                    Text {
                        id: _readRateTxt
                        anchors.centerIn: parent
                        text: readingOverlay.rateLabel()
                        color: "#b0b0b0"
                        font.pixelSize: 11
                    }
                    TapHandler {
                        onTapped: readingOverlay.cycleRate()
                        onLongPressed: readingOverlay._showRateSlider = !readingOverlay._showRateSlider
                    }
                }
                Rectangle {
                    id: _readStopBtn
                    anchors.verticalCenter: parent.verticalCenter
                    // v0.1.248: height 24→26, radius 12→7.
                    width: _readStopTxt.implicitWidth + 16; height: 26
                    radius: 7
                    color: "transparent"
                    border.color: th.bd; border.width: 1
                    Text { id: _readStopTxt; anchors.centerIn: parent; text: "stop"; color: "#b0b0b0"; font.pixelSize: 11 }
                    TapHandler {
                        onTapped: {
                            // v0.1.236: route through stopReading()
                            // which handles cancel-during-delay
                            // gracefully. If the 300ms delay
                            // hadn't fired yet, corpus_start was
                            // never called and corpus_stop is
                            // skipped (callCorpusStop suppressed
                            // when hadStarted=false).
                            readingOverlay.stopReading(true)
                        }
                    }
                }
            }
        }

        // v0.1.238: WPM fine-control slider. Shown when a rate
        // button is long-pressed. Sits above the readingOverlay
        // (negative y) so it doesn't cover the reading-state
        // word flow. Tap outside dismisses.
        //
        // Range 80-280 WPM matches the Rust persistence clamp
        // (80..=300 with 280 as practical fast-reading upper).
        // Snap to 5-WPM increments. Live preview — the wpm
        // value updates as the user drags, so the WPM timer's
        // interval re-evaluates immediately and the visual
        // reflects the new rate without needing release.
        //
        // Persistence happens on slider release (not on every
        // step) to avoid writing the file dozens of times per
        // drag.
        Rectangle {
            id: _wpmSliderPopup
            visible: readingOverlay._showRateSlider && readingOverlay.state !== "idle"
            width: 240
            height: 64
            // v0.1.241: now that the readingOverlay anchors to
            // the TOP of the window (was bottom), the slider pops
            // BELOW the overlay (positive y) instead of above.
            // Same visual relationship to the rate button (just
            // off the opposite edge).
            x: readingOverlay.width - width - 60
            y: readingOverlay.height + 8
            color: Qt.rgba(0.08, 0.08, 0.10, 0.97)
            border.color: th.ac
            border.width: 1
            radius: 6
            Column {
                anchors.fill: parent
                anchors.margins: 8
                spacing: 4
                Row {
                    width: parent.width
                    Text {
                        text: "reading rate"
                        color: th.tc
                        font.pixelSize: 11
                        anchors.verticalCenter: parent.verticalCenter
                    }
                    Item {
                        width: parent.width - _rateLabelLeft.width - _rateValTxt.width
                        height: 1
                        Item { id: _rateLabelLeft }
                    }
                    Text {
                        id: _rateValTxt
                        text: readingOverlay.wpm + " wpm"
                        color: th.ac
                        font.pixelSize: 11
                        font.bold: true
                        anchors.verticalCenter: parent.verticalCenter
                    }
                }
                Slider {
                    width: parent.width
                    height: 24
                    from: 80
                    to: 280
                    stepSize: 5
                    value: readingOverlay.wpm
                    onMoved: {
                        // Live-update wpm. The WPM timer's
                        // interval binding picks this up
                        // immediately.
                        readingOverlay.wpm = Math.round(value)
                    }
                    onPressedChanged: {
                        // Persist only on release (pressed went
                        // false). Avoids dozens of writes during
                        // a drag.
                        if (!pressed) readingOverlay.persistWpm()
                    }
                }
            }
        }
        // Dismissal: long-press the rate button again to toggle
        // off. Considered tap-outside-to-dismiss but the MouseArea
        // would either swallow taps on the readingOverlay's
        // existing buttons (stop, cancel, etc.) or need fragile
        // ApplicationWindow-level anchoring. Simpler model: long-
        // press is the toggle gesture in both directions.
    }

    // Polling timer for the moment classifier. Every 3 seconds,
    // ask Rust what the current decision is. If it transitioned
    // from silence → solo (or similar), show the prompt. The
    // backend's moment_decision() already accounts for
    // suppression state (cooldowns, session-silenced), so we
    // just react to the returned value.
    Timer {
        id: _momentCheckTimer
        interval: 3000
        repeat: true
        running: backend !== null
        property string lastShownDecision: "silence"
        onTriggered: {
            if (!backend) return
            var decision = backend.moment_decision().toString()
            if (decision === lastShownDecision) return
            lastShownDecision = decision
            if (decision === "solo") {
                corpusPrompt.opacity = 1.0
            } else if (decision === "checkin") {
                // v0.1.187: DeepNight acknowledgment. Different
                // UI from SoloPrompt (single button, italicized,
                // softer border).
                deepNightCheckin.opacity = 1.0
            } else if (decision === "coread") {
                // v0.1.188: multi-voice variant. Same three-button
                // structure as corpusPrompt; different copy.
                coreadPrompt.opacity = 1.0
            } else if (decision === "wink") {
                // v0.1.189: sustained-noise observation. Single
                // button, italicized, like the DeepNight check-in.
                cafeWink.opacity = 1.0
            } else if (decision === "silence") {
                // Suppression engaged elsewhere; hide whichever
                // is showing.
                corpusPrompt.opacity = 0
                deepNightCheckin.opacity = 0
                coreadPrompt.opacity = 0
                cafeWink.opacity = 0
            }
        }
    }

    // ═══ COPY MENU POPUP ═══
    //
    // Double-click in terminal opens this menu instead of immediately
    // copying. Lists smart options + chevrons for box-area expansion.
    //
    // Architecture:
    //   - Anchor row/col captured from the double-click (the "anchor cell")
    //   - List of preset selections: word, line, paragraph, block output,
    //     full screen
    //   - Below: 4 chevrons (cardinal) that expand the current selection
    //     by one cell in that direction. j/k/h/l keyboard equivalents.
    //   - Enter copies the current selection.
    //   - Esc closes without copying.
    //
    // The menu uses termScreen's selStartRow/Col, selEndRow/Col so the
    // visual selection rectangle (selectionLayer) shows live feedback
    // as the user expands/contracts.
    Popup {
        id: copyMenuPopup
        modal: false  // not modal — selection rect should show through
        dim: false
        closePolicy: Popup.CloseOnEscape | Popup.CloseOnPressOutside
        // Anchor cell — where the user double-clicked. We use this as
        // the "center" for expand/contract operations.
        property int anchorRow: 0
        property int anchorCol: 0
        // Position the popup near the click but clamped to viewport.
        // openAt() sets x/y based on click coords + offset.
        x: 0; y: 0
        width: 240
        // Height adapts: header + list + chevron pad + spacing.
        height: _copyMenuCol.implicitHeight + 24
        background: Rectangle {
            color: Qt.darker(th.sf, 0.85)
            radius: 10
            border.color: th.bd; border.width: 1
        }

        // Open at a click position. Clamps to root.width / root.height.
        function openAt(clickX, clickY, row, col) {
            anchorRow = row
            anchorCol = col
            // Seed the selection at this single cell. The visible
            // selection rectangle in selectionLayer already follows
            // termScreen.sel* properties.
            if (typeof termScreen !== "undefined") {
                termScreen.selStartRow = row
                termScreen.selStartCol = col
                termScreen.selEndRow = row
                termScreen.selEndCol = col
                termScreen.selActive = true
                termScreen.selDragging = false
                termScreen._captureAbsoluteAnchors()
            }
            // Place popup. Default offset: 12px right + 12px down
            // from click. If that pushes off screen, flip to other side.
            var px = clickX + 12
            var py = clickY + 12
            if (px + width > root.width - 8) px = clickX - width - 12
            if (py + height > root.height - 8) py = clickY - height - 12
            if (px < 8) px = 8
            if (py < 8) py = 8
            x = px; y = py
            open()
            // Take focus so j/k/h/l/Enter reach our Keys handler.
            // v0.1.113: focus must go to the inner FocusScope, not
            // the Popup itself (Popup isn't an Item).
            if (typeof _copyMenuFocus !== "undefined") {
                _copyMenuFocus.forceActiveFocus()
            } else {
                forceActiveFocus()
            }
        }

        // v0.1.346: seed anchor + cell-level selection WITHOUT
        // opening the popup. Used by the new double-tap-to-
        // select-word path so the copyPill becomes the primary
        // post-selection affordance instead of this popup. The
        // popup is still reachable via the pill's [⋯] button for
        // chevron-expand / paragraph / screen power features.
        function seedSelectionAt(row, col) {
            anchorRow = row
            anchorCol = col
            if (typeof termScreen === "undefined") return
            termScreen.selStartRow = row
            termScreen.selStartCol = col
            termScreen.selEndRow = row
            termScreen.selEndCol = col
            termScreen.selActive = true
            termScreen.selDragging = false
            termScreen._captureAbsoluteAnchors()
        }

        // Selection helpers — modify termScreen.sel* properties so the
        // overlay (selectionLayer) updates live. Each returns a label
        // for the toast.
        function selectAnchorOnly() {
            termScreen.selStartRow = anchorRow
            termScreen.selStartCol = anchorCol
            termScreen.selEndRow = anchorRow
            termScreen.selEndCol = anchorCol
            termScreen._captureAbsoluteAnchors()
        }
        function selectWord() {
            // Walk left and right from anchor on the same row, stopping
            // at whitespace boundaries. Uses backend.term_row to fetch
            // text. For empty rows, falls back to a single-char selection.
            if (!backend) return
            var rowText = backend.term_row(anchorRow)
            if (!rowText || rowText.length === 0) {
                selectAnchorOnly(); return
            }
            var n = rowText.length
            var c = Math.min(anchorCol, n - 1)
            // If anchor is on whitespace, pick the nearest token to the
            // left (or right if nothing left).
            var isSep = function(ch) {
                return ch === " " || ch === "\t" || ch === ""
            }
            if (isSep(rowText.charAt(c))) {
                // Try left first
                var lcand = c
                while (lcand > 0 && isSep(rowText.charAt(lcand - 1))) lcand--
                if (lcand > 0) {
                    c = lcand - 1
                } else {
                    // Try right
                    var rcand = c
                    while (rcand < n - 1 && isSep(rowText.charAt(rcand))) rcand++
                    c = rcand
                }
            }
            // Now expand left/right to word boundaries
            var l = c
            while (l > 0 && !isSep(rowText.charAt(l - 1))) l--
            var r = c
            while (r < n - 1 && !isSep(rowText.charAt(r + 1))) r++
            termScreen.selStartRow = anchorRow
            termScreen.selStartCol = l
            termScreen.selEndRow = anchorRow
            termScreen.selEndCol = r
            termScreen._captureAbsoluteAnchors()
        }
        function selectLine() {
            if (!backend) return
            var rowText = backend.term_row(anchorRow)
            var endCol = rowText ? Math.max(0, rowText.length - 1) : 0
            termScreen.selStartRow = anchorRow
            termScreen.selStartCol = 0
            termScreen.selEndRow = anchorRow
            termScreen.selEndCol = endCol
            termScreen._captureAbsoluteAnchors()
        }
        function selectParagraph() {
            // Walk up while previous row is non-empty. Walk down while
            // next row is non-empty. Stop at blank lines or viewport edges.
            if (!backend) return
            var rows = backend.term_visible_rows()
            var top = anchorRow, bot = anchorRow
            while (top > 0) {
                var t = backend.term_row(top - 1)
                if (!t || t.length === 0) break
                top--
            }
            while (bot < rows - 1) {
                var b = backend.term_row(bot + 1)
                if (!b || b.length === 0) break
                bot++
            }
            var bottomText = backend.term_row(bot)
            var endCol = bottomText ? Math.max(0, bottomText.length - 1) : 0
            termScreen.selStartRow = top
            termScreen.selStartCol = 0
            termScreen.selEndRow = bot
            termScreen.selEndCol = endCol
            termScreen._captureAbsoluteAnchors()
        }
        function selectFullScreen() {
            if (!backend) return
            var rows = backend.term_visible_rows()
            termScreen.selStartRow = 0
            termScreen.selStartCol = 0
            termScreen.selEndRow = rows - 1
            termScreen.selEndCol = termScreen.lastC > 0 ? termScreen.lastC - 1 : 79
            termScreen._captureAbsoluteAnchors()
        }
        // Chevron expansion: nudge the END of the selection by one cell
        // in the given direction. Always operates on the END so
        // expand-from-anchor works naturally.
        function expandUp() {
            if (termScreen.selEndRow > 0) {
                termScreen.selEndRow--
                termScreen._captureAbsoluteAnchors()
            }
        }
        function expandDown() {
            if (!backend) return
            var rows = backend.term_visible_rows()
            if (termScreen.selEndRow < rows - 1) {
                termScreen.selEndRow++
                termScreen._captureAbsoluteAnchors()
            }
        }
        function expandLeft() {
            if (termScreen.selEndCol > 0) termScreen.selEndCol--
        }
        function expandRight() {
            if (termScreen.selEndCol < (termScreen.lastC - 1)) termScreen.selEndCol++
        }

        // Copy the current selection and close.
        function commitCopy() {
            var txt = ""
            if (backend && backend.term_selection_text) {
                txt = backend.term_selection_text(
                    termScreen.selStartRow, termScreen.selStartCol,
                    termScreen.selEndRow, termScreen.selEndCol)
            }
            if (txt && txt.length > 0) {
                if (backend && backend.clipboard_set) backend.clipboard_set(txt)
                toast.show("Copied " + txt.length + " chars")
            }
            close()
        }

        onClosed: {
            // Keep selection visible after close so the user can still
            // see what was just copied. They can dismiss with Esc or
            // by clicking elsewhere — handled by termScreen.clearSelection.
        }

        // v0.1.113: Keys must attach to an Item, not a Popup. Wrap
        // contents in a FocusScope so j/k/h/l/Enter shortcuts work.
        // forceActiveFocus() on the FocusScope from openAt() lets it
        // receive keyboard events while the popup is open.
        contentItem: FocusScope {
            id: _copyMenuFocus
            focus: true
            Keys.onPressed: function(event) {
                if (event.key === Qt.Key_J) { copyMenuPopup.expandDown(); event.accepted = true }
                else if (event.key === Qt.Key_K) { copyMenuPopup.expandUp(); event.accepted = true }
                else if (event.key === Qt.Key_H) { copyMenuPopup.expandLeft(); event.accepted = true }
                else if (event.key === Qt.Key_L) { copyMenuPopup.expandRight(); event.accepted = true }
                else if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) {
                    copyMenuPopup.commitCopy(); event.accepted = true
                }
            }

            ColumnLayout {
                id: _copyMenuCol
                anchors.fill: parent; anchors.margins: 12
            spacing: 8

            Text {
                Layout.fillWidth: true
                text: "Copy from ⟨" + copyMenuPopup.anchorRow + "," + copyMenuPopup.anchorCol + "⟩"
                color: th.tm; font.pixelSize: 10; font.italic: true
            }

            // Preset selection options
            Repeater {
                model: [
                    { label: "Word",        action: "word"   },
                    { label: "Line",        action: "line"   },
                    { label: "Paragraph",   action: "para"   },
                    { label: "Whole screen",action: "screen" }
                ]
                delegate: Rectangle {
                    Layout.fillWidth: true
                    height: 28
                    radius: 6
                    color: _itemMa.containsMouse
                        ? Qt.lighter(th.sf, 1.4)
                        : Qt.lighter(th.sf, 1.15)
                    Behavior on color { ColorAnimation { duration: 100 } }
                    Text {
                        anchors.left: parent.left; anchors.leftMargin: 10
                        anchors.verticalCenter: parent.verticalCenter
                        text: modelData.label; color: th.tc; font.pixelSize: 12
                    }
                    MouseArea {
                        id: _itemMa
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        propagateComposedEvents: false
                        onClicked: {
                            if (modelData.action === "word")    copyMenuPopup.selectWord()
                            else if (modelData.action === "line")   copyMenuPopup.selectLine()
                            else if (modelData.action === "para")   copyMenuPopup.selectParagraph()
                            else if (modelData.action === "screen") copyMenuPopup.selectFullScreen()
                            // Auto-commit on preset click. The user can
                            // ALSO drag chevrons to fine-tune, but if
                            // they tap a preset the intent is "copy this
                            // and done."
                            copyMenuPopup.commitCopy()
                        }
                    }
                }
            }

            // Divider
            Rectangle { Layout.fillWidth: true; height: 1; color: th.bd; opacity: 0.5 }

            Text {
                Layout.fillWidth: true
                text: "Expand (j↓ k↑ h← l→ ⏎)"
                color: th.tm; font.pixelSize: 9; font.italic: true
            }

            // Chevron grid: 3×3 with arrows in cardinal slots, "OK" in center
            GridLayout {
                Layout.alignment: Qt.AlignHCenter
                columns: 3
                rowSpacing: 4
                columnSpacing: 4
                // Top row: empty, ↑, empty
                Item { Layout.preferredWidth: 36; Layout.preferredHeight: 30 }
                Rectangle {
                    Layout.preferredWidth: 36; Layout.preferredHeight: 30; radius: 6
                    color: _upMa.containsMouse ? Qt.lighter(th.ac, 1.2) : Qt.lighter(th.sf, 1.3)
                    Behavior on color { ColorAnimation { duration: 80 } }
                    Text { anchors.centerIn: parent; text: "\u25B2"; color: th.tc; font.pixelSize: 14 }
                    MouseArea { id: _upMa; anchors.fill: parent; hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: copyMenuPopup.expandUp() }
                }
                Item { Layout.preferredWidth: 36; Layout.preferredHeight: 30 }
                // Middle row: ←, OK/Enter, →
                Rectangle {
                    Layout.preferredWidth: 36; Layout.preferredHeight: 30; radius: 6
                    color: _leftMa.containsMouse ? Qt.lighter(th.ac, 1.2) : Qt.lighter(th.sf, 1.3)
                    Behavior on color { ColorAnimation { duration: 80 } }
                    Text { anchors.centerIn: parent; text: "\u25C0"; color: th.tc; font.pixelSize: 14 }
                    MouseArea { id: _leftMa; anchors.fill: parent; hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: copyMenuPopup.expandLeft() }
                }
                Rectangle {
                    Layout.preferredWidth: 36; Layout.preferredHeight: 30; radius: 6
                    color: _okMa.containsMouse ? Qt.lighter(th.ac, 1.4) : th.ac
                    Behavior on color { ColorAnimation { duration: 80 } }
                    Text { anchors.centerIn: parent; text: "\u23CE"; color: "#fff"; font.pixelSize: 14; font.bold: true }
                    MouseArea { id: _okMa; anchors.fill: parent; hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        propagateComposedEvents: false
                        onClicked: copyMenuPopup.commitCopy() }
                }
                Rectangle {
                    Layout.preferredWidth: 36; Layout.preferredHeight: 30; radius: 6
                    color: _rightMa.containsMouse ? Qt.lighter(th.ac, 1.2) : Qt.lighter(th.sf, 1.3)
                    Behavior on color { ColorAnimation { duration: 80 } }
                    Text { anchors.centerIn: parent; text: "\u25B6"; color: th.tc; font.pixelSize: 14 }
                    MouseArea { id: _rightMa; anchors.fill: parent; hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: copyMenuPopup.expandRight() }
                }
                // Bottom row: empty, ↓, empty
                Item { Layout.preferredWidth: 36; Layout.preferredHeight: 30 }
                Rectangle {
                    Layout.preferredWidth: 36; Layout.preferredHeight: 30; radius: 6
                    color: _downMa.containsMouse ? Qt.lighter(th.ac, 1.2) : Qt.lighter(th.sf, 1.3)
                    Behavior on color { ColorAnimation { duration: 80 } }
                    Text { anchors.centerIn: parent; text: "\u25BC"; color: th.tc; font.pixelSize: 14 }
                    MouseArea { id: _downMa; anchors.fill: parent; hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: copyMenuPopup.expandDown() }
                }
                Item { Layout.preferredWidth: 36; Layout.preferredHeight: 30 }
            }
        }
        }
    }

    // ═══ FILE PICKER DRAWER ═══
    // Touch-friendly directory browser opened by double-tapping a path/
    // folder token in the terminal. Currently a SINGLE drawer that
    // shows immediate children of one directory at a time — tapping
    // a directory entry navigates into it (replacing the contents).
    // The macOS-style cascading multi-drawer is the intended evolution
    // (see TODO_v68_deferred.md #1) but a single drawer already covers
    // 90% of the value: tap deep, hit Done, get a `cd <path>` at the
    // prompt.
    //
    // Layout: full-height drawer slides in from the right. Top bar has
    // current path + Done button. Body is a ListView of entries with
    // directory entries marked with a folder icon and trailing `/`.
    // Tapping a file ends the picker by inserting that file's path
    // (e.g. for `cd ../Downloads` then tapping `report.pdf` yields
    // `cat ~/Downloads/report.pdf` — actually no, just inserts the
    // path; user composes the verb separately).
    Popup {
        id: filePickerDrawer
        modal: true; dim: true
        closePolicy: Popup.CloseOnEscape | Popup.CloseOnPressOutside
        // v0.1.125: column view. Width adapts to column count
        // (capped by root.width). Each column is COLUMN_WIDTH wide;
        // total width = columns × that + chrome.
        // v0.1.208: mobile gets narrower columns (160 vs 240). Two-
        // line name wrapping keeps row text readable at the narrower
        // width.
        readonly property int columnWidth: root.width < 600 ? 160 : 240
        readonly property int chromeWidth: 12  // padding only; no per-column borders
        // Adaptive width: at least one column; grow up to root.width
        // as columns are added.
        x: Math.max(0, root.width - width)
        y: 0
        height: root.height
        width: {
            // Single-pane mode: fixed narrow width like the pre-v125 layout.
            if (!useColumnPicker) {
                return Math.min(root.width, 380)
            }
            // v0.1.165: depend on _columnsTick. The width binding
            // previously read `_columns.count` directly, but
            // `_columns` is a JS var (not a QML object), so mutating
            // `.count` doesn't fire a notify signal. The binding
            // never re-evaluated when new columns were pushed, so
            // the drawer stayed at single-column width even after
            // drilling into a deep path.
            //
            // The `_columnsTick` access in the expression below is a
            // void read that does nothing except register the
            // dependency. Every `_appendColumn` and friends call
            // `_bumpColumnsTick()` which now properly causes this
            // binding to re-fire.
            //
            // User report: "directory picker is fixed with the
            // missing names but it doesn't expand to the left to fit
            // more folders."
            var _force = _columnsTick  // intentional dep
            var cols = Math.max(1, _columns.count)
            var desired = cols * filePickerDrawer.columnWidth + filePickerDrawer.chromeWidth
            return Math.min(root.width, Math.max(filePickerDrawer.columnWidth + filePickerDrawer.chromeWidth, desired))
        }
        Behavior on width { NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }
        Behavior on x { NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }
        // Slide-from-right enter animation. NOTE: from = root.width
        // (off-screen), to follows the x binding above.
        enter: Transition {
            NumberAnimation { property: "opacity"; from: 0; to: 1; duration: 180 }
        }
        exit: Transition {
            NumberAnimation { property: "opacity"; from: 1; to: 0; duration: 150 }
        }
        // Currently-selected leaf (a file or the rightmost folder).
        // _commitAsPath / _commitAsCd reads this.
        property string currentPath: ""
        property bool showHidden: false
        // v0.1.127: pick between column view (Finder-style) and
        // single-pane (the pre-v125 layout). User flips this in
        // Settings if the column UX doesn't work in their flow.
        // Default true (column view), since the macOS-style picker
        // was specifically requested.
        property bool useColumnPicker: true

        // v0.1.208: folder-only mode. When true:
        //   - Listings come via term_list_dir_counted (with child counts)
        //   - Files are filtered OUT of the displayed entries
        //   - Each folder shows "(N)" indicating files+folders inside
        //   - Navigating into a folder that contains only files does
        //     NOT open an empty pane on the right (the bug fix)
        //   - Up-nav still pops columns normally
        //   - Per-row icon switches from 📁 emoji to a small
        //     hash-based identicon (favicon-style)
        // Caller sets this via the openAtFolder() entry point.
        property bool folderOnly: false

        // v0.1.208: adaptive column width for narrow screens. Mobile
        // (root.width < 600) gets 160px columns with 2-line name
        // wrapping. Desktop keeps the original 240px.
        readonly property int _isMobile: root.width < 600 ? 1 : 0
        // Column model: each entry = { path, entries: ListModel }.
        // ListModel-of-ListModels isn't directly supported by QML, so
        // we use a JavaScript array of { path, entries } objects
        // exposed via a property. ListModel for the displayed entries
        // is created on demand per column.
        property var _columns: ({ count: 0, items: [] })
        // Bump _columnsTick to force binding re-evaluation when we
        // mutate _columns.items (QML doesn't observe deep changes).
        property int _columnsTick: 0
        function _bumpColumnsTick() {
            _columnsTick = _columnsTick + 1
        }

        background: Rectangle {
            color: th.sf
            border.color: th.bd; border.width: 1
            // Drop shadow on left edge to suggest the drawer is layered
            // above the terminal. A simple gradient — Qt doesn't have a
            // free shadow primitive but a darken-toward-left strip is
            // visually similar.
            Rectangle {
                anchors.left: parent.left; anchors.top: parent.top; anchors.bottom: parent.bottom
                width: 6
                gradient: Gradient {
                    orientation: Gradient.Horizontal
                    GradientStop { position: 0.0; color: Qt.rgba(0,0,0,0.25) }
                    GradientStop { position: 1.0; color: Qt.rgba(0,0,0,0) }
                }
            }
        }
        function openAt(token) {
            // Determine which path to open. If listing the token
            // succeeds, open it as a directory. If empty, list parent.
            folderOnly = false
            _openAtInternal(token)
        }

        // v0.1.208: folder-only entry point. Files are hidden;
        // folders show their child counts. Use when the picker is
        // serving a "pick a destination folder" / "navigate folders"
        // workflow rather than a generic file picker.
        function openAtFolder(token) {
            folderOnly = true
            _openAtInternal(token)
        }

        // v0.1.208: internal helper picking the right backend method
        // based on folderOnly. Single call site for the listing fetch
        // so the format (2-part vs 3-part) parsing in _appendColumn
        // has one upstream to worry about.
        function _listDir(path) {
            if (!backend) return ""
            if (folderOnly && backend.term_list_dir_counted) {
                return backend.term_list_dir_counted(path, showHidden)
            }
            return backend.term_list_dir(path, showHidden)
        }

        function _openAtInternal(token) {
            var raw = _listDir(token)
            var path = token
            if (!raw || raw.length === 0) {
                var slash = token.lastIndexOf("/")
                var parent = slash > 0 ? token.substring(0, slash) : token
                if (parent.length === 0) parent = "/"
                var raw2 = _listDir(parent)
                if (!raw2 || raw2.length === 0) {
                    toast.show("Cannot list: " + token)
                    return
                }
                raw = raw2
                path = parent
            }
            // Reset columns and seed with this directory.
            _columns.items = []
            _columns.count = 0
            _bumpColumnsTick()
            currentPath = path
            _appendColumn(path, raw)
            open()
        }
        // Append a column for `path` populated with entries from
        // pre-fetched `raw` (term_list_dir or term_list_dir_counted
        // output).
        //
        // v0.1.208: line format is now either
        //   `kind\x1Fname`           (term_list_dir, 2 parts)
        //   `kind\x1Fname\x1Fcount`  (term_list_dir_counted, 3 parts)
        // We accept either, parse count when present. In folder-only
        // mode we additionally filter out non-directory entries so
        // the displayed list contains only folders.
        function _appendColumn(path, raw) {
            // v0.1.141: diagnostic logging. User reported sub-column
            // headers showing "undefined" while the first column
            // showed the path correctly. Need to confirm whether
            // `path` is reaching this function as expected for
            // sub-columns, and whether the push is being seen by
            // the Repeater's modelData binding.
            console.log("[picker._appendColumn] path=" + JSON.stringify(path)
                + " raw_len=" + (raw ? raw.length : 0)
                + " items_before=" + _columns.items.length
                + " folderOnly=" + folderOnly)
            var entries = []
            var lines = raw.split("\n")
            for (var i = 0; i < lines.length; i++) {
                var parts = lines[i].split("\x1F")
                // Accept 2-part (uncounted) or 3-part (counted) lines.
