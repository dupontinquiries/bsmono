            // _liveHintsRefineTimer in processResult. We don't query
            // before whisper because empty-partial TAB in zsh dumps the
            // entire alias/function/PATH lexicon (hundreds of entries
            // plus a startling visual flicker on the user's prompt).
            // Once whisper has given us a refinement target, the query
            // is small and bounded.
        }
        function refreshLiveHints(partial) {
            if (!backend) return
            // Only meaningful on terminal tab — backend returns empty
            // string for browser tab, but skip the round-trip entirely.
            if (tabBar.currentIndex !== 1) return
            var raw = backend.voice_get_live_hints(partial)
            liveHintsModel.clear()
            if (!raw) return
            var lines = raw.split("\n")
