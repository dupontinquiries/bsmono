    // Polled property mirroring backend.is_editor_active(). We poll
    // instead of relying on a signal because the foreground command
    // changes across PTY events (fork/exec) that don't all surface
    // signals we listen to. Cheap (one /proc read) at 400ms cadence,
    // same pattern as _pagerPoll in _touchRow.
    property bool _isEditorActive: false
    Timer {
        id: _editorPoll
        interval: 400
        running: backend !== null
        repeat: true
        onTriggered: {
            if (!backend || !backend.is_editor_active) {
                root._isEditorActive = false
                return
            }
            root._isEditorActive = backend.is_editor_active()
        }
    }

    // Brace-insert state. After a pair is emitted via the brace popup,
    // we set _braceInsertActive=true and capture the cursor row at
    // emit. A 1000ms timer aborts if no completion (per spec #10);
    // a row-change observer (TODO v0.1.143 with drag-forward) would
    // abort if editor auto-indent moves the cursor unexpectedly.
    // Mouse/tap input is blocked during this window (spec #9).
    property bool _braceInsertActive: false
    property int  _braceCursorRowAtInsert: -1
    Timer {
        id: _braceInsertGuard
        interval: 1000
        onTriggered: {
            if (root._braceInsertActive) {
                root._braceInsertActive = false
                console.log("[brace] insert guard timeout, aborting")
                // Voice-only toast (filed for v0.1.143 — needs toast surface
                // wired to bottom-screen overlay for voice context).
            }
        }
    }

    // Background fingerprint-DB drain. Backend's bg-listen worker
    // accumulates transcribed audio in a queue between captures.
    // We periodically drain it so the queue doesn't fill up. The
    // drain itself does the matching against shell history and
    // stores fingerprints if matched. Cheap when queue is empty
    // (one mutex lock + early return) so polling at 30s is fine.
    Timer {
        interval: 30000
        running: backend !== null
        repeat: true
        onTriggered: {
            if (backend && backend.voice_drain_bg) {
                var n = backend.voice_drain_bg()
                if (n > 0) {
                    console.log("[bg-drain] timer pulled " + n + " fingerprints")
                }
            }
        }
    }

    // Wake-word event poll. The backend's wake-word listener pushes
    // events when "Yo Big K" fires. We poll at 250ms so user gets
    // visual feedback within a quarter second of finishing the wake
    // phrase. Cheap (one mutex lock, usually empty).
    //
    // When a wake event fires we open the voice popup as if the user
    // had pressed the mic button. The captured wake audio is already
    // in last_audio_buffer so the matching pipeline uses its pitch
    // as the hint automatically — the user doesn't have to do
    // anything special.
    //
    // Stops polling while voice popup is open: redundant during
    // active capture, AND wake suppression is set true during that
    // window so no events would arrive anyway.
    // v0.1.751: COALESCED wake-event poll. Previously two independent 250ms
    // timers (wake + ask-ai) each woke and read pending_signals separately.
    // Now ONE timer reads the cheap bitmask once and dispatches to whichever
    // channels are set — the realization of the "one cheap heartbeat, deep
    // penetration only when a bit is set" design. Idle cost: one int read per
    // tick (no mutex). Both channels are wake-category events, so the timer is
    // gated on voice_wake_listening() (off entirely when no wake word is set).
    Timer {
        id: eventPollTimer
        interval: 250
        running: backend !== null
            && backend.voice_wake_listening && backend.voice_wake_listening()
        repeat: true
        onTriggered: {
            if (!backend || !backend.pending_signals) return
            var sig = backend.pending_signals()
            if (sig === 0) return  // cheap idle path — nothing pending, no locks
            // Wake (bit 1) — only act when no voice popup is already open.
            if ((sig & 1) !== 0 && !voicePopup.visible && backend.voice_pop_wake_event) {
                var fired = backend.voice_pop_wake_event()
                if (fired === "1") {
                    console.log("[wake] event fired — opening voice popup")
                    voicePopup.openedByWake = true
                    voicePopup.startListening()
                } else if (fired && fired.indexOf("1\x1F") === 0) {
                    // wake fired with an inline command ("{keyword}, open terminal")
                    var inline = fired.substring(2)  // skip "1\x1F"
                    console.log("[wake] inline command: " + JSON.stringify(inline))
                    voicePopup.openedByWake = true
                    voicePopup.acceptInlineCommand(inline)
                }
            }
            // AskAi (bit 2) — only when neither popup is open.
            if ((sig & 2) !== 0 && !askAiPopup.visible && !voicePopup.visible
                    && backend.voice_pop_ask_ai) {
                var question = backend.voice_pop_ask_ai()
                if (question && question.length > 0) {
                    console.log("[ask-ai] event fired — question=" + JSON.stringify(question))
                    askAiPopup.askQuestion(question)
                }
            }
        }
    }

    // Deferred paste for the pager-exit flow. When voice executes a
    // term_cmd while a pager is in the foreground, we send `q` then
    // wait for the pager to clear, then paste the actual command.
    // Without the gap, the command bytes race the alt-screen exit
    // and the leading characters get eaten. 70ms empirically clears
    // less/man on local PTYs; remote sessions might need more but
    // this is a best-effort optimization, not correctness.
    Timer {
        id: _pagerExitTimer
        interval: 70
        property string cmd: ""
        onTriggered: {
            if (backend && cmd.length > 0) {
                backend.pty_write(cmd + "\r")
            }
            cmd = ""
        }
    }

    // v0.1.217: single-quote a shell path that contains characters
    // posix sh treats as significant: whitespace, single-quote,
    // parentheses, backticks, dollar signs, semicolons, ampersands,
    // pipes, glob chars, or angle brackets.
    //
    // Strategy: if the path is "safe" (alphanum, `/`, `.`, `_`, `-`,
    // `~`), return as-is. Otherwise wrap in single quotes and
    // escape embedded single quotes via the standard
    // `'\''` (close-quote, escaped-quote, reopen-quote) trick.
    //
    // Tilde handling: a leading `~` or `~/` is preserved OUTSIDE
    // the quotes so the shell still does home-directory expansion.
    // `~/My Stuff` becomes `~/'My Stuff'`, not `'~/My Stuff'`
    // (which would be a literal path with a tilde character).
    //
    // This is a JS mirror of backend's `shell_quote` (src/main.rs)
    // with the added tilde-preservation behavior (backend doesn't
    // need it — backend resolves `~` to $HOME before calling
    // shell_quote, but QML paths can carry `~` straight through
    // from user input like favorites).
    //
    // Used by every site that emits `cd <path>\r` to the PTY so
    // folder names with spaces ("My Documents") don't break apart
    // into two arguments.
    function shellQuote(p) {
        if (!p || p.length === 0) return "''"
        // Allowed bare set: alphanumeric (a-z, A-Z, 0-9), plus
        // `/`, `.`, `_`, `-`, `~`. Matches backend shell_quote's
        // allowed set. Anything else triggers single-quote
        // wrapping. We use an explicit char check (not a regex)
        // because regex literals with `/` inside character
        // classes confuse the structural lint.
        var bareSafe = "/._-~"
        function _isBare(ch) {
            if (ch >= "a" && ch <= "z") return true
            if (ch >= "A" && ch <= "Z") return true
            if (ch >= "0" && ch <= "9") return true
            return bareSafe.indexOf(ch) >= 0
        }
        var needsQuote = false
        for (var i = 0; i < p.length; i++) {
            if (!_isBare(p.charAt(i))) { needsQuote = true; break }
        }
        if (!needsQuote) return p
        // Tilde preservation: if the path starts with `~/` or
        // bare `~`, peel that prefix off so it stays unquoted.
        var prefix = ""
        var rest = p
        if (p.charAt(0) === "~") {
            if (p.length === 1) {
                // Bare `~` — pass through (no quoting needed).
                return p
            }
            if (p.charAt(1) === "/") {
                prefix = "~/"
                rest = p.substring(2)
            }
            // `~user/...` — leave the `~user` portion bare too.
            // (Rare but valid.)
            else {
                var slash = p.indexOf("/")
                if (slash > 0) {
                    prefix = p.substring(0, slash + 1)
                    rest = p.substring(slash + 1)
                } else {
                    // `~user` with no path — pass through.
                    return p
                }
            }
            if (rest.length === 0) return prefix
        }
        return prefix + "'" + rest.split("'").join("'\\''") + "'"
    }


    //
    // v0.1.106: when the user issues a cd via voice/palette/smart-cd,
    // we want to offer a quick undo path (one tap → cd back). Without
    // it, voice misrecognition that lands on a wrong cd is annoying
    // to recover from.
    //
    // Flow:
    //   1. executeIntent fires `cd <path>\r` for term_cmd starting with cd
    //   2. _smartCdUndoTimer.restart() (300ms grace)
    //   3. Timer fires: ask backend for term_previous_cwd
    //   4. If non-empty + different from current, show toast with
    //      Undo button. Tap → cd to previous_cwd
    //   5. Toast auto-dismisses after 6 seconds
    //
    // Timer interval is 300ms because OSC 7 emits AFTER the shell
    // processes the cd (which can take 50-150ms on slow shells like
    // bash with PROMPT_COMMAND chains). 300ms is a comfortable margin.
    Timer {
        id: _smartCdUndoTimer
        interval: 300
        onTriggered: {
            if (!backend || !backend.term_previous_cwd) return
            var prev = backend.term_previous_cwd()
            if (!prev || prev.length === 0) return
            if (typeof undoCdToast !== "undefined") {
                undoCdToast.show(prev)
            }
        }
    }

    // Workflow playback engine (v0.1.115).
    //
    // After voicePopup confirms a "workflow_playback" intent, this
    // timer pulls one command at a time from backend.workflow_next_playback()
    // and feeds it into the PTY. Stops when the backend returns
    // empty (workflow complete).
    //
    // Pacing: 600ms between commands. Conservative — quick commands
    // (ls, pwd) finish in <100ms but compile-style commands take seconds.
    // For now we don't wait-for-prompt; if a slow command is still
    // running when we feed the next one, the shell queues it. That's
    // typically fine: bash reads stdin in order. If the next command
    // depends on the previous one finishing visibly, the user should
    // wait — or future work adds wait-for-prompt detection.
    //
    // If the user wants to abort mid-playback they can:
    //   - voice "cancel" (we'd wire that in a follow-up turn)
    //   - just close the app
    //   - call backend.workflow_cancel_playback() (currently no UI button)
    Timer {
        id: _wfPlaybackTimer
        interval: 600
        repeat: true
        running: false
        onTriggered: {
            if (!backend || !backend.workflow_next_playback) {
                running = false
                return
            }
            var cmd = backend.workflow_next_playback()
            if (!cmd || cmd.length === 0) {
                running = false
                if (typeof toast !== "undefined" && toast.show) {
                    toast.show("Workflow finished")
                }
                return
            }
            // Feed into PTY. Same path as voice-confirmed term_cmd.
            console.log("[workflow] step: " + cmd)
            backend.pty_write(cmd + "\r")
        }
    }

    // ═══ KEYBOARD SHORTCUTS ═══
    Shortcut { sequence: "Ctrl+L"; onActivated: {
        // On terminal tab: pass Ctrl+L (clear screen) through to PTY.
        // On browser tab: jump to URL bar.
        if (tabBar.currentIndex === 1 && backend) {
            backend.pty_write_byte(0x0c)
        } else {
            swipeView.currentIndex=0; tabBar.currentIndex=0
            urlBar.forceActiveFocus(); urlBar.selectAll()
        }
    } }
    // Ctrl+R: in terminal, send 0x12 (DC2 / Ctrl-R) to PTY for shell reverse-
    // history-search. In browser, reload the current page.
    // ApplicationShortcut so a focused child widget can't shadow it — same
    // reason we use ApplicationShortcut for Ctrl-C/D/Z below.
    Shortcut { sequence: "Ctrl+R"; context: Qt.ApplicationShortcut
        onActivated: {
            if (tabBar.currentIndex === 1 && backend) {
                console.log("[shortcut] Ctrl+R -> PTY (reverse history search)")
                backend.pty_write_byte(0x12)
                if (typeof termKeyArea !== "undefined") termKeyArea.forceActiveFocus()
            } else if (backend) {
                loading = true; backend.nav(backend.last_query)
            }
        } }
    // Fallback for Ctrl-R: many desktop environments (KDE Plasma especially)
    // bind Ctrl-R to a system-level action that consumes the event before
    // any application sees it. We confirmed this is happening via diagnostic
    // in v0.1.51 — the user pressed Ctrl-R repeatedly and zero handler logs
    // fired. Ctrl-Shift-R is free on most desktops, so it serves as a
    // keyboard fallback. Tap the C-r touch button or use this combo.
    Shortcut { sequence: "Ctrl+Shift+R"; context: Qt.ApplicationShortcut
        enabled: tabBar.currentIndex === 1
        onActivated: {
            console.log("[shortcut] Ctrl+Shift+R -> PTY (reverse history search, fallback)")
            if (backend) backend.pty_write_byte(0x12)
            if (typeof termKeyArea !== "undefined") termKeyArea.forceActiveFocus()
        } }
    // Ctrl+C / Ctrl+Z / Ctrl+D on the terminal tab need to reach the PTY.
    // We have a Keys.onPressed handler in termKeyArea (a hidden TextInput)
    // that's supposed to catch these, but its activation depends on focus
    // being inside that TextInput, which fails when focus has migrated to
    // the toolbar, voice popup, or any other widget. Application-level
    // Shortcuts with `enabled: tabBar.currentIndex === 1` are reliable and
    // don't conflict with browser-side Ctrl-C-as-copy because they only
    // activate when the terminal tab is selected.
    //
    // context: Qt.ApplicationShortcut so the shortcut works regardless of
    // which child has keyboard focus. Without this, the shortcut may be
    // shadowed by widgets that consume the keystroke first (text inputs,
    // popups). On the terminal tab, that's wrong — we want C-c / C-z / C-d
    // to ALWAYS go to the PTY.
    Shortcut { sequence: "Ctrl+C"; context: Qt.ApplicationShortcut
        enabled: tabBar.currentIndex === 1
        onActivated: {
            console.log("[shortcut] Ctrl+C -> PTY")
            if (backend) backend.pty_write_byte(0x03)
            if (typeof termKeyArea !== "undefined") termKeyArea.forceActiveFocus()
        } }
    Shortcut { sequence: "Ctrl+Z"; context: Qt.ApplicationShortcut
        enabled: tabBar.currentIndex === 1
        onActivated: {
            console.log("[shortcut] Ctrl+Z -> PTY")
            if (backend) backend.pty_write_byte(0x1a)
            if (typeof termKeyArea !== "undefined") termKeyArea.forceActiveFocus()
        } }
    Shortcut { sequence: "Ctrl+D"; context: Qt.ApplicationShortcut
        enabled: tabBar.currentIndex === 1
        onActivated: {
            console.log("[shortcut] Ctrl+D -> PTY")
            if (backend) backend.pty_write_byte(0x04)
            if (typeof termKeyArea !== "undefined") termKeyArea.forceActiveFocus()
        } }
    // Konsole-style copy/paste — Ctrl+C in a terminal is SIGINT, so the
    // copy shortcut needs Shift. Same for paste; bracketed paste handled
    // by pty_paste on the backend side. Only active on the terminal tab —
    // browser tab uses plain Ctrl+C/V via the default text widgets.
    Shortcut { sequence: "Ctrl+Shift+C"; context: Qt.ApplicationShortcut
        enabled: tabBar.currentIndex === 1
        onActivated: {
            // v0.1.103: passthrough behavior. If a selection exists,
            // copy it and toast. If NOT, send the keystroke through to
            // the PTY so TUI apps that bind Ctrl-Shift-C (rare but
            // exists — e.g. some IDEs) can receive it.
            //
            // Ctrl-Shift-C in PTY world is encoded as: ESC [ < (the
            // shift) followed by Ctrl-C... actually no, terminal
            // protocol uses kitty-style modifyOtherKeys for this.
            // Practically simpler: send raw Ctrl-C (0x03). Most users
            // hitting Ctrl-Shift-C with no selection mean to send
            // SIGINT anyway (Shift was held by accident). For TUIs that
            // genuinely want Ctrl-Shift-C, the kitty-encoded version
            // would be `\e[99;6u` — we leave that as a future
            // enhancement.
            var txt = ""
            if (typeof termScreen !== "undefined" && termScreen.selActive
                && backend && backend.term_selection_text)
            {
                txt = backend.term_selection_text(
                    termScreen.selStartRow, termScreen.selStartCol,
                    termScreen.selEndRow, termScreen.selEndCol)
            }
            if (txt && txt.length > 0) {
                console.log("[shortcut] Ctrl+Shift+C -> copy " + txt.length + " chars")
                if (backend && backend.clipboard_set) backend.clipboard_set(txt)
                if (typeof toast !== "undefined" && toast.show) {
                    toast.show("Copied " + txt.length + " chars")
                }
            } else {
                // No selection — passthrough Ctrl-C (SIGINT) to PTY.
                // This is what users expect: they pressed Shift by
                // accident or they explicitly want to interrupt.
                console.log("[shortcut] Ctrl+Shift+C passthrough (no selection)")
                if (backend) backend.pty_write_byte(0x03)
            }
        } }
    Shortcut { sequence: "Ctrl+Shift+V"; context: Qt.ApplicationShortcut
        enabled: tabBar.currentIndex === 1
        onActivated: {
            console.log("[shortcut] Ctrl+Shift+V -> paste from clipboard")
            if (backend) {
                var t = backend.clipboard_get()
                if (t && t.length > 0) backend.pty_paste(t)
            }
            if (typeof termKeyArea !== "undefined") termKeyArea.forceActiveFocus()
        } }
    Shortcut { sequence: "F5"; onActivated: { if(backend){loading=true;backend.nav(backend.last_query)} } }
    Shortcut { sequence: "Ctrl+F"; onActivated: {
        // v0.1.349: terminal-tab Ctrl+F now opens our scrollback
        // search bar by default. Pager/editor TUIs (vim, helix,
        // less, more, view) get the original PTY passthrough so
        // their native find still works — that's the only place
        // where Ctrl+F is meaningfully bound at the program level.
        // Plain shell prompts don't bind Ctrl+F to anything, so
        // sending 0x06 there was wasted; intercepting it for
        // scrollback search is a strict upgrade.
        if (tabBar.currentIndex === 1 && backend) {
            var inAlt = backend.term_in_alt_screen
                ? backend.term_in_alt_screen() : false
            if (inAlt) {
                // Inside alt-screen TUI — forward to PTY so the
                // program's own find works.
                backend.pty_write_byte(0x06)
            } else if (typeof termFindBar !== "undefined") {
                // Plain shell — open our scrollback search.
                termFindBar.openWith("")
            } else {
                // Fallback if termFindBar isn't built (defensive,
                // shouldn't happen in normal builds).
                backend.pty_write_byte(0x06)
            }
        } else {
            findBar.visible=!findBar.visible
            if(findBar.visible) findField.forceActiveFocus()
        }
    } }
    // v0.1.349: F3 / Shift+F3 for next / prev match while the
    // termFindBar is open. Global shortcut so the user doesn't
    // have to keep focus in the field. Only active on terminal tab.
    Shortcut { sequence: "F3"
        enabled: tabBar.currentIndex === 1
        onActivated: {
            if (typeof termFindBar !== "undefined" && termFindBar.visible) {
                termFindBar.step(+1)
            }
        }
    }
    Shortcut { sequence: "Shift+F3"
        enabled: tabBar.currentIndex === 1
        onActivated: {
            if (typeof termFindBar !== "undefined" && termFindBar.visible) {
                termFindBar.step(-1)
            }
        }
    }
    Shortcut { sequence: "Escape"; onActivated: {
        // v0.1.339: fullscreen / large popups close on ESC first.
        // These take priority over find-bar/hint/terminal ESC
        // because when a big modal is occluding the view, the
        // user almost certainly meant to dismiss IT. Check in
        // visual-priority order (most modal → least).
        // v0.1.757: chord overlay (F1 help) closes FIRST — it sits above the
        // graph, so when both are open ESC should dismiss the help, not the
        // graph underneath it.
        if (typeof chordOverlay !== "undefined" && chordOverlay.opened) {
            chordOverlay.close()
            return
        }
        if (typeof cardsCanvas !== "undefined" && cardsCanvas.opened) {
            cardsCanvas._requestClose()
            return
        }
        if (typeof settingsPopup !== "undefined" && settingsPopup.opened) {
            settingsPopup.close()
            return
        }
        if (typeof favoritesPopup !== "undefined" && favoritesPopup.opened) {
            favoritesPopup.close()
            return
        }
        if (typeof filePickerDrawer !== "undefined" && filePickerDrawer.opened) {
            filePickerDrawer.close()
            return
        }
        if (typeof voicePopup !== "undefined" && voicePopup.opened) {
            voicePopup.close()
            return
        }
        // If there's an overlay/find-bar/hint, ESC closes it (existing behavior)
        if (findBar.visible) {
            findBar.visible=false
            return
        }
        // v0.1.349: termFindBar gets a higher ESC priority than
        // selection clear because the bar is a modal-ish surface
        // the user just opened — they almost certainly meant to
        // close THE BAR with this ESC.
        if (tabBar.currentIndex === 1
            && typeof termFindBar !== "undefined"
            && termFindBar.visible)
        {
            termFindBar.closeBar()
            return
        }
        // If there's an active selection on the terminal, ESC clears it
        // before any PTY-side ESC. Lets the user dismiss the selection
        // overlay without losing their place. (The PTY-side ESC is what
        // helix/vim need to exit insert mode, so we don't want to do
        // both — clearing selection takes priority.)
        if (tabBar.currentIndex === 1
            && typeof termScreen !== "undefined"
            && termScreen.selActive)
        {
            termScreen.clearSelection()
            return
        }
        // On terminal tab with no overlay, send ESC to PTY (essential for vim/helix)
        if (tabBar.currentIndex === 1 && backend) {
            backend.pty_write_byte(0x1b)
        }
    } }
    Shortcut { sequence: "Alt+Left"; onActivated: { if(backend) backend.go_back() } }
    Shortcut { sequence: "Alt+Right"; onActivated: { if(backend) backend.go_forward() } }
    Shortcut { sequence: "Ctrl+1"; onActivated: { tabBar.currentIndex=1; swipeView.currentIndex=1 } }
    Shortcut { sequence: "Ctrl+2"; onActivated: { tabBar.currentIndex=1; swipeView.currentIndex=1; _termFocusTimer.restart() } }
    // Ctrl+Tab cycles tabs (replaces what would otherwise be Ctrl+L in terminal-tab use)
    Shortcut { sequence: "Ctrl+Tab"; onActivated: {
        var ni = (tabBar.currentIndex + 1) % 2
        tabBar.currentIndex = ni; swipeView.currentIndex = ni
        if (ni === 1) _termFocusTimer.restart()
    } }
    Shortcut { sequence: "Ctrl+Shift+Tab"; onActivated: {
        var ni = (tabBar.currentIndex + 1) % 2
        tabBar.currentIndex = ni; swipeView.currentIndex = ni
        if (ni === 1) _termFocusTimer.restart()
    } }
    // v0.1.777: Ctrl+Shift+W closes the active PANE in the terminal (was bound
    // to Qt.quit — quit remains on Ctrl+Q). In the browser it closes the active
    // tab. Matches the Ctrl+Shift+* pane-op family.
    Shortcut { sequence: "Ctrl+Shift+W"; onActivated: {
        if (swipeView.currentIndex === 1) {
            // v0.1.881: close a web pane if one's open (web panes are never
            // focused, so the old "close pane" path could only ever close the
            // focused terminal pane). Falls back to the focused pane.
            if (backend && backend.close_web_or_focused_pane) root.termPaneStrip = backend.close_web_or_focused_pane()
            else root._ws("close pane")
        }
        else if (backend && backend.tab_close) backend.tab_close(backend.active_tab_index || 0)
    } }
    // v0.1.643: Ctrl+O opens the file picker to load a file in the web
    // view. The FileDialog (_fileOpenDialog) + its accept→handle_dropped_path
    // path already existed but was never bound to a key (the comment at
    // its definition said "binding TBD"); voice "open file" fired the
    // signal but Ctrl+O did nothing. Browse-tab gated.
    Shortcut {
        sequence: "Ctrl+O"
        enabled: tabBar.currentIndex === 0
        onActivated: _fileOpenDialog.open()
    }
    // v0.1.642: web-tab cycling. `b`=next, `B`=prev. A bare unmodified
    // `b` would clobber typing the letter, so the always-on binding is
    // Alt+b / Alt+B (single step). The true modeless {N}b with a count
    // prefix (2b, 3B) needs a focus-gated digit-accumulating key handler
    // over the browse view — build-gated, see TODO_tab_cycle_shortcut.md.
    // The backend tab_cycle(step, forward) already takes any count, so
    // the count version is a QML-only addition when ready.
    Shortcut {
        sequence: "Alt+b"
        enabled: tabBar.currentIndex === 0
        onActivated: { if (backend && backend.tab_cycle) backend.tab_cycle(1, true) }
    }
    Shortcut {
        sequence: "Alt+Shift+b"
        enabled: tabBar.currentIndex === 0
        onActivated: { if (backend && backend.tab_cycle) backend.tab_cycle(1, false) }
    }
    Shortcut { sequence: "Ctrl+Q"; onActivated: Qt.quit() }
    Shortcut { sequence: "Ctrl+Space"; onActivated: {
        // v0.1.752: toggle — if the voice popup is already open, Ctrl+Space
        // closes/cancels it (user asked for the same key to dismiss). Else
        // start a capture.
        if (voicePopup.visible) {
            if (backend && backend.voice_cancel) backend.voice_cancel()
            voicePopup.close()
        } else if (backend && backend.voice_available && backend.voice_available()) {
            backend.voice_begin_capture(); voicePopup.startListening()
        }
    } }

    // ═══ KEYBINDING ADDITIONS (v0.1.353) ═══
    //
    // Filling Phase 1 gaps named in docs/power-features.md. User
    // earlier called out: "missing keybindings like arrowkeys and
    // the multi-tab and the minimize, maximize, plus others I
    // probably don't know." Arrow keys, multi-tab cycling, and
    // window-control keys (close/quit) were already wired; this
    // section adds the rest of the standard expectations:
    //
    //   Ctrl+= / Ctrl++ : font size up
    //   Ctrl+-          : font size down
    //   Ctrl+0          : font size reset to default (16)
    //   F11             : fullscreen toggle
    //   Ctrl+T          : new browser tab (current URL)
    //   Ctrl+W          : close current browser tab (if >1)
    //   Ctrl+,          : open settings
    //   Ctrl+P          : open browser palette / command picker
    //   ? / F1 / Ctrl+/ : open keybinding overlay (the chord help)
    //
    // The chordRegistry below is the single-source-of-truth list
    // for the overlay. When adding a new Shortcut, also add an
    // entry to chordRegistry so the help screen stays current.
    // (Sync is manual — Qt's Shortcut element doesn't expose a
    // way to enumerate active sequences at runtime.)
    Shortcut { sequence: "Ctrl+="
        onActivated: { if (backend) backend.font_size = Math.min(48, (backend.font_size || 16) + 1) }
    }
    Shortcut { sequence: "Ctrl++"
        onActivated: { if (backend) backend.font_size = Math.min(48, (backend.font_size || 16) + 1) }
    }
    Shortcut { sequence: "Ctrl+-"
        onActivated: { if (backend) backend.font_size = Math.max(8, (backend.font_size || 16) - 1) }
    }
    Shortcut { sequence: "Ctrl+0"
        onActivated: { if (backend) backend.font_size = 16 }
    }
    Shortcut { sequence: "F11"
        onActivated: {
            if (root.visibility === Window.FullScreen) {
                root.visibility = Window.Windowed
            } else {
                root.visibility = Window.FullScreen
            }
        }
    }
    Shortcut { sequence: "Ctrl+T"
        onActivated: {
            // New browser tab — clone current URL or open home.
            // Only meaningful on browser tab; ignored on terminal.
            if (tabBar.currentIndex === 0 && backend && backend.tab_open) {
                var u = backend.last_query || "web2qml://home"
                backend.tab_open(u)
            }
        }
    }
    // v0.1.755: new TERMINAL tab. Ctrl+Shift+T (universal "new tab" chord)
    // opens a terminal-workspace tab and switches to the terminal view. The
    // dogfood gap was "nowhere can I use ... shortcuts to open terminal tabs".
    Shortcut { sequence: "Ctrl+Shift+T"
        onActivated: {
            if (backend && backend.ws_command) {
