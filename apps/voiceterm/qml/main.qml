                                    return  // don't accept; let shortcut fire
                                }
                                // v0.1.782: claim Shift+arrow AND Ctrl+Shift+arrow for
                                // the terminal's own Keys handlers below, so they
                                // dispatch deterministically (Shift→switch tab,
                                // Ctrl+Shift→focus pane) instead of racing the global
                                // Shift+arrow / Ctrl+Shift+arrow shortcuts while this
                                // input is focused. Ctrl+Shift+arrow pane-focus
                                // regressed when Shift+arrow tab-switching landed: the
                                // arrow handler saw Shift set (Ctrl+Shift has Shift)
                                // and switched tabs. Claiming here routes everything
                                // through onLeftPressed/etc., which now checks Ctrl.
                                // (Plain arrows already reach the Keys handlers — no
                                // shortcut matches them — so we needn't claim those.)
                                if ((e.modifiers & Qt.ShiftModifier) &&
                                    (e.key === Qt.Key_Left || e.key === Qt.Key_Right ||
