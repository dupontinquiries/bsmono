                                                id: _collageFlow
                                                width: parent.width
                                                spacing: 4
                                                Repeater {
                                                    model: imgs
                                                    delegate: Image {
                                                        source: modelData
                                                        property int _i: index
                                                        property var _t: _collageItem._tileAt(index)
                                                        height: _t ? _t.h : (imgs.length >= 4 ? 150 : 220)
                                                        width: _t ? _t.w : implicitWidth
                                                        fillMode: Image.PreserveAspectFit
                                                        asynchronous: true
                                                        onStatusChanged: {
                                                            if (status === Image.Ready && sourceSize.height > 0) {
                                                                var a = sourceSize.width / sourceSize.height
                                                                var arr = _collageItem.aspects.slice()
                                                                arr[_i] = a
                                                                _collageItem.aspects = arr
                                                                _collageItem._recompute()
                                                            }
                                                        }
                                                        MouseArea {
                                                            anchors.fill: parent
                                                            onClicked: {
                                                                if (backend && backend.navigate_to)
                                                                    backend.navigate_to(modelData)
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    Component {
                                        id: _textBlock
                                        Text {
                                            width: parent.width
                                            leftPadding: 10
                                            text: noteEditor._renderBlock(blk)
                                            textFormat: Text.RichText
                                            color: th ? th.tc : "#e8e8e8"
                                            font.pixelSize: 14
                                            wrapMode: Text.Wrap
                                            MouseArea {
                                                anchors.fill: parent
                                                onClicked: noteEditor._activateBlock(blkIndex)
                                            }
                                        }
                                    }
                                    Component {
                                        id: _blankBlock
                                        Item {
                                            width: parent.width
                                            height: 26
                                            Row {
                                                anchors.verticalCenter: parent.verticalCenter
                                                x: 10; spacing: 8
                                                Text { text: "\uD83C\uDF99"; font.pixelSize: 15
                                                       opacity: _micMa.containsMouse ? 1.0 : 0.5 }
                                                Text { text: "speak this section"
                                                       color: th ? th.tm : "#888"; font.pixelSize: 12
                                                       opacity: _micMa.containsMouse ? 1.0 : 0.5 }
                                            }
                                            MouseArea {
                                                id: _micMa
                                                anchors.fill: parent
                                                hoverEnabled: true
                                                onClicked: noteEditor._armDictation(blkIndex)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // (feat 3) "+ new section" — append a fresh blank block with its
            // mic armed so you can voice-build the next section.
            Text {
                text: "\uFF0B new section"
                color: _newSecMa.containsMouse ? (th ? th.ac : "#7ddc7d") : (th ? th.tm : "#888")
                font.pixelSize: 13
                leftPadding: 10
                topPadding: 4
                MouseArea {
                    id: _newSecMa
                    anchors.fill: parent
                    anchors.margins: -4
                    hoverEnabled: true
                    onClicked: noteEditor._newSection()
                }
            }
        }

        // (codemap) document outline panel — left-edge list of headings/
        // landmarks; click (or voice "jump to <section>") to leap there.
        Rectangle {
            visible: noteEditor._codemapOpen
            anchors.left: parent.left
            anchors.top: parent.top
            anchors.bottom: parent.bottom
            anchors.topMargin: 52
            anchors.bottomMargin: 12
            width: 210
            color: th ? Qt.rgba(th.sf.r, th.sf.g, th.sf.b, 0.96) : "#23232a"
            border.color: th ? th.bd : "#333"
            border.width: 1
            z: 602
            ListView {
                anchors.fill: parent
                anchors.margins: 6
                clip: true
                model: noteEditor._outline
                delegate: Rectangle {
                    width: ListView.view.width
                    height: 24
                    radius: 4
                    // (live-follow) the section the caret is in gets an accent
                    color: index === noteEditor._activeSection
                             ? (th ? Qt.rgba(th.ac.r, th.ac.g, th.ac.b, 0.20) : "#2a3a2a")
                             : (_omMa.containsMouse ? (th ? th.bb : "#33333d") : "transparent")
                    Rectangle {  // left accent bar on the active section
                        visible: index === noteEditor._activeSection
                        width: 2; height: parent.height
                        color: th ? th.ac : "#7ddc7d"
                    }
                    Text {
                        anchors.verticalCenter: parent.verticalCenter
                        x: 6 + modelData.level * 10   // indent by heading level
                        width: parent.width - x - 4
                        text: (modelData.level === 0 ? "" : "") + modelData.title
                        color: modelData.level === 1 ? (th ? th.tc : "#e8e8e8")
                             : modelData.level === 0 ? (th ? th.tm : "#888")
                             : (th ? th.tc : "#ccc")
                        font.pixelSize: modelData.level === 1 ? 13 : 12
                        font.bold: modelData.level === 1
                        elide: Text.ElideRight
