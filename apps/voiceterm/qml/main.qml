                    }

                    // v0.1.412 (graph view): grab-pan on empty
                    // space. The Flickable (cardsFlick) only pans
                    // when content exceeds the viewport, and its
                    // momentum-flick doesn't feel like directly
                    // dragging the canvas. This background
                    // MouseArea — the FIRST child of graphRoot, so
                    // it sits beneath the edge Canvas and the card
                    // Repeater in z-order — provides a true 1:1
                    // grab-pan: press on empty space and drag to
                    // move the viewport. Cards' own drag MouseAreas
                    // use preventStealing:true and sit ON TOP, so a
                    // press that lands on a card moves the card, not
                    // the canvas — this only fires on genuinely
                    // empty space.
                    //
                    // We adjust cardsFlick.contentX/Y directly by
                    // the drag delta (inverted: dragging right moves
                    // content right = viewport left). Clamped to the
                    // Flickable's content bounds so you can't pan
                    // into the void. Works regardless of whether
                    // content exceeds the viewport.
                    // v0.1.412 (graph view): grab-pan on empty
                    // space. The Flickable (cardsFlick) only pans
                    // when content exceeds the viewport, and its
                    // momentum-flick doesn't feel like directly
                    // dragging the canvas. This DragHandler — on a
                    // background Item that is the FIRST child of
                    // graphRoot (beneath the edge Canvas and card
                    // Repeater in z-order) — provides a true 1:1
                    // grab-pan: press on empty space and drag.
                    //
                    // We use a DragHandler (not a MouseArea) because
                    // it reports `translation` — a cumulative delta
                    // from the grab point measured in a STABLE
                    // frame, immune to the content-moves-under-the-
                    // pointer drift that bites a hand-rolled
                    // MouseArea living inside the scrolled content.
                    // We snapshot the Flickable's contentX/Y at grab
                    // (onActiveChanged) and set them to
                    // start - translation each update — absolute, no
                    // accumulation error.
                    //
                    // Cards' own drag MouseAreas use
                    // preventStealing:true and sit ON TOP (higher
                    // z), so a press landing on a card moves the
                    // card; this handler only engages on genuinely
                    // empty space.
                    Item {
                        id: bgPanLayer
                        anchors.fill: parent
                        z: -1
                        property real _grabContentX: 0
                        property real _grabContentY: 0
                        // v0.1.418: glide state for the grab-pan.
                        // We sample the last contentX/Y + timestamp
                        // on each translation tick to estimate a
                        // release velocity (px/ms), then coast with
                        // friction in _glideTimer. The native
                        // Flickable physics already cover flicks and
                        // two-finger trackpad swipes; this brings the
                        // SAME glide feel to a click-drag on empty
                        // space, which otherwise stopped dead.
                        property real _lastCx: 0
                        property real _lastCy: 0
                        property real _lastT: 0
                        property real _velX: 0
                        property real _velY: 0
                        // Helpers shared by drag + glide so the bounds
                        // math lives in one place.
                        // v0.1.718 FIX: when the content FITS the viewport, the
                        // pan range must collapse to [0,0] (rest at origin), NOT
                        // to [-leftMargin, -leftMargin]. The old form left the
                        // Flickable's natural contentX=0 OUTSIDE the range on a
                        // fitting graph, so every tap triggered an endless
                        // spring-back glide that stole the tap — cards stopped
                        // opening. Leading margins only extend reach when the
                        // content actually overflows that axis.
                        function _overflowX() { return cardsFlick.contentWidth - cardsFlick.width }
                        function _overflowY() { return cardsFlick.contentHeight - cardsFlick.height }
                        function _panMinX() { return _overflowX() > 0 ? -cardsFlick.leftMargin : 0 }
                        function _panMinY() { return _overflowY() > 0 ? -cardsFlick.topMargin : 0 }
                        function _panMaxX() {
                            return _overflowX() > 0
                                ? (_overflowX() + cardsFlick.rightMargin)
                                : 0
                        }
                        function _panMaxY() {
                            return _overflowY() > 0
                                ? (_overflowY() + cardsFlick.bottomMargin)
                                : 0
                        }
                        // v0.1.717: rubber-band overscroll zone — how far past
                        // an edge a drag/glide may travel before springing back.
                        // Makes the canvas feel elastic instead of hard-walled.
                        property real _overscroll: 220
                        // v0.1.717: rubber-band a position past [min,max] — the
                        // overshoot is compressed (diminishing returns) and
                        // capped at _overscroll, so dragging past an edge meets
                        // soft, increasing resistance like a touch canvas.
                        function _rubber(p, min, max, os) {
                            if (p < min) {
                                var over = min - p
                                return min - (over / (1 + over / os)) // asymptotic → os
                            }
                            if (p > max) {
                                var over2 = p - max
                                return max + (over2 / (1 + over2 / os))
                            }
                            return p
                        }
                        Timer {
                            id: _glideTimer
                            interval: 16   // ~60fps coast
                            repeat: true
                            running: false
                            onTriggered: {
                                // Integrate velocity.
                                var nx = cardsFlick.contentX + bgPanLayer._velX * interval
                                var ny = cardsFlick.contentY + bgPanLayer._velY * interval
                                var minX = bgPanLayer._panMinX(), maxX = bgPanLayer._panMaxX()
                                var minY = bgPanLayer._panMinY(), maxY = bgPanLayer._panMaxY()
                                var os = bgPanLayer._overscroll
                                // v0.1.717: allow gliding INTO the overscroll
                                // zone (not a hard wall), but spring back toward
                                // the real edge when out there, and bleed
                                // velocity faster the deeper we are.
                                var cx = Math.max(minX - os, Math.min(maxX + os, nx))
                                var cy = Math.max(minY - os, Math.min(maxY + os, ny))
                                cardsFlick.contentX = cx
                                cardsFlick.contentY = cy
                                // spring-back from overscroll: pull toward edge
                                var pullX = cx < minX ? (minX - cx) : (cx > maxX ? (maxX - cx) : 0)
                                var pullY = cy < minY ? (minY - cy) : (cy > maxY ? (maxY - cy) : 0)
                                if (pullX !== 0) bgPanLayer._velX += pullX * 0.018
                                if (pullY !== 0) bgPanLayer._velY += pullY * 0.018
                                // v0.1.717: gentler friction (0.96 vs 0.92) for a
                                // longer, more natural touch-canvas coast; extra
                                // damping while overscrolled so it settles.
                                var fric = (pullX !== 0 || pullY !== 0) ? 0.82 : 0.96
                                bgPanLayer._velX *= fric
                                bgPanLayer._velY *= fric
                                // settle: stop only when at rest AND inside bounds
                                var inBounds = (cx >= minX && cx <= maxX && cy >= minY && cy <= maxY)
                                if (inBounds && Math.abs(bgPanLayer._velX) < 0.01
                                    && Math.abs(bgPanLayer._velY) < 0.01) {
                                    running = false
                                } else if (!inBounds && Math.abs(bgPanLayer._velX) < 0.004
                                    && Math.abs(bgPanLayer._velY) < 0.004) {
                                    // snap precisely to edge and stop
                                    cardsFlick.contentX = Math.max(minX, Math.min(maxX, cx))
                                    cardsFlick.contentY = Math.max(minY, Math.min(maxY, cy))
                                    running = false
                                }
                            }
                        }
                        DragHandler {
                            id: bgPanDrag
                            target: null  // we don't move an item; we drive the Flickable
                            // v0.1.735 (dogfood: graph card taps dead on touch):
                            // by default this pan handler grabs the touch point
                            // on press and won't relinquish it, so a tap that
                            // lands on a card is consumed here and the card's
                            // MouseArea never sees its release → "nothing
                            // registers." (Works with a mouse because a same-
                            // point press+release never crosses the drag
                            // threshold.) ApprovesTakeOverByItems lets the
                            // card MouseArea steal the grab for a stationary
                            // tap; we still CanTakeOverFromItems so an actual
                            // drag on empty canvas pans. A drag that starts on
                            // a card is the card's (move it); a drag on the
                            // background pans.
                            grabPermissions: PointerHandler.CanTakeOverFromHandlersOfDifferentType
                                | PointerHandler.CanTakeOverFromItems
                                | PointerHandler.ApprovesTakeOverByItems
                                | PointerHandler.ApprovesTakeOverByHandlersOfDifferentType
                            onActiveChanged: {
                                if (active) {
                                    // Grab start: snapshot + stop any
                                    // in-progress glide, reset velocity
                                    // sampling.
                                    _glideTimer.running = false
                                    bgPanLayer._grabContentX = cardsFlick.contentX
                                    bgPanLayer._grabContentY = cardsFlick.contentY
                                    bgPanLayer._lastCx = cardsFlick.contentX
                                    bgPanLayer._lastCy = cardsFlick.contentY
                                    bgPanLayer._lastT = Date.now()
                                    bgPanLayer._velX = 0
                                    bgPanLayer._velY = 0
                                } else {
                                    // Release: start the glide if we have
                                    // meaningful velocity, OR if we're sitting
                                    // in the overscroll zone (v0.1.717 — so the
                                    // canvas springs back instead of staying
                                    // pulled past the edge).
                                    // v0.1.718: if the pointer paused before
                                    // release (last move > 60ms ago), the user
                                    // stopped — drop the stale velocity so a
                                    // hold-then-lift doesn't fling.
                                    if (Date.now() - bgPanLayer._lastT > 60) {
                                        bgPanLayer._velX = 0; bgPanLayer._velY = 0
                                    }
                                    var overX = cardsFlick.contentX < bgPanLayer._panMinX()
                                        || cardsFlick.contentX > bgPanLayer._panMaxX()
                                    var overY = cardsFlick.contentY < bgPanLayer._panMinY()
                                        || cardsFlick.contentY > bgPanLayer._panMaxY()
                                    if (Math.abs(bgPanLayer._velX) > 0.02
                                        || Math.abs(bgPanLayer._velY) > 0.02
                                        || overX || overY) {
                                        _glideTimer.running = true
                                    }
                                }
                            }
                            // v0.1.415: QtQuick 2.15 has `translation`
                            // (cumulative delta from grab), NOT the
                            // Qt6-only `activeTranslation`. Same
                            // semantics for our absolute-from-grab
                            // math, so use translation + its change
                            // signal. (Using activeTranslation broke
                            // QML load entirely on Qt 5.15 — "not
                            // available in QtQuick 2.15".)
                            onTranslationChanged: {
                                if (!active) return
                                var s = graphRoot.scale
                                // v0.1.418: respect the Flickable's
                                // leading/trailing margins so the
                                // pan can reach the same extent as a
                                // flick (bounds helpers on bgPanLayer).
                                var minX = bgPanLayer._panMinX()
                                var minY = bgPanLayer._panMinY()
                                var maxX = bgPanLayer._panMaxX()
                                var maxY = bgPanLayer._panMaxY()
                                var nx = bgPanLayer._grabContentX - translation.x * s
                                var ny = bgPanLayer._grabContentY - translation.y * s
                                // v0.1.717: rubber-band — past an edge, apply
                                // increasing resistance (drag tracks at a
                                // fraction) instead of clamping dead, so the
                                // canvas feels elastic, not walled.
                                var os = bgPanLayer._overscroll
                                var cx = bgPanLayer._rubber(nx, minX, maxX, os)
                                var cy = bgPanLayer._rubber(ny, minY, maxY, os)
                                cardsFlick.contentX = cx
                                cardsFlick.contentY = cy
                                // v0.1.718: velocity estimate (px/ms) for the
                                // release glide — now smoothed + floored + capped
                                // to fix "small swipe → huge leap back". The old
                                // raw (delta/dt) spiked when two move events
                                // fired ~1ms apart (a tiny delta over a tiny dt
                                // = enormous velocity), so a gentle nudge flung
                                // the canvas. Fixes: ignore sub-8ms samples (dt
                                // floor), exponential-smooth so one spiky frame
                                // can't dominate, and hard-cap the magnitude.
                                var now = Date.now()
                                var dt = now - bgPanLayer._lastT
                                if (dt >= 8) {
                                    var instVX = (cx - bgPanLayer._lastCx) / dt
                                    var instVY = (cy - bgPanLayer._lastCy) / dt
                                    // EMA: 0.5 new / 0.5 prior — a ramped, not
                                    // instantaneous, impact velocity.
                                    bgPanLayer._velX = bgPanLayer._velX * 0.5 + instVX * 0.5
                                    bgPanLayer._velY = bgPanLayer._velY * 0.5 + instVY * 0.5
                                    // cap so no single flick exceeds ~2.2 px/ms
                                    // (≈ a brisk but controlled fling).
                                    var cap = 2.2
                                    bgPanLayer._velX = Math.max(-cap, Math.min(cap, bgPanLayer._velX))
                                    bgPanLayer._velY = Math.max(-cap, Math.min(cap, bgPanLayer._velY))
                                    bgPanLayer._lastCx = cx
                                    bgPanLayer._lastCy = cy
                                    bgPanLayer._lastT = now
                                }
                            }
                        }
                    }

                    // Edges below cards.
                    Canvas {
                        id: edgeCanvas
                        anchors.fill: parent
                        renderStrategy: Canvas.Cooperative
                        onPaint: {
                            var ctx = getContext("2d")
                            ctx.clearRect(0, 0, width, height)
                            var dx = -cardsCanvas.graphMinX
                            var dy = -cardsCanvas.graphMinY
                            for (var i = 0; i < cardsCanvas.edgeData.length; i++) {
                                var e = cardsCanvas.edgeData[i]
                                var fi = cardsCanvas.idToIdx[e.from]
                                var ti = cardsCanvas.idToIdx[e.to]
                                if (fi === undefined || ti === undefined) continue
                                var a = cardsCanvas.cardData[fi]
                                var b = cardsCanvas.cardData[ti]
                                var matched = cardsCanvas._isMatched(e.from)
                                    && cardsCanvas._isMatched(e.to)
                                ctx.globalAlpha = matched ? 1.0 : 0.15
                                ctx.strokeStyle = th.bd
                                // v0.1.761: back-edges (feedback loops pointing
                                // against the flow) get a distinct dashed,
                                // accent-tinted stroke so they read as "return"
                                // edges, not mistakes. Reset dash after.
                                if (e.back) {
                                    ctx.strokeStyle = th.ac
                                    ctx.setLineDash([6, 4])
                                } else {
                                    ctx.setLineDash([])
                                }
                                // v0.1.325: weight → line thickness.
                                var w = (e.weight !== undefined) ? e.weight : 1
                                var thick = Math.sqrt(w) * 1.2
                                if (thick < 1) thick = 1
                                if (thick > 5) thick = 5
                                ctx.lineWidth = thick

                                // v0.1.327 (Mermaid+/cards arc 2.7.3):
                                // edge style differentiation for
                                // hardware-diagram readability.
                                //   "a" → solid arrow
                                //   "l" → solid line (no head)
                                //   "t" → thick solid arrow
                                //   "d" → dashed arrow
                                var style = e.style || "a"
                                if (style === "d") {
                                    ctx.setLineDash([6, 4])
                                } else {
                                    ctx.setLineDash([])
                                }
                                if (style === "t") {
                                    // Thick override — bump width
                                    // beyond the sqrt(w) scale so
                                    // `==>` reads as visibly heavier
                                    // than a same-weight `-->`.
                                    ctx.lineWidth = Math.max(thick, 3.5)
                                }

                                // v0.1.327: route line to terminate
                                // at the destination card's edge
                                // rather than centroid, so the
                                // arrowhead sits visually inside
                                // the card's perimeter.
                                //
                                // v0.1.329: apply per-card Z offset
                                // so edges follow the visually-
                                // lifted cards in tilt mode. At
                                // tilt 0, both offsets are 0 →
                                // identical to v0.1.327 behavior.
                                var aZ = cardsCanvas._zOffset(a.kind || "page")
                                var bZ = cardsCanvas._zOffset(b.kind || "page")
                                var ax = a.x + dx
                                var ay = a.y + dy - aZ
                                var bx = b.x + dx
                                var by = b.y + dy - bZ
                                var vdx = bx - ax
                                var vdy = by - ay
                                var len = Math.sqrt(vdx*vdx + vdy*vdy)
                                if (len < 0.5) continue
                                var ux = vdx / len
                                var uy = vdy / len
                                // Pull endpoint back by destination
                                // card's half-extent along the line.
                                // Approximation: use whichever of
                                // half_w / half_h matches the larger
                                // axis of movement.
                                // v0.1.747: larger gap (was +2) so the
                                // arrowhead sits clearly OFF the card edge
                                // instead of crowding it — the "more
                                // aggressive arrow shortening" dogfood ask.
                                var edgeGap = 12
                                var pullB = (Math.abs(ux) > Math.abs(uy)
                                    ? b.hw : b.hh) + edgeGap
                                var pullA = (Math.abs(ux) > Math.abs(uy)
                                    ? a.hw : a.hh) + edgeGap
                                // v0.1.747: don't let the two pulls cross past
                                // each other on short edges (would invert the
                                // arrow). Cap total pull at 85% of the span.
