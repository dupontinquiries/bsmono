        {n:"Mono",bg:"#272822",sf:"#3e3d32",tc:"#f8f8f2",tm:"#75715e",bd:"#49483e",ac:"#66d9ef",lk:"#66d9ef",lh:"#fd971f",ib:"#3e3d32",ig:"#f8f8f2",bb:"#49483e",bf:"#a6e22e",tbg:"#272822",tfg:"#a6e22e"},
        {n:"Rose",bg:"#191724",sf:"#1f1d2e",tc:"#e0def4",tm:"#6e6a86",bd:"#26233a",ac:"#c4a7e7",lk:"#c4a7e7",lh:"#ebbcba",ib:"#26233a",ig:"#e0def4",bb:"#26233a",bf:"#e0def4",tbg:"#191724",tfg:"#9ccfd8"},
        {n:"Gruv",bg:"#282828",sf:"#3c3836",tc:"#ebdbb2",tm:"#928374",bd:"#504945",ac:"#83a598",lk:"#83a598",lh:"#fe8019",ib:"#3c3836",ig:"#ebdbb2",bb:"#504945",bf:"#ebdbb2",tbg:"#282828",tfg:"#b8bb26"},
        {n:"Ocean",bg:"#1b2b34",sf:"#343d46",tc:"#d8dee9",tm:"#65737e",bd:"#4f5b66",ac:"#6699cc",lk:"#6699cc",lh:"#f99157",ib:"#343d46",ig:"#d8dee9",bb:"#4f5b66",bf:"#d8dee9",tbg:"#1b2b34",tfg:"#99c794"},
        // v0.1.239: expanded themes. Tap-and-hold the theme grid
        // expand affordance reveals these 12 additional themes in
        // a 4x3 layout. Three categories per user feedback:
        // "reading, red colors, and light/dark focus."
        //
        // Reading-focus (4): high contrast or warm-paper feel,
