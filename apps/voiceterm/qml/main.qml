        // Original ambiguous utterance, kept so we can switch into
        // fragment-completion mode retroactively if the AI says yes.
        property string _fragmentCheckOriginalText: ""

        // Cancel any active AI fragment check. Idempotent.
        function cancelFragmentCheck() {
            if (_fragmentCheckJobId === 0) return
            console.log("[fragment-ai] cancelling job=" + _fragmentCheckJobId)
            if (backend && backend.async_job_cancel) {
                backend.async_job_cancel(_fragmentCheckJobId)
            }
            _fragmentCheckJobId = 0
            _fragmentCheckOriginalText = ""
            _fragmentCheckTimer.stop()
        }

        // Poll the AI fragment check at 100ms. Stops when result lands
        // or job ID gets cleared (cancellation). Total wait is bounded
        // by the backend's 3s timeout — if the LLM hasn't replied by
        // then, the job returns an error and we just drop it.
        Timer {
            id: _fragmentCheckTimer
            interval: 100
            repeat: true
            running: false
            onTriggered: {
                if (voicePopup._fragmentCheckJobId === 0) {
                    stop()
                    return
                }
                if (!backend || !backend.async_job_poll) {
                    stop()
                    return
                }
                var r = backend.async_job_poll(voicePopup._fragmentCheckJobId)
                if (r === "" || r === undefined || r === null) return
                // Result landed.
                var jobId = voicePopup._fragmentCheckJobId
                var origText = voicePopup._fragmentCheckOriginalText
                voicePopup._fragmentCheckJobId = 0
                voicePopup._fragmentCheckTimer.stop()
                console.log("[fragment-ai] job=" + jobId + " result: " + r)
                // Reply parsing: tinyllama tends to reply "fragment" /
                // "complete" / "fragment." / "Answer: fragment". We
                // accept any reply containing the substring "fragment"
                // (case-insensitive) as a vote for fragment, anything
                // else as complete.
                var lower = (r + "").toLowerCase()
                var saysFragment = lower.indexOf("fragment") >= 0
                if (!saysFragment) {
                    // AI confirms complete — nothing to do, the parallel
                    // parse is already in flight. Just discard.
                    console.log("[fragment-ai] vote=complete, no action")
                    voicePopup._fragmentCheckOriginalText = ""
                    return
                }
                // AI says fragment. But we already started parsing as
                // final. Conditions to retroactively switch:
                //   - User hasn't replied yet (no executed action, no
                //     close, no tap that cancelled auto-listen)
                //   - We don't have a strong-confidence top candidate
                //     already executed
                // The safe check: if popup is still open AND we still
                // have the same recognizedText we sent for AI check,
                // promote to fragment mode.
                if (!voicePopup.opened) {
                    console.log("[fragment-ai] popup closed, dropping vote")
                    voicePopup._fragmentCheckOriginalText = ""
                    return
                }
                if (voicePopup._executed) {
                    console.log("[fragment-ai] intent already executed, dropping vote")
                    voicePopup._fragmentCheckOriginalText = ""
                    return
                }
                console.log("[fragment-ai] vote=fragment, switching to fragment mode")
                // Cancel any in-flight auto-listen so we re-arm cleanly
                // for the continuation utterance.
                voicePopup.cancelConfirmListen()
                voicePopup._pendingFragment = origText.trim().replace(/[.,!?]+$/, "")
                voicePopup.recognizedText = voicePopup._pendingFragment + " ..."
                voicePopup.processing = false
                voicePopup._fragmentCheckOriginalText = ""
                if (backend) backend.play_tone("ok")
                voicePopup.startConfirmListen()
            }
        }

        // Three-state classifier for incomplete utterances:
        //   1  → STRONG fragment, definitely incomplete (e.g. "cd to")
        //   0  → AMBIGUOUS, could be either (e.g. "show all the")
        //  -1  → complete, parse normally
        //
        // Strong cases trigger immediate fragment-completion auto-listen.
        // Ambiguous cases SHOULD eventually consult an AI binary classifier
        // in a background thread (TODO_dynamic_prompts.md), but for now
        // they fall through to normal parsing — better to act on the
        // user's words than to over-eagerly wait for more.
        //
        // Heuristic:
        //   - Ends in a hanging preposition AND ≤ 3 words → strong
        //   - Ends in a preposition with 4-5 words → ambiguous
        //   - Ends in article/determiner with ≤ 5 words → ambiguous
        //   - Anything else → complete
        function classifyFragment(text) {
            var t = (text || "").toLowerCase().trim()
                .replace(/[.,!?]+$/, "")
            if (t.length === 0) return -1
            var words = t.split(/\s+/)
            var n = words.length
            if (n === 0 || n > 5) return -1
            var last = words[n - 1]
            // Strong tails — these almost never end a complete thought.
            var strongTails = ["to", "into", "from", "at", "with", "for",
                "by", "on", "as", "of", "in", "and", "or", "then",
                "is", "was", "will", "do", "does"]
            // Soft tails — could legitimately end an utterance ("show all",
            // "I want this", "it's that") but often don't.
            var softTails = ["the", "a", "an", "my", "this", "that"]
            for (var i = 0; i < strongTails.length; i++) {
                if (last === strongTails[i]) {
                    return n <= 3 ? 1 : 0
                }
            }
            for (var j = 0; j < softTails.length; j++) {
                if (last === softTails[j]) return 0
            }
            return -1
        }

        // Compatibility wrapper for sites still calling isIncompleteFragment.
        function isIncompleteFragment(text) {
            return classifyFragment(text) === 1
        }

        // Begin an auto-listen pass for a yes/no/candidate-name reply.
        // Starts the confirmListenStartTimer which arms after 350ms.
        // No-op if popup isn't open or we're already listening.
        function startConfirmListen() {
            if (!opened) return
            if (_confirmListening) return
            if (!backend) return
            console.log("[voice-confirm] auto-listen starting")
            _confirmListening = true
            confirmListenStartTimer.start()
        }

        // Stop any active confirmation listen. Safe to call when nothing
        // is in flight. Routes voice_cancel to the backend so an in-
        // progress recording is dropped (no transcription, no result).
        //
        // IMPORTANT: this does NOT cancel an in-flight AI fragment
        // check. Previously it did, which meant any incidental tap
        // (selecting a candidate, scrolling, etc.) interrupted the
        // AI request — user feedback: "AI should only be interrupted
        // by 'cancel' and listen word but it gets interrupted by
        // anything." Cancellation now requires explicit close()
        // (which calls cancelFragmentCheck via onClosed) or a
        // cancel-shaped voice utterance.
        function cancelConfirmListen() {
            if (!_confirmListening) return
            console.log("[voice-confirm] auto-listen cancelled by tap")
            _confirmListening = false
            confirmListenStartTimer.stop()
            confirmListenTimer.stop()
            if (backend) backend.voice_cancel()
        }

        // Process the result of a confirmation-listen utterance. Branches:
        //   - empty / very short → user was silent or background noise,
        //     do nothing (popup stays open, candidates remain visible)
        //   - "yes" buzzword → execute the current top candidate
        //   - "no" buzzword → highlight next candidate WITHOUT executing.
        //     If at the end of the list, close the popup. Re-arms a new
        //     confirm-listen so the user can keep saying no.
        //   - phonetic match against any candidate's primary text →
        //     promote that candidate to top, re-arm confirm-listen
        //   - longer utterance with real content → treat as a NEW
        //     command, re-parse via processResult
        function processConfirmResult(text) {
            var trimmed = (text || "").toLowerCase()
                .replace(/[.,!?\s]+$/g, "").replace(/^[.,!?\s]+/, "").trim()
            // Helper: classify utterance's FIRST meaningful token
            // against cancel-shaped words. Same liberalization as the
            // main yes/no/cancel handler below — covers "cancel please",
            // "stop, never mind", "abort everything", etc. Defined once
            // here so all three branches (AI-lock, pending-fragment,
            // main) use the same rule.
            function _isCancelShaped(t) {
                if (!t) return false
                var toks = t.toLowerCase().replace(/[^a-z\s]/g, " ")
                    .split(/\s+/).filter(function(x) { return x.length > 0 })
                if (toks.length === 0) return false
                var first = toks[0]
                if (first === "never" && toks.length > 1 && toks[1] === "mind") return true
                var closeSet = ["cancel", "abort", "quit", "stop",
                    "nevermind", "close", "exit", "dismiss", "forget"]
                return closeSet.indexOf(first) >= 0
            }
            // AI-thinking lock: while a fragment AI check is in flight,
            // we ignore most utterances to prevent the user accidentally
            // confirming/rejecting a candidate state that's about to
            // change retroactively. Only cancel-shaped words pass through
            // (they cancel both the AI and the popup). Everything else
            // is treated as "stay open, keep listening" — same effect as
            // silence, but logs a notice.
            if (_fragmentCheckJobId !== 0) {
                if (_isCancelShaped(trimmed)) {
                    console.log("[ai-lock] cancel during AI think — closing")
                    cancelFragmentCheck()
                    close()
                    return
                }
                if (trimmed.length === 0) return
                console.log("[ai-lock] ignoring '" + trimmed + "' — AI still thinking")
                // Re-arm so the user can speak again once AI finishes.
                startConfirmListen()
                return
            }
            // Pending fragment branch: if the user previously voiced an
            // incomplete fragment ("cd to") and we're waiting for the rest,
            // concatenate this utterance with the fragment and re-process
            // as a single command. Buzzword check is deferred to the
            // re-processed result because saying "yes" while a fragment
