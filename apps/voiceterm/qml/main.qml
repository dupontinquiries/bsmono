                            color: model.isHeader?th.tc:model.kind==="action"?th.lh:model.kind==="link"?th.lk:model.kind==="heading"?Qt.lighter(th.ac,1.2):model.kind==="archive"?Qt.lighter(th.lh,1.3):
                                model.kind==="sitepage"?th.tfg:model.kind==="widget"?Qt.lighter(th.ac,1.4):th.tm
                            font.pixelSize: model.isHeader?13:12; font.family: model.kind==="info"?"monospace":ffam; font.bold: model.isHeader; wrapMode: Text.WordWrap; elide: Text.ElideRight; maximumLineCount: 2 }
                        MouseArea { id: _bma; anchors.fill: parent; hoverEnabled: true; visible: !model.isHeader
