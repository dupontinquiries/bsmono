                            // Key_Return event (Keys.onPressed) AND as a
                            // committed newline in the IME text path
                            // (onTextChanged sees "\n"). On platforms where
                            // both fire for one keypress (observed on the
                            // user's Asahi/Wayland setup — "commands are
                            // appended with a newline"), we'd send CR twice:
                            // the shell executes on the first and the second
                            // produces a blank line. Dedup by timestamp: when
                            // either path sends a CR, stamp _lastEnterMs; the
                            // other path skips a CR that lands within the
                            // window. Cheap and path-agnostic.
                            property double _lastEnterMs: 0
                            function _sendEnterOnce() {
                                var now = Date.now()
                                // 30ms window: the double-fire (key event +
                                // IME commit) for ONE press lands in the same
                                // event-loop turn (<5ms apart), while keyboard
                                // auto-repeat is >=30ms — so held-Enter still
                                // sends one CR per repeat, but a single press
                                // can't produce two.
                                if (now - _lastEnterMs < 30) return false
                                _lastEnterMs = now
                                backend.pty_write_byte(0x0d)
                                return true
                            }
