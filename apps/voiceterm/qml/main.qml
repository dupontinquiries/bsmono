                                    Math.min(anchorY - 12, browseFlick.contentHeight - browseFlick.height))
                                jumped = true
                            }
                        }
                        if (!jumped) {
                            var maxLine = 1
                            var ow = backend.current_doc_outline ? backend.current_doc_outline() : ""
                            ow.split("\n").forEach(function(r){
