import QtQuick 2.15
import QtQuick.Controls 2.15
import QtQuick.Layouts 1.15
import QtQuick.Window 2.15
// v0.1.394 (drag-drop arc): Dialogs for FileDialog and
// the file-drop handling. Qt 6.2+ ships FileDialog under
// QtQuick.Dialogs; the import is version-less for forward
// compat (Qt 6 doesn't require a version number on this
// module).
import QtQuick.Dialogs

ApplicationWindow {
    id: root; visible: true; width: 1024; height: 768; title: backend ? backend.last_query : "Web2QML"
    // v0.1.546: explicit alias to the context `backend` so child
    // components that declare their OWN `backend` property can receive
    // it without the self-reference shadow trap (`backend: backend`
    // inside a child resolves to the child's own null property, not the
    // context one). Children use `backend: root.ctxBackend`.
    property var ctxBackend: backend

    // v0.1.833: voice scroll intents reach the active web pane(s) via this signal
    // (replacing the old browseFlick, removed with the web view in v832). Each
    // visible web pane's Flickable responds. mode: line|page|top|bottom.
    signal scrollWebPanes(real amount, string mode)

    // v0.1.232: compact-layout mode flag. Root source of truth
    // for "we're on a small/portrait/touch surface; switch to
    // mobile-style chrome." Combines width threshold and
    // portrait orientation; ANDs onto an explicit override
    // (settable from QML for testing or user preference).
    //
    // Filed as sub-ship A of the Mobile unified bar arc. Layout
    // changes that depend on this (unified URL+tab bar, popup
    // reflow, bar height transition) hang off this flag.
    //
    // Heuristic rationale:
    //   - Width < 720: definitely too narrow for the dual-bar
    //     desktop layout
    //   - Portrait orientation: even on wider devices like
    //     tablets, portrait is a touch-thumb-reach context
    //   - We deliberately DON'T detect touchscreen via Qt's
    //     input-device APIs. Asahi Fedora may not report touch
    //     consistently, and falling-back to "wider layout" on
    //     a touch device is safer than falling-back to
    //     "compact" on a desktop.
    //
    // The override property is for testing — set
    // `root.compactLayoutOverride = 1` (true) or 0 (false) to
    // force on/off. Default `-1` = auto-detect.
    property int compactLayoutOverride: -1
    readonly property bool compactLayout: {
        if (compactLayoutOverride === 1) return true
        if (compactLayoutOverride === 0) return false
        // Auto-detect: narrow OR portrait
        var narrow = width < 720
        var portrait = height > width
        return narrow || portrait
    }
    Component.onCompleted: {
        // One-shot log at startup so we can see what the
        // detection said. Helps the user (or future-Claude
        // reading a transcript) understand which branch the
        // layout took.
        console.log("[compactLayout] init: w=" + width + " h=" + height
            + " narrow=" + (width < 720) + " portrait=" + (height > width)
            + " → compactLayout=" + compactLayout)
        // v0.1.293 (TAB-1b): restore the active speaker's tabs
        // from disk so they survive restart. No-op when no
        // speaker is active or no tabs were persisted.
        if (backend && backend.workspace_restore_tabs) {
            backend.workspace_restore_tabs()
        }
        // v0.1.813: populate the sidebar tab strip immediately. Previously
        // termPaneStrip stayed "" until the first term_output_changed fired the
        // ws_wire() refresh, so the tab list showed empty on launch (especially
        // when starting away from the terminal page).
        if (backend && backend.ws_wire) {
            root.termPaneStrip = backend.ws_wire()
        }
    }

    // v0.1.459: app foreground/background → backend idle gate.
    // ApplicationWindow.active is false when the window loses focus
    // (app backgrounded, screen off, another app foregrounded). We
    // push that to the backend so idle subsystems back off (the
    // wake-listener slows its poll 4x while backgrounded). Debounced
    // so a brief focus blip (a transient popup, a notification
    // shade) doesn't thrash the cadence — only a state that holds
    // for _bgDebounce.interval actually flips the gate.
    onActiveChanged: {
        if (active) {
            // Foregrounding is urgent (user wants snappy wake) — apply
            // immediately and cancel any pending background flip.
            _bgDebounce.stop()
            if (backend && backend.set_app_backgrounded) {
                backend.set_app_backgrounded(false)
            }
            // v0.1.721: re-entry surfacing. After a REAL absence (≥30s away,
            // not a transient focus blip), offer a "here's where you were"
            // assist bubble (auto-name + last command). The backend scheduler
            // rate-limits it so repeated refocus can't nag.
            if (_bgLeftAt > 0 && (Date.now() - _bgLeftAt) >= 30000
                && backend && backend.session_reentry_assist) {
                backend.session_reentry_assist()
            }
            _bgLeftAt = 0
        } else {
            // Backgrounding can wait out a debounce window.
            if (_bgLeftAt === 0) _bgLeftAt = Date.now()
            _bgDebounce.restart()
        }
    }
    // v0.1.721: when the window last lost focus (0 = currently focused).
    property double _bgLeftAt: 0
    Timer {
        id: _bgDebounce
        interval: 1500
        repeat: false
        onTriggered: {
            // Still inactive after the window? Commit the background gate.
            if (!root.active && backend && backend.set_app_backgrounded) {
                backend.set_app_backgrounded(true)
            }
        }
    }
    onCompactLayoutChanged: {
        console.log("[compactLayout] changed to " + compactLayout
            + " (w=" + width + " h=" + height + ")")
    }

    // v0.1.151: startup probe results surfaced via toast. The Rust
    // main() runs a [clipboard-probe] check before Qt spins up
    // (logs to stderr), and exposes clipboard_available() to QML.
    // Here we read it once on startup and warn the user via toast
    // if no clipboard write tool is on PATH — gives an immediate
    // visible cue rather than waiting for the user to hit a copy
    // button and notice nothing happened.
    //
    // Delayed 1500ms via a Timer so it doesn't fire during the
    // first-paint window when other startup UI may also be
    // animating in (palette opens, theme transitions, etc).
    Timer {
        id: _clipboardProbeTimer
        interval: 1500
        repeat: false
        // Start when backend is first available. The triggered handler
        // guards against null backend too in case the binding re-evaluates
        // weirdly during shutdown.
        running: backend !== null
        property bool _fired: false
        onTriggered: {
            if (_fired) return
            _fired = true
            if (!backend || !backend.clipboard_available) return
            if (!backend.clipboard_available()) {
                if (typeof toast !== "undefined") {
                    toast.show("No clipboard tool — install wl-clipboard / xclip", "warning")
                }
            }
        }
    }

    // ═══ DRAG AND DROP + FILE DIALOG (v0.1.394) ═══
    //
    // Top-level DropArea that covers the whole window. Accepts
    // text/uri-list (the standard MIME type file managers send
    // when dragging files). On drop, the first URL is passed to
    // backend.handle_dropped_path which classifies by extension
    // and either navigates to file:// for renderable files or
    // hands off via xdg-open for others (PDFs, images, etc.).
    //
    // Visual feedback: subtle accent border + tint when a drag
    // is over the window. Auto-clears when the drag leaves or
    // drops.
    //
    // Multi-file drops are NOT handled in v1 — only the first
    // URL gets dispatched. The toast names the file so the user
    // knows what happened.
    DropArea {
        id: _fileDropArea
        anchors.fill: parent
        keys: ["text/uri-list"]
        property bool _dragActive: false
        onEntered: function(drag) {
            if (drag.hasUrls) {
                _dragActive = true
                drag.accepted = true
            }
        }
        onExited: { _dragActive = false }
        onDropped: function(drop) {
            _dragActive = false
            if (!drop.hasUrls || drop.urls.length === 0) return
            // Take the first URL only. Strip file:// scheme;
            // backend handles either form, but path-form
            // produces cleaner logs.
            var url = drop.urls[0].toString()
            var path = url.startsWith("file://") ? url.substring(7) : url
            // URL-decode (Qt sends % escapes for special chars).
            try { path = decodeURIComponent(path) } catch (e) {}
            if (backend && backend.handle_dropped_path) {
                var handled = backend.handle_dropped_path(path)
                if (typeof toast !== "undefined" && toast.show) {
                    var basename = path.substring(path.lastIndexOf("/") + 1)
                    if (handled) {
                        toast.show("Loaded " + basename, "success")
                    } else {
                        toast.show("Opened " + basename + " externally", "info")
                    }
                }
                drop.accept()
            }
        }

        // Visual feedback rectangle. Sits inside DropArea but
        // doesn't intercept clicks (z=10000 puts it above
        // everything; opacity gated by _dragActive).
        Rectangle {
            anchors.fill: parent
            z: 10000
            visible: _fileDropArea._dragActive
            color: "transparent"
            border.color: th ? th.ac : "#3b82f6"
            border.width: 4
            opacity: 0.7
            Text {
                anchors.centerIn: parent
                text: "Drop file to open"
                color: th ? th.ac : "#3b82f6"
                font.pixelSize: 28
                font.bold: true
            }
        }
    }

    // FileDialog opened by voice intent "open file" / chord
    // (binding TBD). On accept, dispatches the picked file via
    // the same backend.handle_dropped_path used by drag-drop.
    FileDialog {
        id: _fileOpenDialog
        title: "Open a file"
        onAccepted: {
            var url = selectedFile.toString()
            var path = url.startsWith("file://") ? url.substring(7) : url
            try { path = decodeURIComponent(path) } catch (e) {}
            if (backend && backend.handle_dropped_path) {
                var handled = backend.handle_dropped_path(path)
                if (typeof toast !== "undefined" && toast.show) {
                    var basename = path.substring(path.lastIndexOf("/") + 1)
                    if (handled) {
                        toast.show("Loaded " + basename, "success")
                    } else {
                        toast.show("Opened " + basename + " externally", "info")
                    }
                }
            }
        }
    }

    // Bridge: backend signal -> open the FileDialog. Keeps the
    // dispatch path uniform: voice intent fires the signal,
    // QML's FileDialog handles UI, on-accept calls back.
    Connections {
        target: backend
        function onOpen_file_dialog_requested() {
            _fileOpenDialog.open()
        }
    }

    // ── v0.1.710: Notes / zettelkasten setup wizard ──
    // A guided multi-step flow that scaffolds a notes workspace, with an
    // optional spoken walk-through. Step machine lives here; the backend
    // owns the scaffold plan, id schemes, and narration script (all tested).
    // RUNTIME-UNTESTED: compile + qml_lint verified; not exercised in a GUI.
    FolderDialog {
        id: _notesFolderDialog
        title: "Choose a folder for your notes"
        onAccepted: {
            var url = selectedFolder.toString()
            var path = url.startsWith("file://") ? url.substring(7) : url
            try { path = decodeURIComponent(path) } catch (e) {}
            notesWizard.cfgRoot = path
        }
    }

    Popup {
        id: notesWizard
        modal: true; dim: true
        closePolicy: Popup.CloseOnEscape
        x: Math.round((root.width - width) / 2)
        y: Math.round((root.height - height) / 2)
        width: Math.min(root.width - 48, 640)
        height: Math.min(root.height - 80, 560)
        background: Rectangle { color: (th ? th.sf : "#1e1e26"); radius: 14
            border.color: (th ? th.bd : "#33333d"); border.width: 1 }

        // ── wizard state (mirror of backend workspace_wizard::Step order) ──
        property int step: 0                 // 0..6 (Welcome..Done)
        readonly property int stepCount: 7
        property string cfgRoot: ""
        property string cfgScheme: "timestamp"   // or "folgezettel"
        property string cfgLayout: "flat"        // or "structured"
        property bool cfgSeedIndex: true
        property bool cfgSeedPrimer: true
        property bool cfgDaily: false
        property bool cfgVoice: true
        property string resultMsg: ""
        property var _script: []             // [[idx,title,say,accepts]]

        function _loadScript() {
            _script = []
            if (!backend || !backend.wizard_voice_script) return
            var wire = backend.wizard_voice_script()
            var lines = wire.split("\n")
            for (var i = 0; i < lines.length; i++) {
                var p = lines[i].split("\t")
                if (p.length >= 4) _script.push(p)
            }
        }
        function narration(i) {
            for (var j = 0; j < _script.length; j++)
                if (parseInt(_script[j][0]) === i) return _script[j][2]
            return ""
        }
        function accepts(i) {
            for (var j = 0; j < _script.length; j++)
                if (parseInt(_script[j][0]) === i) return _script[j][3]
            return ""
        }
        function stepTitle(i) {
            var names = ["Welcome","Where","Note IDs","Layout","Starter notes","Review","Done"]
            return names[Math.max(0, Math.min(names.length - 1, i))]
        }

        function speakStep() {
            // play narration via the guarded speech path (silent until the
            // audio layer is wired). Best-effort; never throws.
            if (!cfgVoice) return
            var line = narration(step)
            if (line.length > 0 && typeof _playSpeechPlan === "function") {
                try { _playSpeechPlan([line]) } catch (e) {}
            }
        }

        function canAdvance() {
            if (step === 1 && cfgRoot.trim().length === 0) return false
            return true
        }
        function goNext() {
            if (step === 5) { doScaffold(); return }   // Review → create
            if (!canAdvance()) {
                if (typeof toast !== "undefined" && toast.show)
                    toast.show("Choose a folder for your notes first.", "info")
                return
            }
            if (step < stepCount - 1) step++
            speakStep()
        }
        function goBack() { if (step > 0) { step--; speakStep() } }

        function doScaffold() {
            if (!backend || !backend.wizard_scaffold) return
            var wire = [cfgRoot, cfgScheme, cfgLayout,
                cfgSeedIndex ? "1" : "0", cfgSeedPrimer ? "1" : "0",
                cfgDaily ? "1" : "0", cfgVoice ? "1" : "0"].join("\t")
            var r = backend.wizard_scaffold(wire)
            var parts = r.split("\t")
            if (parts[0] === "ok") {
                resultMsg = "Created " + parts[1] + " items."
                notesWizard._indexPath = parts.length > 2 ? parts[2] : ""
                step = 6   // Done
                speakStep()
            } else {
                resultMsg = "Error: " + (parts.length > 1 ? parts[1] : "unknown")
                if (typeof toast !== "undefined" && toast.show)
                    toast.show(resultMsg, "error")
            }
        }
        property string _indexPath: ""

        onAboutToShow: {
            step = 0; resultMsg = ""; _indexPath = ""
            _loadScript()
            speakStep()
        }

        // route a recognized walk-through phrase to a wizard action. Called
        // from the voice dispatch when the wizard is visible.
        function handleVoice(phrase) {
            var p = phrase.toLowerCase().trim()
            if (p === "cancel" || p === "close") { notesWizard.close(); return true }
            if (p === "next" || p === "continue") { goNext(); return true }
            if (p === "back" || p === "previous") { goBack(); return true }
            if (p === "create" || p === "build it") { doScaffold(); return true }
            if (p === "choose folder" || p === "pick folder") { _notesFolderDialog.open(); return true }
            if (p === "timestamps" || p === "timestamp") { cfgScheme = "timestamp"; return true }
            if (p === "folgezettel") { cfgScheme = "folgezettel"; return true }
            if (p === "flat") { cfgLayout = "flat"; return true }
            if (p === "structured") { cfgLayout = "structured"; return true }
            if (p === "skip starters") { cfgSeedIndex = false; cfgSeedPrimer = false; return true }
            if (p === "keep starters") { cfgSeedIndex = true; cfgSeedPrimer = true; return true }
            if (p === "add daily template") { cfgDaily = true; return true }
            if (p === "open index" && _indexPath.length > 0) {
                if (backend && backend.handle_dropped_path) backend.handle_dropped_path(_indexPath)
                notesWizard.close(); return true
            }
            if (p === "new note") { notesWizard.close(); return true }
            return false
        }

        contentItem: ColumnLayout {
            spacing: 14
            // header: title + step dots
            RowLayout {
                Layout.fillWidth: true
                Text { text: "Set up your zettelkasten"; color: (th ? th.tc : "#e8e8ee")
                    font.pixelSize: 18; font.bold: true; Layout.fillWidth: true }
                Text { text: notesWizard.stepTitle(notesWizard.step) + "  "
                        + (notesWizard.step + 1) + "/" + notesWizard.stepCount
                    color: (th ? th.tm : "#9a9aa6"); font.pixelSize: 13 }
            }
            Rectangle { Layout.fillWidth: true; height: 1; color: (th ? th.bd : "#33333d") }

            // body — a StackLayout keyed to step
            StackLayout {
                Layout.fillWidth: true; Layout.fillHeight: true
                currentIndex: notesWizard.step

                // 0 Welcome
                ColumnLayout { spacing: 10
                    Text { Layout.fillWidth: true; wrapMode: Text.WordWrap; color: (th ? th.tc : "#e8e8ee")
                        text: "A zettelkasten is a web of small, linked notes. This wizard "
                            + "creates a workspace, picks a note-id style, and (optionally) "
                            + "walks you through it by voice." }
                    CheckBox { text: "Narrate by voice"; checked: notesWizard.cfgVoice
                        onToggled: notesWizard.cfgVoice = checked }
                }
                // 1 Choose location
                ColumnLayout { spacing: 10
                    Text { color: (th ? th.tc : "#e8e8ee"); text: "Where should your notes live?" }
                    RowLayout { Layout.fillWidth: true
                        Text { Layout.fillWidth: true; elide: Text.ElideMiddle
                            color: notesWizard.cfgRoot.length ? (th ? th.tc : "#e8e8ee") : (th ? th.tm : "#9a9aa6")
                            text: notesWizard.cfgRoot.length ? notesWizard.cfgRoot : "(no folder chosen)" }
                        Button { text: "Choose…"; onClicked: _notesFolderDialog.open() }
                    }
                }
                // 2 Id scheme
                ColumnLayout { spacing: 8
                    Text { color: (th ? th.tc : "#e8e8ee"); text: "How should notes be named?" }
                    RadioButton { text: "Timestamps — 202606071430 (unique, no bookkeeping)"
                        checked: notesWizard.cfgScheme === "timestamp"
                        onClicked: notesWizard.cfgScheme = "timestamp" }
                    RadioButton { text: "Folgezettel — 1, 1a, 1a1 (Luhmann branching)"
                        checked: notesWizard.cfgScheme === "folgezettel"
                        onClicked: notesWizard.cfgScheme = "folgezettel" }
                }
                // 3 Layout
                ColumnLayout { spacing: 8
                    Text { color: (th ? th.tc : "#e8e8ee"); text: "Folder layout?" }
                    RadioButton { text: "Flat — one folder, connected by [[links]]"
                        checked: notesWizard.cfgLayout === "flat"
                        onClicked: notesWizard.cfgLayout = "flat" }
                    RadioButton { text: "Structured — inbox / permanent / references / index"
                        checked: notesWizard.cfgLayout === "structured"
                        onClicked: notesWizard.cfgLayout = "structured" }
                }
                // 4 Seed content
                ColumnLayout { spacing: 6
                    Text { color: (th ? th.tc : "#e8e8ee"); text: "Starter notes:" }
                    CheckBox { text: "Index / hub note"; checked: notesWizard.cfgSeedIndex
                        onToggled: notesWizard.cfgSeedIndex = checked }
                    CheckBox { text: "How-to-zettelkasten primer"; checked: notesWizard.cfgSeedPrimer
                        onToggled: notesWizard.cfgSeedPrimer = checked }
                    CheckBox { text: "Daily-note template"; checked: notesWizard.cfgDaily
                        onToggled: notesWizard.cfgDaily = checked }
                }
                // 5 Review
                ColumnLayout { spacing: 6
                    Text { color: (th ? th.tc : "#e8e8ee"); font.bold: true; text: "Review" }
                    Text { color: (th ? th.tm : "#9a9aa6"); wrapMode: Text.WordWrap; Layout.fillWidth: true
                        text: "Folder: " + (notesWizard.cfgRoot || "(none)")
                            + "\nIDs: " + notesWizard.cfgScheme
                            + "\nLayout: " + notesWizard.cfgLayout
                            + "\nStarters: " + (notesWizard.cfgSeedIndex ? "index " : "")
                              + (notesWizard.cfgSeedPrimer ? "primer " : "")
                              + (notesWizard.cfgDaily ? "daily" : "") }
                }
                // 6 Done
                ColumnLayout { spacing: 8
                    Text { color: (th ? th.ac : "#7fd17f"); font.bold: true; font.pixelSize: 16
                        text: "Your zettelkasten is ready." }
                    Text { color: (th ? th.tc : "#e8e8ee"); wrapMode: Text.WordWrap; Layout.fillWidth: true
                        text: notesWizard.resultMsg + " Say \"new note\" to write your first one, "
                            + "or open the index to start linking." }
                }
            }

            // voice hint line
            Text {
                Layout.fillWidth: true; visible: notesWizard.cfgVoice
                color: (th ? th.tm : "#9a9aa6"); font.pixelSize: 12; wrapMode: Text.WordWrap
                text: "🎙 Say: " + notesWizard.accepts(notesWizard.step).split("|").join(" · ")
            }

            // footer buttons
            RowLayout {
                Layout.fillWidth: true
                Button { text: "Cancel"; onClicked: notesWizard.close() }
                Item { Layout.fillWidth: true }
                Button { text: "Back"; enabled: notesWizard.step > 0 && notesWizard.step < 6
                    onClicked: notesWizard.goBack() }
                Button {
                    text: notesWizard.step === 5 ? "Create" : (notesWizard.step === 6 ? "Done" : "Next")
                    highlighted: true
                    onClicked: {
                        if (notesWizard.step === 6) notesWizard.close()
                        else notesWizard.goNext()
                    }
                }
            }
        }
    }

    // Open the wizard from a backend signal (voice intent "set up my notes").
    Connections {
        target: backend
        ignoreUnknownSignals: true
        function onNotes_wizard_requested() { notesWizard.open() }
    }

    // ── v0.1.713: peer handshake panel ──
    // Acoustic dial-up handshake between two developers + a peers browser.
    // Dial plays the identity tones; Listen polls the mic and decodes. On a
    // trusted peer, share/receive a workspace (git-backed, author-stamped).
    // RUNTIME-UNTESTED: compile + qml_lint verified; audio path needs a device.
    FolderDialog {
        id: _shareSrcDialog
        title: "Choose the notes folder to share"
        onAccepted: {
            var u = selectedFolder.toString()
            peerPanel.notesRoot = u.startsWith("file://") ? u.substring(7) : u
        }
    }
    FolderDialog {
        id: _receiveSrcDialog
        title: "Choose the received copy to import"
        onAccepted: {
            var u = selectedFolder.toString()
            peerPanel.receiveSrc = u.startsWith("file://") ? u.substring(7) : u
        }
    }

    Popup {
        id: peerPanel
        modal: true; dim: true
        closePolicy: Popup.CloseOnEscape
        x: Math.round((root.width - width) / 2)
        y: Math.round((root.height - height) / 2)
        width: Math.min(root.width - 48, 640)
        height: Math.min(root.height - 80, 580)
        background: Rectangle { color: (th ? th.sf : "#1e1e26"); radius: 14
            border.color: (th ? th.bd : "#33333d"); border.width: 1 }

        // identity + workspace
        property string myId: "me"
        property string keyFp: ""
        property string notesRoot: ""
        property string workspaceDigest: ""
        property string voiceprintRef: ""
        property string receiveSrc: ""
        property string myVoiceprint: ""   // CSV embedding of my voice
        property string peerVoiceprint: "" // claimed CSV embedding from the peer
        property string verifyMsg: ""
        // handshake state mirror (matches peer_handshake::HsState names)
        property string hsState: "idle"   // idle|dialing|listening|trusted|rejected
        property string peerWire: ""        // decoded peer payload
        property string statusLine: ""

        function parseWire(wire, key) {
            var parts = wire.split(";")
            for (var i = 0; i < parts.length; i++) {
                var kv = parts[i].split("=")
                if (kv[0] === key) return kv[1]
            }
            return ""
        }

        function refreshDigest() {
            if (!backend || !backend.workspace_manifest || notesRoot.length === 0) return
            var r = backend.workspace_manifest(notesRoot, myId)
            var p = r.split("\t")
            if (p[0] === "digest") workspaceDigest = p[1]
            else statusLine = "manifest: " + r
        }

        function dial() {
            if (!backend || !backend.handshake_payload_wire) return
            refreshDigest()
            // voiceprint_ref signals "I will speak to verify" when enrolled.
            var vpRef = myVoiceprint.length > 0 ? ("vp-" + myId) : ""
            var wire = backend.handshake_payload_wire(myId, keyFp, workspaceDigest, vpRef)
            var n = backend.handshake_dial(wire)
            hsState = "dialing"
            statusLine = n >= 0 ? ("dialing… (" + n + " tones)") : "bad payload"
            _dialDoneTimer.restart()
        }

        function enrollVoice() {
            if (!backend || !backend.voiceprint_capture) return
            var wire = backend.voiceprint_capture()
            if (wire && wire.length > 0) {
                myVoiceprint = wire
                verifyMsg = "voiceprint enrolled (" + wire.split(",").length + " dims)"
            } else {
                verifyMsg = "no voice captured — speak, then enroll"
            }
        }

        // Verify a live voice against a claimed embedding wire (the peer speaks).
        // If no wire is passed, falls back to the peer's stored voiceprint.
        function verifyPeerVoice(claimedWire) {
            if (!backend || !backend.handshake_verify_voice) return
            var claimed = claimedWire
            if ((!claimed || claimed.length === 0) && peerWire.length > 0 && backend.peer_load_voiceprint) {
                claimed = backend.peer_load_voiceprint(notesRoot, parseWire(peerWire, "id"))
            }
            if (!claimed || claimed.length === 0) {
                verifyMsg = "no voiceprint on file for this peer — enroll them first"; return
            }
            var r = backend.handshake_verify_voice(claimed, 0.35)
            var p = r.split("\t")
            if (p[0] === "match") {
                verifyMsg = "✓ voice matched (dist " + p[1] + ")"
                if (hsState === "verifying") { hsState = "trusted"; statusLine = "peer verified by voice" }
            } else if (p[0] === "no") {
                verifyMsg = "✗ voice did NOT match (dist " + p[1] + ")"
                if (hsState === "verifying") { hsState = "rejected"; statusLine = "voice mismatch — rejected" }
            } else {
                verifyMsg = "verify error: " + (p[1] || "?")
            }
        }

        // Save the peer's voiceprint after a successful pairing so future
        // handshakes can verify automatically.
        function savePeerVoiceprint(author, vpWire) {
            if (!backend || !backend.peer_save_voiceprint || vpWire.length === 0) return
            var r = backend.peer_save_voiceprint(notesRoot, author, vpWire)
            if (r === "ok") { verifyMsg = "voiceprint saved for " + author; refreshPeers() }
        }

        // v0.1.723: first-pairing capture — record THIS peer speaking now,
        // embed, and store under their dir. The peer holds the mic and speaks
        // the pairing phrase; we capture + save in one tap.
        function capturePeerVoiceprint(author) {
            if (!backend || !backend.voiceprint_capture) {
                verifyMsg = "voice capture unavailable"; return
            }
            var vp = backend.voiceprint_capture()
            if (!vp || vp.length === 0) {
                verifyMsg = "no voice captured — have " + author + " speak, then tap 🎙 again"
                return
            }
            savePeerVoiceprint(author, vp)
        }

        property var peers: []   // [[dir,author,digest,files,shared_at,has_vp]]
        function refreshPeers() {
            if (!backend || !backend.peer_list || notesRoot.length === 0) { peers = []; return }
            var w = backend.peer_list(notesRoot)
            var next = []
            if (w.length > 0) {
                var lines = w.split("\n")
                for (var i = 0; i < lines.length; i++) {
                    var c = lines[i].split("\t")
                    if (c.length >= 6) next.push(c)
                }
            }
            // reassigning the property fires the auto-generated peersChanged,
            // which re-evaluates the ListView model binding. (Mutating in place
            // would NOT notify — and declaring an explicit peersChanged signal
            // collides with the property's own change signal: a fatal QML load
            // error. v0.1.716 fix.)
            peers = next
        }
        Timer { id: _dialDoneTimer; interval: 1500; onTriggered: {
            if (peerPanel.hsState === "dialing") { peerPanel.hsState = "idle"; peerPanel.statusLine = "dial sent" }
        } }

        function startListen() {
            hsState = "listening"; statusLine = "listening for a peer…"; peerWire = ""
            _listenPoll.restart()
        }
        Timer { id: _listenPoll; interval: 400; repeat: true; running: false
            property int ticks: 0
            onTriggered: {
                if (peerPanel.hsState !== "listening") { stop(); ticks = 0; return }
                ticks++
                if (backend && backend.handshake_listen) {
                    var wire = backend.handshake_listen()
                    if (wire && wire.length > 0) {
                        peerPanel.peerWire = wire
                        var vp = peerPanel.parseWire(wire, "vp")
                        if (vp && vp.length > 0) {
                            // peer claims a voiceprint → require the voice step.
                            peerPanel.hsState = "verifying"
                            peerPanel.statusLine = "peer " + peerPanel.parseWire(wire, "id")
                                + " — have them speak, then Verify voice"
                        } else {
                            peerPanel.hsState = "trusted"
                            peerPanel.statusLine = "peer: " + peerPanel.parseWire(wire, "id")
                                + "  (fp " + peerPanel.parseWire(wire, "fp") + ")"
                        }
                        stop(); ticks = 0
                    }
                }
                if (ticks > 60) { // ~24s timeout
                    peerPanel.hsState = "idle"; peerPanel.statusLine = "no peer heard"
                    stop(); ticks = 0
                }
            }
        }

        function doShare() {
            if (!backend || !backend.workspace_share || notesRoot.length === 0) {
                statusLine = "pick a notes folder first"; return
            }
            var now = Math.floor(Date.now() / 1000)
            var dest = notesRoot + "/.web2qml-share"
            var r = backend.workspace_share(notesRoot, myId, dest, now)
            var p = r.split("\t")
            statusLine = p[0] === "ok"
                ? ("shared " + p[2] + " files → " + dest + " (digest " + p[1] + ")")
                : ("share error: " + (p[1] || "?"))
        }
        function doReceive() {
            if (!backend || !backend.workspace_receive || notesRoot.length === 0
                || receiveSrc.length === 0) {
                statusLine = "need notes folder + received copy"; return
            }
            var author = peerWire.length ? parseWire(peerWire, "id") : "peer"
            var label = new Date().toISOString().substring(0, 10)
            var r = backend.workspace_receive(notesRoot, author, receiveSrc, label)
            var p = r.split("\t")
            if (p[0] === "ok") {
                statusLine = "received → " + p[1] + " (" + p[2] + " files)"
                peerPanel._lastPeerRel = p[1]
            } else statusLine = "receive error: " + (p[1] || "?")
        }
        property string _lastPeerRel: ""
        function doDiff() {
            if (!backend || !backend.workspace_diff || _lastPeerRel.length === 0) {
                statusLine = "receive a peer first"; return
            }
            var d = backend.workspace_diff(notesRoot, _lastPeerRel)
            statusLine = d.length ? d : "no changes since received snapshot"
        }

        onAboutToShow: { hsState = "idle"; statusLine = ""; refreshDigest(); refreshPeers() }
        onAboutToHide: { _listenPoll.stop() }

        contentItem: ColumnLayout {
            spacing: 12
            RowLayout { Layout.fillWidth: true
                Text { text: "Peer handshake"; color: (th ? th.tc : "#e8e8ee")
                    font.pixelSize: 18; font.bold: true; Layout.fillWidth: true }
                Rectangle { width: 10; height: 10; radius: 5
                    color: peerPanel.hsState === "trusted" ? (th ? th.ac : "#7fd17f")
                        : peerPanel.hsState === "rejected" ? "#d17f7f"
                        : peerPanel.hsState === "verifying" ? "#d1a87f"
                        : peerPanel.hsState === "listening" ? "#d1c97f" : (th ? th.tm : "#9a9aa6") }
                Text { text: peerPanel.hsState; color: (th ? th.tm : "#9a9aa6"); font.pixelSize: 13 }
            }
            Rectangle { Layout.fillWidth: true; height: 1; color: (th ? th.bd : "#33333d") }

            GridLayout {
                columns: 2; Layout.fillWidth: true; columnSpacing: 10; rowSpacing: 6
                Text { text: "My handle"; color: (th ? th.tm : "#9a9aa6") }
                TextField { Layout.fillWidth: true; text: peerPanel.myId
                    onEditingFinished: peerPanel.myId = text; placeholderText: "you" }
                Text { text: "Notes folder"; color: (th ? th.tm : "#9a9aa6") }
                RowLayout { Layout.fillWidth: true
                    Text { Layout.fillWidth: true; elide: Text.ElideMiddle
                        color: peerPanel.notesRoot.length ? (th ? th.tc : "#e8e8ee") : (th ? th.tm : "#9a9aa6")
                        text: peerPanel.notesRoot.length ? peerPanel.notesRoot : "(none)" }
                    Button { text: "…"; onClicked: _shareSrcDialog.open() }
                }
                Text { text: "Workspace digest"; color: (th ? th.tm : "#9a9aa6") }
                Text { Layout.fillWidth: true; color: (th ? th.tc : "#e8e8ee"); font.family: "monospace"
                    text: peerPanel.workspaceDigest.length ? peerPanel.workspaceDigest : "—" }
            }

            // dial / listen
            RowLayout { Layout.fillWidth: true; spacing: 8
                Button { text: "📡 Dial"; Layout.fillWidth: true; onClicked: peerPanel.dial() }
                Button { text: peerPanel.hsState === "listening" ? "Listening…" : "🎧 Listen"
                    Layout.fillWidth: true; enabled: peerPanel.hsState !== "listening"
                    onClicked: peerPanel.startListen() }
            }
            // voiceprint: enroll mine + verify the peer's spoken voice
            RowLayout { Layout.fillWidth: true; spacing: 8
                Button { text: peerPanel.myVoiceprint.length ? "🎙 Re-enroll voice" : "🎙 Enroll voice"
                    Layout.fillWidth: true; onClicked: peerPanel.enrollVoice() }
                Button { text: "✓ Verify peer voice"; Layout.fillWidth: true
                    enabled: peerPanel.hsState === "verifying"
                    onClicked: peerPanel.verifyPeerVoice(peerPanel.peerVoiceprint) }
            }
            Text { Layout.fillWidth: true; visible: peerPanel.verifyMsg.length > 0
                color: (th ? th.tm : "#9a9aa6"); font.pixelSize: 12; wrapMode: Text.WordWrap
                text: peerPanel.verifyMsg }
            // share / receive / diff
            RowLayout { Layout.fillWidth: true; spacing: 8
                Button { text: "Share"; Layout.fillWidth: true; onClicked: peerPanel.doShare() }
                Button { text: "Receive…"; Layout.fillWidth: true
                    onClicked: { if (peerPanel.receiveSrc.length === 0) _receiveSrcDialog.open()
                                 else peerPanel.doReceive() } }
                Button { text: "Diff"; Layout.fillWidth: true; onClicked: peerPanel.doDiff() }
            }

            // status / output
            Rectangle { Layout.fillWidth: true; Layout.fillHeight: true; radius: 8
                color: (th ? th.bb : "#16161c"); border.color: (th ? th.bd : "#33333d")
                Flickable { anchors.fill: parent; anchors.margins: 8; clip: true
                    contentHeight: _tableStatusText.height
                    Text { id: _tableStatusText; width: parent.width; wrapMode: Text.WrapAnywhere
                        font.family: "monospace"; font.pixelSize: 12
                        color: (th ? th.tc : "#e8e8ee"); text: peerPanel.statusLine }
                }
            }

            // paired peers browser
            Text { Layout.fillWidth: true; text: "Paired peers"; color: (th ? th.tm : "#9a9aa6")
                font.pixelSize: 12; visible: peerPanel.peers.length > 0 }
            ListView {
                Layout.fillWidth: true
                Layout.preferredHeight: Math.min(peerPanel.peers.length * 30, 120)
                visible: peerPanel.peers.length > 0
                clip: true
                model: peerPanel.peers
                delegate: RowLayout {
                    width: ListView.view ? ListView.view.width : 0
                    Text { text: (modelData[5] === "1" ? "🔒 " : "○ ") + modelData[1]
                        color: (th ? th.tc : "#e8e8ee"); Layout.fillWidth: true; font.pixelSize: 13 }
                    Text { text: modelData[3] + " files"; color: (th ? th.tm : "#9a9aa6"); font.pixelSize: 11 }
                    // v0.1.723: first-pairing voiceprint capture — record THIS
                    // peer speaking, embed, and store it under their dir so
                    // future handshakes verify by voice. 🎙 = none on file yet.
                    Button {
                        text: modelData[5] === "1" ? "🎙↻" : "🎙"
                        implicitHeight: 24
                        onClicked: peerPanel.capturePeerVoiceprint(modelData[1])
                    }
                    Button { text: "diff"; implicitHeight: 24
                        onClicked: { peerPanel._lastPeerRel = "peers/" + modelData[0]; peerPanel.doDiff() } }
                }
            }

            RowLayout { Layout.fillWidth: true
                Button { text: "Close"; onClicked: peerPanel.close() }
                Item { Layout.fillWidth: true }
            }
        }
    }

    Connections {
        target: backend
        ignoreUnknownSignals: true
        function onPeer_handshake_requested() { peerPanel.open() }
    }


    // ═══ PROFILING (v0.1.170) ═══
    //
    // When WEB2QML_PROFILE=1 is set in the environment, QML accumulates
    // frame-time and touch-event stats in a 3-second sliding window and
    // emits one JSON summary line to ~/.config/web2qml/profiling.log via
    // backend.prof_log(). Goal: real numbers from the device, instead of
    // guessing what's slow.
    //
    // Off by default. Even the env-check happens once at startup via
    // backend.prof_enabled() — if false, the Timer never starts and
    // onFrameSwapped is a no-op, so zero overhead in production.
    //
    // Format per line (JSON):
    //   {"t":<unix_ms>,"fps_p":[min,p25,p50,p75,max],"dt_p":[...ms],
    //    "frames":<count>,"touches":[<press>,<move>,<release>],
    //    "events":[<labeled markers>],"page":<url>}
    //
    // fps_p comes from 1000/dt for each frame delta. dt_p is the raw
    // millisecond percentile spread — sometimes more informative for
    // spotting individual long frames than the fps stats.
    QtObject {
        id: _prof
        property bool enabled: false
        // Circular buffer of recent frame deltas (ms). Capped at ~250
        // entries (~4s at 60fps) so it never grows unbounded.
        property var _frameDts: []
        property real _lastFrameT: 0
        // Touch counters in current window
        property int _touchPress: 0
        property int _touchMove: 0
        property int _touchRelease: 0
        // Labeled events in current window
        property var _events: []
        // Current page (set by browser on load)
        property string _page: ""

        function _setupOnce() {
            if (!backend) return
            try {
                enabled = backend.prof_enabled()
            } catch (e) {
                enabled = false
            }
            if (enabled) {
                console.log("[profile] enabled (WEB2QML_PROFILE=1) — writing to ~/.config/web2qml/profiling.log")
                _profEmitTimer.start()
            }
        }

        // Called from onFrameSwapped at the root.
        function frame() {
            if (!enabled) return
            var now = Date.now()
            if (_lastFrameT > 0) {
                var dt = now - _lastFrameT
                // Sanity-clamp: a 5000ms "frame" (window minimized,
                // backgrounded, etc) shouldn't poison the stats. Drop
                // anything > 200ms — those are pauses, not frames.
                if (dt < 200) {
                    _frameDts.push(dt)
                    if (_frameDts.length > 250) _frameDts.shift()
                }
            }
            _lastFrameT = now
        }

        function touch(kind) {
            if (!enabled) return
            if (kind === 0) _touchPress++
            else if (kind === 1) _touchMove++
            else if (kind === 2) _touchRelease++
        }

        function event(label) {
            if (!enabled) return
            if (_events.length < 32) _events.push(label)
        }

        function setPage(url) {
            if (!enabled) return
            _page = url || ""
            event("page:" + (url || ""))
        }

        // Compute 5-number summary [min, p25, p50, p75, max].
        function _summary(arr) {
            if (arr.length === 0) return [0, 0, 0, 0, 0]
            var s = arr.slice().sort(function(a, b) { return a - b })
            var n = s.length
            function pct(p) {
                var i = Math.floor((n - 1) * p)
                return s[i]
            }
            return [s[0], pct(0.25), pct(0.5), pct(0.75), s[n - 1]]
        }

        function _flush() {
            if (!enabled || !backend) return
            var dts = _frameDts.slice()
            var dt_p = _summary(dts)
            var fps_p = [0, 0, 0, 0, 0]
            if (dts.length > 0) {
                // fps_p mirrors dt_p but inverted, so min(dt) → max(fps)
                fps_p = [
                    dt_p[4] > 0 ? Math.round(1000 / dt_p[4] * 10) / 10 : 0,
                    dt_p[3] > 0 ? Math.round(1000 / dt_p[3] * 10) / 10 : 0,
                    dt_p[2] > 0 ? Math.round(1000 / dt_p[2] * 10) / 10 : 0,
                    dt_p[1] > 0 ? Math.round(1000 / dt_p[1] * 10) / 10 : 0,
                    dt_p[0] > 0 ? Math.round(1000 / dt_p[0] * 10) / 10 : 0
                ]
            }
            var line = JSON.stringify({
                t: Date.now(),
                fps_p: fps_p,
                dt_p: dt_p,
                frames: dts.length,
                touches: [_touchPress, _touchMove, _touchRelease],
                events: _events,
                page: _page
            })
            backend.prof_log(line) // LINT-OK: guarded by !backend return at function entry
            // Reset window state. Keep _frameDts as-is so the buffer
            // remains a *sliding* window across emit boundaries —
            // smoothing the percentiles. Reset only the counters/events.
            _touchPress = 0
            _touchMove = 0
            _touchRelease = 0
            _events = []
        }
    }
    Timer {
        id: _profEmitTimer; interval: 3000; repeat: true; running: false
        onTriggered: _prof._flush()
    }
    Timer {
        id: _profStartupTimer; interval: 100; repeat: false; running: backend !== null
        onTriggered: _prof._setupOnce()
    }

    // v0.1.896: memory-footprint poll. The backend method no-ops (returns "")
    // unless WEB2QML_MEMLOG is set, so this 15s tick costs a single env check +
    // early return in normal use; when enabled it emits a `[mem] …` line (route
    // to a file with WEB2QML_LOG=mem) for the later optimization pass.
    Timer {
        id: _memFootprintTimer; interval: 15000; repeat: true; running: backend !== null
        onTriggered: { if (backend && backend.mem_footprint_log) backend.mem_footprint_log() }
    }

    // v0.1.383 (session arc, step 3 completion): when the
    // user navigates to web2qml://sessions, a background
    // worker generates the LLM summary asynchronously. This
    // timer fires once ~3.5 seconds after navigation to
    // re-load the page — by then the worker's usually
    // finished and the banner picks up the cached summary.
    // If the worker is still going, the banner stays as
    // the placeholder and the user can manually refresh.
    Timer {
        id: sessionSummaryReloadTimer
        interval: 3500
        repeat: false
        running: false
        onTriggered: {
            if (backend && backend.last_query
                && backend.last_query.toString() === "web2qml://sessions"
                && backend.load_page)
            {
                backend.load_page("web2qml://sessions",
                    backend.recursion_depth)
            }
        }
    }
    // Watch nav changes — when last_query lands on the
    // sessions page (via URL bar, voice, settings link, or
    // session-arc voice intent), kick off the reload timer.
    Connections {
        target: backend
        function onLast_query_changed() {
            if (backend && backend.last_query
                && backend.last_query.toString() === "web2qml://sessions")
            {
                sessionSummaryReloadTimer.start()
            }
        }
    }
    onFrameSwapped: _prof.frame()
    // ═══ END PROFILING ═══

    // ═══ THEME ═══
    property int themeIdx: backend ? backend.theme_idx : 0
    // v0.1.239: when true, the theme picker grid expands to show
    // all 20 themes (8 base + 12 expanded reading/red/focus
    // categories). Default false — keeps the picker compact
    // until the user opts in. Session-only; no persistence yet
    // (the user re-expands per session if they want to see the
    // wider set).
    property bool themePickerExpanded: false

    // v0.1.423: follow-system-theme. When true, _sysThemeWatch
    // polls backend.system_color_scheme() and flips between a
    // dark (idx 0) and light (idx 1) theme when the desktop's
    // preference changes. Session-only opt-in (no persistence
    // yet — re-enable per session). _lastSysScheme tracks the
    // last applied value so we only switch on an actual change,
    // and a user who manually picks a theme while this is on
    // isn't immediately re-overridden (we only act on a CHANGE).
    property bool followSystemTheme: false
    property int _lastSysScheme: -2  // -2 = not yet sampled
    function _applySystemTheme() {
        if (!backend || !backend.system_color_scheme) return
        var cs = backend.system_color_scheme()  // -1 unknown, 0 light, 1 dark
        if (cs < 0) return  // unknown → don't touch the theme
        if (cs === _lastSysScheme) return
        _lastSysScheme = cs
        // Flip to a sensible default theme for the new mode:
        // 0 = Dark (default), 1 = Light. Only change if we're not
        // already on the matching one (avoids redundant writes).
        var target = (cs === 1) ? 0 : 1
        if (themeIdx !== target) {
            themeIdx = target
            if (backend) {
                backend.dark_theme = (cs === 1)
                _rt.restart()
            }
        }
    }
    Timer {
        id: _sysThemeWatch
        interval: 3000  // poll every 3s while enabled
        repeat: true
        running: root.followSystemTheme
        onTriggered: root._applySystemTheme()
    }

    onThemeIdxChanged: {
        // v0.1.113: guard against binding loop. qmetaobject-rs property
        // setters don't suppress same-value writes, so without the
        // !== check we'd write back, fire theme_idx_changed, re-evaluate
        // the binding, fire onThemeIdxChanged again, and so on.
        if (backend && backend.theme_idx !== themeIdx) {
            backend.theme_idx = themeIdx
            backend.save_settings()
        }
    }
    readonly property var themes: [
        {n:"Dark",bg:"#1e1e1e",sf:"#2b2b2b",tc:"#d4d0c8",tm:"#908d85",bd:"#3e3e3e",ac:"#5599dd",lk:"#5599dd",lh:"#e08030",ib:"#363636",ig:"#e0e0e0",bb:"#3a4a60",bf:"#c8dce8",tbg:"#0d0d0d",tfg:"#c8e0a0"},
