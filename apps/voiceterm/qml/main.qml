                ListView { Layout.fillWidth: true; Layout.fillHeight: true; clip: true; model: browserModel; flickDeceleration: 1500; maximumFlickVelocity: 8000; boundsBehavior: Flickable.DragAndOvershootBounds
                    // v0.1.508: scroll perf for the sitemap/browser
