        // user to keep speaking. The next utterance gets concatenated
        // onto this prefix instead of being parsed standalone.
        // Empty string means no fragment in flight.
        property string _pendingFragment: ""

        // AI fragment check: when classifyFragment returns 0 (ambiguous),
