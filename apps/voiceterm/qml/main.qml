                Text { text: "Page Commands"; color: th.tc; font.pixelSize: 17; font.bold: true }
                Rectangle { Layout.fillWidth: true; height: 1; color: th.bd }
                Rectangle { Layout.fillWidth: true; Layout.preferredHeight: 34; radius: 17; color: th.ib
                    RowLayout { anchors.fill: parent; anchors.leftMargin: 10; anchors.rightMargin: 10; spacing: 4
                        TextInput { id: pageSearchField; Layout.fillWidth: true; verticalAlignment: TextInput.AlignVCenter; color: th.tc; font.pixelSize: 12; selectByMouse: true
                            // v0.1.509: debounce the fuzzy filter. Each
                            // keystroke previously ran applyFuzzy(), which
                            // does browserModel.clear() + full re-append
                            // (destroying/recreating every delegate). A
                            // fast typist triggered one full rebuild per
