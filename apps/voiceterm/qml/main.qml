    // v0.1.814: global animation duration. The settings slider sets `animDetent`
    // (integer detents); `globalAnimMs` is the resolved per-animation duration that
    // UI animations bind to. Detent 0 = system default, 1 = instant (0ms), then a
    // 50ms base ramping with compounding +5 increments (55, 65, 80, 100, ...).
    property int animDetent: 6
    property int globalAnimMs: _animMsForDetent(animDetent)
    function _animMsForDetent(n) {
        if (n <= 0) return 150   // "System (KDE)" — placeholder until a backend hook reads kdeglobals
        if (n === 1) return 0    // instant
        // base 50ms + compounding +5 increments: 50 + 5*(1+2+...+(n-2))
        return Math.round(50 + 5 * (n - 2) * (n - 1) / 2)
    }
    // Label for the current detent (shown beside the slider).
    function _animDetentLabel(n) {
        if (n <= 0) return "System"
        if (n === 1) return "0 ms (off)"
        return _animMsForDetent(n) + " ms"
    }
