                                border.width: 1; border.color: th ? th.bd : "#3a3a44"
                                Text { id: _abtnTxt; anchors.centerIn: parent
                                    text: modelData.g + " " + modelData.n
                                    color: _abtnMa.containsMouse ? "#fff" : (th ? th.tc : "#ddd"); font.pixelSize: 11 }
                                MouseArea { id: _abtnMa; anchors.fill: parent; hoverEnabled: true
                                    onClicked: commandPalette._openTarget(_prow.rowIndex, modelData.t) }
                            }
