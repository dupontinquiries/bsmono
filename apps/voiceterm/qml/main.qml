        function rebuildBrowserPalette() { _fullPaletteData = []; browserModel.clear(); if(!backend) return
            browserModel.append({isHeader:true,label:"Actions",text:"",url:"",kind:""})
            browserModel.append({isHeader:false,label:"",text:"Reload page",url:"_reload",kind:"action"})
            browserModel.append({isHeader:false,label:"",text:"Go to homepage",url:"_homepage",kind:"action"})
            browserModel.append({isHeader:false,label:"",text:"Archive this page",url:"_archive",kind:"action"})
            browserModel.append({isHeader:false,label:"",text:"Discover site map",url:"_discover_site",kind:"action"})
            var sm=backend.site_map_current(); if(sm.length>0) { browserModel.append({isHeader:true,label:"Site Map",text:"",url:"",kind:""})
                var sr=sm.split("\n"); for(var i=0;i<Math.min(sr.length,40);i++){if(!sr[i])continue;var s=sr[i].split("\x1F");if(s.length>=4)browserModel.append({isHeader:false,label:"",text:s[1],url:s[2],kind:"sitepage"})}}
            var ar=backend.archive_recent(); if(ar.length>0) { browserModel.append({isHeader:true,label:"Archive",text:"",url:"",kind:""})
                var al=ar.split("\n"); for(var a=0;a<al.length;a++){if(!al[a])continue;var ap=al[a].split("\x1F");if(ap.length>=6)browserModel.append({isHeader:false,label:"",text:ap[1]+" ["+ap[4]+"]",url:ap[2],kind:"archive"})}}
            var pi=backend.page_info(); if(pi.length>0) { browserModel.append({isHeader:true,label:"Page Info",text:"",url:"",kind:""})
                var pl=pi.split("\n"); for(var p=0;p<pl.length;p++) if(pl[p]) browserModel.append({isHeader:false,label:"",text:pl[p],url:"",kind:"info"}) }
            var hs=backend.page_sitemap(); if(hs.length>0) { browserModel.append({isHeader:true,label:"Headings",text:"",url:"",kind:""})
                var hr=hs.split("\n"); for(var h=0;h<hr.length;h++){if(!hr[h])continue;var hp=hr[h].split("\x1F");if(hp.length>=4){browserModel.append({isHeader:false,label:"",text:"  ".repeat(parseInt(hp[1])-1)+hp[2],url:hp[3]?"#"+hp[3]:"",kind:"heading"})}}}
            var lk=backend.page_links(); if(lk.length>0) { browserModel.append({isHeader:true,label:"Links",text:"",url:"",kind:""})
                var lr=lk.split("\n"); for(var l=0;l<Math.min(lr.length,40);l++){if(!lr[l])continue;var lp=lr[l].split("\x1F");if(lp.length>=3)browserModel.append({isHeader:false,label:"",text:lp[1],url:lp[2],kind:"link"})}}
            var wg=backend.detect_widgets(); if(wg.length>0) { browserModel.append({isHeader:true,label:"Interactive",text:"",url:"",kind:""})
                var wr=wg.split("\n"); for(var w=0;w<wr.length;w++){if(!wr[w])continue;var wp=wr[w].split("\x1F")
                    if(wp.length>=4){var wl=""; if(wp[1]==="chat")wl="\uD83D\uDCAC "+wp[2]; else if(wp[1]==="login")wl="\uD83D\uDD12 Login"; else if(wp[1]==="oauth")wl="\uD83D\uDD11 "+wp[2]; else if(wp[1]==="api")wl="\uD83D\uDD27 "+wp[2]
                        browserModel.append({isHeader:false,label:"",text:wl,url:wp.length>=5?wp[4]:wp[3],kind:"widget"})}}}
        }
