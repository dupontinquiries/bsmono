        // v0.1.723: backlinks panel ("what links here") — right edge, lists the
        // notes that link to THIS note (reverse [[ ]] index). Click to open.
        Rectangle {
            visible: noteEditor._backlinksOpen
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.bottom: parent.bottom
            anchors.topMargin: 52
            anchors.bottomMargin: 12
            anchors.rightMargin: 8
            width: 230
            color: th ? Qt.rgba(th.sf.r, th.sf.g, th.sf.b, 0.96) : "#23232a"
            border.color: th ? th.bd : "#333"
            border.width: 1
            radius: 6
            z: 602
            Column {
                anchors.fill: parent
                anchors.margins: 8
                spacing: 6
                Row {
                    width: parent.width
                    Text { text: "\uD83D\uDD17 Links here"; color: th ? th.tc : "#eee"
                        font.pixelSize: 12; font.bold: true
                        width: parent.width - 28 }
                    Text { text: noteEditor._backlinks.length.toString()
                        color: th ? th.ac : "#7ddc7d"; font.pixelSize: 12; font.bold: true }
                }
                Rectangle { width: parent.width; height: 1; color: th ? th.bd : "#333" }
                Text {
                    visible: noteEditor._backlinks.length === 0
                    width: parent.width; wrapMode: Text.WordWrap
                    text: "No other notes link here yet. This note is an orphan — consider linking it from an index."
                    color: th ? th.tm : "#888"; font.pixelSize: 10; font.italic: true
                }
                ListView {
                    width: parent.width
                    height: parent.height - 40
                    clip: true
                    visible: noteEditor._backlinks.length > 0
                    model: noteEditor._backlinks
                    delegate: Rectangle {
                        width: ListView.view.width
                        height: 26
                        radius: 4
                        color: _blMa.containsMouse ? (th ? th.bb : "#33333d") : "transparent"
                        Text {
                            anchors.verticalCenter: parent.verticalCenter
                            x: 6; width: parent.width - 10
                            text: "\u2190 " + modelData.display
                            color: th ? th.tc : "#e8e8e8"
                            font.pixelSize: 12; elide: Text.ElideRight
                        }
                        MouseArea {
                            id: _blMa
                            anchors.fill: parent
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: {
                                // open the linking note in the editor (file://).
                                if (backend && backend.nav) {
                                    noteEditor.close()
                                    backend.link_nav("file://" + modelData.path)
                                }
                            }
                        }
                    }
                }
            }
        }

        // (feat 4) read-only scrub-preview overlay: while hovering a rail
        // tick, show that historical state rendered, dimmed, so you can find
        // the right point before clicking to jump.
        Rectangle {
            visible: noteEditor._previewDoc.length > 0
            anchors.fill: parent
            anchors.topMargin: 52
            anchors.rightMargin: noteEditor._undoRailOpen ? 208 : 8
            anchors.leftMargin: 8
            anchors.bottomMargin: 12
            color: th ? Qt.rgba(th.bg.r, th.bg.g, th.bg.b, 0.97) : "#16161a"
            border.color: th ? th.ac : "#7ddc7d"
            border.width: 1
            z: 603
            Flickable {
                anchors.fill: parent
                anchors.margins: 10
                contentHeight: _notePreviewText.implicitHeight
                clip: true
                Text {
                    id: _notePreviewText
                    width: parent.width
                    text: "<i>preview</i><br>" + noteEditor._previewDoc
                          .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
                          .replace(/\n/g, "<br>")
                    textFormat: Text.RichText
                    color: th ? th.tm : "#aaa"
                    font.family: "monospace"
                    font.pixelSize: 13
                    wrapMode: Text.Wrap
                }
            }
        }

        // (feat 3) visual undo timeline rail — a slim column of ticks on the
        // right edge, newest at the bottom, the current state highlighted,
        // voice (🎤) units marked. Click a tick to jump to that state.
        Rectangle {
            visible: noteEditor._undoRailOpen
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.bottom: parent.bottom
            anchors.topMargin: 52
            anchors.bottomMargin: 12
            width: 200
            color: th ? Qt.rgba(th.sf.r, th.sf.g, th.sf.b, 0.96) : "#23232a"
            border.color: th ? th.bd : "#333"
            border.width: 1
            z: 602
            ListView {
                anchors.fill: parent
                anchors.margins: 6
                clip: true
                model: noteEditor._undoTicks
                delegate: Rectangle {
                    width: ListView.view.width
                    height: 26
                    radius: 4
                    color: modelData.cur ? (th ? Qt.rgba(th.ac.r, th.ac.g, th.ac.b, 0.22) : "#2a3a2a")
                                         : (_tickMa.containsMouse ? (th ? th.bb : "#33333d") : "transparent")
                    Row {
                        anchors.fill: parent
                        anchors.leftMargin: 8
                        spacing: 6
                        Text {
                            anchors.verticalCenter: parent.verticalCenter
                            text: modelData.cur ? "\u25C9" : "\u25CB"  // ◉ / ○
                            color: modelData.cur ? (th ? th.ac : "#7ddc7d") : (th ? th.tm : "#888")
                            font.pixelSize: 11
                        }
                        Text {
                            anchors.verticalCenter: parent.verticalCenter
                            width: parent.width - 30
                            text: modelData.label
                            color: th ? th.tc : "#e8e8e8"
                            font.pixelSize: 11
                            elide: Text.ElideRight
                        }
                    }
                    MouseArea {
                        id: _tickMa
                        anchors.fill: parent
                        hoverEnabled: true
                        onEntered: {
                            // (feat 4) scrub-preview: peek this state read-only
                            if (backend.editor_undo_peek)
                                noteEditor._previewDoc = backend.editor_undo_peek(modelData.idx)
                        }
                        onExited: noteEditor._previewDoc = ""
                        onClicked: {
                            noteEditor._previewDoc = ""
                            if (backend.editor_undo_goto) {
                                noteEditor._applyHistory(backend.editor_undo_goto(modelData.idx))
                            }
                        }
                    }
                }
            }
        }

        // v0.1.721: completion dropdown now tracks the caret (inline), instead
        // of being pinned to the bottom-left. Maps the active TextEdit's
        // cursorRectangle into noteEditor coords and clamps to stay on-screen.
        Rectangle {
            id: _completionPopup
            visible: noteEditor.showCompletions
            width: 320
            height: Math.min(noteEditor.completions.length * 30 + 8, 248)
            // caret position mapped into this Item's coordinates.
            // v0.1.752: guard _activeEdit — it's an id in a sibling scope that
            // isn't always resolvable here (caused a ReferenceError every
            // binding eval). typeof-check keeps the popup positioning safe.
            property var _ae: (typeof _activeEdit !== "undefined") ? _activeEdit : null
            property point _caret: (visible && _ae)
                ? _ae.mapToItem(noteEditor,
                    _ae.cursorRectangle.x,
                    _ae.cursorRectangle.y + _ae.cursorRectangle.height)
                : Qt.point(16, 16)
            // place just below the caret; flip above if it would overflow the
            // bottom; clamp horizontally so it never leaves the editor.
            x: Math.max(8, Math.min(_caret.x, noteEditor.width - width - 8))
            y: (_caret.y + height > noteEditor.height - 8)
               ? Math.max(8, _caret.y - height - (_ae ? _ae.cursorRectangle.height : 0) - 4)
               : _caret.y + 2
            radius: 6
            color: th ? th.sf : "#23232a"
            border.color: th ? th.ac : "#7ddc7d"
            border.width: 1
            z: 601
            ListView {
                id: _completionListView
                anchors.fill: parent
                anchors.margins: 4
                clip: true
                model: noteEditor.completions
                currentIndex: noteEditor._completionIndex
                onCurrentIndexChanged: positionViewAtIndex(currentIndex, ListView.Contain)
                delegate: Rectangle {
                    width: ListView.view.width
                    height: 28
                    // v0.1.721: highlight the keyboard-selected row (or hover).
                    color: (index === noteEditor._completionIndex)
                           ? (th ? th.ac : "#7ddc7d")
                           : (_compMouse.containsMouse ? (th ? th.bb : "#33333d") : "transparent")
                    radius: 4
                    RowLayout {
                        anchors.fill: parent
                        anchors.leftMargin: 8
                        Text {
                            Layout.fillWidth: true
                            text: modelData.text
                            color: (index === noteEditor._completionIndex)
                                   ? (th ? th.bg : "#1a1a1f")
                                   : (th ? th.tc : "#e8e8e8")
                            font.pixelSize: 12; elide: Text.ElideRight
                        }
                        Text {
                            text: modelData.kind === "note" ? "↪ linked"
                                 : modelData.kind === "hist" ? "recent" : ""
                            color: (index === noteEditor._completionIndex)
                                   ? (th ? th.bg : "#1a1a1f")
                                   : (th ? th.tm : "#888")
                            font.pixelSize: 10
                            rightPadding: 8
                        }
                    }
                    MouseArea {
                        id: _compMouse
                        anchors.fill: parent
                        hoverEnabled: true
                        onPositionChanged: noteEditor._completionIndex = index
                        onClicked: {
                            var blk = noteEditor._blocks[noteEditor._activeIdx]
                            var g = blk ? (noteEditor._blockBaseOffset(blk)
                                           + noteEditor._activeLocalCursor)
                                        : noteEditor._activeLocalCursor
                            noteEditor._acceptCompletion(modelData.text, g)
                        }
                    }
                }
            }
        }
    }

    // ═══ CLICK CHOOSER ═══ (v0.1.724)
    //
    // "click X" search-then-act overlay. Replaces the old blind fuzzy click:
    // a confirm chip for one strong match, or a numbered chooser for a few /
    // many. Pick by tap (voice number routing can target the same act()).
    Popup {
        id: clickChooser
        modal: true; dim: true
        closePolicy: Popup.CloseOnEscape | Popup.CloseOnPressOutside
        x: Math.round((root.width - width) / 2)
        y: Math.round(root.height * 0.28)
        width: Math.min(root.width - 60, 440)
        padding: 0
        background: Rectangle { color: th ? th.sf : "#23232a"; radius: 12
            border.color: th ? th.ac : "#7ddc7d"; border.width: 1 }

        property string mode: "choose"   // "confirm" | "choose"
        property string phrase: ""
        property string confirmId: ""
        property string confirmLabel: ""
        property var items: []           // [{id,label}]

        function _act(id) {
            close()
            if (!backend) return
            if (id.indexOf("control:") === 0) {
                // a button/control — fall back to find-on-page for the label.
                var lbl = id.substring(8)
                findBar.visible = true; findField.text = lbl; findField.accepted()
            } else {
                loading = true; backend.last_query = id; backend.nav(id)
            }
        }
        function openConfirm(id, label, score) {
            mode = "confirm"; confirmId = id; confirmLabel = label
            items = []; open()
        }
        function openChoose(p, list) {
            mode = "choose"; phrase = p; items = list
            confirmId = ""; open()
        }

        contentItem: ColumnLayout {
            spacing: 0
            // header
            Text {
                Layout.fillWidth: true; Layout.margins: 14
                wrapMode: Text.WordWrap
                color: th ? th.tc : "#e8e8e8"; font.pixelSize: 14
                text: clickChooser.mode === "confirm"
                    ? ("Click \u201c" + clickChooser.confirmLabel + "\u201d?")
                    : ("Which one? (\u201c" + clickChooser.phrase + "\u201d)")
            }
            Rectangle { Layout.fillWidth: true; height: 1; color: th ? th.bd : "#333" }

            // confirm buttons
            RowLayout {
                visible: clickChooser.mode === "confirm"
                Layout.fillWidth: true; Layout.margins: 12; spacing: 10
                Button { text: "Click it"; Layout.fillWidth: true
                    onClicked: clickChooser._act(clickChooser.confirmId) }
                Button { text: "Cancel"; Layout.fillWidth: true
                    onClicked: clickChooser.close() }
            }

            // numbered chooser
            ListView {
                visible: clickChooser.mode === "choose"
                Layout.fillWidth: true
                Layout.preferredHeight: Math.min(clickChooser.items.length * 38 + 4, 320)
                Layout.margins: 6
                clip: true
                model: clickChooser.items
                delegate: Rectangle {
                    width: ListView.view ? ListView.view.width : 0
                    height: 36; radius: 6
                    color: _ccMa.containsMouse ? (th ? th.bb : "#33333d") : "transparent"
                    RowLayout {
                        anchors.fill: parent; anchors.leftMargin: 10; anchors.rightMargin: 10; spacing: 10
                        Rectangle {
                            width: 22; height: 22; radius: 11
                            color: th ? th.ac : "#7ddc7d"
                            Text { anchors.centerIn: parent; text: (index + 1).toString()
                                color: th ? th.bg : "#1a1a1f"; font.pixelSize: 12; font.bold: true }
                        }
                        Text { Layout.fillWidth: true; text: modelData.label
                            color: th ? th.tc : "#e8e8e8"; font.pixelSize: 13; elide: Text.ElideRight }
                    }
                    MouseArea {
                        id: _ccMa
                        anchors.fill: parent; hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: clickChooser._act(modelData.id)
                    }
                }
            }
        }
    }

    // ═══ LINK RADIAL MENU ═══ (v0.1.278)
    //
    // Right-click or press-and-hold on any link opens this menu
    // near the cursor. Bubbles burst out from the click point in
    // a staggered arc, each offering a distinct action:
    //   - Open: regular navigation (left-click default)
    //   - New tab: opens the link in a real tab in the
    //     BACKGROUND via backend.tab_open_background
    //     (v0.1.407) — the link is queued as a new tab and you
    //     stay on the current page, the expected right-click
    //     behavior. Falls back to foreground tab_open then
    //     in-place nav if those methods are unavailable.
    //   - Copy link: clipboard
    //   - Read here: route through the click-to-read overlay
    //     (was the previous default; now opt-in)
    //   - Preview: TODO — for now an alias for Open
    //
    // The animation: each bubble starts at scale 0 at the anchor
    // point and animates to scale 1 at its arc position, with
    // a 60ms stagger between bubbles. Closing reverses.
    //
    // Background scrim (semi-transparent overlay) catches taps
    // outside any bubble and dismisses the menu.
    Item {
        id: linkRadialMenu
        anchors.fill: parent
        z: 1100
        visible: false
        // Anchor point where the user clicked (window coords).
        property real anchorX: 0
        property real anchorY: 0
        property string targetUrl: ""

        // Open animation timing. Each bubble's delay = index * 50ms.
        property bool _opening: false

        function openAt(x, y, url) {
            anchorX = x
            anchorY = y
            targetUrl = url
            visible = true
            _opening = true
        }
        function dismiss() {
            _opening = false
            // Stagger-out animation; hide after the longest fadeout.
            _closeTimer.restart()
        }
        Timer {
            id: _closeTimer
            interval: 220
            onTriggered: linkRadialMenu.visible = false
        }

        // Scrim — taps dismiss.
        Rectangle {
            anchors.fill: parent
            color: Qt.rgba(0, 0, 0, 0.35)
            opacity: linkRadialMenu._opening ? 1.0 : 0.0
            Behavior on opacity { NumberAnimation { duration: 180; easing.type: Easing.OutQuad } }
            MouseArea {
                anchors.fill: parent
                onClicked: linkRadialMenu.dismiss()
                // Accept right-click too so a second right-click
                // dismisses instead of opening a recursive menu.
                acceptedButtons: Qt.LeftButton | Qt.RightButton
            }
        }

        // Bubble component — reused for each option.
        component RadialBubble: Rectangle {
            id: _bubble
            property string label: ""
            property string icon: ""
            property real targetX: 0  // arc position relative to anchor
            property real targetY: 0
            property int delayMs: 0
            property var onTapped: function() {}

            width: 64; height: 64; radius: 32
            color: th.sf
            border.color: th.ac
            border.width: 1
            // Layered scale animation: scale to 1 with stagger.
            scale: linkRadialMenu._opening ? 1.0 : 0.0
            opacity: linkRadialMenu._opening ? 1.0 : 0.0
            x: linkRadialMenu.anchorX + (linkRadialMenu._opening ? targetX : 0) - width / 2
            y: linkRadialMenu.anchorY + (linkRadialMenu._opening ? targetY : 0) - height / 2
            Behavior on x { NumberAnimation { duration: 220 + _bubble.delayMs
                easing.type: Easing.OutBack; easing.overshoot: 1.4 } }
            Behavior on y { NumberAnimation { duration: 220 + _bubble.delayMs
                easing.type: Easing.OutBack; easing.overshoot: 1.4 } }
            Behavior on scale { NumberAnimation { duration: 180 + _bubble.delayMs
                easing.type: Easing.OutBack; easing.overshoot: 1.2 } }
            Behavior on opacity { NumberAnimation { duration: 160 } }

            Column {
                anchors.centerIn: parent
                spacing: 2
                Text {
                    anchors.horizontalCenter: parent.horizontalCenter
                    text: _bubble.icon
                    color: th.tc
                    font.pixelSize: 20
                    renderType: Text.QtRendering
                }
                Text {
                    anchors.horizontalCenter: parent.horizontalCenter
                    text: _bubble.label
                    color: th.tc
                    font.pixelSize: 10
                }
            }
            MouseArea {
                anchors.fill: parent
                cursorShape: Qt.PointingHandCursor
                onClicked: {
                    _bubble.onTapped()
                    linkRadialMenu.dismiss()
                }
            }
        }

        // The five options. Positions are on an arc above-right
        // of the click — keeps them visible on phones where the
        // click point is often near the bottom of the screen.
        //
        // Arc radius ~90px, spanning roughly -135° to -45° (top
        // half). If the click is near the screen edge, the arc
        // gets mirrored — implemented as a width-aware clamp.
        RadialBubble {
            icon: "\u2192"  // →
            label: "Open"
            targetX: linkRadialMenu._arcX(0)
            targetY: linkRadialMenu._arcY(0)
            delayMs: 0
            onTapped: function() {
                if (backend) backend.link_nav(linkRadialMenu.targetUrl)
            }
        }
        RadialBubble {
            icon: "\uD83D\uDCCB"  // 📋
            label: "Copy"
            targetX: linkRadialMenu._arcX(1)
            targetY: linkRadialMenu._arcY(1)
            delayMs: 50
            onTapped: function() {
                if (backend && backend.clipboard_set) {
                    backend.clipboard_set(linkRadialMenu.targetUrl)
                    if (typeof toast !== "undefined") toast.show("Copied link", "info")
                }
            }
        }
        RadialBubble {
            icon: "\uD83D\uDCD6"  // 📖
            label: "Read"
            targetX: linkRadialMenu._arcX(2)
            targetY: linkRadialMenu._arcY(2)
            delayMs: 100
            onTapped: function() {
                // Routes the link as a "read here" — opens the page
                // and switches to the reading overlay. For now this
                // is the same as Open since the click-to-read
                // routing is on by default after nav; future fork
                // would distinguish "open and start reading
                // immediately" vs "open quietly."
                if (backend) backend.link_nav(linkRadialMenu.targetUrl)
            }
        }
        RadialBubble {
            icon: "\u2197"  // ↗
            label: "New tab"
            targetX: linkRadialMenu._arcX(3)
            targetY: linkRadialMenu._arcY(3)
            delayMs: 150
            onTapped: function() {
                // v0.1.407: tabs exist (since v0.1.284) — open
                // the link in a real new tab in the BACKGROUND
                // (stay on the current page), which is the
                // expected right-click "open in new tab"
                // behavior. Falls back to foreground tab_open,
                // then to in-place nav, if methods are missing.
                if (backend && backend.tab_open_background) {
                    backend.tab_open_background(linkRadialMenu.targetUrl)
                    if (typeof toast !== "undefined" && toast.show) {
                        toast.show("Opened in a new tab", "info")
                    }
                } else if (backend && backend.tab_open) {
                    backend.tab_open(linkRadialMenu.targetUrl)
                } else if (backend) {
                    backend.nav(linkRadialMenu.targetUrl)
                }
            }
        }
        RadialBubble {
            icon: "\u2715"  // ×
            label: "Cancel"
            targetX: 0
            targetY: -110
            delayMs: 200
            onTapped: function() { /* nothing — dismiss handles it */ }
        }

        // Arc-position helpers. 4 main bubbles spaced from -135° to
        // -45° (top-half quadrant). Radius 90 keeps them clear of
        // the typical finger contact area. Cancel bubble at 90° (top
        // dead center) at slightly larger radius.
        function _arcX(idx) {
            var angle = -135 + idx * 30  // -135, -105, -75, -45 degrees
            return 90 * Math.cos(angle * Math.PI / 180)
        }
        function _arcY(idx) {
            var angle = -135 + idx * 30
            return 90 * Math.sin(angle * Math.PI / 180)
        }

        Connections {
            target: backend
            // Triggered by backend.link_menu(url, x, y) when the user
            // taps / right-clicks / presses-and-holds a link.
            // v0.1.538: opens the SlidePopup-style link menu (tap-
            // select) at the tap point — matches the terminal toolbar
            // look, replacing the old radial arc.
            function onLink_menu_requested(url, x, y) {
                linkSlidePopup.targetUrl = url
                linkSlidePopup.show(root.contentItem, x, y, url)
            }
            // v0.1.300: a link with a non-navigable scheme
            // (javascript:, data:) or bare "#" was tapped. Show
            // a brief explanatory toast so the user knows why
            // nothing happened.
            function onUnsupported_link_kind(kind) {
                if (typeof toast === "undefined" || !toast.show) return
                if (kind === "javascript") {
                    toast.show("This link uses JavaScript, which isn't supported here", "warning")
                } else if (kind === "data") {
                    toast.show("Embedded data link not supported", "warning")
                } else if (kind === "empty_fragment") {
                    toast.show("Link goes nowhere (empty target)", "warning")
                } else {
                    toast.show("Link kind not supported: " + kind, "warning")
                }
            }
            // v0.1.330 (cards arc): a ```mermaid``` fenced code
            // block emitted a "View as diagram" link; Backend's
            // nav intercept decoded the source and emitted this
            // signal. Open the cards canvas in mermaid mode.
            //
            // v0.1.342: signal now carries block_id + source_file
            // for per-file pin persistence. Falls back to legacy
            // single-arg behavior when called without them
            // (defensive — shouldn't happen with current Backend).
            function onMermaid_source_clicked(source, block_id, source_file) {
                if (typeof cardsCanvas === "undefined") {
                    if (typeof toast !== "undefined") {
                        toast.show("Cards canvas not available", "warning")
                    }
                    return
                }
                cardsCanvas._mermaidBlockId = block_id || "mermaid_0"
                cardsCanvas._mermaidSourceFile = source_file || ""
                cardsCanvas._sourceMode = "mermaid"  // explicit
                cardsCanvas.openMermaid(source || "")
            }
            // v0.1.343 (niftyplot arc): parallel handler for
            // niftyplot fence blocks. Differs from mermaid only
            // in _sourceMode (drives which backend converter
            // reload() calls).
            function onNiftyplot_source_clicked(source, block_id, source_file) {
                if (typeof cardsCanvas === "undefined") {
                    if (typeof toast !== "undefined") {
                        toast.show("Cards canvas not available", "warning")
                    }
                    return
                }
                cardsCanvas._mermaidBlockId = block_id || "niftyplot_0"
                cardsCanvas._mermaidSourceFile = source_file || ""
                cardsCanvas._sourceMode = "niftyplot"
                cardsCanvas._mermaidSource = source || ""
                cardsCanvas.open()
            }
        }
    }

    // ═══ UNDO-CD TOAST ═══
    //
    // v0.1.106: shown after a `cd` command lands, offers a one-tap undo
    // path (cd back to previous_cwd). _smartCdUndoTimer fires this 300ms
    // after the cd to give the shell time to emit OSC 7 and our backend
    // to update the previous_cwd field.
    //
    // Rendered above the regular toast so it can coexist with other
    // notifications. Auto-dismisses after 6s (longer than the regular
    // toast because the user needs time to read AND decide).
    Rectangle {
        id: undoCdToast
        property string targetPath: ""
        z: 1000
        anchors.bottom: parent.bottom
        anchors.bottomMargin: 84
        anchors.horizontalCenter: parent.horizontalCenter
        width: _undoRow.implicitWidth + 32
        height: 40
        radius: 20
        color: Qt.rgba(0.10, 0.10, 0.10, 0.94)
        border.color: th.ac
        border.width: 1
        opacity: 0
        visible: opacity > 0
        Behavior on opacity { NumberAnimation { duration: 220 } }
        Row {
            id: _undoRow
            anchors.centerIn: parent
            spacing: 12
            Text {
                id: _undoTxt
                anchors.verticalCenter: parent.verticalCenter
                // Display just the basename for compactness — full paths
                // can be long. If basename is empty (root path "/"), show
                // "/" explicitly. Avoid the "split-and-pop returns empty"
                // gotcha by checking length.
                text: {
                    var p = undoCdToast.targetPath
                    if (!p || p === "/") return "cd'd \u2014 back to /"
                    var parts = p.split("/")
                    var base = parts[parts.length - 1] || parts[parts.length - 2] || p
                    return "cd'd \u2014 back to " + base
                }
                color: "#f0f0f0"; font.pixelSize: 12
            }
            Rectangle {
                id: _undoBtn
                width: 64; height: 28; radius: 14
                anchors.verticalCenter: parent.verticalCenter
                color: _undoMa.containsMouse ? Qt.lighter(th.ac, 1.2) : th.ac
                Behavior on color { ColorAnimation { duration: 80 } }
                Text { anchors.centerIn: parent; text: "Undo"
                       color: "#fff"; font.pixelSize: 11; font.bold: true }
                MouseArea {
                    id: _undoMa
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: {
                        if (backend && undoCdToast.targetPath.length > 0) {
                            // Send `cd <path>\r` straight to PTY. The
                            // shell's OSC 7 will fire on success which
                            // updates block_tracker.previous_cwd to the
                            // CURRENT cwd — meaning a second undo from
                            // here would chain backward (toggle behavior).
                            // We don't want chains beyond one level, so
                            // we dismiss the toast immediately on click.
                            // v0.1.217: shellQuote so undo to a path
                            // with spaces (e.g. ~/My Stuff) succeeds.
                            backend.pty_write("cd " + shellQuote(undoCdToast.targetPath) + "\r")
                        }
                        undoCdToast.opacity = 0
                    }
                }
            }
        }
        Timer {
            id: _undoToastTimer
            interval: 6000
            onTriggered: undoCdToast.opacity = 0
        }
        function show(path) {
            // Suppress if path is empty or matches current cwd (no real
            // change to undo) — also if it's the same as last time we
            // showed a toast (avoids double-show on repeated cd to same).
            if (!path || path.length === 0) return
            targetPath = path
            opacity = 1.0
            _undoToastTimer.restart()
        }
    }

    // ═══ CORPUS PROMPT TOAST ═══ (v0.1.186, ship 1b-β.2)
    //
    // The moment classifier decides "is this a good moment to suggest
    // reading aloud for voice calibration?". When it returns "solo",
    // this Rectangle slides up from the bottom with three options:
    //
    //   Yes (accept)           — long cooldown, eventually starts capture
    //   Not now (dismiss)      — ~15min cooldown
    //   Never this session     — silenced for the rest of the process
    //
    // The actual capture flow is ship 2 of the corpus arc; for now
    // "yes" just records acceptance and quiets the prompt down. The
    // toast still serves: confirms the classifier is making good
    // decisions, exercises the suppression state machine, gives the
    // user a real way to tell us "yes/no/never" so we can tune
    // thresholds against real preferences.
    Rectangle {
        id: corpusPrompt
        z: 1100
        anchors.bottom: parent.bottom
        // v0.1.249: lift above bottom chrome (URL+tab bar). Was 84.
        anchors.bottomMargin: 48 + (topBar.visible ? 50 : 0) + 36
        anchors.horizontalCenter: parent.horizontalCenter
        width: _cpRow.implicitWidth + 32
        height: 48
        radius: 24
        color: Qt.rgba(0.10, 0.10, 0.10, 0.96)
        border.color: th.ac
        border.width: 1
        opacity: 0
        visible: opacity > 0
        Behavior on opacity { NumberAnimation { duration: 240 } }

        Row {
            id: _cpRow
            anchors.centerIn: parent
            spacing: 14
            Text {
                anchors.verticalCenter: parent.verticalCenter
                text: "Read this aloud?"
                color: "#f0f0f0"
                font.pixelSize: 13
            }
            // Yes — long cooldown, eventually triggers capture
            Rectangle {
                anchors.verticalCenter: parent.verticalCenter
                width: _cpYes.implicitWidth + 16; height: 28
                radius: 14
                color: th.ac
                Text { id: _cpYes; anchors.centerIn: parent; text: "yes"; color: "#fff"; font.pixelSize: 12; font.bold: true }
                TapHandler {
                    onTapped: {
                        if (backend) backend.prompt_accepted()
                        corpusPrompt.opacity = 0
                        // v0.1.191 (ship 2.2): also enter the
                        // reading-wait state so the user can tap a
                        // paragraph next.
                        readingOverlay.enterWaitingState()
                    }
                }
            }
            // Not now — short cooldown
            Rectangle {
                anchors.verticalCenter: parent.verticalCenter
                width: _cpNot.implicitWidth + 16; height: 28
                radius: 14
                color: Qt.rgba(0.18, 0.18, 0.18, 1.0)
                border.color: th.bd; border.width: 1
                Text { id: _cpNot; anchors.centerIn: parent; text: "not now"; color: "#d0d0d0"; font.pixelSize: 12 }
                TapHandler {
                    onTapped: {
                        if (backend) backend.prompt_dismissed()
                        corpusPrompt.opacity = 0
                    }
                }
            }
            // Never — session-wide silence
            Rectangle {
                anchors.verticalCenter: parent.verticalCenter
                width: _cpNever.implicitWidth + 16; height: 28
                radius: 14
                color: "transparent"
                Text { id: _cpNever; anchors.centerIn: parent; text: "never"; color: "#909090"; font.pixelSize: 12 }
                TapHandler {
                    onTapped: {
                        if (backend) backend.prompt_silenced()
                        corpusPrompt.opacity = 0
                    }
                }
            }
        }
    }

    // ═══ DEEP-NIGHT CHECK-IN ═══ (v0.1.187, ship 1b-β.3)
    //
    // When the classifier returns "checkin" — meaning the user is
    // actually reading at 1-4am — show a small acknowledgment.
    // Not a feature prompt. Not a question that demands a
    // response. Just: "I noticed."
    //
    // Single button. Auto-hides after a while if untapped. Won't
    // fire again this process lifetime once dismissed.
    //
    // Copy: lowercase "why reading at 3am?" — close to what the
    // user originally suggested. The hour is interpolated from
    // the current time so it reads naturally at any DeepNight
    // hour. "just because" as the dismiss-button label — a
    // non-committal acknowledgment, no emotional pressure.
    Rectangle {
        id: deepNightCheckin
        z: 1100
        anchors.bottom: parent.bottom
        // v0.1.249: lift above bottom chrome (URL+tab bar). Was 84.
        anchors.bottomMargin: 48 + (topBar.visible ? 50 : 0) + 36
        anchors.horizontalCenter: parent.horizontalCenter
        width: _dnRow.implicitWidth + 32
        height: 48
        radius: 24
        color: Qt.rgba(0.10, 0.10, 0.10, 0.96)
        // Softer border than corpusPrompt — this isn't a feature,
        // it's a passing note. Theme muted-text color.
        border.color: th.tm
        border.width: 1
        opacity: 0
        visible: opacity > 0
        Behavior on opacity { NumberAnimation { duration: 320 } }

        // Auto-fade after 30s if untapped. Not aggressive about
        // requiring acknowledgment — if the user ignores us, fine.
        Timer {
            id: _dnAutoHide
            interval: 30000
            onTriggered: {
                if (deepNightCheckin.opacity > 0) {
                    if (backend) backend.checkin_dismissed()
                    deepNightCheckin.opacity = 0
                }
            }
        }
        onOpacityChanged: { if (opacity > 0.5) _dnAutoHide.restart() }

        Row {
            id: _dnRow
            anchors.centerIn: parent
            spacing: 14
            Text {
                anchors.verticalCenter: parent.verticalCenter
                // Use the actual current hour so the copy matches
                // reality. "why reading at 3am?" feels more
                // observant than a fixed phrase.
                text: {
                    var d = new Date()
                    var h = d.getHours()
                    var s = (h === 0 ? "12am" :
                             h < 12 ? h + "am" :
                             h === 12 ? "12pm" :
                             (h - 12) + "pm")
                    return "why reading at " + s + "?"
                }
                color: "#d8d8d8"
                font.pixelSize: 13
                font.italic: true
            }
            // Single button. Just-because — non-committal dismiss.
            Rectangle {
                anchors.verticalCenter: parent.verticalCenter
                width: _dnAck.implicitWidth + 16; height: 28
                radius: 14
                color: "transparent"
                border.color: th.bd; border.width: 1
                Text { id: _dnAck; anchors.centerIn: parent; text: "just because"; color: "#b0b0b0"; font.pixelSize: 12 }
                TapHandler {
                    onTapped: {
                        if (backend) backend.checkin_dismissed()
                        deepNightCheckin.opacity = 0
                    }
                }
            }
        }
    }

