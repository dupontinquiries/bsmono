        }

        function startListening(opts) {
            // If auto-listen is in progress (user re-pressed voice while
            // we were waiting for confirmation), cancel it cleanly first
            // so we don't have two recordings competing for the mic.
            cancelConfirmListen()
            // Drop any pending fragment — manual restart implies the
            // user wants to start over, not continue.
            _pendingFragment = ""
            // CRITICAL: reset the wake-registration flag UNLESS the
            // caller explicitly passed { wakeRegistration: true }.
            //
            // v0.1.91 bug observed in user logs: every random utterance
            // got registered as a new wake word ("sample", "yo mac",
            // "your laptop", "test"). Root cause: openedForWakeRegistration
            // was set true by Settings → Wake button, but never cleared
            // when the popup opened for a NORMAL voice command. So the
            // flag stuck across sessions of voicePopup.
