                        //   - Enter / F3 → next match (newer)
                        //   - Shift+Enter / Shift+F3 → prev match (older)
                        //   - Escape → close, return focus to terminal
                        //
                        // The actual match list lives on termScreen
                        // (termScreen.searchMatches / .currentMatchIndex)
                        // because the highlight rendering needs to live
                        // inside termScreen's coordinate space. This bar
                        // is just the input + nav controls.
                        Rectangle {
                            id: termFindBar
                            Layout.fillWidth: true
                            Layout.preferredHeight: visible ? 36 : 0
                            visible: false
                            color: th.sf
                            clip: true
                            Behavior on Layout.preferredHeight {
                                NumberAnimation { duration: 100 }
                            }

                            // v0.1.355: case-sensitivity toggle. Default
                            // false (case-insensitive) — most searches
                            // are casual lookups where case shouldn't
                            // matter. Power users flip the Aa button to
                            // do exact-case work (grep -i vs grep flow).
                            property bool caseSensitive: false

                            // v0.1.361: search mode. "scrollback" =
                            // search terminal output (the default,
                            // existing behavior). "files" = ripgrep the
                            // terminal's cwd. The mode toggle is the
                            // button labeled with the current target —
                            // tap to flip. Results render differently:
                            // scrollback highlights inline; files
                            // surfaces a list below the bar.
                            property string mode: "scrollback"

                            // v0.1.361: filesystem-find result model.
                            // Each entry { path, line, matched }. Selected
                            // index navigates with Up/Down. Enter on a
                            // selected match types its path into the PTY
                            // so the user can run their editor on it.
                            property var fsResults: []
                            property int fsSelectedIndex: -1
                            property bool fsRunning: false

                            // v0.1.355: search history. Recent queries
                            // recalled via Up/Down arrows in the field,
                            // like shell history. In-memory only —
                            // resets on app restart. Capped at 20 to
                            // avoid unbounded growth in long sessions.
                            // historyIndex of -1 means "not navigating
                            // history" (user is typing fresh).
                            property var searchHistory: []
                            property int historyIndex: -1
                            // Text typed by the user before they pressed
                            // Up to walk into history. Restored when
                            // they walk back past the newest entry.
                            property string preHistoryText: ""
                            // v0.1.355: guard flag — walkHistory sets
                            // this true before changing termFindField.text,
                            // so onTextChanged knows to skip its
                            // historyIndex-reset (the text change came
                            // from walking, not user typing).
                            property bool _suppressHistoryReset: false

                            function pushHistory(q) {
                                if (!q || q.length === 0) return
                                // Don't push duplicates of the most
                                // recent entry. If the user repeats a
                                // search, history shouldn't show two
                                // identical-adjacent rows.
                                var h = searchHistory.slice()
                                if (h.length > 0 && h[h.length - 1] === q) return
                                h.push(q)
                                while (h.length > 20) h.shift()
                                searchHistory = h
                            }

                            // Open with optional pre-filled query. If
                            // already open, just focus the field.
                            function openWith(initial) {
                                visible = true
                                if (initial && initial.length > 0) {
                                    termFindField.text = initial
                                    runSearch()
                                }
                                termFindField.forceActiveFocus()
                                termFindField.selectAll()
                            }

                            function closeBar() {
                                visible = false
                                // v0.1.355: push final query into history
