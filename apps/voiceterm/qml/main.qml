                                // Shift. Ctrl+Shift+<letter> is always an app chord
                                // (close pane, new tab, organizer, copy/paste), and
                                // a terminal can't encode a distinct byte for it
                                // anyway (Ctrl+W and Ctrl+Shift+W both make 0x17), so
                                // we must let those fall through to the application
                                // Shortcut. v0.1.778: this is why Ctrl+Shift+W
                                // (close pane) silently did nothing — the unshifted
                                // branch below was swallowing it.
                                if ((e.modifiers & Qt.ControlModifier) &&
                                    !(e.modifiers & Qt.ShiftModifier) &&
                                    e.key >= Qt.Key_A && e.key <= Qt.Key_Z) {
                                    console.log("[shortcutOverride] accepting Ctrl+key=" + e.key)
                                    e.accepted = true
