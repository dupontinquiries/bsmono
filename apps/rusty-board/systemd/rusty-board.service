[Unit]
Description=RustyBoard on-screen keyboard
Documentation=https://github.com/example/rusty-board
After=graphical-session.target
PartOf=graphical-session.target

# Skip, rather than crash-loop, when the user manager has no display to give
# it: started without WAYLAND_DISPLAY (or DISPLAY) the keyboard exits at once,
# Restart= retries it every 2 s, and the unit ends up "failed" with a reason
# that never names the missing variable. The session is what supplies it --
# tideshell imports WAYLAND_DISPLAY into the user manager at startup.
ConditionEnvironment=|WAYLAND_DISPLAY
ConditionEnvironment=|DISPLAY

[Service]
Type=simple
ExecStart=@BIN_DIR@/rusty-board
Restart=on-failure
RestartSec=2

# Limit resources — keyboard shouldn't dominate the system.
MemoryHigh=512M
MemoryMax=1G
CPUWeight=80

# Standard hardening for a user service that needs audio + display.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# systemd CREATES this one before the unit starts, so a fresh install does not
# depend on the installer having made it.
ConfigurationDirectory=rusty-board

# The leading `-` makes a missing path non-fatal.
#
# Without it, systemd refuses to set up the mount namespace when a listed
# directory does not exist, and the unit dies before ExecStart with
# "Failed to set up mount namespacing" — which names the DIRECTORY, not the
# real problem, so it reads like a permissions fault on a path the user can
# see is fine. That is the reported redeploy failure: neither install.sh nor
# redeploy.sh created ~/.config/rusty-board or ~/.local/share/rusty-board, and
# the unit demanded both.
#
# `-` and the installer's mkdir are BOTH here on purpose. The mkdir makes the
# normal path work; the `-` means a user who deletes the directory, or installs
# by some route these scripts do not cover, gets a keyboard that starts rather
# than a namespace error.
# %t is $XDG_RUNTIME_DIR: the control socket (rusty-board.ctl) lives there, and under
# ProtectSystem=strict it cannot be bound without this ("Read-only file system"), which
# silently cut the shell, the companion app and the strip off from the keyboard.
ReadWritePaths=-%h/.config/rusty-board -%h/.local/share/rusty-board %t

[Install]
WantedBy=graphical-session.target
