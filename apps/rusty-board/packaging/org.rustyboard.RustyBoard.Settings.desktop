[Desktop Entry]
Type=Application
Name=Keyboard Settings
GenericName=On-Screen Keyboard Settings
Comment=Rusty Board settings and custom layouts
Exec=rusty-board-settings
Icon=org.rustyboard.RustyBoard
Terminal=false
