      <li>A minimized tray whose spacebar carries tap, double-tap and swipe gestures</li>
      <li>Dictation with a filter strength taken from your accessibility preferences</li>
    </ul>
  </description>
  <launchable type="desktop-id">org.rustyboard.RustyBoard.desktop</launchable>
  <releases>
    <release version="0.1.0" date="2026-08-02"/>
