  <name>Rusty Board</name>
  <summary>Swipe-typing on-screen keyboard</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>Rusty Board is an on-screen keyboard with swipe typing, dictation and a one-handed minimized tray.</p>
