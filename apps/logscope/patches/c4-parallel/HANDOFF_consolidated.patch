+
+    #[test]
+    fn unknown_architecture_classifies_structurally() {
+        let info = detect("some_new_llm", &llama_7b());
+        assert_eq!(info.family, Family::Unknown);
+        assert_eq!(info.attention, AttnKind::Mha); // still readable from hparams
+    }
+}
diff --git a/crates/logscope/src/batching.rs b/crates/logscope/src/batching.rs
new file mode 100644
index 0000000..69e92a1
--- /dev/null
+++ b/crates/logscope/src/batching.rs
@@ -0,0 +1,120 @@
+//! batching.rs — a continuous (in-flight) batching scheduler: the pure slot-admission logic that keeps the
+//! GPU full so total tokens/sec scales with concurrent requests.
+//!
+//! A batch-1 decode barely uses the GPU; decoding many sequences in one batched forward is far more
+//! efficient. Static batching wastes that by waiting for the whole batch to finish before starting the
+//! next. *Continuous* batching instead frees each sequence's KV-cache slot the moment it completes and
+//! admits a waiting request into it immediately, so the active batch stays as full as the work allows.
+//!
+//! This module owns the admission/eviction bookkeeping over a fixed pool of `capacity` slots (FCFS). The
+//! batched forward pass itself is the GPU seam — the engine decodes [`active`](Scheduler::active) each
+//! step, then calls [`complete`](Scheduler::complete) for any sequence that hit EOS / its token cap.
+#![allow(dead_code)]
+
+use std::collections::VecDeque;
+
+/// Fixed-capacity continuous-batching scheduler over request ids.
+pub struct Scheduler {
+    capacity: usize,
+    active: Vec<u64>,
+    waiting: VecDeque<u64>,
+    admitted_total: u64,
+    completed_total: u64,
+}
+
+impl Scheduler {
+    pub fn new(capacity: usize) -> Self {
+        Self { capacity: capacity.max(1), active: Vec::new(), waiting: VecDeque::new(),
+               admitted_total: 0, completed_total: 0 }
+    }
+
+    /// Enqueue a request (FCFS). It is admitted on the next [`admit`](Self::admit) call if a slot is free.
+    pub fn submit(&mut self, id: u64) { self.waiting.push_back(id); }
+
+    /// Fill every free slot from the waiting queue. Returns the ids newly admitted this call (the engine
+    /// must prefill their prompts before the next decode step). Call once per step, before decoding.
+    pub fn admit(&mut self) -> Vec<u64> {
+        let mut just_admitted = Vec::new();
+        while self.active.len() < self.capacity {
+            match self.waiting.pop_front() {
+                Some(id) => { self.active.push(id); self.admitted_total += 1; just_admitted.push(id); }
+                None => break,
+            }
+        }
+        just_admitted
+    }
+
+    /// Free a sequence's slot (it hit EOS or its token cap). A waiting request can take the slot at the
+    /// next `admit` — the continuous-batching win. Returns false if the id wasn't active.
+    pub fn complete(&mut self, id: u64) -> bool {
+        if let Some(pos) = self.active.iter().position(|&a| a == id) {
+            self.active.swap_remove(pos);
+            self.completed_total += 1;
+            true
+        } else { false }
+    }
+
+    /// The sequences to decode this step (the current batch).
+    pub fn active(&self) -> &[u64] { &self.active }
+    pub fn free_slots(&self) -> usize { self.capacity - self.active.len() }
+    pub fn waiting(&self) -> usize { self.waiting.len() }
+    pub fn capacity(&self) -> usize { self.capacity }
+    /// No work left anywhere.
+    pub fn is_idle(&self) -> bool { self.active.is_empty() && self.waiting.is_empty() }
+    /// Slot utilization this step, 0..=1 — what continuous batching is trying to keep near 1.
+    pub fn utilization(&self) -> f32 { self.active.len() as f32 / self.capacity as f32 }
+    pub fn admitted_total(&self) -> u64 { self.admitted_total }
+    pub fn completed_total(&self) -> u64 { self.completed_total }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn admits_up_to_capacity_and_queues_the_rest() {
+        let mut s = Scheduler::new(2);
+        for id in [1, 2, 3, 4] { s.submit(id); }
+        let admitted = s.admit();
+        assert_eq!(admitted, vec![1, 2]);
+        assert_eq!(s.active(), &[1, 2]);
+        assert_eq!(s.waiting(), 2);
+        assert_eq!(s.free_slots(), 0);
+        assert!((s.utilization() - 1.0).abs() < 1e-6);
+    }
+
+    #[test]
+    fn completing_a_sequence_admits_a_waiting_one_mid_flight() {
+        let mut s = Scheduler::new(2);
+        for id in [1, 2, 3] { s.submit(id); }
+        s.admit(); // [1, 2], 3 waits
+        assert!(s.complete(1)); // slot frees immediately
+        assert_eq!(s.free_slots(), 1);
+        let admitted = s.admit(); // 3 takes the freed slot — the continuous-batching win
+        assert_eq!(admitted, vec![3]);
+        assert!(s.active().contains(&3) && s.active().contains(&2));
+        assert_eq!(s.waiting(), 0);
+    }
+
+    #[test]
+    fn completing_unknown_id_is_a_noop() {
+        let mut s = Scheduler::new(2);
+        s.submit(1); s.admit();
+        assert!(!s.complete(99));
+        assert_eq!(s.active(), &[1]);
+    }
+
+    #[test]
+    fn drains_to_idle_and_tracks_totals() {
+        let mut s = Scheduler::new(2);
+        for id in [1, 2, 3] { s.submit(id); }
+        s.admit();
+        assert!(s.complete(1)); assert!(s.complete(2));
+        s.admit(); // 3
+        assert!(s.complete(3));
+        assert!(s.is_idle());
+        assert_eq!(s.admitted_total(), 3);
+        assert_eq!(s.completed_total(), 3);
+        assert!((s.utilization() - 0.0).abs() < 1e-6);
+    }
+}
diff --git a/crates/logscope/src/dedup.rs b/crates/logscope/src/dedup.rs
new file mode 100644
index 0000000..b053caa
--- /dev/null
+++ b/crates/logscope/src/dedup.rs
@@ -0,0 +1,194 @@
+//! dedup.rs — cross-model file compression for the `~/models` folder via content-defined chunking (CDC)
+//! and content-addressed dedup.
+//!
+//! GGUF files in a models folder overlap heavily: quants of one base share vocab/embedding regions,
+//! finetunes share most of the base weights, and re-exports differ only in metadata. Fixed-size blocks
+//! miss this because one inserted byte shifts every later block; **content-defined** boundaries (cut where
+//! a rolling hash hits a pattern) keep identical regions aligned across files, so a [`Store`] keeps each
+//! unique chunk once and represents every model as a manifest of chunk hashes.
+//!
+//! Pure + unit-tested. The seam is just file I/O (read each model's bytes, write the chunk store); the
+//! chunking and dedup accounting are here. Chunk *identity* uses a fast 64-bit hash — fine for accounting
+//! and tests; a real store should use a cryptographic digest (BLAKE3/SHA-256) for collision safety.
+#![allow(dead_code)]
+
+use std::collections::HashMap;
+
+/// Gear table for the rolling hash, generated deterministically at compile time.
+const GEAR: [u64; 256] = {
+    let mut t = [0u64; 256];
+    let mut s: u64 = 0x2545_F491_4F6C_DD1D; // splitmix64 seed
+    let mut i = 0;
+    while i < 256 {
+        s = s.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        let mut z = s;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        z ^= z >> 31;
+        t[i] = z;
+        i += 1;
+    }
+    t
+};
+
+/// Chunking parameters. Cut when the low `mask_bits` of the rolling hash are zero (average chunk ≈
+/// `2^mask_bits` bytes), clamped to `[min, max]`.
+#[derive(Clone, Copy, Debug)]
+pub struct ChunkCfg { pub min: usize, pub max: usize, pub mask_bits: u32 }
+impl Default for ChunkCfg {
+    fn default() -> Self { Self { min: 2048, max: 16384, mask_bits: 12 } } // ~4 KiB average
+}
+
+/// A chunk's position and content hash.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Chunk { pub offset: usize, pub len: usize, pub hash: u64 }
+
+fn fnv1a(bytes: &[u8]) -> u64 {
+    let mut h = 0xcbf2_9ce4_8422_2325u64;
+    for &b in bytes { h ^= b as u64; h = h.wrapping_mul(0x0000_0100_0000_01B3); }
+    h
+}
+
+/// Split `data` into content-defined chunks. Boundaries fall where the Gear rolling hash hits the mask,
+/// subject to `min`/`max`; identical regions in different files produce identical chunks (and hashes).
+pub fn chunk(data: &[u8], cfg: &ChunkCfg) -> Vec<Chunk> {
+    let mut out = Vec::new();
+    if data.is_empty() { return out; }
+    let mask = (1u64 << cfg.mask_bits.min(63)) - 1;
+    let (min, max) = (cfg.min.max(1), cfg.max.max(cfg.min.max(1)));
+    let mut start = 0usize;
+    let mut h = 0u64;
+    let mut i = 0usize;
+    while i < data.len() {
+        h = (h << 1).wrapping_add(GEAR[data[i] as usize]);
+        let len = i - start + 1;
+        let boundary = len >= min && (h & mask) == 0;
+        if boundary || len >= max {
+            out.push(Chunk { offset: start, len, hash: fnv1a(&data[start..start + len]) });
+            start = i + 1;
+            h = 0;
+        }
+        i += 1;
+    }
+    if start < data.len() {
+        out.push(Chunk { offset: start, len: data.len() - start, hash: fnv1a(&data[start..]) });
+    }
+    out
+}
+
+/// One model's representation in the store: an ordered list of chunk hashes (its "recipe").
+#[derive(Clone, Debug)]
+pub struct Manifest { pub name: String, pub chunks: Vec<u64> }
+
+/// A content-addressed chunk store with dedup accounting.
+#[derive(Default)]
+pub struct Store {
+    sizes: HashMap<u64, usize>, // unique chunk hash → its byte length (stored once)
+    logical: u64,               // total bytes across all added files
+}
+
+impl Store {
+    pub fn new() -> Self { Self::default() }
+
+    /// Add a model's bytes; returns its manifest. New chunks grow the store; chunks already present are
+    /// free (the dedup win).
+    pub fn add(&mut self, name: &str, data: &[u8], cfg: &ChunkCfg) -> Manifest {
+        let chunks = chunk(data, cfg);
+        let mut hashes = Vec::with_capacity(chunks.len());
+        for c in &chunks {
+            self.sizes.entry(c.hash).or_insert(c.len);
+            self.logical += c.len as u64;
+            hashes.push(c.hash);
+        }
+        Manifest { name: name.to_string(), chunks: hashes }
+    }
+
+    /// Bytes actually stored (sum of unique chunk lengths).
+    pub fn stored_bytes(&self) -> u64 { self.sizes.values().map(|&s| s as u64).sum() }
+    /// Bytes across all files as if stored independently.
+    pub fn logical_bytes(&self) -> u64 { self.logical }
+    pub fn unique_chunks(&self) -> usize { self.sizes.len() }
+    /// Compression ratio from cross-file dedup (1.0 = no sharing; higher = more shared).
+    pub fn dedup_ratio(&self) -> f32 {
+        let stored = self.stored_bytes();
+        if stored == 0 { 1.0 } else { self.logical as f32 / stored as f32 }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    // a deterministic pseudo-random blob (stands in for model weights)
+    fn blob(seed: u64, n: usize) -> Vec<u8> {
+        let mut s = seed;
+        (0..n).map(|_| { s = s.wrapping_mul(6364136223846793005).wrapping_add(1); (s >> 33) as u8 }).collect()
+    }
+
+    #[test]
+    fn chunking_is_deterministic_and_within_bounds() {
+        let data = blob(1, 200_000);
+        let cfg = ChunkCfg::default();
+        let a = chunk(&data, &cfg);
+        let b = chunk(&data, &cfg);
+        assert_eq!(a, b, "same bytes ⇒ same chunks");
+        assert!(a.len() > 1);
+        // every chunk respects max; all but the last respect min; offsets/lengths tile the file exactly
+        assert!(a.iter().all(|c| c.len <= cfg.max));
+        assert!(a[..a.len() - 1].iter().all(|c| c.len >= cfg.min));
+        let covered: usize = a.iter().map(|c| c.len).sum();
+        assert_eq!(covered, data.len());
+        assert_eq!(a[0].offset, 0);
+        for w in a.windows(2) { assert_eq!(w[1].offset, w[0].offset + w[0].len); }
+    }
+
+    #[test]
+    fn identical_files_dedupe_completely() {
+        let data = blob(7, 120_000);
+        let mut s = Store::new();
+        s.add("model-a.gguf", &data, &ChunkCfg::default());
+        let stored_after_first = s.stored_bytes();
+        s.add("model-a-copy.gguf", &data, &ChunkCfg::default());
+        assert_eq!(s.stored_bytes(), stored_after_first, "second identical file adds nothing");
+        assert_eq!(s.logical_bytes(), 2 * data.len() as u64);
+        assert!((s.dedup_ratio() - 2.0).abs() < 1e-3);
+    }
+
+    #[test]
+    fn files_sharing_a_base_dedupe_the_shared_region() {
+        // a base + finetune: same first 256 KiB of "weights", different tails (like a LoRA-merged model)
+        let base = blob(42, 262_144);
+        let mut a = base.clone(); a.extend(blob(100, 40_000));
+        let mut b = base.clone(); b.extend(blob(200, 40_000));
+        let cfg = ChunkCfg::default();
+        let mut s = Store::new();
+        s.add("base.gguf", &a, &cfg);
+        let before = s.stored_bytes();
+        s.add("finetune.gguf", &b, &cfg);
+        let added = s.stored_bytes() - before;
+        // only the differing tail (~40 KiB) plus a boundary chunk should be new — far less than the whole file
+        assert!(added < 60_000, "shared base should not be re-stored (added {added} bytes)");
+        assert!(s.dedup_ratio() > 1.5);
+    }
+
+    #[test]
+    fn a_byte_insertion_only_disturbs_local_chunks() {
+        // content-defined boundaries should re-sync after an edit, not invalidate the whole file
+        let data = blob(9, 150_000);
+        let mut edited = data.clone();
+        edited.insert(75_000, 0xAB); // single inserted byte mid-file
+        let cfg = ChunkCfg::default();
+        let mut s = Store::new();
+        s.add("orig", &data, &cfg);
+        let before = s.stored_bytes();
+        s.add("edited", &edited, &cfg);
+        let added = (s.stored_bytes() - before) as usize;
+        // re-sync means only a few chunks around the edit are new, not ~half the file
+        assert!(added < data.len() / 4, "CDC should re-sync (added {added} of {} bytes)", data.len());
+    }
+
+    #[test]
+    fn empty_input_makes_no_chunks() {
+        assert!(chunk(&[], &ChunkCfg::default()).is_empty());
+    }
+}
diff --git a/crates/logscope/src/gemmplan.rs b/crates/logscope/src/gemmplan.rs
new file mode 100644
index 0000000..4a8449d
--- /dev/null
+++ b/crates/logscope/src/gemmplan.rs
@@ -0,0 +1,159 @@
+//! gemmplan.rs — pure dispatch planning for the GPU GEMM/attention kernels: output-tile grids, the
+//! >65535-workgroups-per-dimension fold, and split-K for skinny matrices.
+//!
+//! The kernels themselves are the GPU seam, but *how* the host launches them is pure arithmetic that
+//! directly affects throughput and correctness: too-small tiles waste memory bandwidth, and a workgroup
+//! count above the per-dimension cap (65535 on WebGPU/Vulkan) silently drops work unless it's folded into a
+//! 2-D/3-D grid (RULESET K3). Getting this right is a real llama-inference speedup lever; it's also exactly
+//! the kind of off-by-one that's miserable to debug on-device, so it's unit-tested here.
+#![allow(dead_code)]
+
+pub fn ceil_div(a: u32, b: u32) -> u32 { let b = b.max(1) as u64; ((a as u64 + b - 1) / b) as u32 }
+
+/// Per-dimension dispatch limits. `max_per_dim` is the hardware cap on workgroups in one dimension.
+#[derive(Clone, Copy, Debug)]
+pub struct Limits { pub max_per_dim: u32, pub max_invocations: u32 }
+impl Default for Limits {
+    fn default() -> Self { Self { max_per_dim: 65535, max_invocations: 256 } } // WebGPU baseline
+}
+
+/// A 3-D workgroup grid to dispatch.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Grid3 { pub x: u32, pub y: u32, pub z: u32 }
+impl Grid3 {
+    pub fn total(&self) -> u64 { self.x as u64 * self.y as u64 * self.z as u64 }
+    /// Reconstruct the flat workgroup id the kernel computes from its 3-D builtins (row-major in x).
+    pub fn linear(&self, x: u32, y: u32, z: u32) -> u64 {
+        (z as u64 * self.y as u64 + y as u64) * self.x as u64 + x as u64
+    }
+}
+
+/// Fold a flat workgroup `count` into a ≤3-D grid with every dimension ≤ `max_per_dim`, so dispatches above
+/// the per-dim cap still launch (K3). The grid may cover slightly more than `count` (the kernel must guard
+/// `linear_id >= count`); padding is kept minimal. `None` if it can't fit even in 3-D.
+pub fn fold_grid(count: u32, max_per_dim: u32) -> Option<Grid3> {
+    let max = max_per_dim.max(1);
+    if count <= max { return Some(Grid3 { x: count.max(1), y: 1, z: 1 }); }
+    let x = max;
+    let y = ceil_div(count, x);
+    if y <= max { return Some(Grid3 { x, y, z: 1 }); }
+    let y = max;
+    let xy = x as u64 * y as u64;
+    let z = ((count as u64 + xy - 1) / xy) as u32;
+    if z <= max { return Some(Grid3 { x, y, z }); }
+    None
+}
+
+/// Output-tile workgroup count for an M×N GEMM at `tile_m`×`tile_n` outputs per group.
+pub fn gemm_tile_groups(m: u32, n: u32, tile_m: u32, tile_n: u32) -> u32 {
+    ceil_div(m, tile_m) * ceil_div(n, tile_n)
+}
+
+/// Pick a split-K factor: when the output is small (few tiles) the GPU is underused, so split the K
+/// (contraction) dimension into independent partials that reduce afterward — more parallel groups. Returns
+/// 1 when there's already enough work or K is too small to split usefully.
+pub fn split_k(tile_groups: u32, k: u32, target_groups: u32, min_k_per_split: u32) -> u32 {
+    if tile_groups == 0 || tile_groups >= target_groups { return 1; }
+    let want = ceil_div(target_groups, tile_groups);          // factor that would reach the target
+    let by_k = (k / min_k_per_split.max(1)).max(1);           // don't make slivers smaller than this
+    want.min(by_k).max(1)
+}
+
+/// A full dispatch plan for one GEMM.
+#[derive(Clone, Copy, Debug)]
+pub struct GemmPlan { pub tiles_m: u32, pub tiles_n: u32, pub split_k: u32, pub grid: Grid3 }
+
+/// Plan an M×N×K GEMM: tile the output, optionally split K for occupancy, and fold the total group count
+/// (`tiles_m * tiles_n * split_k`) into a launchable grid.
+pub fn plan_gemm(m: u32, n: u32, k: u32, tile_m: u32, tile_n: u32, target_groups: u32, limits: &Limits) -> Option<GemmPlan> {
+    let tiles_m = ceil_div(m, tile_m);
+    let tiles_n = ceil_div(n, tile_n);
+    let base = tiles_m * tiles_n;
+    let sk = split_k(base, k, target_groups, tile_m.max(tile_n).max(16));
+    let grid = fold_grid(base * sk, limits.max_per_dim)?;
+    Some(GemmPlan { tiles_m, tiles_n, split_k: sk, grid })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn ceil_div_rounds_up() {
+        assert_eq!(ceil_div(0, 4), 0);
+        assert_eq!(ceil_div(1, 4), 1);
+        assert_eq!(ceil_div(8, 4), 2);
+        assert_eq!(ceil_div(9, 4), 3);
+    }
+
+    #[test]
+    fn small_counts_stay_one_dimensional() {
+        assert_eq!(fold_grid(1000, 65535), Some(Grid3 { x: 1000, y: 1, z: 1 }));
+    }
+
+    #[test]
+    fn large_counts_fold_and_cover_every_id() {
+        let count = 70_000u32; // > 65535 → must go 2-D
+        let g = fold_grid(count, 65535).unwrap();
+        assert!(g.x <= 65535 && g.y <= 65535 && g.z <= 65535);
+        assert!(g.total() >= count as u64, "grid must cover all work");
+        // the padding is small (less than one full extra row)
+        assert!(g.total() < count as u64 + g.x as u64);
+    }
+
+    #[test]
+    fn fold_is_a_bijection_up_to_count() {
+        // every workgroup id 0..count maps to a distinct in-range (x,y,z), and the kernel's linear()
+        // reproduces the id — i.e. no work is dropped or double-counted
+        let count = 200_000u32;
+        let g = fold_grid(count, 65535).unwrap();
+        let mut seen = std::collections::HashSet::new();
+        for id in 0..count as u64 {
+            let x = (id % g.x as u64) as u32;
+            let y = ((id / g.x as u64) % g.y as u64) as u32;
+            let z = (id / (g.x as u64 * g.y as u64)) as u32;
+            assert!(x < g.x && y < g.y && z < g.z);
+            assert_eq!(g.linear(x, y, z), id);
+            assert!(seen.insert(id));
+        }
+        assert_eq!(seen.len(), count as usize);
+    }
+
+    #[test]
+    fn huge_dispatch_uses_three_dimensions() {
+        // ~5.4e9 groups can't fit in 2-D (65535² ≈ 4.29e9) → needs z
+        let count = u32::MAX; // ceil(MAX/65535)=65536 > cap → must spill into z
+        let g = fold_grid(count, 65535).unwrap();
+        assert!(g.z > 1, "this dispatch can't fit in 2-D");
+        assert!(g.total() >= count as u64);
+        assert!(g.x <= 65535 && g.y <= 65535 && g.z <= 65535);
+    }
+
+    #[test]
+    fn split_k_kicks_in_only_when_underutilized() {
+        // a 1×1-tile GEMM with big K: few groups → split to reach the target
+        assert!(split_k(1, 8192, 64, 128) > 1);
+        // plenty of tiles already → no split
+        assert_eq!(split_k(256, 8192, 64, 128), 1);
+        // tiny K → don't split into slivers
+        assert_eq!(split_k(1, 64, 64, 128), 1);
+    }
+
+    #[test]
+    fn plan_gemm_tiles_and_folds() {
+        // a 4096×4096×4096 matmul at 64×64 tiles → 64×64 = 4096 groups, fits 1-D, no split needed
+        let p = plan_gemm(4096, 4096, 4096, 64, 64, 512, &Limits::default()).unwrap();
+        assert_eq!((p.tiles_m, p.tiles_n), (64, 64));
+        assert_eq!(p.split_k, 1);
+        assert_eq!(p.grid, Grid3 { x: 4096, y: 1, z: 1 });
+    }
+
+    #[test]
+    fn plan_gemm_splits_k_for_a_skinny_output() {
+        // tiny output (one tile) but large K → split K to fill the GPU
+        let p = plan_gemm(64, 64, 16384, 64, 64, 32, &Limits::default()).unwrap();
+        assert_eq!((p.tiles_m, p.tiles_n), (1, 1));
+        assert!(p.split_k > 1);
+        assert_eq!(p.grid.total(), p.split_k as u64); // 1 tile × split_k groups
+    }
+}
diff --git a/crates/logscope/src/kvcache.rs b/crates/logscope/src/kvcache.rs
new file mode 100644
index 0000000..3cfe7bc
--- /dev/null
+++ b/crates/logscope/src/kvcache.rs
@@ -0,0 +1,210 @@
+//! kvcache.rs — paged KV-cache block allocation (PagedAttention-style): the pure bookkeeping that lets the
+//! engine pack many sequences into a fixed KV budget without reserving `max_len` each.
+//!
+//! Physical KV storage is divided into fixed-size **blocks** (`block_size` tokens of K/V each). Every
+//! sequence keeps a **block table** mapping its logical positions to physical blocks, and grows it one
+//! block at a time only when it crosses a block boundary — so memory tracks actual length, not the worst
+//! case, and uniform blocks mean no external fragmentation. Blocks are **ref-counted**: [`fork`](Paged::fork)
+//! shares a parent's blocks with a child (prefix sharing — e.g. the many fanout lanes off one prompt), and
+//! a write into a still-shared partial block triggers **copy-on-write** so the siblings stay isolated.
+//!
+//! This composes under `batching`: admit a request only when [`can_admit`](Paged::can_admit); `append` as
+//! it decodes; `free` on completion. The K/V tensor storage and the paged-attention kernel are the GPU
+//! seam (this module hands out block ids and says when to copy); the allocation logic is here and tested.
+#![allow(dead_code)]
+
+use std::collections::HashMap;
+
+pub type Block = u32; // physical block id
+pub type SeqId = u64;
+
+/// Blocks required to hold `tokens` tokens.
+pub fn blocks_for(tokens: usize, block_size: usize) -> usize {
+    let bs = block_size.max(1);
+    (tokens + bs - 1) / bs
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub struct Oom; // out of physical blocks
+
+/// A paged KV-cache allocator over a fixed pool of physical blocks.
+pub struct Paged {
+    block_size: usize,
+    free: Vec<Block>,
+    refcount: Vec<u16>,
+    tables: HashMap<SeqId, Vec<Block>>,
+    lengths: HashMap<SeqId, usize>,
+}
+
+impl Paged {
+    pub fn new(num_blocks: usize, block_size: usize) -> Self {
+        Self {
+            block_size: block_size.max(1),
+            free: (0..num_blocks as Block).rev().collect(), // pop() hands out 0,1,2,…
+            refcount: vec![0; num_blocks],
+            tables: HashMap::new(),
+            lengths: HashMap::new(),
+        }
+    }
+
+    pub fn block_size(&self) -> usize { self.block_size }
+    pub fn total_blocks(&self) -> usize { self.refcount.len() }
+    pub fn free_blocks(&self) -> usize { self.free.len() }
+    pub fn used_blocks(&self) -> usize { self.total_blocks() - self.free_blocks() }
+    pub fn block_table(&self, seq: SeqId) -> Option<&[Block]> { self.tables.get(&seq).map(|v| v.as_slice()) }
+    pub fn seq_len(&self, seq: SeqId) -> Option<usize> { self.lengths.get(&seq).copied() }
+    /// Could a fresh sequence of `n_tokens` be admitted right now?
+    pub fn can_admit(&self, n_tokens: usize) -> bool { self.free.len() >= blocks_for(n_tokens, self.block_size) }
+
+    fn alloc(&mut self) -> Option<Block> {
+        let b = self.free.pop()?;
+        self.refcount[b as usize] = 1;
+        Some(b)
+    }
+
+    /// Admit a new sequence and allocate blocks for its `n_prompt_tokens` prefill.
+    pub fn admit(&mut self, seq: SeqId, n_prompt_tokens: usize) -> Result<(), Oom> {
+        let need = blocks_for(n_prompt_tokens, self.block_size);
+        if self.free.len() < need { return Err(Oom); }
+        let table = (0..need).map(|_| self.alloc().unwrap()).collect();
+        self.tables.insert(seq, table);
+        self.lengths.insert(seq, n_prompt_tokens);
+        Ok(())
+    }
+
+    /// Extend `seq` by `n` tokens, allocating blocks as boundaries are crossed and copying-on-write the
+    /// current partial block if it is still shared. Atomic: if the blocks aren't available, nothing changes.
+    pub fn append(&mut self, seq: SeqId, n: usize) -> Result<(), Oom> {
+        let Some(&len) = self.lengths.get(&seq) else { return Err(Oom) };
+        let bs = self.block_size;
+        let table = self.tables.get(&seq).unwrap();
+        let growth = blocks_for(len + n, bs) - blocks_for(len, bs);
+        // a write into the existing partial last block needs COW if that block is still shared
+        let cow = if len % bs != 0 {
+            let last = *table.last().unwrap();
+            usize::from(self.refcount[last as usize] > 1)
+        } else { 0 };
+        if self.free.len() < growth + cow { return Err(Oom); }
+
+        let mut table = self.tables.get(&seq).unwrap().clone();
+        if cow == 1 {
+            let li = table.len() - 1;
+            let old = table[li];
+            let nb = self.alloc().unwrap(); // engine copies old→nb
+            self.refcount[old as usize] -= 1;
+            table[li] = nb;
+        }
+        for _ in 0..growth { let b = self.alloc().unwrap(); table.push(b); }
+        self.tables.insert(seq, table);
+        self.lengths.insert(seq, len + n);
+        Ok(())
+    }
+
+    /// Share `parent`'s current blocks with a new `child` (prefix sharing, no new blocks). Subsequent
+    /// writes copy-on-write so the two never corrupt each other.
+    pub fn fork(&mut self, child: SeqId, parent: SeqId) -> Result<(), Oom> {
+        let table = self.tables.get(&parent).ok_or(Oom)?.clone();
+        let len = self.lengths[&parent];
+        for &b in &table { self.refcount[b as usize] += 1; }
+        self.tables.insert(child, table);
+        self.lengths.insert(child, len);
+        Ok(())
+    }
+
+    /// Release a sequence; blocks whose refcount hits zero return to the free pool.
+    pub fn free(&mut self, seq: SeqId) {
+        if let Some(table) = self.tables.remove(&seq) {
+            self.lengths.remove(&seq);
+            for &b in &table {
+                let rc = &mut self.refcount[b as usize];
+                *rc = rc.saturating_sub(1);
+                if *rc == 0 { self.free.push(b); }
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn blocks_for_is_ceil_div() {
+        assert_eq!(blocks_for(0, 4), 0);
+        assert_eq!(blocks_for(1, 4), 1);
+        assert_eq!(blocks_for(4, 4), 1);
+        assert_eq!(blocks_for(5, 4), 2);
+    }
+
+    #[test]
+    fn admit_allocates_prefill_blocks_and_can_oom() {
+        let mut p = Paged::new(3, 4); // 3 blocks × 4 tokens
+        assert!(p.admit(1, 6).is_ok()); // ceil(6/4)=2 blocks
+        assert_eq!(p.used_blocks(), 2);
+        assert_eq!(p.block_table(1).unwrap().len(), 2);
+        assert_eq!(p.admit(2, 9), Err(Oom)); // needs 3, only 1 free
+        assert!(p.admit(3, 4).is_ok());      // 1 block fits
+        assert_eq!(p.free_blocks(), 0);
+    }
+
+    #[test]
+    fn append_only_grows_on_block_boundaries() {
+        let mut p = Paged::new(8, 4);
+        p.admit(1, 1).unwrap();          // 1 block, len 1
+        let before = p.free_blocks();
+        p.append(1, 2).unwrap();         // len 1→3, still in block 0
+        assert_eq!(p.free_blocks(), before, "no new block within a block");
+        p.append(1, 2).unwrap();         // len 3→5, crosses into block 1
+        assert_eq!(p.free_blocks(), before - 1);
+        assert_eq!(p.block_table(1).unwrap().len(), 2);
+    }
+
+    #[test]
+    fn free_returns_blocks_to_the_pool() {
+        let mut p = Paged::new(4, 4);
+        p.admit(1, 8).unwrap(); // 2 blocks
+        assert_eq!(p.free_blocks(), 2);
+        p.free(1);
+        assert_eq!(p.free_blocks(), 4);
+        assert!(p.block_table(1).is_none());
+    }
+
+    #[test]
+    fn fork_shares_blocks_without_allocating() {
+        let mut p = Paged::new(8, 4);
+        p.admit(1, 6).unwrap();          // 2 blocks
+        let free_after_admit = p.free_blocks();
+        p.fork(2, 1).unwrap();
+        assert_eq!(p.free_blocks(), free_after_admit, "sharing allocates nothing");
+        assert_eq!(p.block_table(1), p.block_table(2), "child sees the same physical blocks");
+        assert_eq!(p.seq_len(2), Some(6));
+    }
+
+    #[test]
+    fn append_after_fork_copies_on_write() {
+        let mut p = Paged::new(8, 4);
+        p.admit(1, 2).unwrap();          // 1 partial block, len 2
+        p.fork(2, 1).unwrap();           // child shares it (refcount 2)
+        let free_before = p.free_blocks();
+        p.append(1, 1).unwrap();         // parent writes into the shared partial block → COW
+        assert_eq!(p.free_blocks(), free_before - 1, "COW consumed one block");
+        assert_ne!(p.block_table(1).unwrap()[0], p.block_table(2).unwrap()[0], "parent diverged onto its own copy");
+        assert_eq!(p.seq_len(1), Some(3));
+        assert_eq!(p.seq_len(2), Some(2), "child is untouched");
+        // freeing the child returns its (now unshared) original block
+        let f = p.free_blocks();
+        p.free(2);
+        assert_eq!(p.free_blocks(), f + 1);
+    }
+
+    #[test]
+    fn append_is_atomic_under_oom() {
+        let mut p = Paged::new(2, 4);
+        p.admit(1, 4).unwrap();          // 1 block exactly full, 1 free
+        // ask for 8 more tokens → needs 2 new blocks, only 1 free → Oom, no mutation
+        assert_eq!(p.append(1, 8), Err(Oom));
+        assert_eq!(p.seq_len(1), Some(4));
+        assert_eq!(p.block_table(1).unwrap().len(), 1);
+        assert_eq!(p.free_blocks(), 1);
+    }
+}
