+    #[test]
+    fn select_ranks_by_slots_then_models_and_caps_at_max_fleet() {
+        let offers: Vec<(PeerId, Capability)> = (0..15)
+            .map(|i| (format!("p{i:02}"), cap("ollama", i % 3, (i % 5) as u32 + 1))).collect();
+        let picks = select_invitees(&offers, 100);
