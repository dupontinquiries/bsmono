+        let mut w = Worker::new("box:7000", cap("wgpu", 1, 1));
+        assert!(w.on_opening("p", 1).is_some());            // first offer ok
+        match w.on_invite("p", 1) { Msg::Accept { .. } => {}, m => panic!("{m:?}") }
+        assert!(w.is_joined());
