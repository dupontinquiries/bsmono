# perf-loop/hosts.env — copy to hosts.env (gitignored) and edit.
# Driver side = the M4 Max laptop (Claude Code runs here). Target = the M2 Ultra.

ULTRA_HOST=ultra                    # ssh alias / Tailscale name of the M2 Ultra
ULTRA_REPO='~/perf/repo'            # remote copy of the monorepo (rsync target, no target/)
ULTRA_RESULTS='~/perf/results'      # where bench.sh writes JSON + raw logs on the target
ULTRA_SHADERS='~/perf/shaders'      # LOGSCOPE_SHADER_DIR on the target (hot-loaded .wgsl)
ULTRA_MODELS='~/models'             # read-only from the loop's point of view

BENCH_MODEL=Qwen3.6-35B-A3B-Q4_K_M.gguf        # the target workload (Ornith-1.5-35B-A3B is the same arch)
BENCH_MODEL_SMALL=Llama-3.2-1B-Instruct-Q4_K_M.gguf   # 20-second smoke run
BENCH_ACTIVE_FRACTION=0.09          # active/total params for the roofline (3B/35B); 1.0 for dense
LLAMA_BENCH=/opt/homebrew/bin/llama-bench      # optional: the Metal/Ollama-class reference; leave empty to skip
