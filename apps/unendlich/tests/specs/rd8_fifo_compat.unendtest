# RD=8 forced to FIFO present mode. A/B comparison against rd8_smoke
# to measure latency-mitigation effectiveness at heavy load.
#
# Hypothesis from RD=2 data: MAILBOX wins on acquire and wait_fences.
# RD=8 question: does that win hold up when the GPU is genuinely
# overloaded (shadow + main passes both taking real time), or does
# the GPU bottleneck swamp the present-mode difference?

spec_version = 1
name = "rd8_fifo_compat"
description = """
Same workload as rd8_smoke, but VSYNC=1 forces FIFO present mode.
The c.5/c.7 bisect runs used this config — this spec is the most
direct comparison to that historical data.
"""

[engine]
binary = "unendlich-world"
duration_ms = 30000

[env]
UNENDLICH_RENDER_DISTANCE = "8"
UNENDLICH_VSYNC = "1"
UNENDLICH_INDIRECT = "1"
UNENDLICH_LOD_FACTORS = "4,8,16,32"

[expect]
duration_completed = true
rendering_max = { min = 50 }
loaded_max = { min = 300 }
