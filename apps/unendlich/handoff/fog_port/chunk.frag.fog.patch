--- t01/unendlich/crates/unendlich-engine/src/shaders/chunk.frag	2026-06-04 00:30:07.000000000 +0000
+++ t02/unendlich/crates/unendlich-engine/src/shaders/chunk.frag	2026-06-04 00:50:12.000000000 +0000
@@ -77,6 +77,9 @@
 // will start returning real scattering data and the march loop
 // becomes the fallback for out-of-volume samples.
 layout(set = 0, binding = 2) uniform sampler3D froxel_volume;
+// binding 3 is the chunks SSBO (vertex stage); binding 4 is the 2D moisture
+// field for fog approach 4 (GPU bridge). Sampled only when fog_approach==4.
+layout(set = 0, binding = 4) uniform sampler2D moisture_tex;
 
 // ─── Material classification ────────────────────────────────────────────
 //
@@ -758,6 +761,68 @@
     vec3  fog_color = mix(base_fog, ubo.sun_color.rgb, warm_amount);
     fog_color = mix(fog_color, vec3(0.85), clamp(dist / 200.0, 0.0, 1.0));
 
+    // ─── Fog approach A/B (debug, live) ─────────────────────────────────
+    // Selector arrives in ubo.sky_color.a (set Rust-side from DEBUG.fog_approach
+    // in the debug panel). Flip it live with no recompile:
+    //   0 = off          -> no fog
+    //   1 = froxel/current -> the marched fog above (shadowed in-scatter, shafts)
+    //   2 = analytic     -> world-space height/distance fog (frame-stable starter)
+    //   3 = analytic+march, 4 = advected -> not implemented yet, keep marched fog
+    int fog_approach = int(ubo.sky_color.a + 0.5);
+    if (fog_approach == 0) {
+        fog = 0.0;
+    } else if (fog_approach == 2) {
+        // STARTER world-space analytic fog (turn-1 sketch). Density is a pure
+        // function of world position - denser low, thinner high - so it does
+        // NOT swim with the camera the way a view-aligned volume does. Reuses
+        // the marched `fog_color` so when you A/B against approach 1 only the
+        // density PROFILE changes, making the difference easy to read. Scales
+        // with the existing fog_density knob (atmos_params.x), so the Looks /
+        // "more-less fog" controls still work here. Replace this block with
+        // your real turn-1 analytic fog when it lands in the other thread.
+        float k    = 0.02;                          // height falloff per metre
+        float h    = max(v_world_pos.y - 8.0, 0.0); // metres above a base line
+        float dens = ubo.atmos_params.x * 0.75 * exp(-k * h);
+        fog = clamp(1.0 - exp(-dens * dist), 0.0, 1.0);
+    } else if (fog_approach == 3) {
+        // Wind-advected PROCEDURAL fog (interim, no sim texture): analytic
+        // height density modulated by world-space noise scrolled along the wind
+        // vector, so the fog visibly drifts. Uses only existing uniforms
+        // (wind_params + time_of_day) — no new binding — and approximates the
+        // look the real moisture sim (approach 4) will produce once the GPU
+        // bridge lands.
+        float k = 0.02;
+        float h = max(v_world_pos.y - 8.0, 0.0);
+        vec2  wind = ubo.wind_params.xy;
+        float t = ubo.atmos_params.w;                 // time-of-day as a clock
+        vec2  p = v_world_pos.xz * 0.02 - wind * t * 0.05; // noise scrolled by wind
+        float n = clamp(0.5 + 0.25 * sin(p.x) + 0.25 * sin(p.y * 1.3 + p.x * 0.5), 0.1, 1.0);
+        float dens = ubo.atmos_params.x * 0.75 * exp(-k * h) * n;
+        fog = clamp(1.0 - exp(-dens * dist), 0.0, 1.0);
+    } else if (fog_approach == 4) {
+        // Advected 2.5D moisture sim (GPU bridge). Ray-MARCH the world-sampled
+        // moisture between the camera and this fragment, so fog banks sit at
+        // fixed world locations (you move through them) rather than riding the
+        // camera as a distance haze. ro/rd are true world space (v_world_pos and
+        // camera_pos are both world). Constants MUST match world_renderer MOIST_*.
+        const vec2  MOIST_ORIGIN = vec2(-512.0, -512.0);
+        const float MOIST_INV    = 1.0 / 1024.0;
+        vec3  ro = ubo.camera_pos.xyz;
+        vec3  rd = v_world_pos - ro;           // camera -> fragment, length == dist
+        const int STEPS = 8;
+        float seg = dist / float(STEPS);       // world metres per step
+        float optical = 0.0;
+        for (int s = 0; s < STEPS; ++s) {
+            vec3  p  = ro + rd * ((float(s) + 0.5) / float(STEPS));
+            vec2  uv = clamp((p.xz - MOIST_ORIGIN) * MOIST_INV, 0.0, 1.0);
+            float condensate = texture(moisture_tex, uv).r;
+            float ground = exp(-0.015 * max(p.y, 0.0)); // gentle ground-hug (tune)
+            optical += condensate * ground * seg;
+        }
+        fog = clamp(1.0 - exp(-optical * 0.05), 0.0, 1.0); // 0.05 = thickness (tune)
+    }
+    // approach 1 (default) keeps the marched fog computed above.
+
     color = mix(color, fog_color, fog);
     } // end if (!froxel_filled)
 
