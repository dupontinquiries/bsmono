#version 450
//
// ui_blur.comp — one axis of a separable Gaussian for the frosted-UI blur.
// Dispatched TWICE, ping-ponging two half-res images:
//   pass H: dir = (1, 0)   src = downsampled scene   dst = temp
//   pass V: dir = (0, 1)   src = temp                dst = blur target
// The blur target is then handed to egui as a texture; the kit samples it under
// each frosted panel (see unendlich_ui::frosted_backdrop and docs/FROSTED-UI.md).
//
// One invocation per destination texel. Workgroup 8×8 → dispatch
// (ceil(w/8), ceil(h/8), 1). 9-tap, sigma ≈ 2.5 texels at half-res ≈ a wide,
// soft frost at full res. Weights are pre-normalized (sum = 1).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_src;                 // linear sampler
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D u_dst;

layout(push_constant) uniform PushConstants {
    ivec2 size; // size of u_dst (== u_src) in texels
    ivec2 dir;  // blur axis: (1,0) horizontal, (0,1) vertical
} pc;

// Normalized 1D Gaussian: center + 4 symmetric taps.
const float W[5] = float[](0.227027, 0.194595, 0.121622, 0.054054, 0.016216);

void main() {
    ivec2 d = ivec2(gl_GlobalInvocationID.xy);
    if (d.x >= pc.size.x || d.y >= pc.size.y) {
        return;
    }
    vec2 uv = (vec2(d) + 0.5) / vec2(pc.size);
    vec2 step = vec2(pc.dir) / vec2(pc.size); // one-texel step along the axis
    vec3 c = texture(u_src, uv).rgb * W[0];
    for (int i = 1; i < 5; ++i) {
        c += texture(u_src, uv + step * float(i)).rgb * W[i];
        c += texture(u_src, uv - step * float(i)).rgb * W[i];
    }
    imageStore(u_dst, d, vec4(c, 1.0));
}
