#version 450
// neural_feat_lean.comp — the trimmed feature pass: base(8) + 6 hint rays = 14.
// Drops the 90 occupancy octree-gathers (shown to not affect quality), so the
// feature pass is just the 6 hint marches. Pairs with a 14->64->48->3 net.
// Output stride 14:  [0:3] normal  [3:6] albedo  [6] sun·n  [7] height  [8:14] hints.
#extension GL_GOOGLE_include_directive : require
#include "octree_types.glsl"
layout(std430, binding = 0) readonly buffer OctreeNodes { OctreeNode nodes[]; };
#include "octree_sample.glsl"

layout(local_size_x = 64) in;
layout(std430, binding = 1) readonly  buffer GBuf { float gbuf[]; };
layout(std430, binding = 2) readonly  buffer Alb  { float alb[];  };
layout(std430, binding = 3) writeonly buffer Feat { float feat[]; };
layout(push_constant) uniform PC { uint M; uint NB; };

float occ(vec3 p) {
    ivec3 c = ivec3(floor(p));
    if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, ivec3(int(OCTREE_CHUNK_SIZE))))) return 0.0;
    return octree_sample(0u, uvec3(c)) > 0u ? 1.0 : 0.0;
}
float march(vec3 o, vec3 d, float maxd) {
    float t = 0.5; int steps = int(maxd / 0.5);
    for (int s = 0; s < steps; ++s) { if (occ(o + d * t) > 0.5) return t / maxd; t += 0.5; if (t > maxd) break; }
    return 1.0;
}

void main() {
    uint r = gl_GlobalInvocationID.x;
    if (r >= M) return;
    uint fb = r * 14u, gb = r * 8u;
    if (gbuf[gb + 7u] < 0.5) { for (uint i = 0u; i < 14u; ++i) feat[fb + i] = 0.0; return; }

    vec3 wp = vec3(gbuf[gb], gbuf[gb+1u], gbuf[gb+2u]);
    vec3 nrm = vec3(gbuf[gb+3u], gbuf[gb+4u], gbuf[gb+5u]);
    int  mat = clamp(int(gbuf[gb+6u]), 0, int(NB)-1);
    vec3 sun = normalize(vec3(0.5, 0.82, 0.30));
    vec3 base = wp + nrm * 0.5;

    feat[fb] = nrm.x; feat[fb+1u] = nrm.y; feat[fb+2u] = nrm.z;
    feat[fb+3u] = alb[uint(mat)*4u]; feat[fb+4u] = alb[uint(mat)*4u+1u]; feat[fb+5u] = alb[uint(mat)*4u+2u];
    feat[fb+6u] = clamp(dot(nrm, sun), -1.0, 1.0);
    feat[fb+7u] = wp.y / float(OCTREE_CHUNK_SIZE);

    vec3 H[5] = vec3[5](vec3(0,1,0), vec3(1,2,1), vec3(-1,2,1), vec3(1,2,-1), vec3(-1,2,-1));
    feat[fb+8u] = march(base, sun, 40.0);
    for (uint h = 0u; h < 5u; ++h) feat[fb+9u+h] = march(base, normalize(H[h]), 16.0);
}
