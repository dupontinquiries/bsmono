#version 450
//
// chunk_mesh_sparse.comp — v0.24.5 GPU mesher (Layer A.2).
//
// Reads a SurfaceRecord[] buffer (one record per surface block in a chunk),
// emits axis-aligned quads — one per exposed face bit. Pure quad-emission
// for v1; greedy merging is v2.
//
// One thread per record. Each thread atomically reserves space in the
// vertex and index buffers, then writes its quads.
//
// Layout convention:
//   - Vertex stride 24 bytes ([pos: vec3, color: vec3]) matching
//     `render::mesher::Vertex` and `world::gpu_mesher_vk::GpuVertex`.
//   - Index buffer is u32. Each face = 2 triangles = 6 indices.
//   - Index values are LOCAL to this dispatch's vertex range. The caller
//     adds the chunk's vertex_base offset when integrating into the
//     renderer's shared vertex buffer (matches the existing
//     `mesh_buffer_pool` "pre-shift indices by vertex_base" convention).
//
// Bindings:
//   0 (readonly storage):  SurfaceRecord[] input.
//   1 (writeonly storage): float[] vertex output (24 bytes per vertex).
//   2 (writeonly storage): uint[] index output (4 bytes per index).
//   3 (storage):           Counters (vertex_count, index_count) atomically
//                          incremented by each thread.
//
// Push constants:
//   record_count : number of records in this dispatch.
//   vertex_capacity, index_capacity : caller's pre-allocated bounds.
//                                     Threads must not write beyond these.

layout(local_size_x = 64) in;

struct SurfaceRecord {
    int world_x;
    int world_y;
    int world_z;
    uint packed; // bits 0..8 = block_type, bits 8..14 = face_mask, rest reserved
};

layout(std430, set = 0, binding = 0) readonly buffer Records {
    SurfaceRecord records[];
};

// Vertices stored as raw floats: 6 floats per vertex (pos.xyz, color.rgb).
// std430 packs floats consecutively.
layout(std430, set = 0, binding = 1) writeonly buffer Vertices {
    float vertex_floats[];
};

layout(std430, set = 0, binding = 2) writeonly buffer Indices {
    uint indices[];
};

// Per-batch counters: groups of 4 u32 per chunk slot.
//   counters[chunk_slot*4 + 0] = vertex_count
//   counters[chunk_slot*4 + 1] = index_count
//   counters[chunk_slot*4 + 2] = overflow_flag
//   counters[chunk_slot*4 + 3] = reserved
// Push constant `counter_offset` is the u32 offset of this chunk's group
// (i.e., chunk_slot * 4 from the CPU side).
layout(std430, set = 0, binding = 3) buffer Counters {
    uint counters[];
};

layout(push_constant) uniform PushConstants {
    uint record_count;
    uint vertex_capacity; // in vertices, not floats
    uint index_capacity;  // in indices
    uint record_offset;   // index of first record in records[] for this chunk
    uint vertex_offset;   // vertex slot index for this chunk's output start (in vertices)
    uint index_offset;    // index slot for this chunk's output start (in indices)
    uint counter_offset;  // u32 offset for this chunk's 4-u32 counter group
    uint _pad;
} pc;

// Face bit constants (must match world::surface::face module).
const uint FACE_PX = 1u << 0u;
const uint FACE_NX = 1u << 1u;
const uint FACE_PY = 1u << 2u;
const uint FACE_NY = 1u << 3u;
const uint FACE_PZ = 1u << 4u;
const uint FACE_NZ = 1u << 5u;

// Compute a per-block-type color. v1: simple hash-based palette so each
// block type is visually distinct. Bring lighting/tints back in v2.
vec3 block_color(uint block_type) {
    // Stone-ish palette as defaults; specific types get distinct colors.
    if (block_type == 1u)  return vec3(0.50, 0.50, 0.55); // Stone
    if (block_type == 2u)  return vec3(0.55, 0.40, 0.25); // Dirt
    if (block_type == 3u)  return vec3(0.30, 0.65, 0.25); // Grass
    if (block_type == 4u)  return vec3(0.85, 0.80, 0.55); // Sand
    if (block_type == 5u)  return vec3(0.65, 0.65, 0.60); // Gravel
    if (block_type == 6u)  return vec3(0.45, 0.35, 0.20); // Wood-ish
    if (block_type == 7u)  return vec3(0.30, 0.50, 0.25); // Leaves-ish
    if (block_type == 8u)  return vec3(0.80, 0.80, 0.85); // Snow
    if (block_type == 9u)  return vec3(0.75, 0.85, 0.95); // Ice
    if (block_type == 12u) return vec3(0.40, 0.40, 0.45); // Cobblestone
    // Generic hash for everything else, deterministic.
    float h = float(block_type) * 0.61803398875;
    return vec3(
        fract(h * 3.7),
        fract(h * 5.3),
        fract(h * 7.1)
    ) * 0.5 + 0.4;
}

// Write a single vertex at chunk-local index `v_local` in the chunk's
// slot. The slot's start in the global buffer is `pc.vertex_offset`.
// Slot N occupies vertices [pc.vertex_offset .. pc.vertex_offset + VERTEX_CAPACITY).
void write_vertex(uint v_local, vec3 pos, vec3 color) {
    uint base = (pc.vertex_offset + v_local) * 6u;
    vertex_floats[base + 0u] = pos.x;
    vertex_floats[base + 1u] = pos.y;
    vertex_floats[base + 2u] = pos.z;
    vertex_floats[base + 3u] = color.r;
    vertex_floats[base + 4u] = color.g;
    vertex_floats[base + 5u] = color.b;
}

// Emit one quad: 4 vertices + 6 indices. Vertices written at chunk-local
// slots [v_base_local .. v_base_local+4); indices written at chunk-local
// slots [i_base_local .. i_base_local+6).
//
// Index VALUES are chunk-local (not adjusted by pc.vertex_offset). CPU
// readback extracts chunk N's vertex/index ranges from their respective
// slots and treats indices as relative to slot start. This matches v1's
// single-chunk semantics (ChunkMesh has slot-local vertex indices).
//
// Quad winding: counter-clockwise when viewed from outside the block
// (i.e. from the side the face is exposed to).
void emit_quad(uint v_base_local, uint i_base_local, vec3 p0, vec3 p1, vec3 p2, vec3 p3, vec3 color) {
    write_vertex(v_base_local + 0u, p0, color);
    write_vertex(v_base_local + 1u, p1, color);
    write_vertex(v_base_local + 2u, p2, color);
    write_vertex(v_base_local + 3u, p3, color);
    // Triangle 1: 0, 1, 2.  Triangle 2: 0, 2, 3.
    // Index VALUES are chunk-local; indices ARRAY position is global.
    uint i_global = pc.index_offset + i_base_local;
    indices[i_global + 0u] = v_base_local + 0u;
    indices[i_global + 1u] = v_base_local + 1u;
    indices[i_global + 2u] = v_base_local + 2u;
    indices[i_global + 3u] = v_base_local + 0u;
    indices[i_global + 4u] = v_base_local + 2u;
    indices[i_global + 5u] = v_base_local + 3u;
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= pc.record_count) return;

    // Read record from this chunk's slot in the records buffer.
    SurfaceRecord r = records[pc.record_offset + tid];
    uint block_type = r.packed & 0xFFu;
    uint face_mask  = (r.packed >> 8u) & 0x3Fu;

    // Count exposed faces. Could use bitCount() but inline is fine for 6 bits.
    uint quad_count = 0u;
    if ((face_mask & FACE_PX) != 0u) quad_count += 1u;
    if ((face_mask & FACE_NX) != 0u) quad_count += 1u;
    if ((face_mask & FACE_PY) != 0u) quad_count += 1u;
    if ((face_mask & FACE_NY) != 0u) quad_count += 1u;
    if ((face_mask & FACE_PZ) != 0u) quad_count += 1u;
    if ((face_mask & FACE_NZ) != 0u) quad_count += 1u;

    if (quad_count == 0u) return;

    uint v_count = quad_count * 4u;
    uint i_count = quad_count * 6u;

    // Reserve output space within this chunk's counter group.
    // Returned offsets are CHUNK-LOCAL (relative to chunk's slot).
    uint v_base_local = atomicAdd(counters[pc.counter_offset + 0u], v_count);
    uint i_base_local = atomicAdd(counters[pc.counter_offset + 1u], i_count);

    // Overflow check on chunk-local offsets vs per-chunk capacity.
    if (v_base_local + v_count > pc.vertex_capacity
        || i_base_local + i_count > pc.index_capacity)
    {
        atomicAdd(counters[pc.counter_offset + 2u], 1u);
        return;
    }

    // Block AABB in world space. Each block is a unit cube whose corner
    // (-X,-Y,-Z) sits at (world_x, world_y, world_z) and which extends
    // +1 along each axis.
    vec3 mn = vec3(float(r.world_x), float(r.world_y), float(r.world_z));
    vec3 mx = mn + vec3(1.0);
    vec3 color = block_color(block_type);

    uint v_cursor = v_base_local;
    uint i_cursor = i_base_local;

    // +X face (normal pointing +X): looking from +X toward -X, vertices
    // are ordered counter-clockwise. Face is on the mx.x plane.
    if ((face_mask & FACE_PX) != 0u) {
        emit_quad(v_cursor, i_cursor,
            vec3(mx.x, mn.y, mn.z), // 0: -Y,-Z
            vec3(mx.x, mn.y, mx.z), // 1: -Y,+Z
            vec3(mx.x, mx.y, mx.z), // 2: +Y,+Z
            vec3(mx.x, mx.y, mn.z), // 3: +Y,-Z
            color);
        v_cursor += 4u;
        i_cursor += 6u;
    }

    // -X face (normal pointing -X): on the mn.x plane.
    if ((face_mask & FACE_NX) != 0u) {
        emit_quad(v_cursor, i_cursor,
            vec3(mn.x, mn.y, mx.z),
            vec3(mn.x, mn.y, mn.z),
            vec3(mn.x, mx.y, mn.z),
            vec3(mn.x, mx.y, mx.z),
            color);
        v_cursor += 4u;
        i_cursor += 6u;
    }

    // +Y face: on the mx.y plane.
    if ((face_mask & FACE_PY) != 0u) {
        emit_quad(v_cursor, i_cursor,
            vec3(mn.x, mx.y, mn.z),
            vec3(mx.x, mx.y, mn.z),
            vec3(mx.x, mx.y, mx.z),
            vec3(mn.x, mx.y, mx.z),
            color);
        v_cursor += 4u;
        i_cursor += 6u;
    }

    // -Y face: on the mn.y plane.
    if ((face_mask & FACE_NY) != 0u) {
        emit_quad(v_cursor, i_cursor,
            vec3(mn.x, mn.y, mx.z),
            vec3(mx.x, mn.y, mx.z),
            vec3(mx.x, mn.y, mn.z),
            vec3(mn.x, mn.y, mn.z),
            color);
        v_cursor += 4u;
        i_cursor += 6u;
    }

    // +Z face: on the mx.z plane.
    if ((face_mask & FACE_PZ) != 0u) {
        emit_quad(v_cursor, i_cursor,
            vec3(mx.x, mn.y, mx.z),
            vec3(mn.x, mn.y, mx.z),
            vec3(mn.x, mx.y, mx.z),
            vec3(mx.x, mx.y, mx.z),
            color);
        v_cursor += 4u;
        i_cursor += 6u;
    }

    // -Z face: on the mn.z plane.
    if ((face_mask & FACE_NZ) != 0u) {
        emit_quad(v_cursor, i_cursor,
            vec3(mn.x, mn.y, mn.z),
            vec3(mx.x, mn.y, mn.z),
            vec3(mx.x, mx.y, mn.z),
            vec3(mn.x, mx.y, mn.z),
            color);
        v_cursor += 4u;
        i_cursor += 6u;
    }
}
