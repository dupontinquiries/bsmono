# systemd USER unit: autostart tideshell with the cosmic session.
# Install ONLY after a manual run-in-session.sh test passed (DEPLOY-FP5.md, stage 5):
#   install -Dm644 tideshell.service ~/.config/systemd/user/tideshell.service
#   systemctl --user daemon-reload && systemctl --user enable --now tideshell.service
# Undo:
#   systemctl --user disable --now tideshell.service
# Logs (engine trace): journalctl --user -u tideshell -f
[Unit]
Description=tideshell touch shell (edge gestures, switcher, control center)
PartOf=graphical-session.target
After=graphical-session.target
# A crash loop must not spin: stop after 5 failures in 60 s. These belong in [Unit];
# under [Service] systemd ignores them ("Unknown key") and the limit never applied.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=%h/.local/bin/tideshell
Environment=TIDESHELL_TRACE=stderr
# Per-phone settings, e.g. which camera the lock-screen pane opens:
#   TIDESHELL_CAMERA=/base/soc@0/cci@ac4a000/i2c-bus@0/camera@1a
#   TIDESHELL_CAMERA_CAPTURE=1280x960
# The leading "-" makes the file optional.
EnvironmentFile=-%h/.config/tideshell/env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
