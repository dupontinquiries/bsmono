# Maintainer: PhotoSync Contributors <photosync@example.com>
pkgname=photosync-system
pkgver=0.1.0
pkgrel=0
pkgdesc="High-compression photo sync system with deduplication and camera GUI"
url="https://github.com/photosync/photosync-system"
arch="all"
license="MIT OR Apache-2.0"
depends="
    syncthing
    zstd
    sqlite
    libcamera
    qt5-qtbase
    qt5-qtdeclarative
    qt5-qtquickcontrols2
    qt5-qtmultimedia
    mesa-gbm
    mesa-egl
    "
makedepends="
    cargo
    rust
    cmake
    sqlite-dev
    zstd-dev
    qt5-qtbase-dev
    qt5-qtdeclarative-dev
    qt5-qtquickcontrols2-dev
    qt5-qtmultimedia-dev
    libcamera-dev
    mesa-dev
    libdrm-dev
    "
install="$pkgname.post-install"
subpackages="$pkgname-doc $pkgname-gui"
source="$pkgname-$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"

build() {
    # Build Rust components
    cargo build --release --locked
    
    # Build Qt GUI
    cd gui
    mkdir -p build
    cd build
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    make
    cd ../..
}

check() {
    cargo test --release --locked
}

package() {
    # Install binaries
    install -Dm755 target/release/photosync-daemon \
        "$pkgdir"/usr/bin/photosync-daemon
    install -Dm755 target/release/photosync-cli \
        "$pkgdir"/usr/bin/photosync-cli
    
    # Install setup script
    install -Dm755 scripts/setup-syncthing.sh \
        "$pkgdir"/usr/bin/photosync-setup
    
    # Install systemd service (for systemd-based Alpine)
    install -Dm644 systemd/photosync.service \
        "$pkgdir"/usr/lib/systemd/user/photosync.service
    
    # Install OpenRC service (for Alpine's default init)
    install -Dm755 packaging/apk/photosync.initd \
        "$pkgdir"/etc/init.d/photosync
    install -Dm644 packaging/apk/photosync.confd \
        "$pkgdir"/etc/conf.d/photosync
    
    # Create state directory
    install -dm755 "$pkgdir"/var/lib/photosync
    
    # Install documentation
    install -Dm644 README.md \
        "$pkgdir"/usr/share/doc/$pkgname/README.md
}

gui() {
    pkgdesc="$pkgdesc (camera GUI)"
    depends="$pkgname=$pkgver-r$pkgrel"
    
    # Install GUI from build directory
    cd "$builddir"/gui/build
    DESTDIR="$subpkgdir" make install
    
    # Install GUI documentation
    install -Dm644 "$builddir"/gui/README.md \
        "$subpkgdir"/usr/share/doc/$pkgname/GUI-README.md
}

sha512sums=""
