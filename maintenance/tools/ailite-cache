#!/bin/sh
# ailite-cache — make cargo's warm state survive a sandbox reset.
#
# The problem: a fresh sandbox re-materializes the source tree with NEW mtimes
# and an empty target/, so a build that would be a 0.1 s incremental no-op
# becomes a full cold build. Two facts make this fixable on stable cargo:
#   1. Registry/git dependencies are treated as immutable — cargo does not
#      mtime-check their sources. A restored artifact cache stays fresh for
#      ALL external deps automatically.
#   2. Only workspace-local crates are mtime-checked. If local sources carry
#      the SAME fixed timestamp at prewarm time and at restore time, nothing
#      recompiles at all.
# Measured in-sandbox (crypto-kit, 53 crates): cold 8.9 s -> after reset with
# restore+touch: 0.12 s, zero units recompiled. Restore must land at the SAME
# absolute path the cache was built at (fingerprints embed paths).
#
# Usage (run from the workspace root):
#   ailite-cache touch                  # pin all source mtimes to a fixed epoch
#   ailite-cache save    CACHE.tar DIR  # snapshot artifact dir (target/ or build-dir)
#   ailite-cache restore CACHE.tar DIR  # unpack snapshot, then re-pin mtimes
#
# Prewarm recipe (once, output CACHE.tar is what you hand to the next sandbox):
#   ailite-cache touch
#   AILITE_BUILD_DIR=/tmp/bd cargo ailite check   # or test/build
#   ailite-cache save cache.tar /tmp/bd
# Each later sandbox/message:
#   ailite-cache restore cache.tar /tmp/bd        # then check is a ~0.1 s no-op
#
# Optional extras, same idea, bigger scope:
#   * also save/restore $CARGO_HOME/registry to skip the network fetch (~4 s
#     per 300 crates here);
#   * nightly alternative to mtime pinning: -Zchecksum-freshness (both at
#     prewarm and at restore) — not used here, stable suffices.

set -eu
EPOCH="${AILITE_EPOCH:-2001-09-09 01:46:40}"   # any fixed instant; must match across runs

pin_mtimes() {
  # local sources only; leave .git and artifact dirs alone
  find . -name .git -prune -o -name target -prune -o -type f -print0 \
    | xargs -0 -r touch -d "$EPOCH"
  echo "ailite-cache: pinned source mtimes under $(pwd) to '$EPOCH'" >&2
}

cmd="${1:-}"; [ $# -gt 0 ] && shift || true
case "$cmd" in
  touch)
    pin_mtimes ;;
  save)
    tar="${1:?usage: ailite-cache save CACHE.tar DIR}"; dir="${2:?need DIR}"
    tar -C "$(dirname "$dir")" -cf "$tar" "$(basename "$dir")"
    echo "ailite-cache: saved $dir -> $tar ($(du -sh "$tar" | cut -f1))" >&2 ;;
  restore)
    tar="${1:?usage: ailite-cache restore CACHE.tar DIR}"; dir="${2:?need DIR}"
    mkdir -p "$(dirname "$dir")"
    tar -C "$(dirname "$dir")" -xf "$tar"
    pin_mtimes
    echo "ailite-cache: restored $tar -> $dir" >&2 ;;
  *)
    sed -n '2,30p' "$0" >&2; exit 2 ;;
esac
