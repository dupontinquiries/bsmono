+        // The resulting grid is uploaded to moisture_tex in the command
+        // recording below, before the color pass.
+        {
+            let now = std::time::Instant::now();
+            let dt = self
+                .moisture_last_tick
+                .map(|p| now.duration_since(p).as_secs_f32())
+                .unwrap_or(1.0 / 60.0)
+                .clamp(0.0, 0.1);
+            self.moisture_last_tick = Some(now);
+
+            let wind = [atmos.wind_xz[0], atmos.wind_xz[1]];
+            let clamp = crate::debug_settings::DEBUG
+                .advect_clamp
+                .load(std::sync::atomic::Ordering::Relaxed);
+            // Tuned for visibility: low capacity + brisk evaporation so
+            // condensate forms over/downwind of the procedural "lakes".
+            let params = ClimateParams {
+                capacity_base: 0.15,
+                capacity_temp_k: 1.0,
+                evap_rate: 0.25,
+                mix_rate: 0.03,
+                ambient: 0.08,
+                rain_rate: 0.08,
+            };
+            let temp = 0.30_f32; // TODO: real diurnal temperature
+
+            self.moisture_field.begin_tick();
+            self.moisture_field.advect(dt, clamp, |_x, _z| wind);
+            self.moisture_field.step_climate(&params, |x, z| {
+                let wx = MOIST_ORIGIN[0] + x as f32 * MOIST_CELL;
+                let wz = MOIST_ORIGIN[1] + z as f32 * MOIST_CELL;
+                let n = (wx * 0.013).sin() * (wz * 0.011).cos(); // low-freq lakes
+                ClimateSample {
+                    temperature: temp,
+                    is_water: if n > 0.35 { 1.0 } else { 0.0 },
+                }
+            });
+
+            // Visible condensate per cell -> upload grid (take/return the Vec to
+            // keep field + grid borrows disjoint).
+            let mut grid = std::mem::take(&mut self.moisture_grid);
+            grid.clear();
+            for z in 0..MOIST_W {
+                for x in 0..MOIST_W {
+                    grid.push(self.moisture_field.fog_density(&params, x, z, temp));
+                }
+            }
+            self.moisture_grid = grid;
+        }
