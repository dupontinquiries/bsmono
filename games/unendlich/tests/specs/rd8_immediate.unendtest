# RD=8 with VSYNC=immediate — tearing allowed, zero present-side
# latency. Tests whether MAILBOX is still queueing any frames at
# heavy load (it shouldn't be, in theory — newest-wins is the
# whole point — but driver behavior on Asahi could surprise).
#
# If `cpu_acquire_p50_ms` between rd8_smoke (MAILBOX) and this spec
# (IMMEDIATE) is essentially identical, MAILBOX is fully effective
# and IMMEDIATE buys nothing extra. If IMMEDIATE shows lower acquire
# times, MAILBOX has residual queueing we'd want to address.

spec_version = 1
name = "rd8_immediate"
description = """
RD=8 with IMMEDIATE present mode (tearing allowed). Used to detect
whether MAILBOX still incurs any swapchain queueing at heavy load.
"""

[engine]
binary = "unendlich-world"
duration_ms = 30000

[env]
UNENDLICH_RENDER_DISTANCE = "8"
UNENDLICH_VSYNC = "immediate"
UNENDLICH_INDIRECT = "1"
UNENDLICH_LOD_FACTORS = "4,8,16,32"

[expect]
duration_completed = true
rendering_max = { min = 50 }
