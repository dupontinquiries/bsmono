# chug_capture_rd8 — 30 second walk-around at rd=8 to provoke chug events.
#
# Variant of chug_capture for testing shadow-resolution impact on chug
# severity. At rd=8 the chug signal is dominant (shadow >8ms in 96.5%
# of frames in v0.24.3-upload-pressure baseline); this spec is the
# A/B platform for UNENDLICH_SHADOW_MAP_SIZE.
#
# Run with the env override to test different shadow sizes:
#   UNENDLICH_SHADOW_MAP_SIZE=2048 (default) — baseline
#   UNENDLICH_SHADOW_MAP_SIZE=1024 — 4× fewer fragments
#   UNENDLICH_SHADOW_MAP_SIZE=512  — 16× fewer fragments
#
# Note: env vars set on the command line don't override spec [env] in
# the launcher. Either edit this file's [env] block to set the size,
# OR run with the bare engine binary using env-var prefix.

spec_version = 1
name = "chug_capture_rd8"
description = "30s rd=8 walk-around for chug investigation (shadow-bound)."

[engine]
binary = "unendlich-world"
duration_ms = 30000

[env]
UNENDLICH_RENDER_DISTANCE = "8"

[expect]
duration_completed = true
