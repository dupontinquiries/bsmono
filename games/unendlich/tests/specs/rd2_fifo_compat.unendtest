# Same workload as rd2_smoke, but explicitly forces FIFO present
# mode (the old c.9-and-earlier default). Used to A/B-test the c.10
# no-latency baseline change: run this spec AND rd2_smoke, compare
# the resulting CPU `acquire` and `wait_fences` distributions to see
# how much latency was being absorbed by the FIFO present.

spec_version = 1
name = "rd2_fifo_compat"
description = """
A/B comparison spec: same as rd2_smoke but with VSYNC=1 forcing
FIFO present mode. Comparing acquire_p50 between the two specs
tells us how much CPU stalling was happening per frame at low
load.
"""

[engine]
binary = "unendlich-world"
duration_ms = 5000

[env]
UNENDLICH_RENDER_DISTANCE = "2"
UNENDLICH_VSYNC = "1"
UNENDLICH_INDIRECT = "1"
UNENDLICH_LOD_FACTORS = "4,8,16,32"

[expect]
duration_completed = true
rendering_max = { min = 1 }
# No shadow assertion — the FIFO path has historically had heavier
# wait_fences tails that drag shadow numbers around. Just verify
# rendering happened.
