# Heavy workload at RD=8 with the no-latency baseline defaults
# (MAILBOX, FIF=1, late-input). The 30s duration ensures we hit
# steady state (chunks loaded, mesh queue settled).
#
# Companion to rd8_fifo_compat for A/B comparison: do the c.10
# defaults handle heavy load better than FIFO/FIF=2 did? The
# `loaded_max` and `rendering_max` should be similar between the
# two; the differences should appear in `cpu_acquire_p50_ms`,
# `cpu_wait_fences_p99_ms`, and the total frame count `n`.

spec_version = 1
name = "rd8_smoke"
description = """
Heavy workload at RD=8, 30s duration. No-latency baseline defaults
(MAILBOX present mode, FIF=1, late-input poll). Steady-state test
for the c.10 ship.

Same workload as the c.5/c.7 bisect runs — should be directly
comparable to those data points if we want to look at perf
trajectory across the c.5→c.10 arc.
"""

[engine]
binary = "unendlich-world"
duration_ms = 30000

[env]
UNENDLICH_RENDER_DISTANCE = "8"
UNENDLICH_INDIRECT = "1"
UNENDLICH_LOD_FACTORS = "4,8,16,32"

[expect]
duration_completed = true
rendering_max = { min = 50 }    # at RD=8 we expect ~130 max visible chunks
loaded_max = { min = 300 }      # similarly, ~500 max loaded
