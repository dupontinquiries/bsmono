# Minimal smoke test: tiny RD, short duration. Should always pass on a
# working build — its job is to verify the spec/result/launcher
# plumbing, not to make a perf claim.
#
# v0.24.2c.10: dropped UNENDLICH_VSYNC=1. The no-latency baseline ship
# made MAILBOX the default present mode; this spec exercises that. To
# A/B-test against the old FIFO-with-stall behavior, set
# UNENDLICH_VSYNC=1 in the [env] table.

spec_version = 1
name = "rd2_smoke"
description = """
Tiny RD, short duration. Verifies the binary can boot, render a few
frames, and shut down cleanly. No perf claim — assertions just check
the basic loop ran and rendered something.

c.10 update: MAILBOX present mode by default (low-latency, newest-wins).
"""

[engine]
binary = "unendlich-world"
duration_ms = 5000

[env]
UNENDLICH_RENDER_DISTANCE = "2"
UNENDLICH_INDIRECT = "1"
UNENDLICH_LOD_FACTORS = "4,8,16,32"

[expect]
duration_completed = true
rendering_max = { min = 1 }
shadow_p50_ms = { max = 200 }
