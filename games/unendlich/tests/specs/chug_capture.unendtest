# chug_capture — 30 second walk-around at rd=2 to provoke chug events.
#
# Pairs with the v0.24.3+ wait_fences_spike and gpu_spike side-channel
# events. Run this spec, walk around (cross chunk boundaries), then
# `unendlich-analyze wait_spikes` and `gpu_spikes` against the resulting
# events.jsonl.

spec_version = 1
name = "chug_capture"
description = "30s rd=2 walk-around for chug investigation."

[engine]
binary = "unendlich-world"
duration_ms = 30000

[env]
UNENDLICH_RENDER_DISTANCE = "2"

[expect]
duration_completed = true
