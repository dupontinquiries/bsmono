#version 450
// Probe that exercises the REAL engine octree traversal (octree_sample.glsl)
// so it can be diffed against the Rust OctreeArray::sample. One invocation per
// cell of a 32^3 chunk; writes the sampled block id to the output buffer.
#extension GL_GOOGLE_include_directive : require

#include "octree_types.glsl"

layout(std430, set = 0, binding = 0) readonly buffer OctreeNodes {
    OctreeNode nodes[];
};

#include "octree_sample.glsl"

layout(std430, set = 0, binding = 1) writeonly buffer Out {
    uint out_blocks[];
};

layout(push_constant) uniform PC {
    uint base;  // root node index (0 for a single chunk)
    uint n;     // total cell count (32^3)
} pc;

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) { return; }
    uint x = i & 31u;
    uint y = (i >> 5u) & 31u;
    uint z = (i >> 10u) & 31u;
    out_blocks[i] = octree_sample(pc.base, uvec3(x, y, z));
}
