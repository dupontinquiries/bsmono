#version 450
// Probe that exercises `cell_density` from `froxel_fill.comp` for GPU-vs-CPU
// parity testing (froxel_parity.rs). `cell_density` isn't factored into a
// shared .glsl include, so its body is copied here VERBATIM — kept
// byte-identical to froxel_fill.comp's own copy; see that file for the
// canonical source and the physical/design rationale in its comments. If
// froxel_fill.comp's cell_density ever changes, this copy must be updated to
// match or the parity test stops meaning anything (it would just be
// comparing two independently-maintained implementations).
//
// One invocation per query world position. Reads a small push-constant
// block carrying the atmosphere/wind/camera state a real frame would supply
// via the UBO — small and explicit here since a probe has no reason to
// stand up the full CameraUbo layout.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer QueryPositions {
    vec4 positions[]; // xyz = world position, w unused
};

layout(std430, set = 0, binding = 1) writeonly buffer OutDensities {
    float densities[];
};

layout(push_constant) uniform PC {
    vec4 camera_pos;      // xyz
    vec4 wind_and_time;   // x=wind.x, y=wind.y, z=humidity, w=time_seconds
    vec4 base_density_pn; // x=base_density, y=query_count
} pc;

// ─── Copied verbatim from froxel_fill.comp ──────────────────────────
float hash13(vec3 p3) {
    p3 = fract(p3 * 0.1031);
    p3 += dot(p3, p3.zyx + 31.32);
    return fract((p3.x + p3.y) * p3.z);
}

float value_noise_3d(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);
    float c000 = hash13(i + vec3(0,0,0));
    float c100 = hash13(i + vec3(1,0,0));
    float c010 = hash13(i + vec3(0,1,0));
    float c110 = hash13(i + vec3(1,1,0));
    float c001 = hash13(i + vec3(0,0,1));
    float c101 = hash13(i + vec3(1,0,1));
    float c011 = hash13(i + vec3(0,1,1));
    float c111 = hash13(i + vec3(1,1,1));
    float x00 = mix(c000, c100, u.x);
    float x10 = mix(c010, c110, u.x);
    float x01 = mix(c001, c101, u.x);
    float x11 = mix(c011, c111, u.x);
    float y0  = mix(x00, x10, u.y);
    float y1  = mix(x01, x11, u.y);
    return mix(y0, y1, u.z);
}

float fbm2(vec3 p) {
    float n  = value_noise_3d(p) * 0.65;
          n += value_noise_3d(p * 2.7) * 0.35;
    return n;
}

const float GROUND_FOG_Y    = 8.0;
const float GROUND_FOG_STR  = 1.1;
const float GROUND_FOG_FALL = 0.06;
const float DENSITY_MUL     = 1.0;

float cell_density(vec3 world_pos) {
    float alt_y = clamp(world_pos.y, -20.0, 200.0);

    float base_density   = pc.base_density_pn.x;
    float humidity       = pc.wind_and_time.z;
    float humidity_curve = pow(humidity, 1.6);
    float density_at_player = base_density * mix(0.6, 2.2, humidity_curve);

    float height_fog       = exp(-alt_y * 0.05);
    float altitude_rolloff = exp(-max(alt_y - 60.0, 0.0) * 0.01);

    float time_seconds = pc.wind_and_time.w;
    vec2  wind_xy      = pc.wind_and_time.xy;
    float wind_speed   = length(wind_xy);
    vec3  wind_offset  = vec3(wind_xy.x, 0.0, wind_xy.y) * time_seconds;
    const float MOISTURE_FREQ = 0.05;
    const float STREAK_GAIN   = 2.0;
    const float STREAK_MAX    = 5.0;
    vec3 mp = (world_pos - wind_offset) * MOISTURE_FREQ;
    if (wind_speed > 1e-4) {
        vec2  wdir    = wind_xy / wind_speed;
        float along   = dot(mp.xz, wdir);
        vec2  across  = mp.xz - along * wdir;
        float stretch = 1.0 + min(wind_speed * STREAK_GAIN, STREAK_MAX);
        mp.xz = across + (along / stretch) * wdir;
    }
    float moisture = smoothstep(0.15, 0.85, fbm2(mp));
    float altitude_moisture_bias = clamp(1.5 - alt_y * 0.012, 0.2, 1.4);
    float wisp_factor  = mix(0.4, 1.6, moisture) * altitude_moisture_bias;

    float dist_from_cam = length(world_pos - pc.camera_pos.xyz);
    float proximity_clear = smoothstep(0.0, 3.0, dist_from_cam);

    float ground_fog = 1.0
        + GROUND_FOG_STR * exp(-max(alt_y - GROUND_FOG_Y, 0.0) * GROUND_FOG_FALL);

    float density = density_at_player
                  * DENSITY_MUL
                  * (height_fog * 0.5 + 1.0)
                  * ground_fog
                  * altitude_rolloff
                  * wisp_factor
                  * proximity_clear;
    density = min(density, 2.0);

    return density;
}
// ─── End verbatim copy ───────────────────────────────────────────────

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint n = uint(pc.base_density_pn.y);
    if (i >= n) { return; }
    densities[i] = cell_density(positions[i].xyz);
}
