#version 450
// neural_feat_gbuf.comp — feature pass over the IMAGE G-buffer, with the octree
// hint-ray march (r310). Per covered pixel: base-8 features from the G-buffer + 6
// occlusion hint rays marched through the octree from the surface point (1 toward
// the sun, 5 over the upper hemisphere). The rays use octree_sample_ext to skip by
// leaf size (a 32-wide air leaf advances 32 blocks in one step), not a fixed march.
//
// Per-pixel base lookup across chunks comes from base_grid[]: per-chunk root indices
// (EMPTY = 0xFFFFFFFF) the renderer rebuilds each frame, indexed by chunk coord
// relative to grid_origin (extent grid_dims). nodes[] is the global octree node
// table (the pool buffer). worldpos→chunk is floor(p/32); chunk-local is floor(p) -
// chunk*32 in [0,32).
//
// Output stride 14 = lean net input: [0:3]normal [3:6]albedo [6]sun·n [7]height
// [8:14]hints. Encoding MUST match the trainer (B2) — retrain on what this emits.

#extension GL_GOOGLE_include_directive : require
#include "octree_types.glsl"
layout(std430, set = 0, binding = 4) readonly buffer OctreeNodes { OctreeNode nodes[]; };
#include "octree_sample.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D g_normal;
layout(set = 0, binding = 1) uniform sampler2D g_albedo;
layout(set = 0, binding = 2) uniform sampler2D g_worldpos;
layout(std430, set = 0, binding = 3) writeonly buffer Feat { float feat[]; };
layout(std430, set = 0, binding = 5) readonly buffer BaseGrid { uint base_grid[]; };

layout(push_constant) uniform PC {
    vec4 sun_dir;      // xyz = normalized sun direction (world)
    uint width;
    uint height;
    float y_scale;
    uint _pad0;
    ivec4 grid_origin; // xyz = min chunk coord covered by base_grid
    uvec4 grid_dims;   // xyz = base_grid extent in chunks
} pc;

const uint EMPTY = 0xFFFFFFFFu;
const float MAXD = 32.0; // max march distance (blocks)

// Occlusion along `dir` from world point `org`. Returns hit distance / MAXD in
// [0,1], or 1.0 if open (no solid within MAXD, or the ray leaves loaded chunks).
float hint_ray(vec3 org, vec3 dir) {
    float t = 0.25;
    for (int i = 0; i < 24; ++i) {
        if (t >= MAXD) return 1.0;
        vec3 p = org + dir * t;
        ivec3 bc = ivec3(floor(p / 32.0));
        ivec3 rel = bc - pc.grid_origin.xyz;
        if (any(lessThan(rel, ivec3(0))) || any(greaterThanEqual(rel, ivec3(pc.grid_dims.xyz)))) {
            return 1.0; // left the loaded grid → open
        }
        uint gi = uint((rel.z * int(pc.grid_dims.y) + rel.y) * int(pc.grid_dims.x) + rel.x);
        uint base = base_grid[gi];
        if (base == EMPTY) return 1.0; // chunk not resident → open
        uvec3 local = uvec3(ivec3(floor(p)) - bc * 32);
        uvec3 lo;
        uint ls;
        uint block = octree_sample_ext(base, local, lo, ls);
        if (block != 0u) return t / MAXD; // solid → occluded at t
        // Air leaf: advance just past its far face along the ray.
        vec3 leaf_min = vec3(bc) * 32.0 + vec3(lo);
        vec3 leaf_max = leaf_min + vec3(float(ls));
        float tx = (dir.x > 0.0) ? (leaf_max.x - p.x) / dir.x
                 : (dir.x < 0.0) ? (leaf_min.x - p.x) / dir.x : 1e30;
        float ty = (dir.y > 0.0) ? (leaf_max.y - p.y) / dir.y
                 : (dir.y < 0.0) ? (leaf_min.y - p.y) / dir.y : 1e30;
        float tz = (dir.z > 0.0) ? (leaf_max.z - p.z) / dir.z
                 : (dir.z < 0.0) ? (leaf_min.z - p.z) / dir.z : 1e30;
        float adv = min(tx, min(ty, tz));
        t += max(adv, 0.0625) + 0.03; // step past the leaf boundary
    }
    return 1.0;
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= pc.width || y >= pc.height) {
        return;
    }
    ivec2 px = ivec2(int(x), int(y));
    uint row = (y * pc.width + x) * 14u;

    vec3 n    = texelFetch(g_normal, px, 0).xyz;
    vec3 alb  = texelFetch(g_albedo, px, 0).xyz;
    vec3 wpos = texelFetch(g_worldpos, px, 0).xyz;
    vec3 nn = normalize(n + vec3(1e-6));

    float ndotsun = max(dot(nn, pc.sun_dir.xyz), 0.0);
    float height  = wpos.y * pc.y_scale;

    feat[row + 0u] = n.x;
    feat[row + 1u] = n.y;
    feat[row + 2u] = n.z;
    feat[row + 3u] = alb.x;
    feat[row + 4u] = alb.y;
    feat[row + 5u] = alb.z;
    feat[row + 6u] = ndotsun;
    feat[row + 7u] = height;

    // Lift the ray origin off the surface along the normal to avoid self-hit.
    vec3 org = wpos + nn * 0.5;
    // 1 sun ray + 5 fixed upper-hemisphere rays (world space). The net retrains on
    // whatever these emit (B2), so the exact directions only need to be consistent.
    feat[row + 8u]  = hint_ray(org, pc.sun_dir.xyz);
    feat[row + 9u]  = hint_ray(org, vec3(0.0, 1.0, 0.0));
    feat[row + 10u] = hint_ray(org, normalize(vec3(0.6, 0.8, 0.0)));
    feat[row + 11u] = hint_ray(org, normalize(vec3(-0.6, 0.8, 0.0)));
    feat[row + 12u] = hint_ray(org, normalize(vec3(0.0, 0.8, 0.6)));
    feat[row + 13u] = hint_ray(org, normalize(vec3(0.0, 0.8, -0.6)));
}
