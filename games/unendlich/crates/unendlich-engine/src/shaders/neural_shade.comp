#version 450
// neural_shade.comp — fused per-pixel neural deferred shading.
//
// Runs the whole shading MLP (3 Q8 linear layers + silu) in ONE compute pass:
// one invocation per pixel reads its feature vector, runs the net, writes RGB.
// Weights are Q8_0 (int8 packed 4/u32, one f32 scale per 32-block) — the exact
// layout of the bit-exact `linear_q8_0` kernel — with bias folded into a virtual
// input column (index == FIN is 1.0, padding above it is 0.0).
//
// Bindings (matches the host's input-then-output order):
//   0 feat[M*FIN0]   1 qw1 2 sc1   3 qw2 4 sc2   5 qw3 6 sc3   7 out[M*3]
// Production note: A[]/B[] are private arrays sized for the widest layer; on a
// real GPU you'd tile the hidden dim, but the math here is the reference.

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly  buffer Feat { float feat[]; };
layout(std430, binding = 1) readonly  buffer QW1  { uint  qw1[];  };
layout(std430, binding = 2) readonly  buffer SC1  { float sc1[];  };
layout(std430, binding = 3) readonly  buffer QW2  { uint  qw2[];  };
layout(std430, binding = 4) readonly  buffer SC2  { float sc2[];  };
layout(std430, binding = 5) readonly  buffer QW3  { uint  qw3[];  };
layout(std430, binding = 6) readonly  buffer SC3  { float sc3[];  };
layout(std430, binding = 7) writeonly buffer Out  { float outc[]; };

layout(push_constant) uniform PC {
    uint M;       // pixels
    uint FIN0;    // real features into layer 1 (104)
    uint n1; uint k1;   // layer 1 out / padded-in
    uint n2; uint k2;   // layer 2
    uint n3; uint k3;   // layer 3
};

const uint KMAX = 256u;   // >= max(n1, n2) + slack

float silu(float x) { return x / (1.0 + exp(-x)); }

// signed int8 at column i of packed row -> matches linear_q8_0 extraction
int qval(uint packed, uint i) { return bitfieldExtract(int(packed), int((i & 3u) * 8u), 8); }

void main() {
    uint r = gl_GlobalInvocationID.x;
    if (r >= M) return;

    float A[KMAX];   // current activations
    float B[KMAX];   // next activations

    // ---- layer 1: feat (augmented) -> n1, silu ----
    for (uint j = 0u; j < n1; ++j) {
        float acc = 0.0;
        uint kb = k1 >> 5;
        for (uint i = 0u; i < k1; ++i) {
            float x = (i < FIN0) ? feat[r * FIN0 + i] : ((i == FIN0) ? 1.0 : 0.0);
            uint widx = j * k1 + i;
            int  q = qval(qw1[widx >> 2], i);
            float w = float(q) * sc1[j * kb + (i >> 5)];
            acc += x * w;
        }
        A[j] = silu(acc);
    }

    // ---- layer 2: A(augmented, FIN=n1) -> n2, silu ----
    for (uint j = 0u; j < n2; ++j) {
        float acc = 0.0;
        uint kb = k2 >> 5;
        for (uint i = 0u; i < k2; ++i) {
            float x = (i < n1) ? A[i] : ((i == n1) ? 1.0 : 0.0);
            uint widx = j * k2 + i;
            int  q = qval(qw2[widx >> 2], i);
            float w = float(q) * sc2[j * kb + (i >> 5)];
            acc += x * w;
        }
        B[j] = silu(acc);
    }

    // ---- layer 3: B(augmented, FIN=n2) -> n3 (RGB), no silu ----
    for (uint j = 0u; j < n3; ++j) {
        float acc = 0.0;
        uint kb = k3 >> 5;
        for (uint i = 0u; i < k3; ++i) {
            float x = (i < n2) ? B[i] : ((i == n2) ? 1.0 : 0.0);
            uint widx = j * k3 + i;
            int  q = qval(qw3[widx >> 2], i);
            float w = float(q) * sc3[j * kb + (i >> 5)];
            acc += x * w;
        }
        outc[r * 3u + j] = clamp(acc, 0.0, 1.0);
    }
}
