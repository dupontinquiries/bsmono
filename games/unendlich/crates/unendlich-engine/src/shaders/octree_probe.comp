// octree_probe.comp — GPU verification of the on-the-wire octree.
//
// v0.24.26-octree-on-gpu. Sole consumer of the octree storage buffer
// in this ship. Each invocation reads one query `(base, x, y, z)`,
// walks the octree on the GPU via `octree_sample()`, and writes the
// resulting `block_id` to a parallel result buffer the CPU reads
// back.
//
// Falsification gate: the binary asserts that the GPU result equals
// `OctreeArray::sample(x, y, z)` computed in Rust. If the GLSL
// `OctreeNode` layout, `octree_sample()` math, or the SSBO upload
// path drift, this catches it on the first run with
// `UNENDLICH_OCTREE_VERIFY=1`.
//
// This shader has no production responsibility — the renderer can
// run without it. It exists to keep the wire format honest as more
// consumers migrate to the octree.

#version 450
#extension GL_GOOGLE_include_directive : require

// Types + constants must come BEFORE the SSBO declaration so
// `OctreeNode` is in scope when the SSBO references it.
#include "octree_types.glsl"

// Binding 0: every loaded chunk's octree nodes, flat-packed.
// Per-chunk slices are `[base..base+count)`; the query carries `base`.
layout(std430, set = 0, binding = 0) readonly buffer OctreeNodes {
    OctreeNode nodes[];
};

// Binding 1: one uvec4 per query. .x = base_node, .yzw = chunk-local
// (x, y, z) coords in [0, 32).
layout(std430, set = 0, binding = 1) readonly buffer Queries {
    uvec4 queries[];
};

// Binding 2: one uint per query — the sampled block_id (raw u8
// widened to u32). CPU reads this back and compares against
// `OctreeArray::sample`.
layout(std430, set = 0, binding = 2) writeonly buffer Results {
    uint results[];
};

// Sample function comes AFTER the SSBO so it can reference nodes[].
#include "octree_sample.glsl"

layout(push_constant) uniform PC {
    uint query_count;
} pc;

// 64 threads/group matches the CPU-side WORKGROUP_SIZE constant in
// octree_probe_pipeline.rs.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.query_count) {
        return;
    }
    uvec4 q = queries[idx];
    uint base = q.x;
    uvec3 pos = q.yzw;
    results[idx] = octree_sample(base, pos);
}
