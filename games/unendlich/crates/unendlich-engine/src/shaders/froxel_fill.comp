#version 450
//
// froxel_fill.comp — per-frame compute pass that fills the froxel
// scattering volume.
//
// Each invocation handles ONE froxel cell. The volume is
// FROXEL_X × FROXEL_Y × FROXEL_Z = 160 × 90 × 64 = 921,600 froxels.
// Workgroup size 8×8×1 → dispatch (20, 12, 64) workgroups.
//
// Per-froxel work:
//   1. Compute the froxel's world-space position from its
//      (x_tile, y_tile, z_slice) using inverse view-projection +
//      logarithmic Z-slice mapping.
//   2. Sample local atmospheric density: humidity field × 3D fbm
//      noise advected by wind. Same fbm flavor as v0.15's per-fragment
//      march, just done once per froxel instead of per fragment.
//   3. Project the world position into shadow-map clip-space and
//      sample the shadow map to determine if the froxel is in
//      direct sunlight.
//   4. Compute single-scatter in-scattering: density × HG-phase ×
//      sun_color × shadow.
//   5. Write `vec4(scattered_rgb, transmittance)` for this froxel.
//
// The fragment shader will then transform v_world_pos → froxel
// UVW and trilinearly sample this volume to get the fog
// contribution for that fragment, in O(1) per fragment instead of
// O(FOG_STEPS).

#extension GL_EXT_samplerless_texture_functions : require

// ─── Workgroup configuration ────────────────────────────────────────
// 8×8×1 = 64 threads, fits a Metal SIMD group well.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// ─── Bindings ───────────────────────────────────────────────────────
//
// Mirror of the graphics-side CameraUbo, padded to match. We need
// view_proj, camera_pos, sun_dir, sun_color, sky_color,
// atmos_params (density, humidity, temperature, time_of_day),
// wind_params, and light_view_proj. The other fields are unused
// here but present in the struct for layout match.
layout(set = 0, binding = 0) uniform CameraUbo {
    mat4 view_proj;
    vec4 camera_pos;
    vec4 sun_dir;
    vec4 sun_color;
    vec4 sky_color;
    vec4 ambient_color;
    vec4 atmos_params;
    vec4 wind_params;
    vec4 viewport_rect;
    mat4 light_view_proj;
} ubo;

layout(set = 0, binding = 1) uniform sampler2DShadow shadow_map;

// The output froxel volume. Storage image — we WRITE per-froxel
// scattering and transmittance. The fragment shader (in chunk.frag)
// reads from a separate sampled view of the same image.
layout(set = 0, binding = 2, rgba16f) uniform writeonly image3D froxel_out;

// Push constants: inverse view-projection so we can unproject froxel
// (x,y,z) into world position, plus the camera's near/far depth
// values needed for the inverse log-Z slice mapping.
layout(push_constant) uniform PushConstants {
    mat4 inv_view_proj;
    vec4 cam_near_far;          // x = near, y = far, zw = unused
    vec4 froxel_extent_packed;  // xyz = (FROXEL_X, FROXEL_Y, FROXEL_Z), w = unused
    vec4 froxel_near_far;       // x = FROXEL_NEAR_M, y = FROXEL_FAR_M, zw = unused
} pc;

// ─── AAA volumetric tunables (r68-03) ───────────────────────────────
//
// Exposed as GLSL consts with sane defaults so the operator can A/B on
// the M2 by editing + recompiling. They are DESCRIPTOR-STABLE: no new
// binding/UBO field, so descriptor_gate / ubo_parity stay green. To
// promote any of these to a live uniform, drop it into one of the
// already-present-but-unused CameraUbo lanes (`ambient_color.*`,
// `atmos_params.z`/temperature, or `viewport_rect.*`) and set it on the
// Rust side — the struct layout does not change. Documented in the
// return note.
const float PHASE_G_FWD   = 0.72;   // forward Mie lobe (crisper shafts than 0.6)
const float PHASE_G_BACK  = -0.22;  // gentle back-scatter glow around the sun
const float PHASE_BLEND   = 0.70;   // 0 = all back lobe, 1 = all forward
const float SHAFT_INTENSITY = 1.25; // god-ray sun in-scatter gain (1.0 = neutral)
const float DENSITY_MUL   = 1.0;    // global fog density scale
const vec3  SCATTER_TINT  = vec3(1.0, 1.0, 1.0); // sun scattering colour multiplier

// Valley / ground fog: extra density that pools low and thins with height.
const float GROUND_FOG_Y    = 8.0;   // reference ground/valley height (world Y, m)
const float GROUND_FOG_STR   = 1.1;  // peak extra density at/below GROUND_FOG_Y
const float GROUND_FOG_FALL  = 0.06; // e-fold per metre above the ground

// Temporal sampling. The default (no-temporal) path is stable and
// shimmer-free: TEMPORAL_JITTER = 0 means each froxel samples its cell
// centre every frame. FULL temporal reprojection (history blend to kill
// residual noise) needs TWO new resources this shader does NOT bind, to
// stay descriptor-stable:
//   * a prev-frame froxel sampler (set=0, binding=3, rgba16f sampled 3D)
//   * the previous-frame view_proj (e.g. a 2nd push-constant mat4)
// Wire those on the Rust side (pipeline layout + a ping-pong froxel
// image + regenerate the descriptor baseline), then set TEMPORAL_JITTER
// > 0 and blend `froxel_out = mix(reproject(prev, world_pos), cur,
// 1/HISTORY_LEN)`. Until then this stays 0.0 (compiles to a no-op).
const float TEMPORAL_JITTER = 0.0;  // [0,1) Z-slice jitter; 0 = off (default)

// ─── Same hash + fbm as chunk.frag (kept identical so the
// per-fragment fallback march and the per-froxel fill produce the
// same fog when the froxel is queried at the same world position) ──
float hash13(vec3 p3) {
    p3 = fract(p3 * 0.1031);
    p3 += dot(p3, p3.zyx + 31.32);
    return fract((p3.x + p3.y) * p3.z);
}

float value_noise_3d(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);
    float c000 = hash13(i + vec3(0,0,0));
    float c100 = hash13(i + vec3(1,0,0));
    float c010 = hash13(i + vec3(0,1,0));
    float c110 = hash13(i + vec3(1,1,0));
    float c001 = hash13(i + vec3(0,0,1));
    float c101 = hash13(i + vec3(1,0,1));
    float c011 = hash13(i + vec3(0,1,1));
    float c111 = hash13(i + vec3(1,1,1));
    float x00 = mix(c000, c100, u.x);
    float x10 = mix(c010, c110, u.x);
    float x01 = mix(c001, c101, u.x);
    float x11 = mix(c011, c111, u.x);
    float y0  = mix(x00, x10, u.y);
    float y1  = mix(x01, x11, u.y);
    return mix(y0, y1, u.z);
}

float fbm2(vec3 p) {
    float n  = value_noise_3d(p) * 0.65;
          n += value_noise_3d(p * 2.7) * 0.35;
    return n;
}

// ─── Logarithmic Z-slice → view-space depth ─────────────────────────
//
// The Z slice index distributes view-space depth logarithmically so
// near-camera froxels are smaller (more precision) and far-camera
// froxels are larger (cheaper). Inverse formula: given a [0,1] z
// fraction, return the view-space distance.
float view_z_from_slice(float z_norm) {
    // z_norm ∈ [0, 1]. Logarithmic distribution between
    // FROXEL_NEAR_M and FROXEL_FAR_M.
    float near = pc.froxel_near_far.x;
    float far  = pc.froxel_near_far.y;
    return near * pow(far / near, z_norm);
}

// ─── World position from froxel index ───────────────────────────────
//
// The froxel grid tiles the camera frustum. Given the (x, y, z)
// integer froxel indices, return the world-space position of that
// froxel's CENTER. We use the +0.5 offset so the sampled position
// is in the middle of the cell, giving the trilinear sampler
// downstream the right interpolation behavior.
vec3 froxel_to_world_f(vec3 froxel_fidx) {
    // Normalized [0,1] coordinates within the froxel grid. Float index so
    // callers can sub-sample / jitter within a cell (r68-03 temporal hook).
    vec3 uvw = froxel_fidx / pc.froxel_extent_packed.xyz;

    // ─── World-space position from froxel index ─────────────────────
    //
    // Approach: unproject TWO NDC points (near and far) for the same
    // screen-space xy as this froxel, then lerp between them by the
    // logarithmic Z slice fraction. This avoids hairy "what is the
    // camera forward axis" math — the inverse view-projection matrix
    // already handles all of it correctly.
    //
    // Vulkan NDC convention:
    //   - X: -1 (left) to +1 (right). So ndc_x = uvw.x * 2 - 1.
    //   - Y: -1 (top) to +1 (bottom). With our Y-flipped projection
    //         matrix, the top of the screen is ndc_y = -1 and bottom
    //         is +1. So ndc_y = uvw.y * 2 - 1 — same formula as X.
    //         (When we apply the Y-flip in the projection matrix, the
    //         framebuffer ends up the right way up automatically; the
    //         NDC convention for unprojection is unchanged.)
    //   - Z: 0 (near) to 1 (far).
    vec2 ndc_xy = uvw.xy * 2.0 - 1.0;

    // Unproject NDC at near plane (z=0) and far plane (z=1) for this
    // pixel column.
    vec4 world_near_h = pc.inv_view_proj * vec4(ndc_xy, 0.0, 1.0);
    vec4 world_far_h  = pc.inv_view_proj * vec4(ndc_xy, 1.0, 1.0);
    vec3 world_near = world_near_h.xyz / world_near_h.w;
    vec3 world_far  = world_far_h.xyz  / world_far_h.w;

    // We have a ray from world_near to world_far covering the full
    // visible depth range. We want the point on this ray at the
    // logarithmically-distributed view-space distance corresponding
    // to froxel slice uvw.z.
    //
    // Length of the ray segment in world units:
    vec3  ray_full   = world_far - world_near;
    float ray_full_len = length(ray_full);
    vec3  ray_dir    = ray_full / max(ray_full_len, 1e-4);

    // The desired view-space distance at this slice. The ray goes
    // from camera-near out to camera-far; FROXEL_NEAR_M ≤ desired
    // distance ≤ FROXEL_FAR_M, mapped logarithmically.
    float view_z = view_z_from_slice(uvw.z);

    // Distance from camera_pos along the ray to reach the desired
    // forward distance. Because ray_dir is normalized,
    // we just step `view_z` along it from the camera position
    // (NOT from world_near — the camera could be slightly off the ray
    // path due to projection asymmetries). Actually for a perspective
    // projection with the standard near plane, world_near is offset
    // forward from the camera by the near-plane distance along the
    // ray. To compute view-space depth correctly, we want the ray
    // origin AT the camera. So:
    //
    //   point = camera_pos + ray_dir * (view_z / cos_to_forward)
    //
    // where cos_to_forward = dot(ray_dir, camera_forward). We can
    // recover camera_forward by normalizing (world_far - world_near)
    // for the CENTER ray (ndc_xy = 0), but doing this for every
    // froxel is expensive. Cheaper: notice that for a ray emanating
    // from the camera at any angle, the view-space Z of a point on
    // that ray is simply the dot of (point - camera) with the camera
    // forward axis — and that equals view_z by construction if we
    // step view_z along the camera_forward axis times the ratio of
    // ray length to forward projection.
    //
    // Even simpler and correct: lerp world_near to world_far by the
    // fraction (view_z - cam_near) / (cam_far - cam_near) where
    // cam_near and cam_far are the actual camera near/far. This
    // works because the unprojection of NDC z linearly maps clip
    // space, which already accounts for the perspective distortion
    // through the inv_view_proj.
    //
    // BUT the camera's NDC z=0 corresponds to view_z = cam_near, NOT
    // to FROXEL_NEAR_M. So:
    float cam_near = pc.cam_near_far.x;
    float cam_far  = pc.cam_near_far.y;
    float t        = (view_z - cam_near) / max(cam_far - cam_near, 1e-4);
    t = clamp(t, 0.0, 1.0);

    return mix(world_near, world_far, t);
}

// Centre-of-cell convenience wrapper (the +0.5 puts the sample mid-cell).
vec3 froxel_to_world(uvec3 froxel_idx) {
    return froxel_to_world_f(vec3(froxel_idx) + 0.5);
}

// ─── Henyey-Greenstein phase function ───────────────────────────────
//
// Same as chunk.frag's. Strong forward lobe at g=0.6 — Mie scattering
// approximation. Used here to weight in-scatter from sun direction.
float hg_phase(float cos_theta, float g) {
    float g2 = g * g;
    return (1.0 - g2)
         / pow(1.0 + g2 - 2.0 * g * cos_theta, 1.5);
}

// ─── Dual-lobe phase (r68-03) ───────────────────────────────────────
//
// A single HG lobe (g=0.6) gives forward shafts but a flat halo. Real
// atmospheric haze has a strong forward lobe AND a soft back-scatter
// glow; blending two HG lobes captures both cheaply, sharpening the
// god-ray core while keeping a gentle glow around the sun. Pure math,
// no extra taps.
float dual_phase(float cos_theta) {
    float fwd  = hg_phase(cos_theta, PHASE_G_FWD);
    float back = hg_phase(cos_theta, PHASE_G_BACK);
    return mix(back, fwd, PHASE_BLEND);
}

// ─── Shadow query ───────────────────────────────────────────────────
//
// Project a world position into the shadow map's clip space and
// sample. Returns 1.0 (fully lit), 0.0 (full shadow), or in-between.
// 3x3 manual PCF combined with the hardware comparison sampler's 2x2 PCF
// gives a 6x6-effective filter, which softens the volumetric "on/off"
// boundary that a single hardware tap leaves visible at coarse froxel
// Z-resolutions. Each textureOffset call is a single shadow tap.
float shadow_at(vec3 world_pos) {
    vec4 lc = ubo.light_view_proj * vec4(world_pos, 1.0);
    vec3 ndc = lc.xyz / lc.w;
    if (ndc.z < 0.0 || ndc.z > 1.0) return 1.0;
    vec2 uv = ndc.xy * 0.5 + 0.5;
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) return 1.0;
    float sum = 0.0;
    sum += textureOffset(shadow_map, vec3(uv, ndc.z), ivec2(-1, -1));
    sum += textureOffset(shadow_map, vec3(uv, ndc.z), ivec2(-1,  0));
    sum += textureOffset(shadow_map, vec3(uv, ndc.z), ivec2(-1,  1));
    sum += textureOffset(shadow_map, vec3(uv, ndc.z), ivec2( 0, -1));
    sum += textureOffset(shadow_map, vec3(uv, ndc.z), ivec2( 0,  0));
    sum += textureOffset(shadow_map, vec3(uv, ndc.z), ivec2( 0,  1));
    sum += textureOffset(shadow_map, vec3(uv, ndc.z), ivec2( 1, -1));
    sum += textureOffset(shadow_map, vec3(uv, ndc.z), ivec2( 1,  0));
    sum += textureOffset(shadow_map, vec3(uv, ndc.z), ivec2( 1,  1));
    return sum * (1.0 / 9.0);
}

// ─── Per-cell density+inscatter ─────────────────────────────────────
//
// Compute local extinction `density` and local in-scattering color
// at a world-space froxel center. Factored out of `main()` so the
// per-column loop can call it once per Z slice.
float cell_density(vec3 world_pos) {
    // Clamped altitude prevents exp blowup when world_pos.y is far
    // below sea level (deep underground or long downward view rays).
    float alt_y = clamp(world_pos.y, -20.0, 200.0);

    float base_density   = ubo.atmos_params.x;
    float humidity       = ubo.atmos_params.y;
    float humidity_curve = pow(humidity, 1.6);
    float density_at_player = base_density * mix(0.6, 2.2, humidity_curve);

    float height_fog       = exp(-alt_y * 0.05);
    float altitude_rolloff = exp(-max(alt_y - 60.0, 0.0) * 0.01);

    float time_seconds = ubo.atmos_params.w;
    vec2  wind_xy      = ubo.wind_params.xy;
    float wind_speed   = length(wind_xy);
    vec3  wind_offset  = vec3(wind_xy.x, 0.0, wind_xy.y) * time_seconds;
    // ─── Physically-flavored moisture: wind-advected blobs sheared into
    //     streaks. MUST stay identical to chunk.frag's fallback march so
    //     the froxel volume and the march agree at the same world point. ─
    const float MOISTURE_FREQ = 0.05;  // ~20 m dominant wavelength
    const float STREAK_GAIN   = 2.0;   // wind speed → streak elongation
    const float STREAK_MAX    = 5.0;   // cap on elongation factor
    // Advect with the wind (blobs drift downwind), sampled at the
    // dominant moisture frequency.
    vec3 mp = (world_pos - wind_offset) * MOISTURE_FREQ;
    // Shear-stretch the sample frame ALONG the wind so blobs elongate
    // into streaks (a scalar carried by a sheared flow stretches along
    // streamlines). Elongation grows with wind speed: calm → round
    // blobs, gusty → long streaks. Bounded.
    if (wind_speed > 1e-4) {
        vec2  wdir    = wind_xy / wind_speed;
        float along   = dot(mp.xz, wdir);
        vec2  across  = mp.xz - along * wdir;
        float stretch = 1.0 + min(wind_speed * STREAK_GAIN, STREAK_MAX);
        mp.xz = across + (along / stretch) * wdir;
    }
    // Condense into coherent blobs: contrast the field so moisture pools
    // into distinct banks with clearer gaps instead of uniform haze.
    float moisture = smoothstep(0.15, 0.85, fbm2(mp));
    float altitude_moisture_bias = clamp(1.5 - alt_y * 0.012, 0.2, 1.4);
    float wisp_factor  = mix(0.4, 1.6, moisture) * altitude_moisture_bias;

    float dist_from_cam = length(world_pos - ubo.camera_pos.xyz);
    float proximity_clear = smoothstep(0.0, 3.0, dist_from_cam);

    // ─── Valley / ground fog (r68-03) ───────────────────────────────
    // Extra density that pools at/below GROUND_FOG_Y and thins with
    // height, so fog visibly thickens in valleys and lifts off ridges.
    // Uses the same clamped altitude, so it is bounded.
    float ground_fog = 1.0
        + GROUND_FOG_STR * exp(-max(alt_y - GROUND_FOG_Y, 0.0) * GROUND_FOG_FALL);

    float density = density_at_player
                  * DENSITY_MUL
                  * (height_fog * 0.5 + 1.0)
                  * ground_fog
                  * altitude_rolloff
                  * wisp_factor
                  * proximity_clear;
    density = min(density, 2.0);

    return density;
}

// ─── Per-cell in-scattering (the EXPENSIVE half) ─────────────────────
//
// Shadow-attenuated sun (HG phase) + ambient sky. This holds the 9-tap
// shadow PCF that dominates the kernel, so the main loop only calls it
// for froxels whose optical depth is high enough to matter (see the
// "skip empty froxels" early-out in main()).
vec3 cell_inscatter(vec3 world_pos) {
    vec3 to_cam   = ubo.camera_pos.xyz - world_pos;
    vec3 view_dir = normalize(to_cam);
    vec3 to_sun   = -ubo.sun_dir.xyz;
    float cos_theta = dot(view_dir, to_sun);

    float shadow = shadow_at(world_pos);
    float phase  = dual_phase(cos_theta);

    // Shadow-attenuated sun: dual-lobe phase × shaft gain × tint. The
    // per-froxel `shadow` is what turns this into light shafts — air in
    // shadow scatters nothing, lit air scatters along the phase lobe.
    vec3 sun_inscatter     = ubo.sun_color.rgb * SCATTER_TINT
                           * shadow * phase * ubo.sun_dir.w * SHAFT_INTENSITY;
    vec3 ambient_inscatter = ubo.sky_color.rgb * 0.3;
    return sun_inscatter + ambient_inscatter;
}

void main() {
    uvec2 xy = gl_GlobalInvocationID.xy;
    uvec3 froxel_extent = uvec3(pc.froxel_extent_packed.xyz);
    if (any(greaterThanEqual(xy, froxel_extent.xy))) return;

    // ─── Cumulative front-to-back integration along the view ray ──
    //
    // Each invocation of this kernel is responsible for one (x, y)
    // pixel column of the froxel volume — it walks all Z slices
    // from near to far, carrying running cumulative scattered-color
    // and remaining transmittance. At each slice we write the
    // CUMULATIVE state (not the local cell contribution).
    //
    // This means the fragment shader can sample ONCE at the depth
    // of its surface and read the full integrated fog directly —
    // no per-fragment compositing loop needed. Compared to the
    // previous "store local, fragment composites 6 samples"
    // scheme, this is:
    //   - faster on the fragment side (1 sample vs 6+)
    //   - mathematically correct for any view ray length
    //   - immune to per-cell-thickness alignment issues
    //
    // Math (per cell, in order):
    //   trans_local = exp(-density * cell_thickness_in_world_units)
    //   color_local = inscatter * density * cell_thickness
    //   color_acc  += color_local * trans_acc      (using PRIOR trans)
    //   trans_acc  *= trans_local
    //
    // After cell N is processed:
    //   color_acc = total in-scattered light from camera to far edge of cell N
    //   trans_acc = remaining transmittance from camera to far edge of cell N
    //
    // The fragment composites surface color as:
    //   final = surface_color * trans_acc + color_acc
    vec3  color_acc = vec3(0.0);
    float trans_acc = 1.0;

    float fz    = pc.froxel_extent_packed.z;
    uint  num_z = uint(fz);

    // Early-out thresholds for the "skip empty froxels" optimization.
    const float OD_EPS    = 7.0e-5;  // optical depth below which a cell's
                                     // in-scatter is sub-perceptual (<1 LSB;
                                     // validated by froxel_skip_model.c)
    const float TRANS_EPS = 2.0e-3;  // ray already opaque → nothing behind

    for (uint z = 0u; z < num_z; z++) {
        uvec3 froxel_idx = uvec3(xy, z);
        vec3  world_pos  = froxel_to_world(froxel_idx);

        // Optional per-frame temporal jitter (default OFF). When enabled
        // (and paired with the documented history-blend path) this breaks
        // up slice banding; standalone it is a no-op at the default 0.0.
        if (TEMPORAL_JITTER > 0.0) {
            float jz = (hash13(vec3(vec2(xy), ubo.atmos_params.w)) - 0.5) * TEMPORAL_JITTER;
            world_pos = froxel_to_world_f(vec3(vec2(xy), float(z) + 0.5 + jz));
        }

        // World-space thickness of THIS cell along view-z. The grid is
        // log-spaced so near cells are thin (~0.05 m) and far cells thick
        // (~18 m); using the actual thickness makes near/far contribute
        // proportionally.
        float z_near_t    = float(z)        / fz;
        float z_far_t     = float(z + 1u)   / fz;
        float view_z_near = view_z_from_slice(z_near_t);
        float view_z_far  = view_z_from_slice(z_far_t);
        float step_through = view_z_far - view_z_near;

        // Density is cheap — no shadow taps.
        float density = cell_density(world_pos);

        // ─── Skip empty froxels (SHADER_ROADMAP optimization) ─────────
        // cell_inscatter()'s 9-tap shadow PCF dominates this kernel. A
        // cell whose optical depth (density × thickness) is below OD_EPS
        // contributes sub-perceptual in-scatter, and once the ray is
        // saturated (trans_acc ≤ TRANS_EPS) nothing behind it is visible
        // — so in both cases we skip the shadow path and treat in-scatter
        // as zero. The extinction term is still applied below, so this is
        // output-preserving. A large fraction of cells qualify: the
        // proximity-cleared near field, high-altitude clear air, and the
        // gaps between moisture blobs.
        vec3 inscatter = vec3(0.0);
        if (density * step_through > OD_EPS && trans_acc > TRANS_EPS) {
            inscatter = cell_inscatter(world_pos);
        }

        float trans_local = exp(-density * step_through);
        vec3  color_local = inscatter * density * step_through;

        // Front-to-back composite, IN ORDER, IN PLACE.
        color_acc += color_local * trans_acc;
        trans_acc *= trans_local;

        // Floor on stored alpha — a floor of zero is the "unfilled"
        // sentinel used by the fragment shader's probe test, so we never
        // write exactly zero even for fully-transparent cells.
        float trans_alpha = max(trans_acc, 0.001);

        imageStore(
            froxel_out,
            ivec3(froxel_idx),
            vec4(color_acc, trans_alpha)
        );
    }
}
