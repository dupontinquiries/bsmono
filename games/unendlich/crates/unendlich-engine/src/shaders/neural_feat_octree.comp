#version 450
// neural_feat_octree.comp — the feature pass reading r67's GPU octree.
//
// Identical features to neural_feat.comp; occ()/march() walk the octree via
// r67's own octree_sample.glsl instead of a dense grid. Single chunk (base=0)
// here for validation; in r67, map world->chunk and pass that chunk's
// base_node_index (and the per-chunk base table) — feature layout unchanged.

#extension GL_GOOGLE_include_directive : require
#include "octree_types.glsl"
layout(std430, binding = 0) readonly buffer OctreeNodes { OctreeNode nodes[]; };
#include "octree_sample.glsl"

layout(local_size_x = 64) in;
layout(std430, binding = 1) readonly  buffer GBuf { float gbuf[]; };   // wpos3,n3,mat,hit
layout(std430, binding = 2) readonly  buffer Alb  { float alb[];  };   // [NB*4]
layout(std430, binding = 3) writeonly buffer Feat { float feat[]; };

layout(push_constant) uniform PC { uint M; uint NB; };

float occ(vec3 p) {
    ivec3 c = ivec3(floor(p));
    if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, ivec3(int(OCTREE_CHUNK_SIZE)))))
        return 0.0;
    return octree_sample(0u, uvec3(c)) > 0u ? 1.0 : 0.0;
}

float march(vec3 o, vec3 d, float maxd) {
    float t = 0.5;
    int steps = int(maxd / 0.5);
    for (int s = 0; s < steps; ++s) {
        if (occ(o + d * t) > 0.5) return t / maxd;
        t += 0.5;
        if (t > maxd) break;
    }
    return 1.0;
}

void main() {
    uint r = gl_GlobalInvocationID.x;
    if (r >= M) return;
    uint fb = r * 104u;
    uint gb = r * 8u;

    float hit = gbuf[gb + 7u];
    if (hit < 0.5) { for (uint i = 0u; i < 104u; ++i) feat[fb + i] = 0.0; return; }

    vec3 wp = vec3(gbuf[gb + 0u], gbuf[gb + 1u], gbuf[gb + 2u]);
    vec3 nrm = vec3(gbuf[gb + 3u], gbuf[gb + 4u], gbuf[gb + 5u]);
    int  mat = clamp(int(gbuf[gb + 6u]), 0, int(NB) - 1);
    vec3 sun = normalize(vec3(0.5, 0.82, 0.30));
    vec3 base = wp + nrm * 0.5;

    feat[fb + 0u] = nrm.x; feat[fb + 1u] = nrm.y; feat[fb + 2u] = nrm.z;
    feat[fb + 3u] = alb[uint(mat) * 4u + 0u];
    feat[fb + 4u] = alb[uint(mat) * 4u + 1u];
    feat[fb + 5u] = alb[uint(mat) * 4u + 2u];
    feat[fb + 6u] = clamp(dot(nrm, sun), -1.0, 1.0);
    feat[fb + 7u] = wp.y / float(OCTREE_CHUNK_SIZE);

    float radii[3] = float[3](1.0, 2.0, 4.0);
    uint off = 8u;
    for (int ri = 0; ri < 3; ++ri) {
        uint k = 0u;
        for (int dx = -1; dx <= 1; ++dx)
        for (int dy = -1; dy <= 1; ++dy)
        for (int dz = -1; dz <= 1; ++dz) {
            if (dx == 0 && dy == 0 && dz == 0) continue;
            vec3 dir = normalize(vec3(float(dx), float(dy), float(dz)));
            feat[fb + off + k] = occ(base + dir * radii[ri]);
            k += 1u;
        }
        off += 26u;
    }
    for (uint d = 1u; d <= 12u; ++d) feat[fb + off + (d - 1u)] = occ(base + sun * float(d));
    off += 12u;

    vec3 H[5] = vec3[5](vec3(0, 1, 0), vec3(1, 2, 1), vec3(-1, 2, 1), vec3(1, 2, -1), vec3(-1, 2, -1));
    feat[fb + 98u] = march(base, sun, 40.0);
    for (uint h = 0u; h < 5u; ++h) feat[fb + 99u + h] = march(base, normalize(H[h]), 16.0);
}
