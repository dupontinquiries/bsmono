#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require

// unendlich GPU chunk culling — SUBGROUP VARIANT of chunk_cull.comp.
//
// ## What this changes, and what it does NOT
//
// It does NOT fix the global-atomic contention. r482 already did that: each
// workgroup tallies in shared memory and issues ONE global `atomicAdd`. That
// work stands and this variant keeps the same one-global-atomic-per-group
// property.
//
// What is left after r482, per workgroup, is:
//
//     up to 64  shared-memory atomicAdd, all serialised on one address
//      2        barrier()  — full workgroup syncs, unavoidable with shared mem
//      1        global atomicAdd
//
// This variant removes the first two entirely. `subgroupBallot` computes the
// same tally in registers — every lane learns how many lanes ahead of it are
// emitting, with no memory traffic and no sync — so there is nothing to
// barrier on.
//
// ## Why 32 and not 64
//
// Apple GPUs execute 32-wide. A 64-wide workgroup is two SIMD groups that must
// rendezvous at every `barrier()`; at 32 the workgroup IS the subgroup and the
// barriers are not merely cheap, they are absent. The cost is twice as many
// workgroups and therefore twice as many global atomics (one per 32 chunks
// instead of one per 64) — a trade of 1 uncontended global atomic against
// ~32 shared atomics and 2 barriers.
//
// On a 64-wide device (AMD wave64) this is the wrong shape and the original
// shader is the right one. Hence: a VARIANT, selected at pipeline creation
// from `VkPhysicalDeviceSubgroupProperties.subgroupSize` and the presence of
// BASIC|BALLOT in `supportedOperations`. See device_budget.rs, which already
// reads physical-device properties at startup for `gpu_class_from_vk_device_type`.
//
// ## Correctness
//
// Output is the same SET of draw commands as chunk_cull.comp. The ORDER
// differs — it already did, since r482's per-workgroup base is whichever
// group reached the atomic first — and order is irrelevant for an indirect
// draw list. Two properties are preserved deliberately:
//
//   * no early `return`: `subgroupBallot` is a convergent operation and lanes
//     that have exited do not participate, which would undercount. Out-of-
//     range lanes take the same path with `emit = false`, exactly as the
//     original avoids early return for the barriers.
//   * `chunks[]` is read at a clamped index so `c` is always initialised;
//     it is only USED when emit is true, which implies i < chunk_count.

layout(local_size_x = 32) in;

const uint FLAG_DEBUG_OVERLAY = 1u;
const uint FLAG_OCCLUDED      = 2u;

struct ChunkDraw {
    uint  index_count;
    uint  first_index;
    int   vertex_offset;
    uint  flags;
    vec4  aabb_min;
    vec4  aabb_max;
};

layout(std430, set = 0, binding = 0) readonly buffer Chunks {
    ChunkDraw chunks[];
};

struct DrawCmd {
    uint index_count;
    uint instance_count;
    uint first_index;
    int  vertex_offset;
    uint first_instance;
};

layout(std430, set = 0, binding = 1) writeonly buffer Commands {
    DrawCmd commands[];
};

layout(std430, set = 0, binding = 2) buffer Counter {
    uint visible_count;
};

struct ViewParams { vec4 planes[6]; };
layout(std430, set = 0, binding = 3) readonly buffer Views {
    ViewParams view_params[];
};

layout(push_constant) uniform PushConstants {
    uint view_index;
    uint chunk_count;
    uint stride;
    uint stride_phase;
} pc;

bool aabb_visible(vec3 mn, vec3 mx) {
    for (int i = 0; i < 6; i++) {
        vec4 p = view_params[pc.view_index].planes[i];
        vec3 corner = vec3(
            (p.x >= 0.0) ? mx.x : mn.x,
            (p.y >= 0.0) ? mx.y : mn.y,
            (p.z >= 0.0) ? mx.z : mn.z
        );
        if (dot(p.xyz, corner) + p.w < 0.0) return false;
    }
    return true;
}

void main() {
    uint i = gl_GlobalInvocationID.x;

    ChunkDraw c = chunks[(i < pc.chunk_count) ? i : 0u];
    bool emit = false;
    if (i < pc.chunk_count && c.index_count != 0u) {
        bool stride_ok = (pc.stride <= 1u) || ((i % pc.stride) == pc.stride_phase);
        if (stride_ok) {
            bool always_emit = (c.flags & FLAG_DEBUG_OVERLAY) != 0u;
            bool occluded    = (c.flags & FLAG_OCCLUDED) != 0u;
            emit = always_emit || (aabb_visible(c.aabb_min.xyz, c.aabb_max.xyz) && !occluded);
        }
    }

    // The whole r482 aggregation, in registers. `vote` is one bit per lane;
    // `n` is the group's total; `slot` is this lane's rank among the emitters
    // ahead of it — which is exactly what the shared `atomicAdd` returned.
    uvec4 vote = subgroupBallot(emit);
    uint  n    = subgroupBallotBitCount(vote);
    uint  slot = subgroupBallotExclusiveBitCount(vote);

    // One lane reserves the contiguous run for the whole group. `subgroupElect`
    // picks the lowest ACTIVE lane, not lane 0 — which matters here because
    // lane 0 may be out of range on the final partial group.
    uint base = 0u;
    if (subgroupElect()) base = atomicAdd(visible_count, n);
    base = subgroupBroadcastFirst(base);

    if (emit) {
        uint at = base + slot;
        commands[at].index_count    = c.index_count;
        commands[at].instance_count = 1u;
        commands[at].first_index    = c.first_index;
        commands[at].vertex_offset  = c.vertex_offset;
        commands[at].first_instance = i;
    }
}
