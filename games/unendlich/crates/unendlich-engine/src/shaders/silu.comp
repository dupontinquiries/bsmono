#version 450
// silu.comp — SiLU activation x*sigmoid(x), GPU side. Port of gpu-gemm's SILU
// WGSL kernel into unendlich GLSL conventions. CPU ref: x/(1+exp(-x)) in f32.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly  buffer X { float x[]; };
layout(std430, set = 0, binding = 1) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC { uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float v = x[i];
    o[i] = v / (1.0 + exp(-v));
}
