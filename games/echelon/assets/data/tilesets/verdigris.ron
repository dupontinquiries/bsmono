// Oxidized ruins over cold marsh stone. Cyan key, rust-umber bounce
// (modern complementary GI feel), damp-stone specular.
(
    name: "verdigris",
    low: Rgb(36, 48, 43),      low_var: Rgb(45, 58, 48),
    high: Rgb(47, 64, 56),     high_var: Rgb(55, 73, 60),
    ramp: Rgb(58, 68, 55),
    bridge: Rgb(52, 60, 52),
    cliff: Rgb(26, 32, 36),
    rock: Rgb(18, 23, 26),
    grit: 60,
    sun_dir: (-430, -300, 850),
    sun: Rgb(168, 214, 235),
    ambient: Rgb(52, 38, 30),
    rim: Rgb(70, 110, 90),
    spec_pow: 16, spec: 22,
    alloy_glow: Rgb(60, 255, 214),
    flux_glow: Rgb(176, 108, 255),
)
