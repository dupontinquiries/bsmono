{
  "model": {
    "name": "arena_bot_parts",
    "type": "shared_part_templates",
    "comment": "CAD-style layered spec for the game's shared bot part meshes (docs/ART_BIBLE.md rungs 1-5). gen_props.py compiles each assembly below into an IQM. Layer order follows the reference pipeline: frame -> actuator -> armor -> detail. Engine articulation, per-part color, weathering, and alt-mode reshaping all live in robot_parts.c and operate on these templates per slot.",
    "coordinate_system": { "up": "Y", "forward": "Z", "origin": "part_center", "units": "part-local half-extents (engine scales per slot)" }
  },

  "materials": {
    "comment": "Meshes carry a base texture; final color is engine-side per-part tint (element tint + two-tone + rung-5 weathering + accent pass in robot_parts.c).",
    "plate": { "texture": "plate_blue.png", "role": "armor + frame default" }
  },

  "proportions_reference": {
    "comment": "Mirrors robot_parts.c body archetypes (do not edit here; documentation of the live values).",
    "racer_beast":  { "calf": 1.55, "thigh": 0.82, "torso": 0.78, "torso_w": 1.18, "arm": 0.92, "stance": 1.05 },
    "siege":        { "calf": 0.85, "thigh": 0.80, "torso": 0.85, "torso_w": 1.55, "arm": 1.10, "stance": 1.35 },
    "flyer":        { "calf": 1.25, "thigh": 1.15, "torso": 0.95, "torso_w": 0.86, "arm": 1.05, "stance": 0.92 },
    "balanced":     { "calf": 1.30, "thigh": 0.88, "torso": 0.86, "torso_w": 1.06 }
  },

  "joints_reference": {
    "comment": "Engine-side articulation (robot_parts.c gait/pose system).",
    "elbows_knees": { "type": "hinge", "mechanism": "pose-driven swing" },
    "shoulders_hips": { "type": "ball", "mechanism": "pose-driven" },
    "neck": { "type": "limited_rotation" }
  },

  "transform_map_reference": {
    "comment": "Robot<->vehicle identity map (mirrors robot_parts.c vehicle branch): every part has two lives.",
    "chest": "hull wedge", "head": "cab", "visor": "windshield",
    "shoulders": "fenders", "arms": "front wheels", "thighs": "rear wheels",
    "shins": "exhausts", "back": "turret hump", "hands_feet": "hull nubs"
  },

