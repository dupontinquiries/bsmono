# build artifacts
target/
build-*/
dist/
*.rlib
*.rmeta
# caches / os
__pycache__/
*.pyc
.DS_Store
# prebuilt binaries (rebuildable) — keep sources only
**/scene-view-linux-x64

# gitmind: the bulk object store is regenerated via maintenance/gitmind-sync.sh,
# never committed (it's incompressible to git and a committed store self-references
# on the next `gin import`). Config + README are tracked.
/.gitmind/*.redb
/.gitmind/store.redb

# compiled shaders (.spv) are build artifacts regenerated from GLSL — don't track
# new ones. (Pre-existing assets/shaders/*.spv stay tracked until the shader
# build pipeline is wired to compile-on-build; see KITS_AND_BOUNDARIES / build-wiring.)
*.spv
**/target/
node_modules/
*-linux-x64
*-linux-aarch64
