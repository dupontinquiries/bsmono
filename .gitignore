# build artifacts
target/
build-*/
dist/
*.rlib
*.rmeta
# caches / os
__pycache__/
*.pyc
.DS_Store
# prebuilt binaries (rebuildable) — keep sources only
**/scene-view-linux-x64

# gitmind: the bulk object store is regenerated via maintenance/gitmind-sync.sh,
# never committed (it's incompressible to git and a committed store self-references
# on the next `gin import`). Config + README are tracked.
/.gitmind/*.redb
/.gitmind/store.redb

# compiled shaders (.spv) are build artifacts regenerated from GLSL — don't track
# new ones. (Pre-existing assets/shaders/*.spv stay tracked until the shader
# build pipeline is wired to compile-on-build; see KITS_AND_BOUNDARIES / build-wiring.)
*.spv
**/target/
node_modules/
*-linux-x64
*-linux-aarch64

# Test footage stays OUT of the repo. Codec work needs hundreds of MB of
# video and git would carry every byte forever against a 500MB budget;
# the corpus lives outside the tree and is re-supplied per session.
# Measurements are committed as CSVs in apps/fao-codec/docs/, which is
# what actually needs to be reproducible.
*.mkv
*.mp4
*.webm
*.y4m
*.ivf

# egui_kittest snapshot testing: only the committed baseline (*.png without
# one of these suffixes) belongs in the repo. *.new.png/.diff.png/.old.png
# are per-run artifacts written on failure or UPDATE_SNAPSHOTS, not fixtures.
*.new.png
*.diff.png
*.old.png
