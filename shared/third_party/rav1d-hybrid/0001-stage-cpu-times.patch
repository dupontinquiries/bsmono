--- /dev/null
+++ b/src/stage_time.rs
@@ -0,0 +1,45 @@
+//! Per-stage CPU time for the hybrid-decoder work (vidkit): how much of
+//! decoding is entropy (pass 1, CPU forever) and how much is reconstruction
+//! and filtering (pass 2 onward, what a GPU could take). Thread CPU time
+//! (CLOCK_THREAD_CPUTIME_ID), so oversubscribed threads do not count their
+//! waiting. Off unless RAV1D_STAGE_TIMES is set; then the CLI prints it.
+use std::sync::atomic::{AtomicU64, Ordering};
+
+pub const NAMES: [&str; 8] = ["entropy (pass 1)", "reconstruction (pass 2)", "deblock", "cdef", "superres", "loop restoration", "film grain", "single-pass parse+recon"];
+pub static NS: [AtomicU64; 8] = [const { AtomicU64::new(0) }; 8];
+
+pub fn enabled() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("RAV1D_STAGE_TIMES").is_some())
+}
+
+pub fn thread_ns() -> u64 {
+    let mut ts = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    // SAFETY: clock_gettime into a local.
+    unsafe { libc::clock_gettime(libc::CLOCK_THREAD_CPUTIME_ID, &mut ts) };
+    ts.tv_sec as u64 * 1_000_000_000 + ts.tv_nsec as u64
+}
+
+pub struct Guard(usize, u64);
+
+pub fn start(stage: usize) -> Option<Guard> {
+    enabled().then(|| Guard(stage, thread_ns()))
+}
+
+impl Drop for Guard {
+    fn drop(&mut self) {
+        NS[self.0].fetch_add(thread_ns().saturating_sub(self.1), Ordering::Relaxed);
+    }
+}
+
+pub fn report() -> String {
+    let v: Vec<u64> = NS.iter().map(|a| a.load(Ordering::Relaxed)).collect();
+    let total: u64 = v.iter().sum::<u64>().max(1);
+    let mut s = String::from("stage CPU time (thread clocks):\n");
+    for (n, t) in NAMES.iter().zip(&v) {
+        if *t > 0 {
+            s += &format!("  {:26} {:9.1} ms  {:5.1}%\n", n, *t as f64 / 1e6, *t as f64 / total as f64 * 100.0);
+        }
+    }
+    s
+}
